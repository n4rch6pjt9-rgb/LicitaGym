p_agendado.gif' alt='' class='icone-legenda' />&nbsp;Agendado</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_aguardando_homo.gif' alt='' class='icone-legenda' />&nbsp;Aguardando homologação</li><li class=\"listaLI\"><img src='/core/images/icones/ic_compra_anulado.gif' alt='' class='icone-legenda' />&nbsp;Anulado</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_cancelado.gif' alt='' class='icone-legenda' />&nbsp;Cancelado</li><li class=\"listaLI\"><img src='/core/images/icones/ic_compra_deserto.gif' alt='' class='icone-legenda' />&nbsp;Convite deserto</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_adjudicacao.gif' alt='' class='icone-legenda' />&nbsp;Em adjudicação</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_configuracao.gif' alt='' class='icone-legenda' />&nbsp;Em configuração</li><li class=\"listaLI\"><img src='/core/images/icones/ic_oc_pesquisa_satisfacao.gif' alt='' class='icone-legenda' />&nbsp;Em homologação parcial</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_em_proposta.gif' alt='' class='icone-legenda' />&nbsp;Em proposta</li><li class=\"listaLI\"><img src='/core/images/icones/ic_compra_fracassado.gif' alt='' class='icone-legenda' />&nbsp;Fracassado</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_homologacao_pend.gif' alt='' class='icone-legenda' />&nbsp;Homologação pendente</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_homologado.gif' alt='' class='icone-legenda' />&nbsp;Homologado</li><li class=\"listaLI\"><img src='/core/images/icones/ic_contrato.gif' alt='' class='icone-legenda' />&nbsp;Homologado com contrato</li><li class=\"listaLI\"><img src='/core/images/icones/ic_cot_enc_pedido.gif' alt='' class='icone-legenda' />&nbsp;Homologado com pedido</li><li class=\"listaLI\"><img src='/core/images/icones/ic_contrato.gif' alt='' class='icone-legenda' />&nbsp;Homologado com registro de preço</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_interrompido.gif' alt='' class='icone-legenda' />&nbsp;Interrompido</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_julgamento.gif' alt='' class='icone-legenda' />&nbsp;Julgamento dos recursos</li><li class=\"listaLI\"><img src='/core/images/icones/ic_contra_razoes.png' alt='' class='icone-legenda' />&nbsp;Período para contrarrazões</li><li class=\"listaLI\"><img src='/core/images/icones/ic_razao_recurso.png' alt='' class='icone-legenda' />&nbsp;Período para razões do recurso</li><li class=\"listaLI\"><img src='/core/images/icones/ic_c_observacoes.gif' alt='' class='icone-legenda' />&nbsp;Prazo de observações</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_prorrogado.gif' alt='' class='icone-legenda' />&nbsp;Prazo prorrogado</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_abertura_propostas.gif' alt='' class='icone-legenda' />&nbsp;Propostas abertas</li><li class=\"listaLI\"><img src='/core/images/icones/ic_contrato.gif' alt='' class='icone-legenda' />&nbsp;Resumo do processo</li><li class=\"listaLI\"><img src='/core/images/icones/ic_compra_revogado.gif' alt='' class='icone-legenda' />&nbsp;Revogado</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_suspenso.gif' alt='' class='icone-legenda' />&nbsp;Suspenso</li><li>&nbsp;</li><li class=\"listaLI\"><h4 class='titulo-legenda'>COMPRA DIRETA</h4></li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_agendado.gif' alt='' class='icone-legenda' />&nbsp;Agendado/Publicado</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_classificacao.gif' alt='' class='icone-legenda' />&nbsp;Análise dos lances</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_cancelado.gif' alt='' class='icone-legenda' />&nbsp;Cancelado</li><li class=\"listaLI\"><img src='/core/images/icones/ic_compra_deserto.gif' alt='' class='icone-legenda' />&nbsp;Deserta</li><li class=\"listaLI\"><img src='/core/images/icones/ic_atividade_aprovacao.gif' alt='' class='icone-legenda' />&nbsp;Em Aprovação</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_configuracao.gif' alt='' class='icone-legenda' />&nbsp;Em configuração</li><li class=\"listaLI\"><img src='/core/images/icones/ic_oc_pesquisa_satisfacao.gif.gif' alt='' class='icone-legenda' />&nbsp;Em finalização parcial</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_aguardando_homo.gif' alt='' class='icone-legenda' />&nbsp;Finalização pendente</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_homologado.gif' alt='' class='icone-legenda' />&nbsp;Finalizado</li><li class=\"listaLI\"><img src='/core/images/icones/ic_contrato.gif' alt='' class='icone-legenda' />&nbsp;Finalizado com contrato</li><li class=\"listaLI\"><img src='/core/images/icones/ic_cot_enc_pedido.gif' alt='' class='icone-legenda' />&nbsp;Finalizado com pedido</li><li class=\"listaLI\"><img src='/core/images/icones/ic_requisicao_rp_ativo.gif' alt='' class='icone-legenda' />&nbsp;Finalizado com registro de preço</li><li class=\"listaLI\"><img src='/core/images/icones/ic_compra_fracassado.gif' alt='' class='icone-legenda' />&nbsp;Fracassada</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_interrompido.gif' alt='' class='icone-legenda' />&nbsp;Interrompido</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_prorrogado.gif' alt='' class='icone-legenda' />&nbsp;Prazo prorrogado</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_em_proposta.gif' alt='' class='icone-legenda' />&nbsp;Recebimento de lances</li><li class=\"listaLI\"><img src='/core/images/icones/ic_contrato.gif' alt='' class='icone-legenda' />&nbsp;Resumo do processo</li><li class=\"listaLI\"><img src='/core/images/icones/ic_p_suspenso.gif' alt='' class='icone-legenda' />&nbsp;Suspenso</li></ul>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Grade de dados -->\r\n        <div id=\"divPainelMural\" class=\"painel\">\r\n            <h1>\r\n                <div class=\"row-fluid\">\r\n                    <div class=\"span6\">\r\n                        <label id=\"lblMuralTitulo\"></label>\r\n                    </div>\r\n\r\n                    <div class=\"areaClique\">\r\n                        <div id=\"lblTagsFiltros\"></div>\r\n                    </div>\r\n                    \r\n                    <div id=\"btVoltarInicio\" class=\"areaClique\" style=\"display:none;\">\r\n                        <div class=\"ico-voltar-azul-25\" onclick=\"window.location='/Default.aspx'\" ></div>\r\n                    </div>\r\n\r\n                    <div id=\"btVoltarGrid\" class=\"areaClique\" style=\"display:none;float:right;\">\r\n                        <a onclick=\"btAcao_Click('voltarUrlMural')\" class=\"tooltip-cima acoes-detalhes-mural\" data-title=\"Voltar\" ><div class=\"ico-voltar-azul-25\" ></div></a>\r\n                    </div>\r\n                </div>\r\n            </h1>\r\n\r\n            <div class=\"span12\">\r\n                <label id=\"lblMuralInformativo\"></label>\r\n            </div>\r\n             \r\n            <div id=\"tbRfiEmAndamento\" style=\"display:none;\">\r\n            <h1>\r\n                <div class=\"row-fluid\">\r\n                    <div class=\"span8\">\r\n                        <label class=\"lblMuralSubtitulo\" style=\"display:none;color: #2A6496;\">Requests for informations (RFIs) em andamento</label>\r\n                    </div>\r\n                </div>\r\n            </h1>\r\n            <table width=\"100%\">\r\n                <thead id=\"thRfiEmAndamento\" class=\"texto-maiusculo\">\r\n                    \r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado \" style=\"display:none; min-width: 100px;\"><div>RFI</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"display:none;min-width: 300px;\"><div>Objeto</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"display:none;text-align:center;\"><div>Início das inscrições</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"display:none;text-align:center;\"><div>Encerramento das inscrições</div></th>\r\n                </thead>\r\n                <tbody id=\"trRfiEmAndamento\"></tbody>\r\n            </table>\r\n            <button type='button' id=\"btnExpandirRfiEmAndamento\" onclick='ExpandirRfiEmAndamento()' style=\"display:none\" class='botao-expandir' aria-label=\"Ver RFIs em andamento\" data-testid=\"mural-button-expandir-rfi-em-andamento\">Ver todas as RFIs em andamento</button>\r\n            <br />\r\n            <br />\r\n            </div>\r\n            \r\n            <div id=\"tbRfiEncerradas\" style=\"display:none;\">\r\n            <h1>\r\n                <div class=\"row-fluid\">\r\n                    <div class=\"span8\">\r\n                        <label class=\"lblMuralSubtitulo\" style=\"display:none;color: #2A6496;\">Requests for informations (RFIs) encerradas</label>\r\n                    </div>\r\n                </div>\r\n            </h1>\r\n            <table width=\"100%\">\r\n                <thead id=\"thRfiEncerrados\" class=\"texto-maiusculo\">\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado \" style=\"display:none; min-width: 100px;\"><div>RFI</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"display:none; min-width: 300px\"><div>Objeto</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"display:none;text-align:center;\"><div>Início das inscrições</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"display:none;text-align:center;\"><div>Encerramento das inscrições</div></th>\r\n                </thead>\r\n                <tbody id=\"trRfiEncerrados\"></tbody>\r\n            </table> \r\n            <button type='button' id=\"btnExpandirRfiEncerrados\" onclick='ExpandirRfiEncerrados()' style=\"display:none\" class='botao-expandir' aria-label=\"Ver RFIs encerradas\" data-testid=\"mural-button-expandir-rfi-encerrados\">Ver todas as RFIs encerradas</button>\r\n            <br />\r\n            </div>\r\n\r\n            <div id=\"tbConsultores\" style=\"display:none;\">\r\n            <h1 class=\"lblMuralSubtitulo\" style=\"display:none;\">\r\n                <div class=\"row-fluid\">\r\n                    <div class=\"span8\">\r\n                        <label style=\"color: #2A6496;\">Cadastro de Consultores</label>\r\n                    </div>\r\n                </div>\r\n            </h1>\r\n            <table width=\"100%\">\r\n                <thead id=\"thConsultores\" class=\"texto-maiusculo\">\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado \" style=\"min-width:20%\"><div >Chamamento público</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"width:18%\"><div >Linha de fornecimento</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"width:28%\"><div >Empresa</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"width:10%;text-align:center;\"><div >Aprovação</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"width:10%;text-align:center;\"><div >Vigência</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"width:18%;text-align:center;\"><div >Situação</div></th>\r\n                </thead>\r\n                <tbody id=\"trConsultores\"></tbody>\r\n            </table> \r\n            <button type='button' id=\"btnExpandirConsultores\" onclick='ExpandirConsultores()' style=\"display:none\" class='botao-expandir' aria-label=\"Ver todos os componentes do cadastro\" data-testid=\"mural-button-expandir-consultores\">Ver todos os componentes do cadastro</button>\r\n            <br />\r\n            </div>\r\n            \r\n            <div id=\"tbEditais\">\r\n            <h1 class=\"lblMuralSubtitulo\" style=\"display:none;\">\r\n                <div class=\"row-fluid\">\r\n                    <div class=\"span8\">\r\n                        <label class=\"lblMuralSubtitulo\" style=\"color: #2A6496;\">Chamamentos públicos em andamento</label>\r\n                    </div>\r\n                </div>\r\n            </h1>\r\n            <table width=\"100%\">\r\n                <thead id=\"thListaMuralProcesso\" class=\"texto-maiusculo\">\r\n                    <th onclick=\"btOrdenarPor_Click('NCDPROCESSO', this)\" colspan=\"1\" class=\"comum areaClique \" style=\"display:none; min-width: 55px;\"><div class=\"icoOrdenacao\">Código</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado \" style=\"display:none; min-width: 55px;\"><div >Chamamento público</div></th>\r\n                    <th onclick=\"btOrdenarPor_Click('SNRPROCESSODISPLAY', this)\" colspan=\"1\" class=\"mural mural-pesquisa-agrupada mural-estatistico areaClique\" style=\"display:none;\"><div class=\"icoOrdenacao\">Processo</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"display:none;\"><div >Linha de fornecimento</div></th>\r\n                    <th onclick=\"btOrdenarPor_Click('SNREDITAL', this)\" colspan=\"1\" class=\"edital portalTransparencia areaClique\" style=\"display:none;\"><div class=\"icoOrdenacao\">Edital</div></th>\r\n                    <th onclick=\"btOrdenarPor_Click('SNMAPELIDO', this)\" colspan=\"1\" class=\"comum areaClique\" style=\"display:none;\"><div class=\"icoOrdenacao\">Unidade compradora</div></th>\r\n                    <th onclick=\"btOrdenarPor_Click('SDSOBJETO', this)\" colspan=\"1\" class=\"comum areaClique\" style=\"display:none;\"><div class=\"icoOrdenacao\">Objeto</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"display:none;text-align:center;\"><div >Início das inscrições</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"display:none;text-align:center;\"><div>Encerramento das inscrições</div></th>\r\n                    <th onclick=\"btOrdenarPor_Click('SNMMODALIDADE', this)\" colspan=\"1\" class=\"mural mural-pesquisa-agrupada edital portalTransparencia areaClique\" style=\"display:none; min-width: 85px;\"><div class=\"icoOrdenacao\">Modalidade</div></th>\r\n                    <th onclick=\"btOrdenarPor_Click('SNRPROCESSODISPLAY', this)\" colspan=\"1\" class=\"edital areaClique\" style=\"display:none;\"><div class=\"icoOrdenacao\">Processo</div></th>\r\n                    <th id=\"ctl00_conteudoPrincipal_colTituloEdital\" onclick=\"btOrdenarPor_Click(&#39;SDSTITULO&#39;, this)\" colspan=\"1\" class=\"edital portalTransparencia areaClique\" style=\"display:none;\"><div class=\"icoOrdenacao\">Título</div></th>\r\n\r\n                    <th onclick=\"btOrdenarPor_Click('TDTINICIAL', this)\" colspan=\"1\" class=\"mural mural-pesquisa-agrupada areaClique\" style=\"display:none;\"><div class=\"icoOrdenacao\">Data/Hora inicial</div></th>\r\n                    <th onclick=\"btOrdenarPor_Click('SDSCRITERIO', this)\" colspan=\"1\" class=\"portalTransparencia areaClique\" style=\"display:none;\"><div class=\"icoOrdenacao\">Critério</div></th>\r\n                    <th onclick=\"btOrdenarPor_Click('TDTFINAL', this)\" colspan=\"1\" class=\"mural mural-pesquisa-agrupada areaClique\" style=\"display:none;\" data-coluna=\"TDTFINAL\" ><div class=\"icoOrdenacao\">Data/Hora final</div></th>\r\n                    <th colspan=\"1\" class=\"mural mural-pesquisa-agrupada edital portalTransparencia\" style=\"display:none;\">Situação</th>                    \r\n                    <th onclick=\"btOrdenarPor_Click('TDTENCERRADO', this)\" colspan=\"1\" class=\"mural-estatistico portalTransparencia areaClique\" style=\"display:none;\"><div id=\"divFinalizacao\" class=\"icoOrdenacao\">Finalização</div></th>\r\n                    <th onclick=\"btOrdenarPor_Click('DVLESTIMADO', this)\" colspan=\"1\" class=\"mural-estatistico-vlestimado areaClique\" style=\"display:none;\"><div class=\"icoOrdenacao\">Valor estimado</div></th>\r\n                    <th onclick=\"btOrdenarPor_Click('DVLNEGOCIADO', this)\" colspan=\"1\" class=\"mural-estatistico portalTransparencia areaClique\" style=\"display:none;\"><div class=\"icoOrdenacao\">Valor negociado</div></th>\r\n                    <th onclick=\"btOrdenarPor_Click('DVLECONOMIA', this)\" colspan=\"1\" class=\"mural-estatistico-vleconomia areaClique\" style=\"display:none;\"><div class=\"icoOrdenacao\">Economia</div></th>\r\n                    <th onclick=\"btOrdenarPor_Click('DPCECONOMIA', this)\" colspan=\"1\" class=\"mural-estatistico-percenteconomia areaClique\" style=\"display:none;\"><div class=\"icoOrdenacao\">%</div></th>\r\n                </thead>\r\n                <tbody id=\"trListaMuralProcesso\"></tbody>\r\n            </table>      \r\n            <button type='button' id=\"btnExpandirProcessosEmAndamento\" onclick='ExpandirProcessosEmAndamento()' style=\"display:none\" class='botao-expandir float-right' aria-label=\"Ver editais em andamento\" data-testid=\"mural-button-expandir-processos-em-andamento\">Ver todos os editais de cadastro em andamento</button>\r\n            <br />\r\n            <br />\r\n            </div>\r\n\r\n            <div id=\"tbEditaisEncerrados\" style=\"display:none;\">\r\n            <h1>\r\n                <div class=\"row-fluid\">\r\n                    <div class=\"span8\">\r\n                        <label class=\"lblMuralSubtitulo\" style=\"display:none;color: #2A6496;\">Chamamentos públicos encerrados</label>\r\n                    </div>\r\n                </div>\r\n            </h1>\r\n            <table width=\"100%\">\r\n                <thead id=\"thListaEditaisEncerrados\" class=\"texto-maiusculo\">\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado \" style=\"display:none; min-width: 55px;\"><div>Chamamento público</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"display:none;\"><div>Linha de fornecimento</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"display:none;text-align:center;\"><div>Início das inscrições</div></th>\r\n                    <th colspan=\"1\" class=\"edital-simplificado thEditalSimplificado\" style=\"display:none;text-align:center;\"><div>Encerramento das inscrições</div></th>\r\n                </thead>\r\n                <tbody id=\"trListaEditaisEncerrados\"></tbody>\r\n            </table> \r\n            <button type='button' id=\"btnExpandirProcessosEncerrados\" onclick='ExpandirProcessosEncerrados()' style=\"display:none\" class='botao-expandir' aria-label=\"Ver editais encerrados\" data-testid=\"mural-button-expandir-processos-encerrados\">Ver todos os editais de cadastro encerrados</button>\r\n            <br />\r\n            <br />\r\n            </div>\r\n\r\n            <div id=\"carregandoLista\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <!-- Div de Detalhes -->\r\n    <div id=\"divDetalhes\" style=\"display:none; opacity: 0;\">\r\n        \r\n\r\n<link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css\" rel=\"stylesheet\" />\r\n\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/core/include/kendoUI/style/kendo.common.min.css\" /><link rel=\"stylesheet\" type=\"text/css\" href=\"/core/include/kendoUI/style/kendo.metro.min.css\" /><link rel=\"stylesheet\" type=\"text/css\" href=\"/core/include/kendoUI/style/kendo.custom.css\" /><link rel=\"stylesheet\" type=\"text/css\" href=\"/core/include/kendoUI/style/default.css\" /><link rel=\"stylesheet\" type=\"text/css\" href=\"/core/include/kendoUI/style/custom.css\" />\r\n\r\n<style>\r\n    .editalSimplificadoBotoes {\r\n        display: flex;\r\n        align-items: center;\r\n        padding: 5px;\r\n        background-color: #2A6496 !important;\r\n        font-size: 12px;\r\n        cursor: pointer;\r\n        margin-right: 10px;\r\n        border-radius: 12px;\r\n        white-space: nowrap;\r\n    }\r\n\r\n    @media screen and (max-width: 680px) {\r\n        .treeview-flex {\r\n            flex: auto !important;\r\n            width: 100%;\r\n        }\r\n    }\r\n\r\n    .treeview-flex h4 {\r\n        color: #656565;\r\n        margin-bottom: 1em;\r\n        text-align: center;\r\n    }\r\n\r\n    .treeview-flex {\r\n        flex: 1;\r\n        -ms-flex: 1 0 auto;\r\n    }\r\n\r\n    .row-tabstrip {\r\n        width: 95% !important;\r\n    }\r\n\r\n    #divDetalheItemTabstrip-2 {\r\n        padding: 0px !important;\r\n    }\r\n    #lstTagsRegiao {\r\n        display: flex; \r\n        flex-wrap: wrap;\r\n        gap: 6px; \r\n        justify-content: flex-start;\r\n        align-items: flex-start; \r\n        margin-top: 10px;\r\n    }\r\n\r\n    .regiaotag {\r\n        background-color: #f8f9fa; \r\n        border: 1px solid #ddd; \r\n        padding: 2px 8px; \r\n        border-radius: 5px;\r\n        font-size: 12px; \r\n        color: #333; \r\n        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1); \r\n        text-align: center;\r\n    }\r\n    .k-i-expand {\r\n        background: url('imagens/seta_desc.gif')center center no-repeat !important;\r\n        transform: rotate(-90deg);\r\n    }\r\n    \r\n    .k-i-collapse {\r\n        background: url('imagens/seta_desc.gif')center center no-repeat !important;\r\n    }\r\n    \r\n</style>\r\n\r\n<div id=\"areaDetalhes\">\r\n    <!-- Div de detalhes do produto -->\r\n    <div id=\"divDetalheItem\" style=\"display:none;\">\r\n        <div id=\"carregandoDetalheItem\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n\r\n        <div style='width: 100%; text-align: right; padding-top: 10px;' >\r\n            <input type='button' value='Fechar' onclick=\"$('#divDetalheItem').data('kendoWindow').close()\" class='campoBotaoSemIcone' style='width:20%' />\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Div de acompanhamento de lances -->\r\n    <div id=\"divDetalheAcompanhamentoLance\" style=\"display:none;\">\r\n        <div id=\"carregandoDetalheAcompanhamentoLance\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n    </div>\r\n\r\n    <!-- Div de anexo habilitação de lance -->\r\n    <div id=\"divDetalheLanceAnexoHabilitacao\" style=\"display:none;\">\r\n        <div id=\"divAnexoLanceResultado\">\r\n            <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                <div class=\"span12\" style=\"padding-right: 10px;\">\r\n                    <div id=\"carregandoAnexoLanceResultado\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div style='width: 100%; text-align: right; padding-top: 10px;' >\r\n            <input type='button' value='Fechar' onclick=\"$('#divDetalheLanceAnexoHabilitacao').data('kendoWindow').close()\" class='campoBotaoSemIcone' style='width:20%' />\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Resumo -->\r\n    <div class=\"painel\">\r\n        <!-- Acões -->\r\n        <h1>\r\n            <label id=\"lblMuralDetalheTitulo\"></label>\r\n            <div class=\"areaClique\" style=\"text-align: right; display: inline-flex; float:right;\">\r\n                <a style=\"display: none;\" onclick=\"btAcao_Click('faq')\" class=\"tooltip-cima oculta-edital oculta-transparencia acoes-detalhes-mural\"       data-acao=\"faq\" data-title=\"FAQ\" ><div class=\"ico-faq-azul-25\" ></div></a>\r\n                <a style=\"display: none;\" onclick=\"btAcao_Click('anexo')\" class=\"tooltip-cima oculta-edital oculta-transparencia acoes-detalhes-mural\"       data-acao=\"anexo\" data-title=\"Anexo\" ><div class=\"ico-download-azul-25\" ></div></a>               \r\n                <a style=\"display: none;\" id=\"btnRelatorio\" onclick=\"btAcao_Click('relatorio')\" class=\"tooltip-cima oculta-edital oculta-transparencia acoes-detalhes-mural\"   data-acao=\"relatorio\" data-title=\"Relatório\" ><div class=\"ico-relatorio-azul-25\" ></div></a>\r\n                <a style=\"display: none;\" onclick=\"btAcao_Click('chat')\" class=\"tooltip-cima oculta-edital oculta-transparencia acoes-detalhes-mural\"        data-acao=\"chat\" data-title=\"Chat\" ><div class=\"ico-chat-azul-25\" ></div></a>\r\n                <a style=\"display: none;\" id=\"btnHistorico\" onclick=\"btAcao_Click('historico')\" class=\"tooltip-cima oculta-edital oculta-transparencia acoes-detalhes-mural\"   data-acao=\"historico\" data-title=\"Histórico\" ><div class=\"ico-historico-azul-25\" ></div></a>\r\n                <a style=\"display: none;\" id=\"btnResumoEdital\" onclick=\"btAcao_Click('edital')\" class=\"tooltip-cima oculta-edital oculta-transparencia acoes-detalhes-mural\"      data-acao=\"edital\" data-title=\"Resumo do processo\" ><div class=\"ico-edital-azul-25\" ></div></a>                                        \r\n                <a style=\"display: none;\" id=\"btnImpugnar\" onclick=\"btAcao_Click('impugnar')\" class=\"tooltip-cima oculta-edital oculta-transparencia acoes-detalhes-mural\"    data-acao=\"impugnacao\" data-title=\"Impugnação\" ><div class=\"ico-impugnacao-azul-25\" ></div></a>\r\n                <a id=\"ctl00_conteudoPrincipal_ctrlMuralDetalhes_btnNotas\" style=\"display: none;\" onclick=\"btAcao_Click(&#39;notas&#39;)\" class=\"tooltip-cima oculta-edital oculta-transparencia acoes-detalhes-mural\" data-acao=\"notas\" data-title=\"Notas\"><div class=\"ico-notas-azul-25\" ></div></a>\r\n                <a style=\"display: none; color: white !important;\" onclick=\"btAcao_Click('inscreverSemCadastro')\" class=\"editalSimplificadoBotoes\" data-acao=\"inscreverSemCadastro\" data-title=\"QUERO ME INSCREVER E NÃO TENHO CADASTRO\">\r\n                    QUERO ME INSCREVER E NÃO TENHO CADASTRO\r\n                </a>\r\n                <a style=\"display: none; color: white !important;\" onclick=\"btAcao_Click('inscreverComCadastro')\" class=\"editalSimplificadoBotoes\" data-acao=\"inscreverComCadastro\" data-title=\"QUERO ME INSCREVER E TENHO CADASTRO\">\r\n                    QUERO ME INSCREVER E TENHO CADASTRO\r\n                </a>\r\n                <a onclick=\"btAcao_Click('voltarUrlMural')\" class=\"tooltip-cima acoes-detalhes-mural\" data-title=\"Voltar\" ><div class=\"ico-voltar-azul-25\" ></div></a>\r\n            \r\n            </div>\r\n        </h1>\r\n        \r\n        <hr />\r\n\r\n        <!-- Informações Iniciais -->\r\n        <div id=\"grupoResumo\" style=\"display:none;\"></div>\r\n        <div id=\"carregandoResumo\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n\r\n    </div>\r\n\r\n\r\n     <!-- Habilitação -->\r\n     <div class=\"painel oculta-edital oculta-transparencia\" style=\"height: 500px;\" data-acao=\"habilitacao\">\r\n        <h1>Habilitação\r\n            <span class=\"areaClique grade-produto-lote\" style=\"display:none; cursor:pointer; float:right;\" >\r\n            <div class=\"ico-voltar-azul-25\" onclick=\"btVoltarMuralProcessoDetalheItemLote_Click(this)\"></div>\r\n        </span>\r\n        </h1>\r\n        <!-- Lista -->\r\n        <div class=\"row-fluid\">\r\n            <div class=\"span12\">\r\n                <!-- Area Grade -->\r\n                <div>\r\n                    <div id=\"gridHabilitacao\" class=\"grade-item\"></div>\r\n                    <div id=\"gridProdutosLoteHabilitacao\" class=\"grade-produto-lote\" style=\"display:none; opacity: 0;\"></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n     </div>\r\n\r\n    \r\n    <!-- Classificação -->\r\n     <div class=\"painel oculta-edital oculta-transparencia\" style=\"height: 500px;\" data-acao=\"classificacao\">\r\n        <h1>Classificação\r\n            <span class=\"areaClique grade-produto-lote\" style=\"display:none; cursor:pointer; float:right;\" >\r\n            <div class=\"ico-voltar-azul-25\" onclick=\"btVoltarMuralProcessoDetalheItemLote_Click(this)\"></div>\r\n        </span>\r\n        </h1>\r\n        <!-- Lista -->\r\n        <div class=\"row-fluid\">\r\n            <div class=\"span12\">\r\n                <!-- Area Grade -->\r\n                <div>\r\n                    <div id=\"gridClassificacao\" class=\"grade-item\"></div>\r\n                    <div id=\"gridProdutosLoteClassificacao\" class=\"grade-produto-lote\" style=\"display:none; opacity: 0;\"></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n     </div>\r\n    \r\n    <!-- Resultado (antigo Detalhes) -->\r\n    <div class=\"painel oculta-edital\" style=\"height: 500px;\">\r\n        <h1 id=\"HeadDetalhesDoProcesso\" >\r\n            <span>Detalhes do processo</span>\r\n            <span class=\"areaClique grade-produto-lote\" style=\"display:none; cursor:pointer; float:right;\" >\r\n                <div class=\"ico-voltar-azul-25\" onclick=\"btVoltarMuralProcessoDetalheItemLote_Click(this)\"></div>\r\n            </span>\r\n        </h1>\r\n        <!-- Lista -->\r\n        <div class=\"row-fluid\">\r\n            <div class=\"span12\">\r\n                <!-- Area Grade -->\r\n                <div>\r\n                    <div id=\"gridItem\" class=\"grade-item\"></div>\r\n                    <div id=\"gridProdutosLote\" class=\"grade-produto-lote\" style=\"display:none; opacity: 0;\"></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n\r\n    <!-- Chat -->\r\n    <anexoChat>\r\n        <div class=\"row-fluid oculta-edital oculta-transparencia painel-funcionalidades-chat\" data-acao=\"chat\">\r\n            <div id=\"divChat\" class=\"painel\" data-carregado=\"0\">\r\n                <h1>Chat</h1>\r\n                <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                    <div class=\"span12\">\r\n                        <div id=\"carregandoChat\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </anexoChat>\r\n\r\n    <!-- Descricao do edital-->\r\n    <div id=\"divEditalDescricao\" class=\"row-fluid\" data-acao=\"descricao-edital\" style=\"display: none;\">\r\n        <div class=\"painel\" data-carregado=\"0\">\r\n            <h1>Descrição</h1>\r\n            <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                <div class=\"span12\">\r\n                    <div id=\"carregandoEditalDescricao\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Linha de fornecimento-->\r\n    <div id=\"divLinhaFornecimento\" class=\"row-fluid\" data-acao=\"linha-fornecimento\" style=\"display: none;\">\r\n        <div class=\"painel\" data-carregado=\"0\">\r\n            <h1>Linha de fornecimento</h1>\r\n            <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                <div class=\"span12\">\r\n                    <div class=\"treeview-flex\">\r\n                        <div id=\"treeview-kendo\"></div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Anexo do processo-->\r\n    <div class=\"row-fluid painel-funcionalidades-anexo\" data-acao=\"anexo\">\r\n        <div id=\"divAnexo\" class=\"painel\" data-carregado=\"0\">\r\n            <h1>Anexo - Processo</h1>\r\n            <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                <div class=\"span12\">\r\n                    <div id=\"carregandoAnexo\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Anexos da Proposta -->\r\n    <div class=\"row-fluid painel-funcionalidades-anexo\" data-acao=\"anexoproposta\">\r\n        <div id=\"divAnexoProposta\" class=\"painel\" data-carregado=\"0\">\r\n            <h1>Anexo - Proposta</h1>\r\n            <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                <div class=\"span12\">\r\n                    <div id=\"carregandoAnexoProposta\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Cadastro Fornecedor -->\r\n    <div class=\"row-fluid painel-funcionalidades-fornecedor\" data-acao=\"cadastrofornecedor\" style=\"display:none\">\r\n        <div id=\"divCadastroFornecedor\" class=\"painel\" data-carregado=\"0\" style=\"min-height:120px\">\r\n            <h1 id=\"hFornecedor\">Cadastro</h1>\r\n                <div class=\"span12\">\r\n                    <div id=\"grupoCadastroFornecedor\"></div>\r\n                    <div id=\"carregandoCadastroFornecedor\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n    <!-- Anexos da lance -->\r\n    <div class=\"row-fluid painel-funcionalidades-anexo\" data-acao=\"anexolance\">\r\n        <div id=\"divAnexoLance\" class=\"painel\" data-carregado=\"0\">\r\n            <h1>Anexo - Lance</h1>\r\n            <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                <div class=\"span12\">\r\n                    <div id=\"carregandoAnexoLance\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Anexos da negociação -->\r\n    <div class=\"row-fluid painel-funcionalidades-anexo\" data-acao=\"anexonegociacao\">\r\n        <div id=\"divAnexoNegociacao\" class=\"painel\" data-carregado=\"0\">\r\n            <h1>Anexo - Negociação</h1>\r\n            <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                <div class=\"span12\">\r\n                    <div id=\"carregandoAnexoNegociacao\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Anexos da habilitação -->\r\n    <div class=\"row-fluid painel-funcionalidades-anexo\" data-acao=\"anexohabilitacao\">\r\n        <div id=\"divAnexoHabilitacao\" class=\"painel\" data-carregado=\"0\">\r\n            <h1>Anexo - Habilitação</h1>\r\n            <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                <div class=\"span12\">\r\n                    <div id=\"carregandoAnexoHabilitacao\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>    \r\n\r\n    <!-- Anexos da recurso -->\r\n    <div class=\"row-fluid painel-funcionalidades-anexo\" data-acao=\"anexorecurso\">\r\n        <div id=\"divAnexoRecurso\" class=\"painel\" data-carregado=\"0\">\r\n            <h1>Anexo - Recurso</h1>\r\n            <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                <div class=\"span12\">\r\n                    <div id=\"carregandoAnexoRecurso\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Anexos da contra razões -->\r\n    <div class=\"row-fluid painel-funcionalidades-anexo\" data-acao=\"anexocontrarazoes\">\r\n        <div id=\"divAnexoContraRazoes\" class=\"painel\" data-carregado=\"0\">\r\n            <h1>Anexo - Contrarrazões</h1>\r\n            <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                <div class=\"span12\">\r\n                    <div id=\"carregandoAnexoContraRazoes\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Anexos do parecer -->\r\n    <div class=\"row-fluid painel-funcionalidades-anexo\" data-acao=\"anexoparecer\">\r\n        <div id=\"divAnexoParecer\" class=\"painel\" data-carregado=\"0\">\r\n            <h1>Anexo - Parecer</h1>\r\n            <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                <div class=\"span12\">\r\n                    <div id=\"carregandoAnexoParecer\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Histórico / Relatório -->\r\n    \r\n    <div class=\"row-fluid oculta-edital oculta-transparencia painel-funcionalidades-relhis\" data-acao=\"relhis\" >\r\n        <div class=\"span8\">\r\n            <div id=\"divHistorico\" class=\"painel\" data-carregado=\"0\" data-acao=\"historico\" >\r\n                <h1>Histórico</h1>\r\n                <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                    <div class=\"span12\">\r\n                        <div id=\"carregandoHistorico\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"span4\">\r\n            <div id=\"divRelatorio\" class=\"painel\" data-carregado=\"0\" data-acao=\"relatorio\" >\r\n                <h1>Relatórios</h1>\r\n                <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                    <div class=\"span12\">\r\n                        <div id=\"carregandoRelatorio\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Impugnação -->\r\n    <div class=\"row-fluid painel-funcionalidades-impugnacao\" data-acao=\"impugnacao\">\r\n        <div id=\"divImpugnar\" class=\"painel\" data-carregado=\"0\">\r\n            <h1>Registro de impugnação ao processo</h1>\r\n            <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                <div class=\"span12\">\r\n                    <div id=\"carregandoImpugnacao\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>    \r\n\r\n    <!-- Forum (por enquanto, apenas popup) -->\r\n    <div class=\"row-fluid oculta-edital oculta-transparencia painel-funcionalidades-forum\" data-acao=\"forum\">\r\n        <div id=\"divForum\" class=\"painel\" data-carregado=\"0\">\r\n            <h1>Esclarecimentos</h1>\r\n            <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                <div class=\"span12\">\r\n                    <div id=\"carregandoForum\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Notas de Processo -->\r\n    <div id=\"ctl00_conteudoPrincipal_ctrlMuralDetalhes_secaoNotas\" class=\"row-fluid oculta-edital oculta-transparencia\" data-acao=\"notas\">\r\n        <div id=\"divNotas\" class=\"painel\" data-carregado=\"0\">\r\n            <h1>Notas</h1>\r\n            <div class=\"row-fluid\" style=\"color:Black; margin: 5px;\">\r\n                <div class=\"span12\">\r\n                    <div id=\"carregandoNotas\" class=\"carregandoDados\" style=\"display:none\"><img src=\"Imagens/carregando.gif\" /></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <br /><br /><br /><br />\r\n    \r\n    <div id=\"divVoltarTopo\" onclick=\"btAcao_Click('topo')\" class=\"botao-voltar-topo areaClique\" ><div class=\"ico-topo-branco-25\" ></div></div>\r\n</div>\r\n\r\n<script type=\"text/javascript\">\r\n\r\n    var enumLicitacaoSituacaoItemLote = {\"Aberto\":1,\"Fechado\":2,\"Cancelado\":3,\"ReenvioDocumentos\":4,\"Finalizado\":5,\"EmIntencaoRecurso\":6,\"EmRecurso\":7,\"EmContrarrazao\":8,\"EmJulgamentoRecurso\":9,\"ReenvioDeProposta\":10,\"Negociacao\":11,\"AjusteDePreco\":12,\"AguardandoAprovacao\":13,\"Homologado\":14,\"AguardandoHomologacao\":15,\"Revogado\":16,\"Anulado\":17,\"Suspenso\":18,\"EmDisputa\":19,\"EmAutoEncerramento\":20,\"EmAplicacaoLC123\":21,\"EmEnvioDeDocumentos\":22,\"EmDesempate\":23};\r\n    var enumLicitacaoFase = {\"EnvioProposta\":1,\"AnaliseDeCaucao\":2,\"Habilitacao\":3,\"AnaliseDePropostasComercial\":4,\"AnaliseDePropostasTecnica\":5,\"Homologacao\":6,\"DisputaAberta\":7,\"Julgamento\":8,\"DisputaFechada\":9,\"PreQualificacao\":10,\"AnaliseDePropostasCotacao\":11,\"Adjudicacao\":12,\"Execucao\":13};\r\n\r\n    enumCompraDiretaSituacao = { Recebimento_Lances: 2, Prazo_Prorrogado: 3, Analise_Lances: 7 }\r\n\r\n    enumPregaoSituacao = {\r\n        Em_configuração: 0,\r\n        Agendado_Publicado: 1,\r\n        Em_proposta: 2,\r\n        Prazo_prorrogado: 3,\r\n        Suspenso: 4,\r\n        Interrompido: 5,\r\n        Cancelado: 6,\r\n        Anulado: 7,\r\n        Revogado: 8,\r\n        Abertura_de_propostas: 9,\r\n        Classificacao_de_propostas: 10,\r\n        Em_disputa_de_lances: 11,\r\n        Suspenso_em_disputa: 12,\r\n        Interrompido_em_disputa: 13,\r\n        Negociação_Habilitação_Aceitabilidade: 14,\r\n        Período_de_intenção_de_recurso: 15,\r\n        Encerramento_da_sessão_pública: 16,\r\n        Julgamento_da_intencao: 17,\r\n        Período_para_razões_do_recurso: 18,\r\n        Período_para_contra_razões: 19,\r\n        Julgamento_do_recurso: 20,\r\n        Reajuste_de_preços: 21,\r\n        Adjudicação: 22,\r\n        Aguardando_homologação: 23,\r\n        Homologado: 24,\r\n        Manifestação: 25,\r\n        SessãoPúblicaEncerrada: 26,\r\n        Homologacao_pendente: 27,\r\n        PregaoDeserto: 28,\r\n        Fracassado: 29,\r\n        Aguardando_liberação_financeira: 30,\r\n        Financeiro_liberado: 31,\r\n        Reajuste_de_precos_comprador: 32,\r\n        Homologado_com_pedido: 33,\r\n        Homologado_com_registro_de_preco: 34,\r\n        Em_homologacao_parcial: 35,\r\n        Homologado_com_contrato: 36,\r\n        Em_aprovação: 37\r\n    }\r\n\r\n    enumTipoModalidadeLicitacao = {\r\n        Pregao: 1,\r\n        Convite: 2,\r\n        Concorrencia: 3,\r\n        Tomada_de_preco: 4,\r\n        Presencial: 5,\r\n        Concurso: 6,\r\n        Leilao: 7,\r\n        Pre_qualificacao: 8,\r\n        Dispensa_de_licitacao: 9,\r\n        Inexigibilidade: 10,\r\n        Dialogo_competitivo: 11,\r\n        Cotacao: 12,\r\n        Processo_de_selecao_com_disputa: 13,\r\n        Processo_de_selecao_sem_disputa: 14,\r\n        Credenciamento: 24\r\n    }\r\n\r\n    var oMuralProcessoDetalhe,\r\n        arrMuralProcessoDetalheItemProduto = [],\r\n        arrMuralProcessoDetalheItemProdutoLote = [],\r\n        timerAcompanhamentoLances;\r\n\r\n    var nCdModulo = 0;\r\n    var nCdLoteAtual = 0; \r\n\r\n    var nIdProcessoPresencialMuralRanking = 1;\r\n\r\n    var MURALDETALHES = {\r\n        MODULO: {\r\n            CompraDireta: Number(\"19\"),\r\n            Convite: Number(\"23\"),\r\n            PregaoEletronico: Number(\"18\"),\r\n            PregaoPresencial: Number(\"22\"),\r\n            Cotacao: Number(\"8\"),\r\n            Credenciamento: Number(\"53\"),\r\n            PublicacaoDeEditais: Number(\"24\"),\r\n            Licitacao: Number(\"59\")\r\n        },\r\n        RESOURCES: {\r\n            Resumo_edital: \"Resumo do edital\",\r\n            Edital: \"Edital\",\r\n            Resumo_processo: \"Resumo do processo\",\r\n            Detalhe_do_item: \"Detalhes do item\",\r\n            Acompanhar_lances: \"Acompanhar lances\",\r\n            Disputa_aberta: \"Disputa aberta\",\r\n            Anexos: \"Anexos\",\r\n            Nao_foi_possivel_recuperar_dados: \"Não foi possível recuperar os dados desse registro!\",\r\n            Processo_de_compra_nao_encontrado: \"Processo de compra não encontrado.\",\r\n            Numero_do_processo: \"Número do processo\",\r\n            Numero_do_edital: \"Número do edital\",\r\n            Numero: \"Número\",\r\n            Objeto: \"Objeto\",\r\n            Situacao: \"Situação\",\r\n            Modalidade: \"Modalidade\",\r\n            Unidade_compradora: \"Unidade compradora\",\r\n            Inicio_das_propostas: \"Início das propostas\",\r\n            Abertura_da_sessao: \"Abertura da sessão\",\r\n            Inicio_de_sessao_pubica: \"Início de sessão pública\",\r\n            Termino_das_propostas: \"Término das propostas\",\r\n            Termino_da_habilitacao: \"Término da Habilitação\",\r\n            Termino_das_propostas_Abertura_da_sessao: \"Término das propostas/Abertura da sessão\",\r\n            Inicio_dos_lances: \"Início dos lances\",\r\n            Termino_dos_lances: \"Término dos lances\",\r\n            Nao_informado: \"Não informado\",\r\n            Tipo_processo: \"Tipo de processo\",\r\n            Prorragacao_automatica: \"Prorrogação automática\",\r\n            Sim: \"Sim\",\r\n            Nao: \"Não\",\r\n            Prorrogar_por: \"Prorrogar por\",\r\n            Min: \" min.\",\r\n            Condicao: \"Condição\",\r\n            Data_da_publicacao: \"Data de publicação\",\r\n            Data_da_homologacao: \"Data de homologação\",\r\n            Fase: \"Fase\",\r\n            Tipo_de_modalidade: \"Tipo de modalidade\",\r\n            Item: \"Item\",\r\n            Marca: \"Marca\",\r\n            Modelo: \"Modelo\",\r\n            Procedencia: \"Procedência\",\r\n            Quantidade: \"Quantidade\",\r\n            Unidade_medida: \"Unidade de medida\",\r\n            Valor_de_referencia: \"Valor de referência\",\r\n            Melhor_lance: \"Melhor lance\",\r\n            Melhor_proposta: \"Melhor proposta\",\r\n            Economia: \"Economia\",\r\n            Lote: \"Lote\",\r\n            Valor_de_referencia: \"Valor de referência\",\r\n            Empresa: \"Empresa\",\r\n            Valor: \"Valor\",\r\n            Data: \"Data\",\r\n            Ranking: \"Ranking\",\r\n            Rodada: \"Rodada\",\r\n            Situacao_nao_permite_visualizacao: \"Os lances poderão ser visualizados assim que a situação do lote for encerrada\",\r\n            A_situacao_atual_nao_permite_visualizacao: \"A situação atual não permite visualização\",\r\n            As_propostas_poderao_ser_visualizadas_assim_que_a_situacao_do_lote_for_homologada: \"As propostas poderão ser visualizadas assim que a situação do lote for homologada\",\r\n            Os_lances_poderao_ser_visualizados_assim_que_a_situacao_do_item_for_encerrada: \"Os lances poderão ser visualizados assim que a situação do item for encerrada\",\r\n            As_propostas_poderao_ser_visualizados_assim_que_a_situacao_do_item_for_homologada: \"As propostas poderão ser visualizadas assim que a situação do item for homologada\",\r\n            Maior_taxa: \"Maior taxa\",\r\n            Menor_taxa: \"Menor taxa\",\r\n            Menor_preco: \"Menor preço\",\r\n            Lance_vencedor: \"Lance vencedor\",\r\n            Proposta_vencedora: \"Proposta vencedora\",\r\n            Lance_invalido: \"Lance inválido\",\r\n            Invalido_pelo_comprador: \"Inválido pelo comprador\",\r\n            Invalido_pelo_fornecedor: \"Inválido pelo fornecedor\",\r\n            Proposta_invalida: \"Proposta inválida\",\r\n            Passou_vez: \"Passou a vez\",\r\n            Desistiu: \"Desistiu\",\r\n            Homologacao: \"Homologação\",\r\n            As_propostas_poderao_ser_visualizadas_assim_que_a_aceitabilidade_do_lance_vencedor_for_realizada: \"As propostas poderão ser visualizadas assim que a aceitabilidade do lance vencedor for realizada.\",\r\n            Aprovacao: \"Aprovação\",\r\n            Vigencia: \"Vigência\",\r\n            Link: \"Link\",\r\n            Status: \"Status\",\r\n            Justificativa: \"Justificativa\",\r\n            Proposta: \"Proposta\",\r\n            Regiao: \"Região\",\r\n            Nota_equivalente: \"Nota equivalente\",\r\n            Habilitado: \"Habilitado\",\r\n            Inabilitado: \"Inabilitado\",\r\n            Tipo_de_avaliacao: \"Tipo de avaliação\",\r\n            Inicio_do_envio_de_inscricoes: \"Início do envio de inscrições\",\r\n            Fim_do_envio_de_inscricoes: \"Fim do envio de inscrições\",\r\n            Data_da_homologacao_finalizacao: \"Data de homologação\" + \"/\" + \"Finalização\"\r\n        }\r\n    };\r\n\r\n    function MuralProcessoDetalhes_Load(_nCdProcesso, _nCdModulo, _nCdSituacao, _sDsProcesso, _nCdEdital) {\r\n        nCdModulo = _nCdModulo;\r\n\r\n        if (window.location.href.includes(\"nNmTela=E\") && !window.location.href.includes(\"nNmTela=ES\")) {\r\n            $(\"#lblMuralDetalheTitulo\").text(MURALDETALHES.RESOURCES.Resumo_edital);\r\n        } else if (window.location.href.includes(\"nNmTela=PT\")) {\r\n            $(\"#lblMuralDetalheTitulo\").text(MURALDETALHES.RESOURCES.Resumo_processo);\r\n        } else {\r\n            $(\"#lblMuralDetalheTitulo\").text(MURALDETALHES.RESOURCES.Resumo_processo);\r\n        }\r\n\r\n        $(document).scrollTop(0);\r\n\r\n        $(\"#divListagem\").animate({ opacity: 0 }, 300, function () {\r\n            $(\"#divListagem\").hide();\r\n            $(\"#divDetalhes\").show();\r\n            $(\"#divDetalhes\").animate({ opacity: 1 }, 300);\r\n            $(window).unbind(\"scroll\");\r\n\r\n            $(window).scroll(VerificarCargaConteudoScroll);\r\n\r\n            $(\"#grupoResumo\").hide();\r\n            $(\"#carregandoResumo\").show();\r\n\r\n            arrMuralProcessoDetalheItemProduto = [];\r\n            arrMuralProcessoDetalheItemProdutoLote = [];\r\n\r\n            setTimeout(function () {\r\n                $(\"#divDetalheItem\").kendoWindow({\r\n                    actions: [\"Close\"],\r\n                    title: MURALDETALHES.RESOURCES.Detalhe_do_item.toUpperCase(),\r\n                    modal: true,\r\n                    maxHeight: \"350px\",\r\n                    minHeight: \"220px\",\r\n                    width: \"700px\",\r\n                    draggable: false,\r\n                    animation: { open: true, close: true },\r\n                    close: function (e) { $(\"#divDetalheItem\").children().not(\"div\").remove(); scrollBodyFuncional(true, \"/\"); },\r\n                    open: function () { scrollBodyFuncional(false, \"/\"); },\r\n                    visible: false\r\n                });\r\n\r\n                $(\"#divDetalheAcompanhamentoLance\").kendoWindow({\r\n                    actions: [\"Close\"],\r\n                    title: MURALDETALHES.RESOURCES.Acompanhar_lances.toUpperCase(),\r\n                    modal: true,\r\n                    draggable: false,\r\n                    resizable: false,\r\n                    refresh: function () { this.center(); },\r\n                    animation: { open: true, close: true },\r\n                    close: function (e) {\r\n                        var anexoChat = $(\"#divAnexoChatAcompanhamentoLanceLote div\").first().detach();\r\n                        $(anexoChat).appendTo(\"anexoChat\");\r\n                        CarregarChat();\r\n\r\n                        clearInterval(timerAcompanhamentoLances);\r\n                        $(\"#divDetalheAcompanhamentoLance\").data(\"kendoWindow\").restore();\r\n                        $(\"#divDetalheAcompanhamentoLance\").children().not(\"div\").remove();\r\n                        scrollBodyFuncional(true, \"/\");\r\n\r\n                        $(\"#gridItem\").data(\"kendoGrid\").dataSource.read();\r\n\r\n                        setTimeout(function () { $(\".k-overlay\").remove(); }, 100);\r\n                    },\r\n                    open: function () { scrollBodyFuncional(false, \"/\"); },\r\n                    visible: false\r\n                });\r\n\r\n                $(\"#divDetalheLanceAnexoHabilitacao\").kendoWindow({\r\n                    actions: [\"Close\"],\r\n                    title: MURALDETALHES.RESOURCES.Anexos.toUpperCase(),\r\n                    modal: true,\r\n                    draggable: false,\r\n                    resizable: false,\r\n                    refresh: function () { this.center(); },\r\n                    animation: { open: true, close: true },\r\n                    close: function (e) {\r\n                        $(\"#divDetalheLanceAnexoHabilitacao\").data(\"kendoWindow\").restore();\r\n                        $(\"#divDetalheLanceAnexoHabilitacao\").children().not(\"div\").remove();\r\n                    },\r\n                    open: function () { scrollBodyFuncional(true, \"/\"); },\r\n                    visible: false\r\n                });\r\n\r\n            }, 100);\r\n\r\n            var dtoProcesso = {\r\n                nCdProcesso: _nCdProcesso,\r\n                nCdModulo: _nCdModulo,\r\n                nCdSituacao: _nCdSituacao,\r\n                sNrProcesso: _sDsProcesso,\r\n                nCdEdital: _nCdEdital,\r\n                tmpTipoMuralProcesso: objParametroMural.tmpTipoMuralProcesso,\r\n                dtoIdioma: {\r\n                    nCdIdioma: adquirirIdIdioma(\"/\")\r\n                }\r\n            };\r\n\r\n            chamadaWebService(\r\n                \"WebService/Servicos.asmx/PesquisarProcessoDetalhes\",\r\n                \"dtoProcesso:\" + JSON.stringify(dtoProcesso),\r\n                function (_retorno) {\r\n                    if (_retorno.d != null) {\r\n                        oMuralProcessoDetalhe = _retorno.d;\r\n\r\n                        if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL_SIMPLIFICADO) {\r\n                            var sDsTitulo = MURALDETALHES.RESOURCES.Edital + ' - ';\r\n                            if (oMuralProcessoDetalhe.sDsTitulo != '\u0013\u0012\u0012\u0013') sDsTitulo += oMuralProcessoDetalhe.sDsTitulo;\r\n                            else sDsTitulo += MURAL.RESOURCES.Nao_informado\r\n\r\n                            $(\"#lblMuralDetalheTitulo\").text(sDsTitulo);\r\n                            $(\"#lblMuralDetalheTitulo\").css(\"margin-right\", \"auto\");\r\n                            $(\"#lblMuralDetalheTitulo\").parent().css(\"display\", \"flex\");\r\n                            $(\".areaClique\").css(\"justify-content\", \"flex-end\");\r\n                        }\r\n\r\n                        if (_nCdModulo > 0)\r\n                            oMuralProcessoDetalhe.nCdModulo = _nCdModulo;\r\n                        else\r\n                            _nCdModulo = oMuralProcessoDetalhe.nCdModulo\r\n\r\n                        if (_nCdProcesso > 0)\r\n                            oMuralProcessoDetalhe.nCdProcesso = _nCdProcesso;\r\n                        else\r\n                            _nCdProcesso = oMuralProcessoDetalhe.nCdProcesso\r\n\r\n                        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Cotacao)\r\n                            oMuralProcessoDetalhe.nCdOrigem = oMuralProcessoDetalhe.nCdProcesso;\r\n\r\n                        if (_sDsProcesso)\r\n                            oMuralProcessoDetalhe.sDsProcesso = _sDsProcesso;\r\n\r\n                        FecharObjeto(oMuralProcessoDetalhe);\r\n                        if (typeof oMuralProcessoDetalhe == \"undefined\" || oMuralProcessoDetalhe == null) {\r\n                            btAcao_Click(\"voltar\");\r\n                        } else {\r\n                            CarregarDetalhes();\r\n                            /*PROCESSO DETALHE ITEM E LOTE para tudo exceto EDITAL, EDITAL_SIMPLIFICADO e PORTAL_DA_TRANSPARENCIA*/\r\n                            if (objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL\r\n                                && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL_SIMPLIFICADO\r\n                            ) {\r\n                                if (Number(oMuralProcessoDetalhe.nIdTipoApuracao) == 1)\r\n                                    PesquisarProcessoDetalheItemProduto(_nCdProcesso, _sDsProcesso, _nCdModulo, 0);//ITEM\r\n                                else\r\n                                    PesquisarProcessoDetalheItemLote(_nCdProcesso, _nCdModulo, _sDsProcesso);//LOTE\r\n\r\n                                /*FORUM|ESCLARESCIMENTO para MURALPROCESSO*/\r\n                                if (objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.PORTAL_DA_TRANSPARENCIA && oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n                                    CarregarForum(true, oMuralProcessoDetalhe.nCdModulo);\r\n\r\n                                    if (oMuralProcessoDetalhe.bFlExibeHabilitacaoMural) {\r\n                                        PesquisarProcessoHabilitacao(_nCdProcesso, _nCdModulo);\r\n                                    }\r\n                                    if (oMuralProcessoDetalhe.bFlExibeClassificacaoMural) {\r\n                                        PesquisarProcessoClassificacao(_nCdProcesso, _nCdModulo);\r\n                                    }\r\n                                }\r\n                            }\r\n                            else {\r\n                                $(window).unbind(\"scroll\");\r\n                                /*FORUM|ESCLARESCIMENTO para EDITAL SIMPLIFICADO*/\r\n                                if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL_SIMPLIFICADO) {\r\n                                    nCdModulo = MURALDETALHES.MODULO.PublicacaoDeEditais;\r\n                                    CarregarForum(false, nCdModulo);\r\n                                }\r\n\r\n                                if (oMuralProcessoDetalhe.nCdProcesso > 0 && oMuralProcessoDetalhe.nCdModulo > 0) {\r\n                                    VerificarCargaConteudoScroll();\r\n                                }\r\n\r\n                                /*ANEXOS*/\r\n                                CarregarAnexo();\r\n                                CarregarAnexoProposta();\r\n                                CarregarAnexoLance();\r\n                                CarregarAnexoNegociacao();\r\n                                CarregarAnexoHabilitacao();\r\n                                CarregarAnexoRecurso();\r\n                                CarregarAnexoContraRazoes();\r\n                                CarregarAnexoParecer();\r\n                            }\r\n                        }\r\n                    } else {\r\n                        Alerta(MURALDETALHES.RESOURCES.Processo_de_compra_nao_encontrado, \"/\");\r\n                        btAcao_Click(\"voltar\");\r\n                    }\r\n                },\r\n                function () {\r\n                    Alerta(MURALDETALHES.RESOURCES.Processo_de_compra_nao_encontrado, \"/\");\r\n                    btAcao_Click(\"voltar\");\r\n                }\r\n            );\r\n        });\r\n    }\r\n\r\n\r\n    function getDataSource(lstClasses) {\r\n        return lstClasses.map(data => ({\r\n            text: data.text,\r\n            expanded: data.ItemTreeView.length > 0,\r\n            items: data.ItemTreeView.length > 0 ? getDataSource(data.ItemTreeView) : []\r\n        }));\r\n    }\r\n\r\n    function PreencherResumoDetalheLicitacao() {\r\n        var arrResumoDetalheLicitacao = [];\r\n        var valorModalidade = oMuralProcessoDetalhe.sDsObservacao != \"\u0013\u0012\u0012\u0013\" ?\r\n            oMuralProcessoDetalhe.sNmModalidade + \" - \" + oMuralProcessoDetalhe.sDsObservacao : oMuralProcessoDetalhe.sNmModalidade;\r\n\r\n        arrResumoDetalheLicitacao.push({ ordem: 1, id: \"lblNumeroProcesso\", resource: MURALDETALHES.RESOURCES.Numero_do_processo, valor: oMuralProcessoDetalhe.sNrProcesso });\r\n\r\n        //Informações de resumo do processo de licitação podem variar de acordo com a modalidade\r\n        switch (oMuralProcessoDetalhe.nCdTipoModalidade) {\r\n\r\n            case enumTipoModalidadeLicitacao.Pre_qualificacao:\r\n            case enumTipoModalidadeLicitacao.Credenciamento:\r\n                arrResumoDetalheLicitacao.push({ ordem: 2, id: \"lblNumeroEdital\", resource: objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL_SIMPLIFICADO ? MURALDETALHES.RESOURCES.Numero : MURALDETALHES.RESOURCES.Numero_do_edital, valor: oMuralProcessoDetalhe.sNrEdital });\r\n                arrResumoDetalheLicitacao.push({ ordem: 3, id: \"lblSituacao\", resource: MURALDETALHES.RESOURCES.Situacao, valor: oMuralProcessoDetalhe.sDsSituacao });\r\n                arrResumoDetalheLicitacao.push({ ordem: 4, id: \"lblModalidade\", resource: MURALDETALHES.RESOURCES.Modalidade, valor: oMuralProcessoDetalhe.sNmModalidadeTipo });\r\n                arrResumoDetalheLicitacao.push({ ordem: 5, id: \"lblUnidadeCompradora\", resource: MURALDETALHES.RESOURCES.Unidade_compradora, valor: oMuralProcessoDetalhe.sNmEmpresa });\r\n                arrResumoDetalheLicitacao.push({ ordem: 6, id: \"lblEspacamento\", resource: \"\", valor: \"\" });\r\n                arrResumoDetalheLicitacao.push({ ordem: 7, id: \"lblDataInicioProposta\", resource: MURALDETALHES.RESOURCES.Inicio_do_envio_de_inscricoes, valor: formataDataHora(oMuralProcessoDetalhe.tDtInicial, false) });\r\n                arrResumoDetalheLicitacao.push({ ordem: 8, id: \"lblDataTerminoProposta\", resource: MURALDETALHES.RESOURCES.Fim_do_envio_de_inscricoes, valor: formataDataHora(oMuralProcessoDetalhe.tDtFinal, false) });\r\n                arrResumoDetalheLicitacao.push({ ordem: 9, id: \"lblDataHomologacao\", resource: MURALDETALHES.RESOURCES.Data_da_homologacao_finalizacao, valor: formataDataHora(oMuralProcessoDetalhe.tDtHomologacao, false) });\r\n                arrResumoDetalheLicitacao.push({ ordem: 10,id: \"lblObjeto\", resource: MURALDETALHES.RESOURCES.Objeto, valor: kendo.htmlEncode(oMuralProcessoDetalhe.sDsObjeto) });\r\n                break;\r\n            default:\r\n                if (true)\r\n                    arrResumoDetalheLicitacao.push({ ordem: 2, id: \"lblNumeroEdital\", resource: objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL_SIMPLIFICADO ? MURALDETALHES.RESOURCES.Numero : MURALDETALHES.RESOURCES.Numero_do_edital, valor: oMuralProcessoDetalhe.sNrEdital });\r\n\r\n                arrResumoDetalheLicitacao.push({ ordem: 3, id: \"lblObjeto\", resource: MURALDETALHES.RESOURCES.Objeto, valor: kendo.htmlEncode(oMuralProcessoDetalhe.sDsObjeto) });\r\n                arrResumoDetalheLicitacao.push({ ordem: 4, id: \"lblUnidadeCompradora\", resource: MURALDETALHES.RESOURCES.Unidade_compradora, valor: oMuralProcessoDetalhe.sNmEmpresa });\r\n                arrResumoDetalheLicitacao.push({ ordem: 5, id: \"lblDataInicioProposta\", resource: MURALDETALHES.RESOURCES.Inicio_das_propostas, valor: formataDataHora(oMuralProcessoDetalhe.tDtInicial, false) });\r\n                arrResumoDetalheLicitacao.push({ ordem: 6, id: \"lblDataTerminoProposta\", resource: MURALDETALHES.RESOURCES.Termino_das_propostas, valor: formataDataHora(oMuralProcessoDetalhe.tDtFinal, false) });\r\n                arrResumoDetalheLicitacao.push({ ordem: 7, id: \"lblDataAberturaSessao\", resource: MURALDETALHES.RESOURCES.Inicio_de_sessao_pubica, valor: formataDataHora(oMuralProcessoDetalhe.tDtAberturaSessao, false) });\r\n                arrResumoDetalheLicitacao.push({ ordem: 8, id: \"lblFase\", resource: MURALDETALHES.RESOURCES.Fase, valor: oMuralProcessoDetalhe.sDsFase });\r\n                arrResumoDetalheLicitacao.push({ ordem: 9, id: \"lblSituacao\", resource: MURALDETALHES.RESOURCES.Situacao, valor: oMuralProcessoDetalhe.sDsSituacao });\r\n                arrResumoDetalheLicitacao.push({ ordem: 10, id: \"lblModalidade\", resource: MURALDETALHES.RESOURCES.Modalidade, valor: valorModalidade });\r\n                arrResumoDetalheLicitacao.push({ ordem: 12, id: \"lblPublicacao\", resource: MURALDETALHES.RESOURCES.Data_da_publicacao, valor: formataDataHora(oMuralProcessoDetalhe.tDtPublicacao, false) });\r\n                arrResumoDetalheLicitacao.push({ ordem: 11, id: \"lblDataHomologacao\", resource: MURALDETALHES.RESOURCES.Data_da_homologacao, valor: formataDataHora(oMuralProcessoDetalhe.tDtHomologacao, false) });\r\n        }\r\n\r\n        return arrResumoDetalheLicitacao;\r\n    }\r\n\r\n    function CarregarDetalhes() {\r\n        var arrResumoDetalhe = [];\r\n        var arrEditalSimplificado = []\r\n        /*Carrega os detalhes se for COMPRA DIRETA AND nao for nNmTela=E AND nao for nNmTela=E AND nao for nNmTela=PT */\r\n\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.CompraDireta && !window.location.href.includes(\"nNmTela=E\") && !window.location.href.includes(\"nNmTela=ES\") && !window.location.href.includes