            "mimeType": "text/html",
            "text": "\r\n\r\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head id=\"ctl00_Head1\"><meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge,chrome=1\" /><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" /><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" /><link href=\"/portal/css/portalcss?v=8tGe5ZsFUPYqRpERe2D6-nDWpwSV4SE9vLGgcW7ICgM1\" rel=\"stylesheet\"/>\r\n\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/portal/css/uniform/uniform.claren.css\" />\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/portal/css/template2.css\" />\r\n<link rel=\"icon\" type=\"image/vnd.microsoft.icon\" href=\"/core/images/favicon.ico\" />\r\n<link rel=\"shortcut icon\" type=\"image/vnd.microsoft.icon\" href=\"/core/images/favicon.ico\" />\r\n\r\n<link media=\"only screen and (min-device-width: 1025px)\" type=\"text/css\" href=\"/portal/css/estilo-1280.css\" rel=\"stylesheet\" />\r\n<link media=\"only screen and (max-device-width: 1024px) and (min-device-width: 801px)\" type=\"text/css\" href=\"/portal/css/estilo-1024.css\" rel=\"stylesheet\" />\r\n<link media=\"only screen and (max-device-width: 800px) and (min-device-width: 641px) and (max-width: 1024px) and (min-width: 801px)\" type=\"text/css\" href=\"/portal/css/estilo-1024.css\" rel=\"stylesheet\" />\r\n<link media=\"only screen and (max-device-width: 800px) and (min-device-width: 641px) and (max-width: 800px)\" type=\"text/css\" href=\"/portal/css/estilo-800.css\" rel=\"stylesheet\" />\r\n<link media=\"only screen and (max-device-width: 640px) and (min-device-width: 481px) and (max-width: 800px) and (min-width: 641px)\" type=\"text/css\" href=\"/portal/css/estilo-640.css\" rel=\"stylesheet\" />\r\n<link media=\"only screen and (max-device-width: 640px) and (min-device-width: 481px) and (max-width: 640px) and (min-width: 481px)\" type=\"text/css\" href=\"/portal/css/estilo-640.css\" rel=\"stylesheet\" />\r\n<link media=\"only screen and (max-device-width: 640px) and (min-device-width: 481px) and (max-width: 480px)\" type=\"text/css\" href=\"/portal/css/estilo-480.css\" rel=\"stylesheet\" />\r\n<link media=\"only screen and (max-device-width: 480px) and (max-width: 640px) and (min-width: 481px)\" type=\"text/css\" href=\"/portal/css/estilo-640.css\" rel=\"stylesheet\" />\r\n<link media=\"only screen and (max-device-width: 480px) and (max-width: 480px)\" type=\"text/css\" href=\"/portal/css/estilo-480.css\" rel=\"stylesheet\"/>\r\n\r\n\r\n\r\n<!--[if lte IE 8 ]>\r\n    <link href=\"/portal/css/template2.ajustes.lte.ie.8.css\" rel=\"stylesheet\" type=\"text/css\" />\r\n<![endif]-->\r\n \r\n <!--[if IE 9 ]>\r\n    <link href=\"/portal/css/template2.ajustes.css\" rel=\"stylesheet\" type=\"text/css\" />\r\n<![endif]-->\r\n\r\n<script type='text/javascript' charset='utf-8' src='/Portal/Scripts/portaljs1?v=ltEVDwGrKw65e6HdaNedTLno4IOZRoAsuzlKYz_srjQ1'></script>\r\n\r\n<script type='text/javascript' charset='utf-8' src='/Core/Include/portaljs2?v=aZcPjHpF1b7mh5EQTdksmi4-QRp33VzxdkK48ah5bqs1'></script>\r\n\r\n<script type='text/javascript' charset='utf-8' src='/Portal/Scripts/portaljs3?v=fchLAwgTISpkcdIamvKXftmXsqlVtUd3nS2axsXxEtg1'></script>\r\n\r\n<script type='text/javascript' charset='utf-8' src='/bundles/infra-culture-pt-BR?v=meuv2Y2lKG61YkV7Wkh2K8SoG9llehiNef2oLJ72Vu01'></script>\r\n\r\n\r\n\r\n<!--- Javascripts iniciais -->\r\n<script type=\"text/javascript\" charset=\"utf-8\">\r\n    //Uniform - Script de Transformação de Compomentes\r\n    $(function () {\r\n        $(\"input[type=checkbox], input[type=radio], input[type=file], textarea, select\").uniform();\r\n\r\n        $(\"form\").keypress(function (event) {\r\n            if (event.which == 13) {\r\n                if ($(\"*:focus\").attr(\"class\").indexOf(\"enterFiltro\") > -1)\r\n                    $(\"#btProcurar\").trigger(\"click\");\r\n                else if ($(\"*:focus\").attr(\"class\").indexOf(\"enterLogin\") > -1)\r\n                    $(\"form\").find(\"[data-id='btnAcessar']\").trigger(\"click\");\r\n\r\n                event.preventDefault();\r\n            }\r\n        });\r\n\r\n    });\r\n\r\n</script>\r\n\r\n<div id=\"divAlerta\"></div>\r\n        \r\n    <style type=\"text/css\">\r\n        .botao-detalhes{\r\n              color: #ffffff;\r\n              background-color: #2A6496;\r\n              text-transform: uppercase;\r\n              padding: 9px 12px 9px 12px;\r\n              border:0px;\r\n              width:11em;\r\n        }\r\n        .botao-expandir{\r\n              color: #777777;\r\n              border:0px;\r\n              padding: 9px 12px 9px 12px;\r\n              display: block;\r\n              margin: auto;\r\n              width: 396px;\r\n              cursor:pointer;\r\n              float:center;\r\n        }\r\n        .botao-expandir:hover{\r\n              background-color: white;\r\n              text-decoration:underline;\r\n              color:#3D3D3D;\r\n        }\r\n        .botao-detalhes:hover{\r\n              background-color: #93c4f0;\r\n        }\r\n        .thEditalSimplificado{\r\n            cursor: pointer;\r\n            color:#519641;\r\n            text-transform: none;\r\n        }\r\n        tbody#trListaMuralProcesso tr td {max-width:200px; word-wrap:break-word;}\r\n        ul.nav-detalhes li {max-width:430px; word-wrap:break-word;}\r\n        .span12{\r\n             word-wrap:break-word;\r\n        }\r\n        .tdDate{\r\n            text-align:center;\r\n        }\r\n        .linkExterno{\r\n            color: -webkit-link;\r\n            cursor: pointer;\r\n            text-decoration: underline;\r\n        }\r\n        #lblObjeto{\r\n            white-space: pre-wrap;\r\n        }\r\n        .badget-retificado {\r\n            color: #d46b08;\r\n            background: #fff7e6;\r\n            \r\n            box-sizing: border-box;\r\n            margin: 0;\r\n            padding: 0;\r\n            line-height: 18px;\r\n            list-style: none;\r\n            display: inline-block;\r\n            height: auto;\r\n            margin-inline-end: 4px;\r\n            padding-inline: 7px;\r\n            white-space: nowrap;\r\n            border: 1px solid #ffd591;\r\n            border-radius: 4px;\r\n            opacity: 1;\r\n            transition: all 0.2s;\r\n            text-align: start;\r\n            position: relative;\r\n\r\n            margin-left: 8px;\r\n        }\r\n        #divCarregarProcesso {\r\n            position: fixed;\r\n            inset: 0;\r\n            background-color: white;\r\n            z-index: 9999;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n        }\r\n    </style>\r\n\r\n\r\n    <script type=\"text/javascript\" charset=\"utf-8\">\r\n\r\n        $(document).ready(function () {\r\n\r\n            $(document).not(\"a.menu-idioma\").click(function (a) {\r\n                if (!$(a.target).hasClass(\"menu-idioma\")) {\r\n                    $(\".menu-idioma\").removeClass(\"ativo\");\r\n                    $(\".menu-idioma-painel\").removeClass(\"ativo\");\r\n                }\r\n            });\r\n\r\n            kendo.culture('pt-BR');\r\n            criarCookie(\"CK_IDIOMA_PUBLICO_JS\", 'pt-BR', \"/\");\r\n            $(\".menu-idioma\").text($(\".menu-idioma-painel-item li a[style*='font-weight']\").text());\r\n\r\n            $(\"#ddlMenu\").unbind(\"change\");\r\n            $(\"#ddlMenu\").bind(\"change\", function () {\r\n                window.location = $(\"#ddlMenu option:selected\").val();\r\n            });\r\n\r\n            if ($.browser.webkit) {\r\n                $('input[name=\"password\"]').attr('autocomplete', 'off');\r\n            }\r\n\r\n            $('.menu-idioma').click(btMenu_Click);\r\n            $(\".menu-idioma-painel\").mouseleave(btMenu_Click);\r\n\r\n            if ($(\"#divAtualizarNavegador span:nth(1)\").data(\"navegadorNaoSuportado\") > 0)\r\n                $(\"#divAtualizarNavegador\").show();\r\n\r\n            if ($(\".menu-idioma-painel ul li\").length == 1)\r\n                $(\".menu-idioma\").hide();\r\n\r\n        });\r\n\r\n        function btMenu_Click(e) {\r\n            e.preventDefault();\r\n            if ($(\".menu-idioma-painel.ativo\")) {\r\n                $('.menu-idioma').toggleClass('ativo');\r\n                $('.menu-idioma-painel').toggleClass('ativo');\r\n            }\r\n        }\r\n       \r\n    </script>\r\n\r\n<title>\r\n\tPortal de Compras - CIASC\r\n</title></head>\r\n\r\n<body>\r\n    \r\n    <form method=\"post\" action=\"./Mural.aspx\" id=\"aspnetForm\">\r\n<div class=\"aspNetHidden\">\r\n<input type=\"hidden\" name=\"__EVENTTARGET\" id=\"__EVENTTARGET\" value=\"\" />\r\n<input type=\"hidden\" name=\"__EVENTARGUMENT\" id=\"__EVENTARGUMENT\" value=\"\" />\r\n<input type=\"hidden\" name=\"__VIEWSTATE\" id=\"__VIEWSTATE\" value=\"\" />\r\n</div>\r\n\r\n<script type=\"text/javascript\">\r\n//<![CDATA[\r\nvar theForm = document.forms['aspnetForm'];\r\nif (!theForm) {\r\n    theForm = document.aspnetForm;\r\n}\r\nfunction __doPostBack(eventTarget, eventArgument) {\r\n    if (!theForm.onsubmit || (theForm.onsubmit() != false)) {\r\n        theForm.__EVENTTARGET.value = eventTarget;\r\n        theForm.__EVENTARGUMENT.value = eventArgument;\r\n        theForm.submit();\r\n    }\r\n}\r\n//]]>\r\n</script>\r\n\r\n\r\n<script>var PTA_sProjeto ='/';var retornoDialogo6_0;var PTA_sUrlCdn ='/';var PTA_sMsgSeguranca = 'Por questões de segurança, esta função está desativada.';var PTA_sMsgErro = 'Ocorreu um erro na aplicação. Contate o Administrador do Sistema.';var PTA_AjaxProUrl = '/ajaxpro/ASP.portal_mural_aspx,App_Web_khepiqcd.ashx';var PTA_AVISO = 'Aviso';var PTA_FeatureManutencao = 'Ew8HzeplfQY=';var PTA_DataSourceWebService = '01om9s8Tirw=';var PTA_UrlWebServiceDataSource = 'Ew8HzeplfQY=';var PTA_ChaveMetaObjeto = '';if (top.frames['main']) {if(top.frames['main'].document.getElementById('preLoad')) {top.frames['main'].$('#preLoad').hide();top.frames['main'].$('#loadScreenOpacity').hide();}top.frames['main'].inativarErro = false;}</script>\r\n<script type=\"text/javascript\">\r\n//<![CDATA[\r\nobjConfiguracao = JSON.parse('{\"bFlRelatorioPublico\":1,\"bFlHistoricoPublico\":1,\"bFlForumPublico\":1,\"bFlForumPublicoCompraDireta\":1,\"bFlForumPublicoConvite\":1,\"bFlForumPublicoPregaoEletronico\":1,\"bFlForumPublicoPregaoPresencial\":0,\"bFlForumPublicoCotacao\":1,\"bFlCadastroParaEfetuarDownloadAnexoAreaPublica\":1,\"sCaminhoUploadImagemProduto\":\"upload/produtos/\",\"sCaminhoUpload\":\"/upload/\",\"nQtDecimalPercentual\":1,\"nQtDecimalQuantidade\":2,\"nQtRegistrosPagina\":50,\"bFlPainelEletronicoMultiMoeda\":0,\"bFlIdiomaFiltraProcessoPublico\":1,\"nCdMoedaTriangulacao\":1,\"sSgMoedaTriangulacao\":\"R$\",\"nNrMesProcessosFinalizadoExibicaoPainelEletronico\":12,\"bFlExibirVlEstimadoPainelEletronico\":1,\"bFlExibirVlNegociadoPainelEletronico\":1,\"bFlExibirVlEconomiaPainelEletronico\":1,\"bFlExibirPercentEconomiaPainelEletronico\":1,\"bFlExibirQtdProcessosPainelEletronico\":1,\"bFlNotaPublicoPregaoEletronico\":1,\"bFlNotaPublicoPresencial\":1,\"bFlNotaPublicoCompraDireta\":1,\"bFlNotaPublicoConvite\":1,\"bFlNotaPublicoSC\":-2147483648,\"bFlNotaPublicoCotacao\":1,\"bFlInteresseCertame\":0,\"bFlRetiradaEditalPreCadastro\":0}'); objResources = JSON.parse('{\"conteudo\":\"Conteúdo\",\"filtrar\":\"Filtrar\",\"limpar\":\"Limpar\",\"ou\":\"OU\",\"igual_a\":\"Igual a\",\"diferente_de\":\"Diferente de\",\"nenhum_lance_efetuado\":\"Nenhum lance efetuado\",\"nenhum_registro_encontrado\":\"Nenhum registro encontrado.\",\"e_verdadeiro\":\"é verdadeiro\",\"e_falso\":\"é falso\",\"e\":\"E\",\"comeca_com\":\"Começa com\",\"contem\":\"Contém\",\"termina_em\":\"Termina em\",\"email_n_invalido\":\"O endereço de e-mail {0} é inválido.\",\"o_item_selecionado_e_invalido\":\"O item selecionado é inválido\",\"aviso\":\"Aviso\",\"nenhum_registro_encontrado_para_esta_pesquisa_caso_voce_tenha_utilizado_um_fitro_informe_outro_e_tente_novamente\":\"Nenhum registro encontrado para esta pesquisa. Caso você tenha especificado um filtro, utilize outro e realize a pesquisa novamente.\",\"compra_direta\":\"Compra direta\",\"convite\":\"Convite\",\"pregao_eletronico\":\"Pregão eletrônico\",\"cotacao\":\"Cotação de orçamento\",\"pregao_presencial\":\"Processos presenciais\",\"processo_contratacao\":\"Processo de contratação - 14.133\"}'); FecharObjeto(objConfiguracao); FecharObjeto(objResources); //]]>\r\n</script>\r\n\r\n<script type=\"text/javascript\" src=\"/ajaxpro/prototype.ashx\"></script>\r\n<script type=\"text/javascript\" src=\"/Core/Include/js/ajaxpro/core.js\"></script>\r\n<script type=\"text/javascript\" src=\"/ajaxpro/converter.ashx\"></script>\r\n<script type=\"text/javascript\" src=\"/ajaxpro/Paradigma.Framework.Web.Components.BasePage,Paradigma.Framework.Web.Components.ashx\"></script>\r\n\r\n<script src=\"/WebResource.axd?d=1WM_CmUpMJfgdt84yRWcZsKSLfpk6qOIPRpKBKzVYJaD_ub85HUwAv-OvFOQq_OuSZ7Csy3kP8vll7kwOP_bBFGaB-1s7_NnDczGZX8YvpIMM78XFrCsuAuW9DJYM4n2PEEcVR2x0ungAKTIALL7uOgpWn8nCazPfsN97zNBjMfnis7n0&amp;t=639274971980000000\" type=\"text/javascript\"></script>\r\n<div class=\"aspNetHidden\">\r\n\r\n\t<input type=\"hidden\" name=\"__VIEWSTATEGENERATOR\" id=\"__VIEWSTATEGENERATOR\" value=\"7EC649AB\" />\r\n\t<input type=\"hidden\" name=\"__EVENTVALIDATION\" id=\"__EVENTVALIDATION\" value=\"\" />\r\n</div>\r\n        <div class='k-content' id=\"areaConteudo\">\r\n            <!-- Cabeçalho da página -->\r\n            <div id=\"cabecalho\" style=\"background-image:url(/portal/imagens/base_cabecalho.png);\">\r\n    \t    <div id=\"cabecalhoConteudo\" class=\"conteudo\" style=\"background-image:url(/portal/imagens/ilustra_cabecalho.png);\">\r\n                <!-- Logo -->\r\n                <div id=\"marca\">\r\n                    \r\n                        <a href=\"/Default.aspx\">\r\n                            <div class=\"titulo-site\" ><span id=\"ctl00_lblTituloSite\"></span></div>\r\n                            <img src=\"/portal/imagens/marca.png\" id=\"imgLogo\" />\r\n                        </a>\r\n                     \r\n                </div>\r\n            \r\n                <!-- Login -->\r\n                <div class=\"usuario\">\r\n                    <div id=\"conteudoLogin\" class=\"login\">\r\n\r\n<style>\r\n    #cabecalho .usuario div input[type=\"button\"]\r\n    {\r\n        width: 150px !important;\r\n        padding: 8px 7px;\r\n        cursor: pointer;\r\n        color: #fff;\r\n        border-left: none;\r\n        border-radius: 0px 0px 0px 0px;\r\n        -moz-border-radius: 0px 0px 0px 0px;\r\n        -webkit-border-radius: 0px 0px 0px 0px;\r\n        background-color: #2A6496;\r\n        font-family: inherit;\r\n    }\r\n\r\n    #cabecalho .botao-container {\r\n        float: right;\r\n        position: relative;\r\n        color: white;\r\n        display: flex;\r\n        align-items: center;\r\n        justify-content: center;\r\n        padding: 5px 15px;\r\n        border-radius: 5px;\r\n        z-index: 1000;\r\n        margin-right: 40px;\r\n        max-height: 25px;\r\n        margin-top: 9px;\r\n    }\r\n\r\n    .linkBotao {\r\n        display: flex;\r\n        align-items: center;\r\n        justify-content: center;\r\n        text-decoration: none;\r\n        color: white;\r\n        font-size: 14px;\r\n    }\r\n\r\n    .imgBotao {\r\n        margin-right: 10px;\r\n        max-height: 25px;\r\n    }\r\n</style>\r\n\r\n<script type=\"text/javascript\"> \r\n    \r\n    var AUTHCONTROL = {\r\n        iniciar: function (sIdBotao, sURLAuth) {\r\n            $(\"#\" + sIdBotao).on(\"click\", function () {\r\n                AUTHCONTROL.acessarAutenticacao(sURLAuth);\r\n            });\r\n        },\r\n        acessarAutenticacao: function (sURLAuth) {\r\n            if(sURLAuth.trim() != \"\")\r\n                window.location.href = sURLAuth.trim();\r\n            else\r\n                alert(\"Para fazer uso do controle de autenticação, ative a chave IdentityURL.\");\r\n        }\r\n    };\r\n\r\n    $(document).ready(function () {\r\n        var bFlAutenticacaoUnica = eval(\"True\".toLowerCase());\r\n        var sURLAuth = \"https://login.e-lic.sc.gov.br/ciasc/connect/authorize?client_id=68719553-e268-42ca-a7d3-7e0fada2484d&scope=openid profile offline_access&response_type=code%20id_token%20token&redirect_uri=https://e-lic.sc.gov.br/LoginCallback.aspx&response_mode=form_post&state=AeRarYiVpc9kQAcqAn7ZGIUFKdKg2tC4bzHqMhxQGJg=&nonce=VbvMFYjIL2KvMsJY/TgWf5Q/3VU8wpq1/zJrEsgtOwo=\";\r\n        var sURLAuthComprador = \"https://login.e-lic.sc.gov.br/ciasc/connect/authorize?client_id=68719553-e268-42ca-a7d3-7e0fada2484d&scope=openid profile offline_access&response_type=code%20id_token%20token&redirect_uri=https://e-lic.sc.gov.br/LoginCallback.aspx&response_mode=form_post&state=aJSb8+joKo/xf5ibuQvuZ7+CgARysr+q3SxFKIP+OPo=&nonce=JUdZwUvf4zC3SRwX4OCiopiAwpoD09Arqvrf8kcYits=\";\r\n        var sQsUrlAuth = \"\";\r\n\r\n        if (bFlAutenticacaoUnica) {\r\n            AUTHCONTROL.iniciar(\"btnAcessar\", sURLAuth);\r\n        }\r\n        else {\r\n            AUTHCONTROL.iniciar(\"btnAcessarFornecedor\", sURLAuth);\r\n            AUTHCONTROL.iniciar(\"btnAcessarComprador\", sURLAuthComprador);\r\n        }\r\n\r\n        sessionStorage.setItem(\"sQsUrlAuth\", sQsUrlAuth);\r\n    });\r\n\r\n</script>\r\n\r\n\r\n    <div class=\"area-acesso\">\r\n        <span id=\"conteudoCadastrar\"><a id=\"ctl00_ctl08_ctl00_hylCadastro\" href=\"/Empresa/CadastroExterno/ApresentacaoCadastro\">Cadastre-se no sistema</a></span>\r\n    </div>\r\n                        \r\n    \r\n        <div id=\"divLogin\" >\r\n            \r\n                <input type=\"button\" id=\"btnAcessar\" value=\"Acessar\" class=\"cancel enterLogin\" />\r\n            \r\n        </div>\r\n    </div>\r\n                    <div style=\"float:right;\">\r\n                        <a class='menu-idioma' href='#' style=\"font-weight:bold;\"></a>\r\n                        <div class=\"menu-idioma-painel \" style=\"position:absolute; right:0;\">\r\n                        <ul class=\"menu-idioma-painel-item\">                        \r\n                            \r\n                                    <li class=\"item-link\">\r\n                                        <a id=\"ctl00_rptListaIdioma_ctl00_linkIdioma\" data-sufixo=\"BR\" data-id=\"1\" data-descricao=\"Português\" data-cultura=\"pt-BR\" href=\"javascript:__doPostBack(&#39;ctl00$rptListaIdioma$ctl00$linkIdioma&#39;,&#39;&#39;)\" style=\"font-weight:bold\">Português</a>\r\n                                    </li>\r\n                                \r\n                                    <li class=\"item-link\">\r\n                                        <a id=\"ctl00_rptListaIdioma_ctl01_linkIdioma\" data-sufixo=\"US\" data-id=\"2\" data-descricao=\"Inglês\" data-cultura=\"en-US\" href=\"javascript:__doPostBack(&#39;ctl00$rptListaIdioma$ctl01$linkIdioma&#39;,&#39;&#39;)\">Inglês</a>\r\n                                    </li>\r\n                                \r\n                                    <li class=\"item-link\">\r\n                                        <a id=\"ctl00_rptListaIdioma_ctl02_linkIdioma\" data-sufixo=\"ES\" data-id=\"3\" data-descricao=\"Espanhol\" data-cultura=\"es-ES\" href=\"javascript:__doPostBack(&#39;ctl00$rptListaIdioma$ctl02$linkIdioma&#39;,&#39;&#39;)\">Espanhol</a>\r\n                                    </li>\r\n                                \r\n                                    <li class=\"item-link\">\r\n                                        <a id=\"ctl00_rptListaIdioma_ctl03_linkIdioma\" data-sufixo=\"PY\" data-id=\"4\" data-descricao=\"Español de Paraguay\" data-cultura=\"es-PY\" href=\"javascript:__doPostBack(&#39;ctl00$rptListaIdioma$ctl03$linkIdioma&#39;,&#39;&#39;)\">Español de Paraguay</a>\r\n                                    </li>\r\n                                \r\n                                    <li class=\"item-link\">\r\n                                        <a id=\"ctl00_rptListaIdioma_ctl04_linkIdioma\" data-sufixo=\"MX\" data-id=\"5\" data-descricao=\"Espanhol do México\" data-cultura=\"es-MX\" href=\"javascript:__doPostBack(&#39;ctl00$rptListaIdioma$ctl04$linkIdioma&#39;,&#39;&#39;)\">Espanhol do México</a>\r\n                                    </li>\r\n                                    \r\n                        </ul>             \r\n                    </div>\r\n                </div>\r\n                </div>\r\n\r\n                <!-- Botões -->\r\n                <div id=\"ctl00_botoes\" class=\"botoes\">\r\n                </div>  \r\n\r\n                <div class=\"clearfloat\"></div>\r\n                \r\n            </div>\r\n        </div>\r\n\r\n            <!-- Menu -->\r\n            <div id=\"menu\">\r\n    \t        <div class=\"conteudo\">\r\n                    <header>\r\n                        <ul id=\"ulMenu\" class=\"hide_640 hide_480 titulo-menu\"><li><a class='ativo' href='/Default.aspx'>Início</a></li><li><a class='ativo' href='/portal/Mural.aspx'>Mural</a></li><li><a class='ativo' href='/portal/Mural.aspx?nNmTela=ME'>Mural estatístico</a></li><li><a class='ativo' href='/portal/NormaInstrucao.aspx'>Normas e instruções</a></li><li><a class='ativo' href='/Empresa/CadastroExterno/ApresentacaoCadastro'>Cadastro</a></li>\r\n                            <div class=\"clearfloat\"></div>\r\n                        </ul>                    \r\n\r\n                        <div class=\"show_480 show_640\">\r\n                            <h3>MENU</h3>\r\n                            <select name=\"ctl00$ddlMenu\" id=\"ddlMenu\">\r\n\t<option value=\"Default.aspx\">In&#237;cio</option>\r\n\t<option value=\"portal/Mural.aspx\">Mural</option>\r\n\t<option value=\"portal/Mural.aspx?nNmTela=ME\">Mural estat&#237;stico</option>\r\n\t<option value=\"portal/NormaInstrucao.aspx\">Normas e instru&#231;&#245;es</option>\r\n\t<option value=\"Empresa/CadastroExterno/ApresentacaoCadastro\">Cadastro</option>\r\n</select>     \r\n                        </div>     \r\n\r\n                    </header>\r\n                \r\n                </div>\r\n            </div>            \r\n        \r\n            <noscript>\r\n                <div class=\"mensagem-nojavascript\" >\r\n                    <span>Seu navegador está com o javascript desabilitado!</span><br />\r\n                    <span>Para usar o sistema é necessário habilitá-lo. Para ver o procedimento, clique no link correspondente:</span>\r\n                    <br /><br />\r\n                    <ul id=\"ulListaNavegadoresSuportados\" class=\"lista-navegadores\"><li><a href='https://support.microsoft.com/pt-br/office/enable-javascript-7bb9ee74-6a9e-4dd1-babf-b0a1bb136361' target='_blank' rel='noopener noreferrer'>Edge (Chromium)</a></li><li><a href='https://support.mozilla.org/pt-BR/kb/configuracoes-javascript-para-paginas-interativas' target='_blank' rel='noopener noreferrer'>Firefox</a></li><li><a href='https://support.google.com/adsense/answer/12654?hl=pt-br' target='_blank' rel='noopener noreferrer'>Chrome</a></li></ul>\r\n                </div>    \r\n            </noscript>      \r\n            \r\n            <div id=\"divAtualizarNavegador\" class=\"mensagem-nojavascript\" style=\"display:none;\">\r\n                <span id=\"spanTituloAtualizarNavegador\">Seu navegador está desatualizado!</span><br />\r\n                <span id=\"spanMensagemAtualizarNavegador\" data-navegador-nao-suportado=\"0\"></span>\r\n                <br /><br />\r\n                <ul id=\"ulListaNavegadoresHomologados\" class=\"lista-navegadores\"><li><a href='https://www.microsoft.com/pt-br/edge' target='_blank' rel='noopener noreferrer'>Edge (Chromium)</a></li><li><a href='https://www.mozilla.org/pt-BR/firefox/new/' target='_blank' rel='noopener noreferrer'>Firefox</a></li><li><a href='https://www.google.com/intl/pt-BR/chrome/browser/' target='_blank' rel='noopener noreferrer'>Chrome</a></li></ul>\r\n            </div>    \r\n\r\n            <!-- Corpo -->\r\n            <div id=\"corpo\">\r\n    \t        <div class=\"conteudo\">\r\n                    \r\n\r\n    <!-- Scritps -->\r\n    <script type=\"text/javascript\">\r\n\r\n        var arrMuralProcesso = [],\r\n            objParametroMural = {\r\n                nPaginaDe: 1,\r\n                nPaginaAte: objConfiguracao.nQtRegistrosPagina,\r\n                bPopUpFiltroAberto: false,\r\n                bPopUpLegendaAberto: false,\r\n                bDisparou: false,\r\n                bAbreItemAutomatico: false,\r\n                tmpTipoMuralProcesso: enumTipoMuralProcesso.MURAL,\r\n                sOrdenarPor: \"TDTINICIAL\",\r\n                sOrdenarPorDirecao: \"DESC\",\r\n                bAbriuItemAutomatico: false\r\n            };\r\n\r\n        var MURAL = {\r\n            MODULO: {\r\n                CompraDireta: Number(\"19\"),\r\n                Convite: Number(\"23\"),\r\n                PregaoEletronico: Number(\"18\"),\r\n                PregaoPresencial: Number(\"22\"),\r\n                Cotacao: Number(\"8\"),\r\n                Licitacao: Number(\"59\"),\r\n                Credenciamento: Number(\"53\"),\r\n            },\r\n            RESOURCES: {\r\n                Mural_estatistico: \"Mural estatístico\",\r\n                Edital: \"Edital\",\r\n                Editais: \"Editais\",\r\n                Mural: \"Mural\",\r\n                Resumo_do_processo: \"Resumo do processo\",\r\n                Nao_foi_possivel_recuperar_dados: \"Não foi possível recuperar os dados desse registro!\",\r\n                Nenhum_registro_encontrado: \"Nenhum registro encontrado para esta pesquisa. Caso você tenha especificado um filtro, utilize outro e realize a pesquisa novamente.\",\r\n                Nao_ha_mais_registros: \"Não há mais registros com os parâmetros especificados\",\r\n                Nao_informado: \"Não informado\",\r\n                Tipo_de_modalidade: \"Tipo de modalidade\",\r\n                Mais_detalhes: \"Mais detalhes\",\r\n                Indeterminado: \"Indeterminado\",\r\n                Chamamentos_publicos_em_andamento: \"Chamamentos públicos em andamento\",\r\n                Ver_editais_em_andamento: \"Ver todos os editais de cadastro em andamento\",\r\n                Ver_editais_encerrados: \"Ver todos os editais de cadastro encerrados\",\r\n                Ver_RFIs_em_andamento: \"Ver todas as RFIs em andamento\",\r\n                Ver_RFIs_encerradas: \"Ver todas as RFIs encerradas\",\r\n                Portal_da_transparencia: \"Licitações / Processos de seleção\",\r\n                Data_campo_De_ou_Ate_invalida: \"A data informada no filtro de pesquisa Período: Até' deve ser maior que a data informada no campo 'De'\",\r\n                Filtro_pesquisa_Periodo_invalido: \"O filtro de pesquisa 'Período' está inválido, informe os dois campos para realizar a pesquisa.\",\r\n                Nao_foi_possivel_efetuar_a_operacao: \"Não foi possível efetuar a operação.\",\r\n                Nao_foi_possivel_efetuar_a_operacao_nao_foram_encontrados_departamentos_para_a_entidade_selecionada : \"Não foi possível efetuar a operação. Não foi(ram) encontrado(s) departamento(s) para a entidade selecionada.\",\r\n                Favor_informar_datas_dentro_dos_ultimos_tres_anos_vigentes: \"Favor informar datas dentro dos últimos três anos vigentes.\",\r\n                Todas_as_modalidades: \"Todas as modalidades\",\r\n                Todos: \"Todos\",\r\n                Exclusivo_para_empresas_me_epp: \"Exclusivos para empresas ME/EPP\",\r\n                Homologacao: \"Homologação\"\r\n            }\r\n        }\r\n\r\n        var bFlPesquisaAgrupada = \"False\" === \"True\";\r\n\r\n        var bFlExpandeScroll = false;\r\n\r\n        $(document).ready(function () {\r\n            (function () {\r\n                const tela = document.getElementById(\"divCarregarProcesso\");\r\n\r\n                if (!tela) return;\r\n\r\n                const esconderdivCarregarProcesso = () => {\r\n                    tela.style.opacity = \"0\";\r\n                    setTimeout(() => tela.remove(), 400);\r\n                };\r\n\r\n                const urlParams = new URLSearchParams(window.location.search);\r\n\r\n                const deveAguardarCarregamentoCompleto = (\r\n                    0 == 1 &&\r\n                    urlParams.has(\"sDsProcesso\") &&\r\n                    urlParams.has(\"nCdModulo\")\r\n                );\r\n\r\n                if (deveAguardarCarregamentoCompleto) {\r\n                    tela.style.display = \"flex\";\r\n                    tela.style.transition = \"opacity 0.5s ease\";\r\n\r\n                    const intervalo = setInterval(() => {\r\n                        const lbl = document.getElementById(\"lblMuralDetalheTitulo\");\r\n\r\n                        if (lbl && lbl.innerText.trim() !== \"\") {\r\n                            clearInterval(intervalo);\r\n                            clearTimeout(seguro);\r\n                            esconderdivCarregarProcesso();\r\n                        }\r\n                    }, 200);\r\n\r\n                    const seguro = setTimeout(() => {\r\n                        clearInterval(intervalo);\r\n                        esconderdivCarregarProcesso();\r\n                    }, 5000);\r\n                } else {\r\n                    esconderdivCarregarProcesso();\r\n                }\r\n            })();\r\n\r\n            if (window.location.href.indexOf(\"nNmTela=ES\") > -1) {\r\n                objParametroMural.nPaginaAte = 5;\r\n                $(\"#lblMuralTitulo\").text(MURAL.RESOURCES.Editais);\r\n                $(\".lblMuralSubtitulo\").show();\r\n                HabilitarSecoesEditalSimplificado();\r\n                PesquisarConsultores();\r\n                PesquisarProcessosEmAndamento();\r\n                PesquisarProcessosEncerrados();\r\n                PesquisarRfiEmAndamento();\r\n                PesquisarRfiEncerrados();\r\n                AdicionarSessionTimezone();\r\n            } else {\r\n                AdicionarSessionTimezone();\r\n                setTimeout(function () { $(\"#areaFiltro\").fadeIn(); }, 500);\r\n\r\n                if (window.location.href.indexOf(\"nNmTela=ME\") > -1) {\r\n                    $(\"#lblMuralTitulo\").text(MURAL.RESOURCES.Mural_estatistico);\r\n                    PesquisarSituacoesModulo(0);\r\n                    PesquisarTipoProcesso();\r\n                    $(\"#ddlModulo\").bind(\"change\", function () {\r\n                        OcultarFiltroPorModulo();\r\n                        PesquisarSituacoesModulo(this.value);\r\n                    });\r\n                }\r\n                else if (window.location.href.indexOf(\"nNmTela=E\") > -1) {\r\n                    $(\"#lblMuralTitulo\").text(MURAL.RESOURCES.Edital);\r\n                    PesquisarProcessos(false);\r\n                    if(bFlPesquisaAgrupada) {\r\n                        PesquisarSituacoesModulo(0);\r\n                        $(\"#ddlModulo\").bind(\"change\", function () {\r\n                            OcultarFiltroPorModulo();\r\n                            PesquisarSituacoesModulo(this.value);\r\n                        });\r\n                    }\r\n                }\r\n                else if (window.location.href.indexOf(\"nNmTela=PT\") > -1) {\r\n                    $(\"#lblMuralTitulo\").text(MURAL.RESOURCES.Portal_da_transparencia);\r\n                    $(\"#lblTagsFiltros\").html('<div onClick=\"PesquisarProcessos(true, 18, 1)\" style=\"background-color: #E6F4FF; padding: 3px; border: 1px solid #000; border-color: #91caff; color: #0998EA; border-radius: 5px; display: inline-block; font-size: 12px; margin: 4px;\">pregão eletrônico</div><div onClick=\"PesquisarProcessos(true, 22, 2)\" style=\"background-color: #E6F4FF; padding: 3px; border: 1px solid #000; border-color: #91caff; color: #0998EA; border-radius: 5px; display: inline-block; font-size: 12px; margin: 4px;\">Processo presencial</div><div onClick=\"PesquisarProcessos(true, 59, 3)\" style=\"background-color: #E6F4FF; padding: 3px; border: 1px solid #000; border-color: #91caff; color: #0998EA; border-radius: 5px; display: inline-block; font-size: 12px; margin: 4px;\">Disputa aberta</div><div onClick=\"PesquisarProcessos(true, 59, 4)\" style=\"background-color: #E6F4FF; padding: 3px; border: 1px solid #000; border-color: #91caff; color: #0998EA; border-radius: 5px; display: inline-block; font-size: 12px; margin: 4px;\">Disputa fechada</div>');\r\n                    $(\"#divFinalizacao\").text(MURAL.RESOURCES.Homologacao);\r\n                    $(\"#lblMuralInformativo\").html('<p style=\"color: #2A6496 !important\">RLC - Regulamento de Licitações e Contratos, vigentes até 31/03/2024.</p><p style=\"color: #2A6496 !important\">RCA - Regulamento para Contratação e Alienação, facultativo desde 16/05/2023 e obrigatório em 01/04/2024.</p>');\r\n\r\n                    PesquisarProcessos(false);\r\n                    PesquisarSituacoesModulo(0);\r\n                }\r\n                else {\r\n                    $(\"#lblMuralTitulo\").text(MURAL.RESOURCES.Mural);\r\n                    objParametroMural.sOrdenarPor = \"TDTINICIAL\";\r\n\r\n                    PesquisarSituacoesModulo(0);\r\n                    PesquisarTipoProcesso();\r\n                    $(\"#ddlModulo\").bind(\"change\", function () {\r\n                        OcultarFiltroPorModulo();\r\n                        PesquisarSituacoesModulo(this.value);\r\n                    });\r\n                }\r\n            }\r\n           \r\n\r\n            $(\".grupoFiltro.esquerda\").fadeOut();\r\n            $(\".grupoFiltro.direita\").fadeOut();\r\n\r\n            $(\"#areaFiltro\").bind(\"mouseenter\", menuFiltro_MouseEnter);\r\n            $(\"#areaOpcoes\").bind(\"mouseleave\", menuOpcoes_MouseLeave);\r\n            $(\"#areaOpcoes\").bind(\"mouseenter\", menuOpcoes_MouseEnter);\r\n\r\n            $(\".icoOrdenacao\").removeClass(\"ico-ordenacao-asc\");\r\n            $(\".icoOrdenacao\").removeClass(\"ico-ordenacao-desc\");\r\n            $(\".icoOrdenacao\").first().addClass(\"ico-ordenacao-\" + objParametroMural.sOrdenarPorDirecao.toLowerCase());\r\n\r\n            $(window).unbind(\"scroll\");\r\n            $(window).scroll(ChegouFinalScroll);\r\n\r\n            setTimeout(function () {\r\n                $(\"#divResumoEdital\").kendoWindow({\r\n                    actions: [\"Close\"],\r\n                    title: MURAL.RESOURCES.Resumo_do_processo.toUpperCase(),\r\n                    modal: true,\r\n                    draggable: false,\r\n                    resizable: false,\r\n                    animation: { open: true, close: true },\r\n                    close: function (e) { scrollBodyFuncional(true, \"/\"); },\r\n                    open: function () { scrollBodyFuncional(false, \"/\"); },\r\n                    visible: false\r\n                });\r\n\r\n                $(\".campoSelect\").parent().find(\"span:first\").css(\"width\", \"245px\");\r\n                $(\".selector\").css(\"width\", \"\");\r\n\r\n            }, 100);\r\n        });\r\n\r\n        function OcultarFiltroPorModulo() {\r\n            if ($(\"#ddlModulo\").val() == MURAL.MODULO.Cotacao.toString() || $(\"#ddlModulo\").val() == MURAL.MODULO.PregaoPresencial.toString())\r\n                $(\".oculta-campo-modulo\").css(\"margin-left\", -500);\r\n            else\r\n                $(\".oculta-campo-modulo\").css(\"margin-left\", 0);\r\n        }\r\n\r\n        function PesquisarSituacoesModulo(_nCdModulo) {\r\n            \r\n            let sMetodoChamada = bFlPesquisaAgrupada ? \"PesquisarSituacoesAgrupadas\" : \"PesquisarSituacoesModulo\";\r\n\r\n            if (\"False\" === \"True\") {\r\n                sMetodoChamada = \"PesquisarSituacoesAgrupadasPortalTransparencia\";\r\n            }\r\n            chamadaWebService(\r\n                \"WebService/Servicos.asmx/\" + sMetodoChamada,\r\n                \"nCdModulo:\" + parseInt(_nCdModulo),\r\n                function (_retorno) {\r\n                    var arrRetorno = _retorno.d;\r\n\r\n                    var sSelect = $(\"<select>\");\r\n                    $(arrRetorno).each(function () {\r\n                        sSelect.append($(\"<option></option>\").val(this.nCdSituacao).html(this.sDsSituacao));\r\n                    });\r\n\r\n                    $(\"#ddlVisoes option\").remove();\r\n                    $(\"#ddlVisoes\").append(sSelect.html());\r\n                    $(\"#ddlVisoes\").val(\"0\");\r\n                    $.uniform.update(\"#ddlVisoes\");\r\n                    $(\".campoSelect\").parent().find(\"span:first\").css(\"width\", \"245px\");\r\n                    $(\".selector\").css(\"width\", \"\");\r\n                },\r\n                function () {\r\n                    Alerta(MURAL.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                }\r\n            );\r\n        }\r\n\r\n        function PesquisarUnidadeCompradora() {\r\n            chamadaWebService(\r\n                \"WebService/Servicos.asmx/PesquisarEntidadePortalTransparencia\",\r\n                \"\",\r\n                function (_retorno) {\r\n                    var arrRetorno = _retorno.d;\r\n\r\n                    var sSelect = $(\"<select>\");\r\n                if (!false) {\r\n                   sSelect.append($(\"<option></option>\").val(\"\").html(MURAL.RESOURCES.Todos));\r\n                }\r\n                    $(arrRetorno).each(function () {\r\n                        sSelect.append($(\"<option></option>\").val(this.nCdEntidade).html(this.sNmEntidade));\r\n                    });\r\n\r\n                    $(\"#ddlEmpresaUnidadeCompradora option\").remove();\r\n                    $(\"#ddlEmpresaUnidadeCompradora\").append(sSelect.html());\r\n                    $(\"#ddlEmpresaUnidadeCompradora\").val(\"2\");\r\n                    $.uniform.update(\"#ddlEmpresaUnidadeCompradora\");\r\n                    $(\".campoSelect\").parent().find(\"span:first\").css(\"width\", \"245px\");\r\n                    $(\".selector\").css(\"width\", \"\");\r\n                },\r\n                function () {\r\n                    Alerta(MURAL.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                }\r\n            );\r\n        }\r\n\r\n        function PesquisarModalidade() {\r\n            chamadaWebService(\r\n                \"WebService/Servicos.asmx/PesquisarModalidade\",\r\n                \"\",\r\n                function (_retorno) {\r\n                    var arrRetorno = _retorno.d;\r\n\r\n                    var sSelect = $(\"<select>\");\r\n                    sSelect.append($(\"<option></option>\").val(\"\").html(MURAL.RESOURCES.Todas_as_modalidades));\r\n                    $(arrRetorno).each(function () {\r\n                        sSelect.append($(\"<option></option>\").val(this.nCdModalidade).html(this.sDsModalidade));\r\n                    });\r\n\r\n                    $(\"#ddlModulo option\").remove();\r\n                    $(\"#ddlModulo\").append(sSelect.html());\r\n                    $(\"#ddlModulo\").val(\"\");\r\n                    $.uniform.update(\"#ddlModulo\");\r\n                    $(\".campoSelect\").parent().find(\"span:first\").css(\"width\", \"245px\");\r\n                    $(\".selector\").css(\"width\", \"\");\r\n                },\r\n                function () {\r\n                    Alerta(MURAL.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                }\r\n            );\r\n        }\r\n\r\n        function PesquisarTipoProcesso() {\r\n            chamadaWebService(\r\n                \"WebService/Servicos.asmx/PesquisarTipoProcesso\",\r\n                \"\",\r\n                function (_retorno) {\r\n                    \r\n                    var arrRetorno = _retorno.d;\r\n\r\n                    var sSelect = $(\"<select>\");\r\n                    $(arrRetorno).each(function () {\r\n                        sSelect.append($(\"<option></option>\").val(this.nCdTipoProcesso).html(this.sDsTipoProcesso));\r\n                    });\r\n\r\n                    $(\"#ddlTipoProcesso option\").remove();\r\n                    $(\"#ddlTipoProcesso\").append(sSelect.html());\r\n\r\n                    if (objConfiguracao.bFlIdiomaFiltraProcessoPublico > 0) {\r\n                        if (adquirirIdIdioma(\"/\") == 1)\r\n                            $(\"#ddlTipoProcesso\").val(enumTipoProcessoPorIdioma.PTBR);\r\n                        else if (adquirirIdIdioma(\"/\") == 2)\r\n                            $(\"#ddlTipoProcesso\").val(\"2\");\r\n                        else if (adquirirIdIdioma(\"/\") == 4)\r\n                            $(\"#ddlTipoProcesso\").val(enumTipoProcessoPorIdioma.ESPY);\r\n                        else\r\n                            $(\"#ddlTipoProcesso\").val(\"0\");\r\n                    }\r\n                    else\r\n                        $(\"#ddlTipoProcesso\").val(\"0\");\r\n\r\n                    $.uniform.update(\"#ddlTipoProcesso\");\r\n                    $(\".campoSelect\").parent().find(\"span:first\").css(\"width\", \"245px\");\r\n                    $(\".selector\").css(\"width\", \"\");\r\n\r\n                    PesquisarProcessos(false);\r\n                },\r\n                function () {\r\n                    Alerta(MURAL.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                }\r\n            );\r\n        }\r\n\r\n        function menuFiltro_MouseEnter() {\r\n            if (!objParametroMural.bPopUpFiltroAberto) {\r\n                $(\".iconePainel .ico-buscar-branco-25\").attr(\"class\", \"ico-fechar-branco-25\");\r\n\r\n                var nAlturaPainelFiltro = bFlPesquisaAgrupada ? \"360px\" : \"400px\";\r\n                if (window.location.href.indexOf(\"nNmTela=ME\") > -1)\r\n                    nAlturaPainelFiltro = bFlPesquisaAgrupada ? \"450px\" : \"400px\";\r\n                else if (window.location.href.indexOf(\"nNmTela=E\") > -1)\r\n                    nAlturaPainelFiltro = \"310px\";\r\n                else if (window.location.href.indexOf(\"nNmTela=PT\") > -1)\r\n                    nAlturaPainelFiltro = bFlPesquisaAgrupada ? \"500px\" : \"450px\";\r\n\r\n                $(\"#areaFiltro\")\r\n                    .animate({ marginLeft: \"0px\" }, 200, function () { $(\".grupoFiltro.esquerda\").fadeIn(); })\r\n                    .animate({ height: nAlturaPainelFiltro }, 300, function () { objParametroMural.bPopUpFiltroAberto = true; menuOpcoes_MouseLeave(); });\r\n            }\r\n        }\r\n\r\n        function menuFiltro_MouseLeave() {\r\n\r\n            if (objParametroMural.bPopUpFiltroAberto) {\r\n                $(\".grupoFiltro.esquerda\").fadeOut();\r\n                setTimeout(function () {\r\n                    $(\"#areaFiltro\")\r\n                        .animate({ height: \"100px\" }, 200)\r\n                        .animate({ marginLeft: \"-270px\" }, 300, function () { $(\".iconePainel .ico-fechar-branco-25\").attr(\"class\", \"ico-buscar-branco-25\"); objParametroMural.bPopUpFiltroAberto = false; });\r\n                }, 400);\r\n            }\r\n        }\r\n\r\n        function menuOpcoes_MouseEnter() {\r\n            if (!objParametroMural.bPopUpLegendaAberto) {\r\n                $(\".lista-legenda\").addClass(\"overflow\");\r\n                $(\"#areaOpcoes\")\r\n                    .animate({ marginLeft: \"0px\" }, 200, function () { $(\".grupoFiltro.direita\").fadeIn(); })\r\n                    .animate({ height: \"280px\" }, 300, function () { objParametroMural.bPopUpLegendaAberto = true; });\r\n            }\r\n        }\r\n\r\n        function menuOpcoes_MouseLeave() {\r\n            if (objParametroMural.bPopUpLegendaAberto) {\r\n                $(\".lista-legenda\").scrollTop(0);\r\n                $(\".grupoFiltro.direita\").fadeOut();\r\n\r\n                setTimeout(function () {\r\n                    $(\".lista-legenda\").removeClass(\"overflow\");\r\n                    $(\"#areaOpcoes\")\r\n                        .animate({ marginLeft: \"-270px\" }, 200)\r\n                        .animate({ height: \"100px\" }, 300, function () { objParametroMural.bPopUpLegendaAberto = false; });\r\n                }, 300);\r\n            }\r\n        }\r\n\r\n        function ChegouFinalScroll() {\r\n            if (objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL_SIMPLIFICADO || bFlExpandeScroll) {\r\n                var docElement = $(document)[0].documentElement;\r\n                var winElement = $(window)[0];\r\n                if ((docElement.scrollHeight - winElement.innerHeight) == winElement.pageYOffset) {\r\n                    $(window).unbind(\"scroll\");\r\n\r\n                    if (!objParametroMural.bDisparou) {\r\n                        objParametroMural.bDisparou = true;\r\n                        setTimeout(function () {\r\n                            objParametroMural.nPaginaDe = (objParametroMural.nPaginaDe + objConfiguracao.nQtRegistrosPagina);\r\n                            objParametroMural.nPaginaAte = (objParametroMural.nPaginaAte + objConfiguracao.nQtRegistrosPagina);\r\n                            PesquisarProcessos(false, nCdModuloPesquisaRapida, nCdTipoModalidadePesquisaRapida)\r\n                            if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL_SIMPLIFICADO) {\r\n                                PesquisarConsultores();\r\n                                PesquisarProcessosEmAndamento();\r\n                                PesquisarProcessosEncerrados();\r\n                                PesquisarRfiEmAndamento();\r\n                                PesquisarRfiEncerrados();\r\n                            }\r\n                        }, 500);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n\r\n        function HabilitarSecoesEditalSimplificado() {\r\n            $(\"#tbConsultores\").show();\r\n            $(\"#tbRfiEncerradas\").show();\r\n            $(\"#tbRfiEmAndamento\").show();\r\n            $(\"#tbEditaisEncerrados\").show();\r\n        }\r\n\r\n        function ObterQueryStringFiltroUrlMural() {\r\n            var urlParams = new URLSearchParams(window.location.search);\r\n            var sQueryString = \"\";\r\n\r\n            [\"nomeEntidade\", \"Empresa\"].forEach(function (sParametro) {\r\n                var sValor = urlParams.get(sParametro);\r\n                if (sValor !== null && sValor !== \"\")\r\n                    sQueryString += sParametro + \"=\" + encodeURIComponent(sValor) + \"&\";\r\n            });\r\n\r\n            return sQueryString;\r\n        }\r\n\r\n        function trListaMuralProcesso_Click(_nCdProcesso, _nCdModulo, _sDsProcesso, bAbreItemAutomatico, _nCdEdital = -2147483648,bFlPesquisaFornecedores = false) {\r\n            var oObjetoProcesso = $.grep(arrMuralProcesso, function (i) { return i.nCdProcesso == _nCdProcesso; })[0];\r\n\r\n            if (bAbreItemAutomatico && oObjetoProcesso == null) {\r\n                oObjetoProcesso = {\r\n                    nCdProcesso: _nCdProcesso,\r\n                    nCdOrigem: _nCdProcesso,\r\n                    nCdEdital: _nCdEdital\r\n                };\r\n            }\r\n\r\n            var bFlUrlApresentarParametros = 0;\r\n            var urlParams = new URLSearchParams(window.location.search);\r\n            var sDsProcessoParam = urlParams.get(\"sDsProcesso\");\r\n            var nCdModuloParam = urlParams.get(\"nCdModulo\");\r\n            var nCdProcessoParam = urlParams.get(\"nCdProcesso\");\r\n\r\n            if (urlParams.has(\"sDsProcesso\") && urlParams.has(\"nCdModulo\")) {\r\n                var bFlValorIgual = true;\r\n\r\n                if (!(sDsProcessoParam === _sDsProcesso || (sDsProcessoParam === \"\" && _sDsProcesso === \"\"))) {\r\n                    bFlValorIgual = false;\r\n                }\r\n\r\n                if (!(nCdModuloParam === _nCdModulo.toString() || (nCdModuloParam === \"\" && _nCdModulo === \"\"))) {\r\n                    bFlValorIgual = false;\r\n                }\r\n\r\n                if (urlParams.has(\"nCdProcesso\")) {\r\n                    if (!(nCdProcessoParam === _nCdProcesso.toString() || (nCdProcessoParam === \"\" && _nCdProcesso <= 0))) {\r\n                        bFlValorIgual = false;\r\n                    }\r\n                }\r\n\r\n                if (bFlValorIgual) {\r\n                    bFlUrlApresentarParametros = 0; // Não redireciona se os valores são iguais\r\n                }\r\n            }          \r\n\r\n            if (bFlUrlApresentarParametros == 1 && bFlUrlApresentarParametros != \"undefined\") {\r\n                var url = \"/portal/Mural.aspx?\";\r\n\r\n                var nNmTela = urlParams.get(\"nNmTela\");\r\n                if (nNmTela === \"ME\" || nNmTela === \"E\") {\r\n                    url += \"nNmTela=\" + nNmTela + \"&\";\r\n                }\r\n                url += ObterQueryStringFiltroUrlMural();\r\n                url += \"nCdModulo=\" + _nCdModulo + \"&sDsProcesso=\" + _sDsProcesso;\r\n                if (_nCdProcesso > 0) {\r\n                    url += \"&nCdProcesso=\" + _nCdProcesso;\r\n                }\r\n\r\n                window.location.href = url;\r\n                return;\r\n            }\r\n\r\n            if (window.location.href.indexOf(\"nNmTela=ME\") > -1)\r\n                MuralProcessoDetalhes_Load(oObjetoProcesso.nCdOrigem, _nCdModulo, oObjetoProcesso.nCdSituacao, _sDsProcesso, oObjetoProcesso.nCdEdital);\r\n            else\r\n                MuralProcessoDetalhes_Load(oObjetoProcesso.nCdProcesso, _nCdModulo, oObjetoProcesso.nCdSituacao, _sDsProcesso, oObjetoProcesso.nCdEdital);\r\n        }\r\n\r\n\r\n        function trListaMuralResumoEdital_Click(_nCdProcesso, _nCdModulo, _nCdOrigem, _exibeBotaoDetalhes) {\r\n            var oObjetoProcesso = $.grep(arrMuralProcesso, function (i) { return i.nCdProcesso == _nCdProcesso || i.nCdOrigem == _nCdOrigem; })[0];\r\n\r\n            if (Number(oObjetoProcesso.nCdProcesso) > 0) {\r\n\r\n                $(\"#btImprimirEdital\").hide();\r\n                $(\"#btDetalhesDosItens\").hide();\r\n                $(\"#btFecharEdital\").hide();\r\n\r\n                $(\"#btDetalhesDosItens\").unbind(\"click\");\r\n                $(\"#btDetalhesDosItens\").bind(\"click\", function () {\r\n                    trListaMuralProcesso_Click(_nCdProcesso, _nCdModulo, \"\", false);\r\n                    setTimeout(function () {\r\n                        $(\"#divResumoEdital\").data(\"kendoWindow\").close();\r\n                        $(document).scrollTop(0);\r\n                    }, 500);\r\n                });\r\n\r\n                if (_exibeBotaoDetalhes)\r\n                    $(\"#btDetalhesDosItens\").show();\r\n\r\n                $(\"#carregandoResumoEdital\").show();\r\n                $(\"#divResumoEdital\").data(\"kendoWindow\").open();\r\n                $(\"#divResumoEdital\").data(\"kendoWindow\").center();\r\n                $(\"#divResumoEdital\").scrollTop(0);\r\n                $(document).scrollTop(0);\r\n\r\n                var nCdProcessoAux = _nCdOrigem == -2147483648 ? _nCdProcesso : _nCdOrigem;\r\n\r\n                var dtoProcesso = {\r\n                    nCdProcesso: nCdProcessoAux,\r\n                    nCdOrigem: _nCdOrigem,\r\n                    nCdModulo: _nCdModulo,\r\n                    dtoIdioma: {\r\n                        nCdIdioma: adquirirIdIdioma(\"/\")\r\n                    },\r\n                    sGMT: retornaGMT()\r\n                }\r\n\r\n                chamadaWebService(\r\n                    \"WebService/Servicos.asmx/PesquisarResumoEdital\",\r\n                    \"dtoProcesso:\" + JSON.stringify(dtoProcesso),\r\n                    function (_retorno) {\r\n                    \r\n\r\n                        $(\"#carregandoResumoEdital\").hide();\r\n\r\n                        var sTemplateEditado = _retorno.d;\r\n\r\n                        $(\"#frameResumoEdital\").contents().find(\"html\").html(sTemplateEditado);\r\n                        $(\"#divResumoEdital\").data(\"kendoWindow\").center();\r\n\r\n                        $(\"#btFecharEdital\").show();\r\n                        $(\"#btImprimirEdital\").show();\r\n\r\n                    },\r\n                    function (x, e) {\r\n                        $(\"#btFecharEdital\").show();\r\n                    }\r\n                );\r\n            }\r\n        }\r\n\r\n        function btProcurar_Click() {\r\n            arrMuralProcesso = [];\r\n            objParametroMural.nPaginaDe = 1;\r\n            objParametroMural.nPaginaAte = objConfiguracao.nQtRegistrosPagina;\r\n            objParametroMural.sOrdenarPor = \"TDTINICIAL\";\r\n            objParametroMural.sOrdenarPorDirecao = \"DESC\";\r\n\r\n            $(\".icoOrdenacao\").removeClass(\"ico-ordenacao-asc\");\r\n            $(\".icoOrdenacao\").removeClass(\"ico-ordenacao-desc\");\r\n            $(\".icoOrdenacao\").first().addClass(\"ico-ordenacao-\" + objParametroMural.sOrdenarPorDirecao.toLowerCase());\r\n\r\n            PesquisarProcessos(true);\r\n        }\r\n\r\n        function btExportar_Click(sFormato) {\r\n            let sDsErro;\r\n            let bFLPossuiRegistros = false;\r\n            let lstDepartamento = [];\r\n            let lstPromises = []; \r\n            let tDtInicial = new Date($(\"#tbPeriodoDe\").val()).getUTCFullYear();\r\n            let tDtFinal = new Date($(\"#tbPeriodoAte\").val()).getUTCFullYear();\r\n            let nCdEntidade = $(\"#ddlEmpresaUnidadeCompradora option:selected\").val();\r\n            let sDsEntidade = $(\"#ddlEmpresaUnidadeCompradora option:selected\")[0].innerText;\r\n            let bFlDataInvalida = ValidarPeriodoPesquisaPortalTransparencia(tDtInicial, tDtFinal);\r\n            const sUrlBase = \"https://sistematransparenciaweb.com.br/api-licitacoes/publico/licitacoes/export?\";\r\n\r\n            if (!bFlDataInvalida)\r\n                lstDepartamento = PesquisarDepartamentoEmpresaEntidade(nCdEntidade);\r\n            \r\n            if (lstDepartamento.length) {\r\n                for (let sNrAno = tDtInicial; sNrAno <= tDtFinal; sNrAno++) {\r\n                    for (let sDsDepartamento of lstDepartamento) {\r\n                        \r\n                        let sUrl = `${sUrlBase}ano=${sNrAno}&departamento=${sDsDepartamento}&entidade=${sDsEntidade}&formatoExportacao=${sFormato}`;\r\n                        let promise = fetch(sUrl)\r\n                                    .then(response => {\r\n                                        if (!response.ok) {\r\n                                            return response.text();\r\n                                        }\r\n                                        return response.blob();\r\n                                    })\r\n                                    .then(result => {\r\n                                        if (result instanceof Blob) {\r\n                                            const url = URL.createObjectURL(result);\r\n                                            const link = document.createElement('a');\r\n                                            link.href = url;\r\n                                            link.download = `Relatório ${sDsDepartamento} ${sNrAno}.${sFormato.toLowerCase()}`;\r\n                                            link.click();\r\n\r\n                                            bFLPossuiRegistros = true;\r\n                                            URL.revokeObjectURL(url);\r\n                                        } else {\r\n                                            const parser = new DOMParser();\r\n                                            const xmlDoc = parser.parseFromString(result, 'text/xml');\r\n                                            const messageElement = xmlDoc.querySelector('message');\r\n                                            sDsErro  = messageElement.textContent;\r\n                                        }\r\n                                    })\r\n                                    .catch(error => {\r\n                                        alert(error);\r\n                                    });\r\n\r\n                        lstPromises.push(promise);\r\n                    }\r\n                }\r\n\r\n                Promise.all(lstPromises).then(() => {\r\n                    if (!bFLPossuiRegistros) {\r\n                        Alerta(`${MURAL.RESOURCES.Nao_foi_possivel_efetuar_a_operacao} ${sDsErro}`, \"/\");\r\n                    }\r\n                });\r\n\r\n            }\r\n        }\r\n\r\n        function PesquisarDepartamentoEmpresaEntidade(nCdEntidade) {\r\n            let arrDepartamento;\r\n\r\n            chamadaWebServiceAsync(\r\n                \"WebService/Servicos.asmx/PesquisarDepartamentoEmpresaEntidade\",\r\n                \"nCdEntidade:\" + parseInt(nCdEntidade),\r\n                function (_retorno) {\r\n                    arrDepartamento = _retorno.d;\r\n                },\r\n                function () {\r\n                    Alerta(MURAL.RESOURCES.Nao_foi_possivel_efetuar_a_operacao_nao_foram_encontrados_departamentos_para_a_entidade_selecionada, \"/\");\r\n                }\r\n            );\r\n\r\n            return arrDepartamento;\r\n        }\r\n\r\n        function ValidarPeriodoPesquisaPortalTransparencia(tDtInicial, tDtFinal) {\r\n            if (isNaN(tDtInicial) || isNaN(tDtFinal)) {\r\n                Alerta(MURAL.RESOURCES.Filtro_pesquisa_Periodo_invalido, \"/\");\r\n                return true;\r\n            }\r\n\r\n            if (tDtFinal < tDtInicial >= 3 || tDtFinal <= (2026 - 3) ) {\r\n                Alerta(MURAL.RESOURCES.Favor_informar_datas_dentro_dos_ultimos_tres_anos_vigentes, \"/\");\r\n                return true;\r\n            }\r\n\r\n            return false;\r\n        }\r\n\r\n        function btOrdenarPor_Click(_sColuna, _oElemento) {\r\n            objParametroMural.sOrdenarPor = _sColuna;\r\n            objParametroMural.sOrdenarPorDirecao = objParametroMural.sOrdenarPorDirecao == \"DESC\" ? \"ASC\" : \"DESC\";\r\n\r\n            arrMuralProcesso = [];\r\n            objParametroMural.nPaginaDe = 1;\r\n            objParametroMural.nPaginaAte = objConfiguracao.nQtRegistrosPagina;\r\n\r\n            $(\".icoOrdenacao\").removeClass(\"ico-ordenacao-asc\");\r\n            $(\".icoOrdenacao\").removeClass(\"ico-ordenacao-desc\");\r\n            $(_oElemento).find(\"div\").addClass(\"ico-ordenacao-\" + objParametroMural.sOrdenarPorDirecao.toLowerCase());\r\n\r\n            PesquisarProcessos(true, nCdModuloPesquisaRapida, nCdTipoModalidadePesquisaRapida);\r\n        }\r\n\r\n        var bFlExibepercenteconomia = \"1\";\r\n        var bFlExibevleconomia = \"1\";\r\n        var bFlExibevlestimado = \"1\";\r\n        var bFlPesquisaAgrupada = \"False\" === \"True\";\r\n        var nCdModuloPesquisaRapida = 0;\r\n        var nCdTipoModalidadePesquisaRapida = 0;\r\n\r\n        function PesquisarProcessos(_bProcurar, nCdModuloFiltroRapido = 0, nCdTipoModalidadeFiltroRapido = 0) {\r\n            if (nCdModuloFiltroRapido >= 0 && (nCdModuloPesquisaRapida != nCdModuloFiltroRapido || nCdTipoModalidadePesquisaRapida != nCdTipoModalidadeFiltroRapido)) {\r\n                objParametroMural.nPaginaDe = 1;\r\n                objParametroMural.nPaginaAte = 50;\r\n            }\r\n\r\n            nCdModuloPesquisaRapida = nCdModuloFiltroRapido;\r\n            nCdTipoModalidadePesquisaRapida = nCdTipoModalidadeFiltroRapido;\r\n\r\n            if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.PORTAL_DA_TRANSPARENCIA) {\r\n\r\n                if (validarFiltroPeriodo(true)) {\r\n                    return;\r\n                }\r\n            }\r\n\r\n            $(\".comum, .mural, .mural-estatistico, .edital, .mural-pesquisa-agrupada, .portalTransparencia\").hide();\r\n            var sNomeMetodoWebService = \"PesquisarProcessos\";\r\n\r\n            if (bFlPesquisaAgrupada) {\r\n                objParametroMural.tmpTipoMuralProcesso = enumTipoMuralProcesso.MURAL_PESQUISA_AGRUPADA;\r\n                sNomeMetodoWebService = \"PesquisarProcessosPorSituacoesAgrupadas\";\r\n                if (window.location.href.includes(\"nNmTela=ME\")) {\r\n                    objParametroMural.tmpTipoMuralProcesso = enumTipoMuralProcesso.MURAL_ESTATISTICO;\r\n\r\n                    $(\".comum, .mural-estatistico\").show();\r\n\r\n                    if (bFlExibepercenteconomia == 1 && bFlExibepercenteconomia != \"undefined\")\r\n                        $(\".mural-estatistico-percenteconomia\").show();\r\n\r\n                    if (bFlExibevleconomia == 1 && bFlExibevleconomia != \"undefined\")\r\n                        $(\".mural-estatistico-vleconomia\").show();\r\n\r\n                    if (bFlExibevlestimado == 1 && bFlExibevlestimado != \"undefined\")\r\n                        $(\".mural-estatistico-vlestimado\").show();\r\n                }\r\n                else if (window.location.href.includes(\"nNmTela=E\") && !window.location.href.includes(\"nNmTela=ES\")) {\r\n                    objParametroMural.tmpTipoMuralProcesso = enumTipoMuralProcesso.EDITAL;\r\n                    objParametroMural.sOrdenarPor = \"NCDPROCESSO\";\r\n                    $(\".comum, .edital\").show();\r\n                } else {\r\n                    $(\".comum, .mural-pesquisa-agrupada\").show();\r\n                }\r\n\r\n            } else if (window.location.href.includes(\"nNmTela=ME\")) {\r\n                objParametroMural.tmpTipoMuralProcesso = enumTipoMuralProcesso.MURAL_ESTATISTICO;\r\n                sNomeMetodoWebService = \"PesquisarProcessosMuralEstatistico\";\r\n                $(\".comum, .mural-estatistico\").show();\r\n\r\n                if (bFlExibepercenteconomia == 1 && bFlExibepercenteconomia != \"undefined\")\r\n                    $(\".mural-estatistico-percenteconomia\").show();\r\n\r\n                if (bFlExibevleconomia == 1 && bFlExibevleconomia != \"undefined\")\r\n                    $(\".mural-estatistico-vleconomia\").show();\r\n\r\n                if (bFlExibevlestimado == 1 && bFlExibevlestimado != \"undefined\")\r\n                    $(\".mural-estatistico-vlestimado\").show();\r\n            } else if (window.location.href.includes(\"nNmTela=E\") && !window.location.href.includes(\"nNmTela=ES\")) {\r\n                objParametroMural.tmpTipoMuralProcesso = enumTipoMuralProcesso.EDITAL;\r\n                objParametroMural.sOrdenarPor = \"NCDPROCESSO\";\r\n                $(\".comum, .edital\").show();\r\n            } else if (window.location.href.includes(\"nNmTela=ES\")) {\r\n                objParametroMural.tmpTipoMuralProcesso = enumTipoMuralProcesso.EDITAL_SIMPLIFICADO;\r\n                $(\"#areaFiltro\").hide();\r\n                $(\".edital-simplificado\").show();\r\n            } else if (window.location.href.includes(\"nNmTela=PT\")) {\r\n                objParametroMural.tmpTipoMuralProcesso = enumTipoMuralProcesso.PORTAL_DA_TRANSPARENCIA;\r\n                $(\".comum, .portalTransparencia\").show();\r\n            }\r\n            else {\r\n                objParametroMural.tmpTipoMuralProcesso = enumTipoMuralProcesso.MURAL;\r\n                $(\".comum, .mural\").show();\r\n                setTimeout(function () { $(\"#areaOpcoes\").fadeIn(); }, 500);\r\n            }\r\n\r\n            if (objConfiguracao.bFlIdiomaFiltraProcessoPublico > 0)\r\n                $(\"#divTipoProcesso\").show();\r\n\r\n            $(\"#carregandoLista\").show();\r\n\r\n            if (_bProcurar) {\r\n                arrMuralProcesso = [];\r\n                $(\"#trListaMuralProcesso\").children().remove();\r\n            }\r\n            var nCdProcesso = Number(adquirirCookie(\"CK_PROCESSO\", \"/\"));\r\n            objParametroMural.bAbreItemAutomatico = false;\r\n            if (nCdProcesso > 0 && !_bProcurar)\r\n                objParametroMural.bAbreItemAutomatico = true;\r\n\r\n\r\n            var query = location.search.slice(1);\r\n            var partes = query.split('&');\r\n            var queryData = {};\r\n\r\n            partes.forEach(function (parte) {\r\n                var chaveValor = parte.split('=');\r\n                var sQueryKey = chaveValor[0].toLowerCase();\r\n\r\n                if (sQueryKey == 'ncdmodulo')\r\n                    queryData[sQueryKey] = parseInt(chaveValor[1]);\r\n                else if (sQueryKey == 'sdsprocesso' || sQueryKey == 'scdprocesso')\r\n                    queryData[sQueryKey] = chaveValor[1];\r\n                else if (sQueryKey == 'ncdedital')\r\n                    queryData[sQueryKey] = parseInt(chaveValor[1]);\r\n                else if (sQueryKey == 'ncdprocesso')\r\n                    queryData[sQueryKey] = parseInt(chaveValor[1]);\r\n            });\r\n\r\n            if (Object.keys(queryData).length > 0)\r\n                objParametroMural.bAbreItemAutomatico = true;\r\n\r\n            $(\"#btVoltarInicio\").hide();\r\n            var nCdSituacao = adquirirCookie(\"CK_VISAO\", \"/\");\r\n            if (nCdSituacao != \"\")\r\n                $(\"#btVoltarInicio\").show();\r\n\r\n            var sOrdenacao = adquirirCookie(\"CK_ORDENAR_POR\", \"/\");\r\n            if (sOrdenacao != \"\") {\r\n                objParametroMural.sOrdenarPor = sOrdenacao;\r\n                $(\".icoOrdenacao\").removeClass(\"ico-ordenacao-asc\");\r\n                $(\".icoOrdenacao\").removeClass(\"ico-ordenacao-desc\");\r\n                $(\"#thListaMuralProcesso\").find(\"[data-coluna='TDTFINAL']\").find(\"div\").addClass(\"ico-ordenacao-\" + objParametroMural.sOrdenarPorDirecao.toLowerCase());\r\n            }\r\n\r\n            if (nCdSituacao == \"\")\r\n                nCdSituacao = isNaN(Number($(\"#ddlVisoes option:selected\").val())) ? 0 : Number($(\"#ddlVisoes option:selected\").val());\r\n\r\n            var nCdModuloSelected = $(\"#ddlModulo option:selected\").val();\r\n            var nCdModulo;\r\n            var nCdModalidade = 0;\r\n            var nCdTipoModalidade = 0;\r\n\r\n            if (nCdModuloSelected.toString().indexOf('nCdModalidade') !== -1) {\r\n                nCdModalidade = nCdModuloSelected.split('nCdModalidade')[1];\r\n            } else {\r\n                nCdModulo = nCdModuloSelected;\r\n            }\r\n            if (nCdModuloSelected.toString().indexOf('_') !== -1) {\r\n                nCdModulo = nCdModuloSelected.split('_')[0];\r\n                nCdTipoModalidade = nCdModuloSelected.split('_')[1];\r\n            }\r\n\r\n            if (false && nCdModuloSelected.toString().indexOf('_') !== -1) {\r\n                nCdModalidade = nCdModuloSelected.split('_')[1];\r\n            }\r\n\r\n            if (nCdTipoModalidadePesquisaRapida != 0 && false) {\r\n                nCdTipoModalidade = nCdTipoModalidadePesquisaRapida;\r\n                nCdModulo = nCdModuloPesquisaRapida;\r\n                nCdModalidade = nCdTipoModalidadePesquisaRapida;\r\n            }\r\n\r\n            var dtoProcesso = {\r\n                nAnoFinalizacao: isNaN(Number($(\"#ddlAnoFinalizacao option:selected\").val())) ? 0 : Number($(\"#ddlAnoFinalizacao option:selected\").val()),\r\n                tmpTipoMuralProcesso: objParametroMural.tmpTipoMuralProcesso,\r\n\r\n                nCdModulo: isNaN(Number(nCdModulo)) || nCdModuloFiltroRapido ? nCdModuloFiltroRapido : Number(nCdModulo),\r\n\r\n                nCdModalidade: nCdModalidade,\r\n\r\n                nCdModalidadeFase: nCdTipoModalidadeFiltroRapido,\r\n                nCdTipoModalidade: nCdTipoModalidade,\r\n                tmpTipoMuralVisao: nCdSituacao,\r\n                nCdSituacao: nCdSituacao,\r\n                nCdTipoProcesso: isNaN(Number($(\"#ddlTipoProcesso option:selected\").val())) ? 0 : Number($(\"#ddlTipoProcesso option:selected\").val()),\r\n                nCdEmpresa: isNaN(Number($(\"#ddlEmpresaUnidadeCompradora option:selected\").val())) ? 0 : Number($(\"#ddlEmpresaUnidadeCompradora option:selected\").val()),\r\n                sNrProcesso: $(\"#sNrProcesso\").val(),\r\n                nCdProcesso: nCdProcesso,\r\n                sDsObjeto: $(\"#tbsDsObjeto\").val(),\r\n                sDtPeriodoDe: $(\"#tbPeriodoDe\").val(),\r\n                sDtPeriodoAte: $(\"#tbPeriodoAte\").val(),\r\n                sOrdenarPor: objParametroMural.sOrdenarPor,\r\n                sOrdenarPorDirecao: objParametroMural.sOrdenarPorDirecao,\r\n                dtoPaginacao: {\r\n                    nPaginaDe: objParametroMural.nPaginaDe,\r\n                    nPaginaAte: objParametroMural.nPaginaAte\r\n                },\r\n                dtoIdioma: {\r\n                    nCdIdioma: adquirirIdIdioma(\"/\")\r\n                }\r\n            };\r\n            if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.PORTAL_DA_TRANSPARENCIA) {\r\n                dtoProcesso.nCdEmpresa = 0;\r\n                dtoProcesso.nCdEntidade = isNaN(Number($(\"#ddlEmpresaUnidadeCompradora option:selected\").val())) ? 0 : Number($(\"#ddlEmpresaUnidadeCompradora option:selected\").val());\r\n            }\r\n\r\n            if (-2147483648 > 0)\r\n                dtoProcesso.nCdEmpresa = -2147483648;\r\n            else if (-2147483648 > 0)\r\n                dtoProcesso.nCdEntidade = -2147483648;\r\n\r\n\r\n            var bFlUsarFiltroAnterior = localStorage.getItem('bFlUsarFiltroAnterior');\r\n            var dtoProcessoAnterior = localStorage.getItem('dtoProcesso');\r\n\r\n            var urlParams = new URLSearchParams(window.location.search);\r\n            if (!bFlUsarFiltroAnterior && (!urlParams.has(\"sDsProcesso\") && !urlParams.has(\"nCdModulo\"))) {\r\n                localStorage.setItem('dtoProcesso', JSON.stringify(dtoProcesso));\r\n            }\r\n\r\n            var param = bFlUsarFiltroAnterior ? dtoProcessoAnterior : JSON.stringify(dtoProcesso)\r\n            localStorage.removeItem('bFlUsarFiltroAnterior');\r\n            chamadaWebService(\r\n                \"WebService/Servicos.asmx/\" + sNomeMetodoWebService,\r\n                \"dtoProcesso:\" + param,\r\n                function (_retorno) {\r\n                    var arrRetorno = _retorno.d;\r\n                    if (arrRetorno.length <= 0) {\r\n\r\n                        if (_bProcurar || objParametroMural.nPaginaDe == 1) {\r\n                            arrMuralProcesso = [];\r\n                            $(\"#trListaMuralProcesso\").children().remove();\r\n                            $(\"#trListaMuralProcesso\").append(\"<tr style='height: \" + ($(window).height() - 300) + \"px'><td colspan='8' style='text-align:center;'>\" + MURAL.RESOURCES.Nenhum_registro_encontrado + \"</td></tr>\");\r\n                            $(\"#divPainelMural\").css(\"height\", ($(window).height() - 250) + \"px\");\r\n                        }\r\n                        else {\r\n                            if ($(\"#trListaMuralProcesso tr\").find(\".fim-linha\").length <= 0 && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL_SIMPLIFICADO)\r\n                                $(\"#trListaMuralProcesso\").append(\"<tr><td class='fim-linha' colspan='8'>\" + MURAL.RESOURCES.Nao_ha_mais_registros + \"</td></tr>\");\r\n                        }\r\n                    }\r\n                    else {\r\n\r\n                        if (_bProcurar) {\r\n                            arrMuralProcesso = [];\r\n                            $(\"#trListaMuralProcesso\").children().remove();\r\n                        }\r\n\r\n                        $(\"#divPainelMural\").css(\"height\", \"\");\r\n\r\n                        $(arrRetorno).each(function () {\r\n                            var oObjeto = this;\r\n                            arrMuralProcesso.push(oObjeto);\r\n                            var templateTR = \"<tr> \" +\r\n                                \"   <td width='6%'>[nCdProcesso]</td> \" +\r\n                                \"   <td width='11%' onclick='[onClickProcesso]' class='areaClique'>[sNomeProcesso]</td> \" +\r\n                                \"   <td width='10%'>[sNmApelido]</td> \" +\r\n                                \"   <td width='22%'>[sDsObjeto]</td> \" +\r\n                                \"   [colunasVariaveis] \" +\r\n                                \"</tr>\";\r\n\r\n                            switch (objParametroMural.tmpTipoMuralProcesso) {\r\n                                case enumTipoMuralProcesso.MURAL_ESTATISTICO:\r\n                                    var sColunas = \"<td width='6%'>[tDtEncerrado]</td> \";\r\n\r\n                                    if (bFlExibevlestimado == 1)\r\n                                        sColunas = sColunas + \"<td width='12%'>[dVlEstimado]</td> \";\r\n\r\n                                    sColunas += \"<td width='12%'>[dVlNegociado]</td> \";\r\n\r\n                                    if (bFlExibevleconomia == 1)\r\n                                        sColunas = sColunas + \"<td width='12%'>[dVlEconomia]</td> \";\r\n\r\n                                    if (bFlExibepercenteconomia == 1)\r\n                                        sColunas = sColunas + \"<td width='3%'>[dPcEconomia]</td>\";\r\n\r\n                                    templateTR = templateTR.split(\"[colunasVariaveis]\").join(sColunas);\r\n                                    break;\r\n                                case enumTipoMuralProcesso.EDITAL:\r\n                                    if (true) {\r\n                                        templateTR = templateTR.split(\"[colunasVariaveis]\").join(\r\n                                            \"<td width='10%'>[sNmModalidade]</td> \" +\r\n                                            \"<td width='15%'>[sNrEdital]</td> \" +\r\n                                            \"<td width='15%'>[sDsTitulo]</td>\" +\r\n                                            \"<td width='10%'>[sDsImagem]</td>\");\r\n                                    } else {\r\n                                        templateTR = templateTR.split(\"[colunasVariaveis]\").join(\r\n                                            \"<td width='10%'>[sNmModalidade]</td> \" +\r\n                                            \"<td width='15%'>[sNrEdital]</td>\" +\r\n                                            \"<td width='10%'>[sDsImagem]</td>\");\r\n                                    }\r\n\r\n                                    break;\r\n                                case enumTipoMuralProcesso.EDITAL_SIMPLIFICADO:\r\n                                    templateTR = \"<tr> \" +\r\n                                        \"   <td width='18%'>[sNrEdital]</td> \" +\r\n                                        \"   <td width='31%'>[sDsClasse]</td> \" +\r\n                                        \"   <td width='18%'>[sDtInicioVigencia]</td> \" +\r\n                                        \"   <td width='18%'>[sDtFimVigencia]</td> \" +\r\n                                        \"   <td width='15%'><button type='button' onclick='[onClickProcesso]' class='botao-detalhes'>\" + MURAL.RESOURCES.Mais_detalhes + \"</button></td>\" +\r\n                                        \"</tr>\";\r\n                                    if (oObjeto.sDsClasse == null)\r\n                                        templateTR = templateTR.split(\"[sDsClasse]\").join('');\r\n                                    else\r\n                                        templateTR = templateTR.split(\"[sDsClasse]\").join(oObjeto.sDsClasse);\r\n\r\n                                    if (oObjeto.sDtInicioVigencia == null)\r\n                                        templateTR = templateTR.split(\"[sDtInicioVigencia]\").join('');\r\n                                    else\r\n                                        templateTR = templateTR.split(\"[sDtInicioVigencia]\").join(oObjeto.sDtInicioVigencia.split(\" \", 1));\r\n\r\n                                    if (oObjeto.sDtFimVigencia == null)\r\n                                        templateTR = templateTR.split(\"[sDtFimVigencia]\").join(MURAL.RESOURCES.Indeterminado);\r\n                                    else\r\n                                        templateTR = templateTR.split(\"[sDtFimVigencia]\").join(oObjeto.sDtFimVigencia.split(\" \", 1));\r\n                                    break;\r\n                                case enumTipoMuralProcesso.PORTAL_DA_TRANSPARENCIA:\r\n                                    templateTR = templateTR.split(\"[colunasVariaveis]\").join(\r\n                                        \"<td width='10%'>[sGsSiglaRCARLC][sNmModalidade][sNmModalidadeTipo]</td>\" +\r\n                                        \"<td width='5%'>[sDsTitulo]</td>\" +\r\n                                        \"<td width='10%'>[sDsCriterio]</td>\" +\r\n                                        \"<td width='5%'>[sDsImagem]</td>\" +\r\n                                        \"<td width='10%'>[tDtEncerrado]</td>\" +\r\n                                        \"<td width='11%'>[dVlNegociado]</td>\");\r\n                                    if (oObjeto.sGsSiglaRCARLC == '\u0013\u0012\u0012\u0013')\r\n                                        templateTR = templateTR.split(\"[sGsSiglaRCARLC]\").join('');\r\n                                    else\r\n                                        templateTR = templateTR.split(\"[sGsSiglaRCARLC]\").join(oObjeto.sGsSiglaRCARLC);\r\n                                    \r\n                                    if (oObjeto.sNmModalidadeTipo == '\u0013\u0012\u0012\u0013')\r\n                                        templateTR = templateTR.split(\"[sNmModalidadeTipo]\").join('');\r\n                                    else\r\n                                        templateTR = templateTR.split(\"[sNmModalidadeTipo]\").join(oObjeto.sNmModalidadeTipo);\r\n                                    break;\r\n                                default:\r\n                                    var modalidadeLicitacao = oObjeto.sDsObservacao == \"\u0013\u0012\u0012\u0013\" ? \"<td width='19%'>[sNmModalidadeTipo]</td> \" : \"<td width='19%'>[sNmModalidadeTipo] (\" + oObjeto.sDsObservacao + \")</td> \"\r\n                                    var colunaModalidade = oObjeto.nCdModulo == MURAL.MODULO.Licitacao ? modalidadeLicitacao : \"<td width='19%'>[sNmModalidade]</td> \";\r\n                                    var sIconeEdital = \"   <span class='areaClique' onclick=\\\"[onClickResumoEdital]\\\"> \" +\r\n                                        \"     <a class='tooltip' data-title='\" + MURAL.RESOURCES.Resumo_do_processo + \"' > \" +\r\n                                                       \"         <img class='img-ponteiro' src='/portal/imagens/icon_edital_azul_16.png' />\" +\r\n                                        \"     </a>\" +\r\n                                        \"   </span>\";\r\n                                    templateTR = templateTR.split(\"[colunasVariaveis]\").join(\r\n                                        colunaModalidade +\r\n                                        \"<td width='14%'>[tDtInicial]</td> \" +\r\n                                        \"<td width='14%'>[tDtFinal]</td> \" +\r\n                                        \"<td width='2%' ><a class='tooltip' data-title='[sDsSituacao]' ><img src='../core/images/icones/[sDsImagem]'/></a>[sIconeEdital]</td>\");\r\n\r\n                                    if (oObjeto.nCdModulo == MURAL.MODULO.Cotacao)\r\n                                        templateTR = templateTR.split(\"[sIconeEdital]\").join(\"\");\r\n                                    else\r\n                                        templateTR = templateTR.split(\"[sIconeEdital]\").join(sIconeEdital);\r\n                                    break;\r\n                            }\r\n                            if (oObjeto.nCdModulo == MURAL.MODULO.PregaoPresencial && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.PORTAL_DA_TRANSPARENCIA)\r\n                                oObjeto.sNmModalidade = \"<div class='tooltip tooltip-aviso' data-title='\" + MURAL.RESOURCES.Tipo_de_modalidade + \": \" + oObjeto.sNmModalidadeTipo + \"' >\" + oObjeto.sNmModalidade + \"</div>\";\r\n\r\n                            templateTR = templateTR\r\n                                .split(\"[nCdProcesso]\").join(oObjeto.nCdProcesso)\r\n                                .split(oObjeto.nCdModulo == MURAL.MODULO.Licitacao ? \"[sNmModalidadeTipo]\" : \"[sNmModalidade]\").join(oObjeto.nCdModulo == MURAL.MODULO.Licitacao ? oObjeto.sNmModalidadeTipo : oObjeto.sNmModalidade)\r\n                                .split(\"[nAnoFinalizacao]\").join(oObjeto.nAnoFinalizacao)\r\n                                .split(\"[tDtEncerrado]\").join(formataDataHora(oObjeto.tDtEncerrado, false))\r\n                                .split(\"[dVlEstimado]\").join(formataValorMoeda(oObjeto.dVlEstimado, objConfiguracao.nQtDecimalQuantidade, oObjeto.sSgMoeda))\r\n                                .split(\"[dVlNegociado]\").join(formataValorMoeda(oObjeto.dVlNegociado, objConfiguracao.nQtDecimalQuantidade, oObjeto.sSgMoeda))\r\n                                .split(\"[dVlEconomia]\").join(formataValorMoeda(oObjeto.dVlEconomia, objConfiguracao.nQtDecimalQuantidade, oObjeto.sSgMoeda))\r\n                                .split(\"[dPcEconomia]\").join(formataValorMoeda(oObjeto.dPcEconomia, objConfiguracao.nQtDecimalPercentual) + '%')\r\n                                .split(\"[sDsSituacao]\").join(oObjeto.sDsSituacao)\r\n                                .split(\"[tDtInicial]\").join(formataDataHora(oObjeto.tDtInicial, false))\r\n                                .split(\"[sDsCriterio]\").join(oObjeto.sDsCriterio)\r\n                                .split(\"[tDtFinal]\").join(formataDataHora(oObjeto.tDtFinal, false))\r\n                                .split(\"[sDsImagem]\").join(oObjeto.sDsImagem);\r\n\r\n                            if (oObjeto.sDsTitulo == \"\")\r\n                                templateTR = templateTR.split(\"[sDsTitulo]\").join(MURAL.RESOURCES.Nao_informado);\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDsTitulo]\").join(oObjeto.sDsTitulo);\r\n\r\n                            if (oObjeto.sDsObjeto == '\u0013\u0012\u0012\u0013')\r\n                                templateTR = templateTR.split(\"[sDsObjeto]\").join('');\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDsObjeto]\").join(oObjeto.sDsObjeto + (oObjeto.nIdSuperSimples === 1 ? '<div style=\"background-color: #E6F4FF; padding: 3px; border: 1px solid #000; border-color: #91caff; color: #0998EA; border-radius: 5px; display: inline-block;\">' + MURAL.RESOURCES.Exclusivo_para_empresas_me_epp +'</div>' : ''));\r\n\r\n                            if (oObjeto.sNmApelido == '\u0013\u0012\u0012\u0013')\r\n                                templateTR = templateTR.split(\"[sNmApelido]\").join(oObjeto.sNmEmpresa);\r\n                            else\r\n                                templateTR = templateTR.split(\"[sNmApelido]\").join(oObjeto.sNmApelido);\r\n\r\n                            if (oObjeto.sNmModalidade == '\u0013\u0012\u0012\u0013')\r\n                                templateTR = templateTR.split(\"[sNmModalidade]\").join('');\r\n                            else\r\n                                templateTR = templateTR.split(\"[sNmModalidade]\").join(oObjeto.sNmModalidade);\r\n\r\n                            if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL) {\r\n\r\n                                if (oObjeto.sNrProcessoDisplay == '\u0012\u0013\u0013\u0012')\r\n                                    oObjeto.sNrProcessoDisplay = '';\r\n\r\n                                templateTR = templateTR\r\n                                    .split(\"[sNomeProcesso]\").join(oObjeto.sNrEdital)\r\n                                    .split(\"[sNrEdital]\").join(oObjeto.sNrProcessoDisplay);\r\n                            } else if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.PORTAL_DA_TRANSPARENCIA) {\r\n\r\n                                if (oObjeto.sNrProcessoDisplay == '\u0012\u0013\u0013\u0012')\r\n                                    oObjeto.sNrProcessoDisplay = '';\r\n\r\n                                templateTR = templateTR\r\n                                    .split(\"[sNomeProcesso]\").join(oObjeto.sNrEdital)\r\n                                    .split(\"[sNrEdital]\").join(oObjeto.sNrProcessoDisplay);\r\n                            }\r\n                            else {\r\n                                let sNomeProcessoElement = oObjeto.sNrProcessoDisplay;\r\n\r\n                                if (oObjeto.bFlRetificado) {\r\n                                    sNomeProcessoElement = \"<span>\" + oObjeto.sNrProcessoDisplay + \"</span>\" + \"<span class='badget-retificado'>Retificado</span>\"\r\n                                }\r\n\r\n                                templateTR = templateTR\r\n                                    .split(\"[sNomeProcesso]\").join(sNomeProcessoElement)\r\n                                    .split(\"[sNrEdital]\").join(oObjeto.sNrEdital);\r\n                            }\r\n                            \r\n                            // o onclick do template é delimitado por aspas simples: escapa ' e & para o nome do processo não fechar o atributo\r\n                            let sNrProcessoDisplayAtributo = JSON.stringify(oObjeto.sNrProcessoDisplay).replace(/&/g, \"&amp;\").replace(/'/g, \"&#39;\");\r\n                            templateTR = templateTR.split(\"[onClickProcesso]\").join(\"trListaMuralProcesso_Click(\" + oObjeto.nCdProcesso + \", \" + oObjeto.nCdModulo + \", \" + sNrProcessoDisplayAtributo + \", false)\");\r\n                            templateTR = templateTR.split(\"[onClickResumoEdital]\").join(\"trListaMuralResumoEdital_Click(\" + oObjeto.nCdProcesso + \", \" + oObjeto.nCdModulo + \", \" + oObjeto.nCdOrigem + \", true)\");\r\n\r\n                            $(\"#trListaMuralProcesso\").append(templateTR);\r\n                        });\r\n                    }\r\n\r\n                    setTimeout(function () { objParametroMural.bDisparou = false; $(window).scroll(ChegouFinalScroll); }, 500);\r\n\r\n                    if (_bProcurar)\r\n                        setTimeout(function () { $(\"#areaFiltro\").trigger(\"mouseleave\"); }, 500);\r\n                                           \r\n                    $(\"#carregandoLista\").hide();\r\n                    if (objParametroMural.bAbreItemAutomatico && !objParametroMural.bAbriuItemAutomatico) {\r\n                        setTimeout(function () {\r\n                            var nCdModulo = 0;\r\n                            var nCdEdital = -2147483648;\r\n                            var sDsProcesso = \"\";\r\n                            var nCdProcesso = 0;\r\n\r\n                            if (Object.keys(queryData).length > 0) {\r\n\r\n                if (queryData[\"ncdmodulo\"] != undefined)\r\n                    nCdModulo = queryData[\"ncdmodulo\"];\r\n                if (queryData[\"ncdedital\"] != undefined)\r\n                    nCdEdital = queryData[\"ncdedital\"];\r\n                if (queryData[\"ncdprocesso\"] != undefined)\r\n                    nCdProcesso = queryData[\"ncdprocesso\"];\r\n\r\n                if (queryData[\"scdprocesso\"] != undefined)\r\n                    nCdProcesso = queryData[\"scdprocesso\"];\r\n                else if (queryData[\"sdsprocesso\"] != undefined)\r\n                    sDsProcesso = queryData[\"sdsprocesso\"];                            } else {\r\n                                nCdModulo = arrMuralProcesso[0].nCdModulo;\r\n                                nCdProcesso = arrMuralProcesso[0].nCdProcesso;\r\n                            }\r\n                            \r\n                            trListaMuralProcesso_Click(nCdProcesso, nCdModulo, decodeURI(sDsProcesso), true, nCdEdital);\r\n                            objParametroMural.bAbreItemAutomatico = false;\r\n                            objParametroMural.bAbriuItemAutomatico = true;\r\n                        }, 100);\r\n                    }\r\n\r\n                    if (adquirirCookie(\"CK_VISAO\") != \"\") {\r\n                        $(\"#ddlVisoes\").val(adquirirCookie(\"CK_VISAO\", \"/\"));\r\n                        $.uniform.update(\"#ddlVisoes\");\r\n                        $(\".campoSelect\").parent().find(\"span:first\").css(\"width\", \"245px\");\r\n                        $(\".selector\").css(\"width\", \"\");\r\n                    }\r\n\r\n                    removerCookie(\"CK_PROCESSO\", \"/\");\r\n                    removerCookie(\"CK_MODULO\", \"/\");\r\n                    removerCookie(\"CK_VISAO\", \"/\");\r\n                    removerCookie(\"CK_ORDENAR_POR\", \"/\");\r\n                },\r\n                function () {\r\n                    $(\"#carregandoLista\").hide();\r\n                }\r\n            );\r\n        }\r\n\r\n        function ExpandirConsultores() {\r\n            $(\"#tbEditais\").hide();\r\n            $(\"#tbEditaisEncerrados\").hide();\r\n            $(\"#tbRfiEmAndamento\").hide();\r\n            $(\"#tbRfiEncerradas\").hide();\r\n            $(\"#trConsultores\").html('');\r\n            $(\"#btnExpandirConsultores\").remove();\r\n            $(\"#btVoltarGrid\").show();\r\n            objParametroMural.nPaginaAte = 50;\r\n            bFlExpandeScroll = true;\r\n            PesquisarConsultores();\r\n        }\r\n\r\n        function ExpandirProcessosEmAndamento() {\r\n            $(\"#tbConsultores\").hide();\r\n            $(\"#tbEditaisEncerrados\").hide();\r\n            $(\"#tbRfiEmAndamento\").hide();\r\n            $(\"#tbRfiEncerradas\").hide();\r\n            $(\"#trListaMuralProcesso\").html('');\r\n            $(\"#btnExpandirProcessosEmAndamento\").remove();\r\n            $(\"#btVoltarGrid\").show();\r\n            objParametroMural.nPaginaAte = 50;\r\n            bFlExpandeScroll = true;\r\n            PesquisarProcessosEmAndamento();\r\n        }\r\n\r\n        function ExpandirProcessosEncerrados() {\r\n            $(\"#tbConsultores\").hide();\r\n            $(\"#tbEditais\").hide();\r\n            $(\"#tbRfiEmAndamento\").hide();\r\n            $(\"#tbRfiEncerradas\").hide();\r\n            $(\"#trListaEditaisEncerrados\").html('');\r\n            $(\"#btnExpandirProcessosEncerrados\").remove();\r\n            $(\"#btVoltarGrid\").show();\r\n            objParametroMural.nPaginaAte = 50;\r\n            bFlExpandeScroll = true;\r\n            PesquisarProcessosEncerrados();\r\n        }\r\n\r\n        function ExpandirRfiEmAndamento() {\r\n            $(\"#tbConsultores\").hide();\r\n            $(\"#tbEditais\").hide();\r\n            $(\"#tbEditaisEncerrados\").hide();\r\n            $(\"#tbRfiEncerradas\").hide();\r\n            $(\"#trRfiEmAndamento\").html('');\r\n            $(\"#btnExpandirRfiEmAndamento\").remove();\r\n            $(\"#btVoltarGrid\").show();\r\n            objParametroMural.nPaginaAte = 50;\r\n            bFlExpandeScroll = true;\r\n            PesquisarRfiEmAndamento();\r\n        }\r\n\r\n        function ExpandirRfiEncerrados() {\r\n            $(\"#tbConsultores\").hide();\r\n            $(\"#tbEditais\").hide();\r\n            $(\"#tbEditaisEncerrados\").hide();\r\n            $(\"#tbRfiEmAndamento\").hide();\r\n            $(\"#trRfiEncerrados\").html('');\r\n            $(\"#btnExpandirRfiEncerrados\").remove();\r\n            $(\"#btVoltarGrid\").show();\r\n            objParametroMural.nPaginaAte = 50;\r\n            bFlExpandeScroll = true;\r\n            PesquisarRfiEncerrados();\r\n        }\r\n\r\n        function PesquisarConsultores() {\r\n            var sNomeMetodoWebService = \"PesquisarProcessosEditalSimplificado\";\r\n            objParametroMural.tmpTipoMuralProcesso = enumTipoMuralProcesso.EDITAL_SIMPLIFICADO;\r\n\r\n            var dtoProcesso = {\r\n                tmpTipoMuralProcesso: objParametroMural.tmpTipoMuralProcesso,\r\n                sOrdenarPor: objParametroMural.sOrdenarPor,\r\n                sOrdenarPorDirecao: objParametroMural.sOrdenarPorDirecao,\r\n                dtoPaginacao: {\r\n                    nPaginaDe: objParametroMural.nPaginaDe,\r\n                    nPaginaAte: objParametroMural.nPaginaAte\r\n                },\r\n                dtoIdioma: {\r\n                    nCdIdioma: adquirirIdIdioma(\"/\")\r\n                },\r\n                bFlPesquisaFornecedores: true\r\n            };\r\n\r\n            chamadaWebService(\r\n                \"WebService/Servicos.asmx/\" + sNomeMetodoWebService,\r\n                \"dtoProcesso:\" + JSON.stringify(dtoProcesso),\r\n                function (_retorno) {\r\n\r\n                    var arrRetorno = _retorno.d;\r\n                    if (arrRetorno.length <= 0) {\r\n\r\n                        if (objParametroMural.nPaginaDe == 1) {\r\n                            arrMuralProcesso = [];\r\n                            $(\"#trConsultores\").children().remove();\r\n                            $(\"#trConsultores\").append(\"<tr style='height:150px'><td colspan='8' style='text-align:center;'>\" + MURAL.RESOURCES.Nenhum_registro_encontrado + \"</td></tr>\");\r\n                        }\r\n                    }\r\n                    else {\r\n                        $(\"#btnExpandirConsultores\").show();\r\n                        $(\"#divPainelMural\").css(\"height\", \"\");\r\n\r\n                        $(arrRetorno).each(function () {\r\n                            var oObjeto = this;\r\n                            arrMuralProcesso.push(oObjeto);\r\n                            var templateTR = \"<tr> \" +\r\n                                \"   <td width='20%' onclick='[onClickProcesso]' class='areaClique'>[sNrEdital]</td> \" +\r\n                                \"   <td width='18%'>[sDsClasse]</td> \" +\r\n                                \"   <td width='28%'>[sNmEmpresa]</td> \" +\r\n                                \"   <td width='10%' class='tdDate'>[sDtAprovacao]</td> \" +\r\n                                \"   <td width='10%' class='tdDate'>[sDtVigencia]</td> \" +\r\n                                \"   <td width='14%' class='tdDate'>[sDsSituacao]</td> \" +\r\n                                \"</tr>\";\r\n\r\n\r\n                            if (oObjeto.sDtVigencia == null)\r\n                                templateTR = templateTR.split(\"[sDtVigencia]\").join(MURAL.RESOURCES.Indeterminado);\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDtVigencia]\").join(oObjeto.sDtVigencia.split(\" \", 1));\r\n\r\n                            if (oObjeto.sDtAprovacao == null)\r\n                                templateTR = templateTR.split(\"[sDtAprovacao]\").join('');\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDtAprovacao]\").join(oObjeto.sDtAprovacao.split(\" \", 1));\r\n\r\n                                templateTR = templateTR.split(\"[sDsSituacao]\").join(oObjeto.sDsSituacao);\r\n\r\n                                templateTR = templateTR.split(\"[sDsClasse]\").join(oObjeto.sDsClasse);\r\n\r\n                                templateTR = templateTR.split(\"[sDsSituacao]\").join(oObjeto.sDsSituacao);\r\n\r\n                                templateTR = templateTR.split(\"[sNmEmpresa]\").join(oObjeto.sNmEmpresa);\r\n\r\n                                templateTR = templateTR.split(\"[sNrEdital]\").join(oObjeto.sNrEdital);\r\n\r\n                            templateTR = templateTR.split(\"[onClickProcesso]\").join(`CarregarCadastroFornecedor(${kendo.stringify(oObjeto)})`);\r\n\r\n                            $(\"#trConsultores\").append(templateTR);\r\n                        });\r\n                    }\r\n\r\n                    setTimeout(function () { objParametroMural.bDisparou = false; $(window).scroll(ChegouFinalScroll); }, 500);\r\n                    $(\"#carregandoLista\").hide();\r\n                },\r\n                function () {\r\n                    $(\"#carregandoLista\").hide();\r\n                }\r\n            );\r\n\r\n        }\r\n\r\n        function PesquisarProcessosEmAndamento() {\r\n            $(\".comum, .mural, .mural-estatistico, .edital, .portalTransparencia\").hide();\r\n            $(\"#areaFiltro\").hide();    \r\n            $(\".edital-simplificado\").show();\r\n            $(\"#carregandoLista\").show();\r\n            $(\"#btVoltarInicio\").hide();\r\n            var sNomeMetodoWebService = \"PesquisarProcessosEditalSimplificado\";\r\n            objParametroMural.tmpTipoMuralProcesso = enumTipoMuralProcesso.EDITAL_SIMPLIFICADO;\r\n\r\n            var dtoProcesso = {\r\n                tmpTipoMuralProcesso: objParametroMural.tmpTipoMuralProcesso,\r\n                nCdEmpresa: isNaN(Number($(\"#ddlEmpresaUnidadeCompradora option:selected\").val())) ? 0 : Number($(\"#ddlEmpresaUnidadeCompradora option:selected\").val()),\r\n                sOrdenarPor: objParametroMural.sOrdenarPor,\r\n                sOrdenarPorDirecao: objParametroMural.sOrdenarPorDirecao,\r\n                dtoPaginacao: {\r\n                    nPaginaDe: objParametroMural.nPaginaDe,\r\n                    nPaginaAte: objParametroMural.nPaginaAte\r\n                },\r\n                dtoIdioma: {\r\n                    nCdIdioma: adquirirIdIdioma(\"/\")\r\n                },\r\n                bFlEmAndamento: true,\r\n                nCdEditalTipo: 2,\r\n                bFlPesquisaFornecedores: false\r\n            };\r\n\r\n            chamadaWebService(\r\n                \"WebService/Servicos.asmx/\" + sNomeMetodoWebService,\r\n                \"dtoProcesso:\" + JSON.stringify(dtoProcesso),\r\n                function (_retorno) {\r\n                    \r\n                    var arrRetorno = _retorno.d;\r\n                    if (arrRetorno.length <= 0) {\r\n\r\n                        if (objParametroMural.nPaginaDe == 1) {\r\n                            arrMuralProcesso = [];\r\n                            $(\"#trListaMuralProcesso\").children().remove();\r\n                            $(\"#trListaMuralProcesso\").append(\"<tr style='height:150px'><td colspan='8' style='text-align:center;'>\" + MURAL.RESOURCES.Nenhum_registro_encontrado + \"</td></tr>\");\r\n                        }\r\n                    }\r\n                    else {\r\n                        $(\"#btnExpandirProcessosEmAndamento\").show();\r\n                        $(\"#divPainelMural\").css(\"height\", \"\");\r\n\r\n                        $(arrRetorno).each(function () {\r\n                            var oObjeto = this;\r\n                            arrMuralProcesso.push(oObjeto);\r\n                            var templateTR = \"<tr> \" +\r\n                                \"   <td width='20%' onclick='[onClickProcesso]' class='areaClique' >[sNrEdital]</td> \" +\r\n                                \"   <td width='40%'>[sDsClasse]</td> \" +\r\n                                \"   <td width='20%' class='tdDate'>[sDtInicioVigencia]</td> \" +\r\n                                \"   <td width='20%' class='tdDate'>[sDtFimVigencia]</td> \" +\r\n                                \"</tr>\";\r\n                            if (oObjeto.sDsClasse == null)\r\n                                templateTR = templateTR.split(\"[sDsClasse]\").join('');\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDsClasse]\").join(oObjeto.sDsClasse);\r\n\r\n                            if (oObjeto.sDtInicioVigencia == null)\r\n                                templateTR = templateTR.split(\"[sDtInicioVigencia]\").join('');\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDtInicioVigencia]\").join(oObjeto.sDtInicioVigencia.split(\" \", 1));\r\n\r\n                            if (oObjeto.sDtFimVigencia == null)\r\n                                templateTR = templateTR.split(\"[sDtFimVigencia]\").join(MURAL.RESOURCES.Indeterminado);\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDtFimVigencia]\").join(oObjeto.sDtFimVigencia.split(\" \", 1));\r\n\r\n                            if (oObjeto.nCdModulo == MURAL.MODULO.PregaoPresencial && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL)\r\n                                oObjeto.sNmModalidade = \"<div class='tooltip tooltip-aviso' data-title='\" + MURAL.RESOURCES.Tipo_de_modalidade + \": \" + oObjeto.sNmModalidadeTipo + \"' >\" + oObjeto.sNmModalidade + \"</div>\";\r\n\r\n                            templateTR = templateTR\r\n                                .split(\"[nCdProcesso]\").join(oObjeto.nCdProcesso)\r\n                                .split(\"[sNmModalidade]\").join(oObjeto.sNmModalidade)\r\n                                .split(\"[nAnoFinalizacao]\").join(oObjeto.nAnoFinalizacao)\r\n                                .split(\"[tDtEncerrado]\").join(formataDataHora(oObjeto.tDtEncerrado, false))\r\n                                .split(\"[dVlEstimado]\").join(formataValorMoeda(oObjeto.dVlEstimado, objConfiguracao.nQtDecimalQuantidade, oObjeto.sSgMoeda))\r\n                                .split(\"[dVlNegociado]\").join(formataValorMoeda(oObjeto.dVlNegociado, objConfiguracao.nQtDecimalQuantidade, oObjeto.sSgMoeda))\r\n                                .split(\"[dVlEconomia]\").join(formataValorMoeda(oObjeto.dVlEconomia, objConfiguracao.nQtDecimalQuantidade, oObjeto.sSgMoeda))\r\n                                .split(\"[dPcEconomia]\").join(formataValorMoeda(oObjeto.dPcEconomia, objConfiguracao.nQtDecimalPercentual) + '%')\r\n                                .split(\"[sDsSituacao]\").join(oObjeto.sDsSituacao)\r\n                                .split(\"[tDtInicial]\").join(formataDataHora(oObjeto.tDtInicial, false))\r\n                                .split(\"[tDtFinal]\").join(formataDataHora(oObjeto.tDtFinal, false))\r\n                                .split(\"[sDsImagem]\").join(oObjeto.sDsImagem);\r\n\r\n                            if (oObjeto.sDsTitulo == \"\")\r\n                                templateTR = templateTR.split(\"[sDsTitulo]\").join(MURAL.RESOURCES.Nao_informado);\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDsTitulo]\").join(oObjeto.sDsTitulo);\r\n\r\n                            if (oObjeto.sDsObjeto == '\u0013\u0012\u0012\u0013')\r\n                                templateTR = templateTR.split(\"[sDsObjeto]\").join('');\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDsObjeto]\").join(oObjeto.sDsObjeto);\r\n\r\n                            if (oObjeto.sNmApelido == '\u0013\u0012\u0012\u0013')\r\n                                templateTR = templateTR.split(\"[sNmApelido]\").join(oObjeto.sNmEmpresa);\r\n                            else\r\n                                templateTR = templateTR.split(\"[sNmApelido]\").join(oObjeto.sNmApelido);\r\n\r\n                            if (oObjeto.sNmModalidade == '\u0013\u0012\u0012\u0013')\r\n                                templateTR = templateTR.split(\"[sNmModalidade]\").join('');\r\n                            else\r\n                                templateTR = templateTR.split(\"[sNmModalidade]\").join(oObjeto.sNmModalidade);\r\n\r\n                            if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL) {\r\n\r\n                                if (oObjeto.sNrProcessoDisplay == '\u0012\u0013\u0013\u0012')\r\n                                    oObjeto.sNrProcessoDisplay = '';\r\n\r\n                                templateTR = templateTR\r\n                                    .split(\"[sNomeProcesso]\").join(oObjeto.sNrEdital)\r\n                                    .split(\"[sNrEdital]\").join(oObjeto.sNrProcessoDisplay);\r\n                            }\r\n                            else {\r\n                                templateTR = templateTR\r\n                                    .split(\"[sNomeProcesso]\").join(oObjeto.sNrProcessoDisplay)\r\n                                    .split(\"[sNrEdital]\").join(oObjeto.sNrEdital);\r\n                            }\r\n                            \r\n                            templateTR = templateTR.split(\"[onClickProcesso]\").join(\"trListaMuralProcesso_Click(\" + oObjeto.nCdProcesso + \", \" + oObjeto.nCdModulo + \",\\\"\\\",true)\");\r\n                            templateTR = templateTR.split(\"[onClickResumoEdital]\").join(\"trListaMuralResumoEdital_Click(\" + oObjeto.nCdProcesso + \", \" + oObjeto.nCdModulo + \", \" + oObjeto.nCdOrigem + \", true)\");\r\n\r\n                            $(\"#trListaMuralProcesso\").append(templateTR);\r\n                        });\r\n                        $(\".botao-expandir\").show();\r\n                    }\r\n\r\n                    setTimeout(function () { objParametroMural.bDisparou = false; $(window).scroll(ChegouFinalScroll); }, 500);\r\n\r\n\r\n                    $(\"#carregandoLista\").hide();\r\n                },\r\n                function () {\r\n                    $(\"#carregandoLista\").hide();\r\n                }\r\n            );\r\n        }\r\n\r\n        function PesquisarProcessosEncerrados() {\r\n\r\n            var sNomeMetodoWebService = \"PesquisarProcessosEditalSimplificado\";\r\n            objParametroMural.tmpTipoMuralProcesso = enumTipoMuralProcesso.EDITAL_SIMPLIFICADO;\r\n\r\n            var dtoProcesso = {\r\n                tmpTipoMuralProcesso: objParametroMural.tmpTipoMuralProcesso,\r\n                nCdEmpresa: isNaN(Number($(\"#ddlEmpresaUnidadeCompradora option:selected\").val())) ? 0 : Number($(\"#ddlEmpresaUnidadeCompradora option:selected\").val()),\r\n                sOrdenarPor: objParametroMural.sOrdenarPor,\r\n                sOrdenarPorDirecao: objParametroMural.sOrdenarPorDirecao,\r\n                dtoPaginacao: {\r\n                    nPaginaDe: objParametroMural.nPaginaDe,\r\n                    nPaginaAte: objParametroMural.nPaginaAte\r\n                },\r\n                dtoIdioma: {\r\n                    nCdIdioma: adquirirIdIdioma(\"/\")\r\n                },\r\n                bFlEmAndamento: false,\r\n                nCdEditalTipo: 2,\r\n                bFlPesquisaFornecedores: false\r\n            };\r\n\r\n            chamadaWebService(\r\n                \"WebService/Servicos.asmx/\" + sNomeMetodoWebService,\r\n                \"dtoProcesso:\" + JSON.stringify(dtoProcesso),\r\n                function (_retorno) {\r\n                    \r\n                    var arrRetorno = _retorno.d;\r\n                    if (arrRetorno.length <= 0) {\r\n\r\n                        if (objParametroMural.nPaginaDe == 1) {\r\n                            arrMuralProcesso = [];\r\n                            $(\"#trListaEditaisEncerrados\").children().remove();\r\n                            $(\"#trListaEditaisEncerrados\").append(\"<tr style='height:150px'><td colspan='8' style='text-align:center;'>\" + MURAL.RESOURCES.Nenhum_registro_encontrado + \"</td></tr>\");\r\n                        }\r\n                    }\r\n                    else {\r\n\r\n                        $(\"#btnExpandirProcessosEncerrados\").show();\r\n                        $(\"#divPainelMural\").css(\"height\", \"\");\r\n\r\n                        $(arrRetorno).each(function () {\r\n                            var oObjeto = this;\r\n                            arrMuralProcesso.push(oObjeto);\r\n                            var templateTR = \"<tr> \" +\r\n                                \"   <td width='20%' onclick='[onClickProcesso]' class='areaClique' >[sNrEdital]</td> \" +\r\n                                \"   <td width='40%'>[sDsClasse]</td> \" +\r\n                                \"   <td width='20%' class='tdDate'>[sDtInicioVigencia]</td> \" +\r\n                                \"   <td width='20%' class='tdDate'>[sDtFimVigencia]</td> \" +\r\n                                \"</tr>\";\r\n                            if (oObjeto.sDsClasse == null)\r\n                                templateTR = templateTR.split(\"[sDsClasse]\").join('');\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDsClasse]\").join(oObjeto.sDsClasse);\r\n\r\n                            if (oObjeto.sDtInicioVigencia == null)\r\n                                templateTR = templateTR.split(\"[sDtInicioVigencia]\").join('');\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDtInicioVigencia]\").join(oObjeto.sDtInicioVigencia.split(\" \", 1));\r\n\r\n                            if (oObjeto.sDtFimVigencia == null)\r\n                                templateTR = templateTR.split(\"[sDtFimVigencia]\").join(MURAL.RESOURCES.Indeterminado);\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDtFimVigencia]\").join(oObjeto.sDtFimVigencia.split(\" \", 1));\r\n\r\n                       \r\n\r\n                            if (oObjeto.nCdModulo == MURAL.MODULO.PregaoPresencial && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL)\r\n                                oObjeto.sNmModalidade = \"<div class='tooltip tooltip-aviso' data-title='\" + MURAL.RESOURCES.Tipo_de_modalidade + \": \" + oObjeto.sNmModalidadeTipo + \"' >\" + oObjeto.sNmModalidade + \"</div>\";\r\n\r\n                            templateTR = templateTR\r\n                                .split(\"[nCdProcesso]\").join(oObjeto.nCdProcesso)\r\n                                .split(\"[sNmModalidade]\").join(oObjeto.sNmModalidade)\r\n                                .split(\"[nAnoFinalizacao]\").join(oObjeto.nAnoFinalizacao)\r\n                                .split(\"[tDtEncerrado]\").join(formataDataHora(oObjeto.tDtEncerrado, false))\r\n                                .split(\"[dVlEstimado]\").join(formataValorMoeda(oObjeto.dVlEstimado, objConfiguracao.nQtDecimalQuantidade, oObjeto.sSgMoeda))\r\n                                .split(\"[dVlNegociado]\").join(formataValorMoeda(oObjeto.dVlNegociado, objConfiguracao.nQtDecimalQuantidade, oObjeto.sSgMoeda))\r\n                                .split(\"[dVlEconomia]\").join(formataValorMoeda(oObjeto.dVlEconomia, objConfiguracao.nQtDecimalQuantidade, oObjeto.sSgMoeda))\r\n                                .split(\"[dPcEconomia]\").join(formataValorMoeda(oObjeto.dPcEconomia, objConfiguracao.nQtDecimalPercentual) + '%')\r\n                                .split(\"[sDsSituacao]\").join(oObjeto.sDsSituacao)\r\n                                .split(\"[tDtInicial]\").join(formataDataHora(oObjeto.tDtInicial, false))\r\n                                .split(\"[tDtFinal]\").join(formataDataHora(oObjeto.tDtFinal, false))\r\n                                .split(\"[sDsImagem]\").join(oObjeto.sDsImagem);\r\n\r\n                            if (oObjeto.sDsTitulo == \"\")\r\n                                templateTR = templateTR.split(\"[sDsTitulo]\").join(MURAL.RESOURCES.Nao_informado);\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDsTitulo]\").join(oObjeto.sDsTitulo);\r\n\r\n                            if (oObjeto.sDsObjeto == '\u0013\u0012\u0012\u0013')\r\n                                templateTR = templateTR.split(\"[sDsObjeto]\").join('');\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDsObjeto]\").join(oObjeto.sDsObjeto);\r\n\r\n                            if (oObjeto.sNmApelido == '\u0013\u0012\u0012\u0013')\r\n                                templateTR = templateTR.split(\"[sNmApelido]\").join(oObjeto.sNmEmpresa);\r\n                            else\r\n                                templateTR = templateTR.split(\"[sNmApelido]\").join(oObjeto.sNmApelido);\r\n\r\n                            if (oObjeto.sNmModalidade == '\u0013\u0012\u0012\u0013')\r\n                                templateTR = templateTR.split(\"[sNmModalidade]\").join('');\r\n                            else\r\n                                templateTR = templateTR.split(\"[sNmModalidade]\").join(oObjeto.sNmModalidade);\r\n\r\n                            if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL) {\r\n\r\n                                if (oObjeto.sNrProcessoDisplay == '\u0012\u0013\u0013\u0012')\r\n                                    oObjeto.sNrProcessoDisplay = '';\r\n\r\n                                templateTR = templateTR\r\n                                    .split(\"[sNomeProcesso]\").join(oObjeto.sNrEdital)\r\n                                    .split(\"[sNrEdital]\").join(oObjeto.sNrProcessoDisplay);\r\n                            }\r\n                            else {\r\n                                templateTR = templateTR\r\n                                    .split(\"[sNomeProcesso]\").join(oObjeto.sNrProcessoDisplay)\r\n                                    .split(\"[sNrEdital]\").join(oObjeto.sNrEdital);\r\n                            }\r\n                            \r\n                            templateTR = templateTR.split(\"[onClickProcesso]\").join(\"trListaMuralProcesso_Click(\" + oObjeto.nCdProcesso + \", \" + oObjeto.nCdModulo + \",\\\"\\\",true)\");\r\n                            templateTR = templateTR.split(\"[onClickResumoEdital]\").join(\"trListaMuralResumoEdital_Click(\" + oObjeto.nCdProcesso + \", \" + oObjeto.nCdModulo + \", \" + oObjeto.nCdOrigem + \", true)\");\r\n\r\n                           $(\"#trListaEditaisEncerrados\").append(templateTR);\r\n                        });\r\n                    }\r\n\r\n                    setTimeout(function () { objParametroMural.bDisparou = false; $(window).scroll(ChegouFinalScroll); }, 500);\r\n\r\n                    \r\n                    $(\"#carregandoLista\").hide();\r\n                },\r\n                function () {\r\n                    $(\"#carregandoLista\").hide();\r\n                }\r\n            );\r\n        }\r\n\r\n        function PesquisarRfiEmAndamento() {\r\n            var sNomeMetodoWebService = \"PesquisarProcessosEditalSimplificado\";\r\n            objParametroMural.tmpTipoMuralProcesso = enumTipoMuralProcesso.EDITAL_SIMPLIFICADO;\r\n            \r\n            var dtoProcesso = {\r\n                tmpTipoMuralProcesso: objParametroMural.tmpTipoMuralProcesso,\r\n                nCdEmpresa: isNaN(Number($(\"#ddlEmpresaUnidadeCompradora option:selected\").val())) ? 0 : Number($(\"#ddlEmpresaUnidadeCompradora option:selected\").val()),\r\n                sOrdenarPor: objParametroMural.sOrdenarPor,\r\n                sOrdenarPorDirecao: objParametroMural.sOrdenarPorDirecao,\r\n                dtoPaginacao: {\r\n                    nPaginaDe: objParametroMural.nPaginaDe,\r\n                    nPaginaAte: objParametroMural.nPaginaAte\r\n                },\r\n                dtoIdioma: {\r\n                    nCdIdioma: adquirirIdIdioma(\"/\")\r\n                },\r\n                bFlEmAndamento: true,\r\n                nCdEditalTipo: 3,\r\n                bFlPesquisaFornecedores: false\r\n            };\r\n\r\n            chamadaWebService(\r\n                \"WebService/Servicos.asmx/\" + sNomeMetodoWebService,\r\n                \"dtoProcesso:\" + JSON.stringify(dtoProcesso),\r\n                function (_retorno) {\r\n                    \r\n                    var arrRetorno = _retorno.d;\r\n                    if (arrRetorno.length <= 0) {\r\n\r\n                        if (objParametroMural.nPaginaDe == 1) {\r\n                            arrMuralProcesso = [];\r\n                            $(\"#trRfiEmAndamento\").children().remove();\r\n                            $(\"#trRfiEmAndamento\").append(\"<tr style='height:150px'><td colspan='8' style='text-align:center;'>\" + MURAL.RESOURCES.Nenhum_registro_encontrado + \"</td></tr>\");\r\n                        }\r\n                    }\r\n                    else {\r\n                        $(\"#btnExpandirRfiEmAndamento\").show();\r\n                        $(\"#divPainelMural\").css(\"height\", \"\");\r\n\r\n                        $(arrRetorno).each(function () {\r\n                            var oObjeto = this;\r\n                            arrMuralProcesso.push(oObjeto);\r\n                            var templateTR = \"<tr> \" +\r\n                                \"   <td width='20%' onclick='[onClickProcesso]' class='areaClique'>[sNrEdital]</td> \" +\r\n                                \"   <td width='40%'>[sDsObjeto]</td> \" +\r\n                                \"   <td width='20%' class='tdDate'>[sDtInicioVigencia]</td> \" +\r\n                                \"   <td width='20%' class='tdDate'>[sDtFimVigencia]</td> \" +\r\n                                \"</tr>\";\r\n\r\n                            TR = templateTR.split(\"[sDsClasse]\").join(oObjeto.sDsClasse);\r\n\r\n                            if (oObjeto.sDtInicioVigencia == null)\r\n                                templateTR = templateTR.split(\"[sDtInicioVigencia]\").join('');\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDtInicioVigencia]\").join(oObjeto.sDtInicioVigencia.split(\" \", 1));\r\n\r\n                            if (oObjeto.sDtFimVigencia == null)\r\n                                templateTR = templateTR.split(\"[sDtFimVigencia]\").join(MURAL.RESOURCES.Indeterminado);\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDtFimVigencia]\").join(oObjeto.sDtFimVigencia.split(\" \", 1));\r\n\r\n                            if (oObjeto.sDsObjeto == '\u0013\u0012\u0012\u0013')\r\n                                templateTR = templateTR.split(\"[sDsObjeto]\").join('');\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDsObjeto]\").join(oObjeto.sDsObjeto);\r\n\r\n                            templateTR = templateTR\r\n                                .split(\"[sNrEdital]\").join(oObjeto.sNrEdital);\r\n                            \r\n                            templateTR = templateTR.split(\"[onClickProcesso]\").join(\"trListaMuralProcesso_Click(\" + oObjeto.nCdProcesso + \", \" + oObjeto.nCdModulo + \",\\\"\\\",true)\");\r\n\r\n                            $(\"#trRfiEmAndamento\").append(templateTR);\r\n                        });\r\n                    }\r\n\r\n                    setTimeout(function () { objParametroMural.bDisparou = false; $(window).scroll(ChegouFinalScroll); }, 500);\r\n\r\n                    $(\"#carregandoLista\").hide();\r\n                },\r\n                function () {\r\n                    $(\"#carregandoLista\").hide();\r\n                }\r\n            );\r\n        }\r\n\r\n        function PesquisarRfiEncerrados() {\r\n            var sNomeMetodoWebService = \"PesquisarProcessosEditalSimplificado\";\r\n            objParametroMural.tmpTipoMuralProcesso = enumTipoMuralProcesso.EDITAL_SIMPLIFICADO;\r\n\r\n            var dtoProcesso = {\r\n                tmpTipoMuralProcesso: objParametroMural.tmpTipoMuralProcesso,\r\n                nCdEmpresa: isNaN(Number($(\"#ddlEmpresaUnidadeCompradora option:selected\").val())) ? 0 : Number($(\"#ddlEmpresaUnidadeCompradora option:selected\").val()),\r\n                sOrdenarPor: objParametroMural.sOrdenarPor,\r\n                sOrdenarPorDirecao: objParametroMural.sOrdenarPorDirecao,\r\n                dtoPaginacao: {\r\n                    nPaginaDe: objParametroMural.nPaginaDe,\r\n                    nPaginaAte: objParametroMural.nPaginaAte\r\n                },\r\n                dtoIdioma: {\r\n                    nCdIdioma: adquirirIdIdioma(\"/\")\r\n                },\r\n                bFlEmAndamento: false,\r\n                nCdEditalTipo: 3,\r\n                bFlPesquisaFornecedores: false\r\n            };\r\n\r\n            chamadaWebService(\r\n                \"WebService/Servicos.asmx/\" + sNomeMetodoWebService,\r\n                \"dtoProcesso:\" + JSON.stringify(dtoProcesso),\r\n                function (_retorno) {\r\n                    \r\n                    var arrRetorno = _retorno.d;\r\n                    if (arrRetorno.length <= 0) {\r\n\r\n                        if (objParametroMural.nPaginaDe == 1) {\r\n                            arrMuralProcesso = [];\r\n                            $(\"#trRfiEncerrados\").children().remove();\r\n                            $(\"#trRfiEncerrados\").append(\"<tr style='height:150px'><td colspan='8' style='text-align:center;'>\" + MURAL.RESOURCES.Nenhum_registro_encontrado + \"</td></tr>\");\r\n                        }\r\n                    }\r\n                    else {\r\n                        $(\"#btnExpandirRfiEncerrados\").show();\r\n                        $(\"#divPainelMural\").css(\"height\", \"\");\r\n\r\n                        $(arrRetorno).each(function () {\r\n                            var oObjeto = this;\r\n                            arrMuralProcesso.push(oObjeto);\r\n                            var templateTR = \"<tr> \" +\r\n                                \"   <td width='20%' onclick='[onClickProcesso]' class='areaClique'>[sNrEdital]</td> \" +\r\n                                \"   <td width='40%'>[sDsObjeto]</td> \" +\r\n                                \"   <td width='20%' class='tdDate'>[sDtInicioVigencia]</td> \" +\r\n                                \"   <td width='20%' class='tdDate'>[sDtFimVigencia]</td> \" +\r\n                                \"</tr>\"; TR = templateTR.split(\"[sDsClasse]\").join(oObjeto.sDsClasse);\r\n\r\n                            if (oObjeto.sDtInicioVigencia == null)\r\n                                templateTR = templateTR.split(\"[sDtInicioVigencia]\").join('');\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDtInicioVigencia]\").join(oObjeto.sDtInicioVigencia.split(\" \", 1));\r\n\r\n                            if (oObjeto.sDtFimVigencia == null)\r\n                                templateTR = templateTR.split(\"[sDtFimVigencia]\").join(MURAL.RESOURCES.Indeterminado);\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDtFimVigencia]\").join(oObjeto.sDtFimVigencia.split(\" \", 1));\r\n\r\n                            if (oObjeto.sDsObjeto == '\u0013\u0012\u0012\u0013')\r\n                                templateTR = templateTR.split(\"[sDsObjeto]\").join('');\r\n                            else\r\n                                templateTR = templateTR.split(\"[sDsObjeto]\").join(oObjeto.sDsObjeto);\r\n\r\n                            templateTR = templateTR\r\n                                .split(\"[sNrEdital]\").join(oObjeto.sNrEdital);\r\n                            \r\n                            templateTR = templateTR.split(\"[onClickProcesso]\").join(\"trListaMuralProcesso_Click(\" + oObjeto.nCdProcesso + \", \" + oObjeto.nCdModulo + \",\\\"\\\",true)\");\r\n\r\n                            $(\"#trRfiEncerrados\").append(templateTR);\r\n                        });\r\n                    }\r\n\r\n                    setTimeout(function () { objParametroMural.bDisparou = false; $(window).scroll(ChegouFinalScroll); }, 500);\r\n                    $(\"#carregandoLista\").hide();\r\n                },\r\n                function () {\r\n                    $(\"#carregandoLista\").hide();\r\n                }\r\n            );\r\n        }\r\n\r\n        function MuralProcesso_Retorna() {\r\n            $(\"#divDetalhes\").animate({ opacity: 0 }, 300, function () {\r\n                $(\"#divEdital, #divHistorico, #divRelatorio, #divChat, #divDownload, #divForum, #divImpugnar\").each(function () { $(\"#\" + this.id).data(\"carregado\", \"0\"); });\r\n                $(\"#divDetalhes\").hide();\r\n                $(\"#divListagem\").show();\r\n                $(\"#divListagem\").animate({ opacity: 1 }, 300);\r\n                $(window).unbind(\"scroll\");\r\n                $(window).scroll(ChegouFinalScroll);\r\n            });\r\n        }\r\n\r\n        function btLimpar_Click() {\r\n            $(\"#areaFiltro input:text\").val(\"\");\r\n            $(\"#areaFiltro select\").val(\"0\");\r\n\r\n            if (objConfiguracao.bFlIdiomaFiltraProcessoPublico > 0) {\r\n                if (adquirirIdIdioma(\"/\") == 1)\r\n                    $(\"#ddlTipoProcesso\").val(enumTipoProcessoPorIdioma.PTBR);\r\n                else if (adquirirIdIdioma(\"/\") == 2)\r\n                    $(\"#ddlTipoProcesso\").val(\"2\");\r\n                else if (adquirirIdIdioma(\"/\") == 4)\r\n                    $(\"#ddlTipoProcesso\").val(enumTipoProcessoPorIdioma.ESPY);\r\n                else\r\n                    $(\"#ddlTipoProcesso\").val(\"0\");\r\n            }\r\n            else\r\n                $(\"#ddlTipoProcesso\").val(\"0\");\r\n\r\n            $.uniform.update(\"#areaFiltro select\");\r\n            $(\".campoSelect\").parent().find(\"span:first\").css(\"width\", \"245px\");\r\n            $(\".selector\").css(\"width\", \"\");\r\n\r\n            OcultarFiltroPorModulo();\r\n            if (window.location.href.indexOf(\"nNmTela=PT\") > -1) \r\n                PesquisarUnidadeCompradora();\r\n            \r\n            PesquisarSituacoesModulo(0);\r\n           \r\n\r\n            $(\"#tbPeriodoDe\").val(\"\");\r\n            $(\"#tbPeriodoAte\").val(\"\");\r\n        }\r\n\r\n        function validarFiltroPeriodo(bFlValidarExisteUmDosFiltroPeriodoVazio) {\r\n            var sDataDe = $(\"#tbPeriodoDe\").val();\r\n            var sDataAte = $(\"#tbPeriodoAte\").val();\r\n            var bFlDataInvalida = false;\r\n\r\n            if ((sDataAte < sDataDe) && (!isNullOrEmpty(sDataAte)) && (!isNullOrEmpty(sDataDe))) {\r\n                bFlDataInvalida = true;\r\n                Alerta(MURAL.RESOURCES.Data_campo_De_ou_Ate_invalida, \"/\");\r\n            }\r\n\r\n            if (bFlValidarExisteUmDosFiltroPeriodoVazio) {\r\n                if ((isNullOrEmpty($(\"#tbPeriodoDe\").val())) && (!isNullOrEmpty($(\"#tbPeriodoAte\").val())) || (!isNullOrEmpty($(\"#tbPeriodoDe\").val())) && (isNullOrEmpty($(\"#tbPeriodoAte\").val()))) {\r\n                    bFlDataInvalida = true;\r\n                    Alerta(MURAL.RESOURCES.Filtro_pesquisa_Periodo_invalido, \"/\");\r\n                }\r\n            }\r\n\r\n            return bFlDataInvalida;\r\n        }\r\n\r\n        function bindDdlVLibras() {\r\n            PesquisarUnidadeCompradora();\r\n            PesquisarModalidade();\r\n            PesquisarSituacoesModulo(0);\r\n        }\r\n\r\n        var observer = new MutationObserver(function (mutations) {\r\n            var bFlVLibrasAtivo = 0;\r\n            mutations.forEach(function (mutation) {\r\n                if (mutation.addedNodes && mutation.addedNodes.length > 0) {\r\n                    for (var i = 0; i < mutation.addedNodes.length; i++) {\r\n                        var node = mutation.addedNodes[i];\r\n                        if (node.tagName === 'VLIBRASWIDGET' && bFlVLibrasAtivo == 0) {\r\n                            bindDdlVLibras(); \r\n                            observer.disconnect(); \r\n                            bFlVLibrasAtivo++;\r\n                        }\r\n                    }\r\n                }\r\n            });\r\n        });\r\n\r\n        function AdicionarSessionTimezone() {\r\n            const fusoHorario = -1 * new Date().getTimezoneOffset() / 60;\r\n\r\n            chamadaWebService(\r\n                \"WebService/Servicos.asmx/AdicionarSessionTimezone\",\r\n                \"sSession:'\" + fusoHorario + \"'\",\r\n                function (_retorno) {                  \r\n                }\r\n            );\r\n        }\r\n\r\n        observer.observe(document.documentElement, {childList: true, subtree: true });\r\n    </script>\r\n    <!-- Div Listagem -->\r\n    <div id=\"divCarregarProcesso\" style=\"display: none;\"><img src=\"Imagens/carregando.gif\" alt=\"Carregando...\" /></div>\r\n    <div id=\"divListagem\">\r\n        <!-- Painel de filtro (esquerda) -->\r\n        <div id=\"areaFiltro\" class=\"painelFiltro\" style=\"display:none;\">\r\n            <div class=\"iconePainel busca areaClique\" onclick=\"menuFiltro_MouseLeave()\"><div class=\"ico-buscar-branco-25\" title=\"Fechar\"></div></div>\r\n            <div class=\"grupoFiltro esquerda\">\r\n                <h1>Filtros de pesquisa</h1>\r\n                <hr />\r\n                <label for=\"sNrProcesso\" class=\"mural mural-estatistico portalTransparencia\" style=\"display:none;\">Processo</label>\r\n                <label for=\"sNrProcesso\" class=\"edital\" style=\"display:none;\" >Edital</label>\r\n                <label for=\"sNrProcesso\" class=\"mural-pesquisa-agrupada\" style=\"display:none;\" >Número</label>\r\n                <br /><input name=\"ctl00$conteudoPrincipal$sNrProcesso\" type=\"text\" id=\"sNrProcesso\" class=\"campoTexto enterFiltro\" data-testid=\"mural-input-nr-processo\" aria-label=\"Processo\" />\r\n\r\n                <br /><label for=\"tbsDsObjeto\" >Objeto</label>\r\n                <br /><input name=\"ctl00$conteudoPrincipal$tbsDsObjeto\" type=\"text\" id=\"tbsDsObjeto\" class=\"campoTexto enterFiltro\" data-testid=\"mural-input-ds-objeto\" aria-label=\"Objeto\" />\r\n\r\n                <div style=\"display:none;\" class=\"portalTransparencia\" >\r\n                    <br /><label for=\"tbPeriodo\" >Período</label>\r\n                    <br /><label for=\"tbDe\">De</label>\r\n                    <input id=\"tbPeriodoDe\" type=\"date\" value=\"\" class=\"campoTexto  enterFiltro\" style=\"width:36%;\" onBlur=\"validarFiltroPeriodo(false)\" aria-label=\"Data inicial do período\" data-testid=\"mural-input-periodo-de\" />\r\n                    <label for=\"tbDe\" style=\"margin-left:1%;\">Até</label>\r\n                    <input id=\"tbPeriodoAte\" type=\"date\" value=\"\" class=\"campoTexto  enterFiltro\" style=\"width:36%;\" onBlur=\"validarFiltroPeriodo(false)\" aria-label=\"Data final do período\" data-testid=\"mural-input-periodo-ate\" />\r\n\r\n                </div>\r\n\r\n                \r\n                \r\n\r\n                \r\n                <br />\r\n                <label for=\"ddlEmpresaUnidadeCompradora\" id=\"ctl00_conteudoPrincipal_lblEmpresaUnidadeCompradora\">Unidade compradora</label>\r\n                <select name=\"ctl00$conteudoPrincipal$ddlEmpresaUnidadeCompradora\" id=\"ddlEmpresaUnidadeCompradora\" class=\"campoSelect  enterFiltro\" data-testid=\"mural-select-empresa-unidade-compradora\" aria-label=\"Unidade Compradora\">\r\n\t<option value=\"\