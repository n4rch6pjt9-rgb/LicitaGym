            "mimeType": "text/html",
            "text": "\r\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head id=\"ctl00_Head1\">\r\n    <title>Erro</title>\r\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"http://wbcpublic.com.br/core/include/css/wbc.css.aspx\" />\r\n</head>\r\n<body style=\"height: 100%;\">\r\n    <form name=\"aspnetForm\" method=\"post\" action=\"erro.aspx\" id=\"aspnetForm\">\r\n    <div>\r\n        <div id=\"ctl00_vsmGeral\" style=\"color: Red; display: none;\">\r\n        </div>\r\n        <table cellspacing=\"0\" cellpadding=\"0\" align=\"center\" border=\"0\" width=\"100%\" class=\"tabTituloPagina\"\r\n            id=\"tabTitulo\">\r\n            <tr>\r\n                <td class=\"tdTituloPagina\">\r\n                    <div id=\"layDivTitulo\" style=\"overflow: hidden; text-overflow: ellipsis; width: 100%;\r\n                        white-space: nowrap\">\r\n                        <img src=\"http://wbcpublic.com.br/core/images/lin_v_titulo.gif\" align=\"absmiddle\" alt=\" \" />\r\n                        <span id=\"ctl00_conteudoTitulo_lblTitulo\">Erro</span>\r\n                    </div>\r\n                </td>\r\n            </tr>\r\n        </table>\r\n        <br />\r\n        <table cellspacing=\"0\" cellpadding=\"0\" align=\"center\" border=\"0\" width=\"98%\" class=\"tabAba\"\r\n            id=\"tabAbas\">\r\n            <tr>\r\n                <td style=\"width: 13px\">\r\n                </td>\r\n                <td>\r\n                </td>\r\n            </tr>\r\n        </table>\r\n        <table cellspacing=\"0\" cellpadding=\"0\" align=\"center\" border=\"0\" width=\"98%\" class=\"tabCorpoPopup\">\r\n            <tr>\r\n                <td valign=\"top\" id=\"tdCorpo\">\r\n                    <div id=\"layConteudo\" style=\"height: 300px; width: 100%; overflow: auto; overflow-x: none;\r\n                        padding: 15px;\">\r\n                        <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"table-layout: fixed;\" width=\"100%\">\r\n                            <tr>\r\n                                <td><span id=\"sMensagem\">Ocorreu um erro na aplicação. Contate o Administrador do Sistema.</span></td>\r\n                            </tr>\r\n                        </table>\r\n                    </div>\r\n                </td>\r\n            </tr>\r\n        </table>\r\n        <img src=\"images/lin_separador.gif\" alt=\"\" style=\"width: 100%; height: 8px;\" />\r\n        <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"table-layout: fixed;\" width=\"99%\"\r\n            id=\"layTabBotoes\">\r\n            <tr>\r\n                <td align=\"right\">\r\n                    <input type=\"button\" value=\"fechar\" class=\"botao\" onclick=\"window.close();\" style=\"width: 110px;\" />\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n    </form>\r\n</body>\r\n</html>\r\n"
