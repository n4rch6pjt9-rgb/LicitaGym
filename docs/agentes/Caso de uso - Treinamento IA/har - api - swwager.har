            "text": "{\"openapi\":\"3.1.0\",\"info\":{\"title\":\"API Compras.gov.br\",\"description\":\"[Compras Públicas em Dados Abertos](https://www.gov.br/compras/pt-br/cidadao/compras-publicas-dados-abertos)\",\"version\":\"1.0.0\"},\"servers\":[{\"url\":\"https://dadosabertos.compras.gov.br\",\"description\":\"Generated server url\"}],\"tags\":[{\"name\":\"98 - ALICE\",\"description\":\"Serviços de integração Analisador de Licitações, Contratos e Editais (Alice) e Compras.gov.\"},{\"name\":\"02 - CATÁLOGO - SERVIÇO\",\"description\":\"Catálogo de Serviços (CATSER): Consulta serviços com informações detalhadas.\"},{\"name\":\"04 - PGC\",\"description\":\"Consulta dados sobre Planejamento e Gerenciamento de Contratações (PGC).\"},{\"name\":\"AUTENTICACAO\",\"description\":\"Descrição do serviço de autenticação de usuários\"},{\"name\":\"08 - ARP\",\"description\":\"Consulta Atas de Registro de Preços (ARP) e seus respectivos itens.\"},{\"name\":\"07 - CONTRATAÇÕES\",\"description\":\"Consulta contratações realizadas sob a Lei nº 14.133/2021.\"},{\"name\":\"03 - PESQUISA DE PREÇO - PREÇOS PRATICADOS\",\"description\":\"Consulta preços praticados nas compras públicas por códigos de itens do CATMAT e CATSER.\"},{\"name\":\"99 - USUARIOS\",\"description\":\"Serviço de gestão de usuários.\"},{\"name\":\"05 - UASG\",\"description\":\"Consulta dados sobre Unidades Administrativas de Serviços Gerais (UASG).\"},{\"name\":\"01 - CATÁLOGO - MATERIAL\",\"description\":\"Catálogo de Materiais (CATMAT): Consulta itens de materiais com dados detalhados.\"},{\"name\":\"06 - LEGADO\",\"description\":\"Consulta licitações realizadas sob a Lei nº 8.666/1993 e leis anteriores à Lei nº 14.133/2021.\"},{\"name\":\"97 - INDICADORES\",\"description\":\"Este módulo expõe endpoints de indicadores de uso e desempenho da API Compras V2.\"},{\"name\":\"09 - CONTRATOS\",\"description\":\"Consulta contratos e seus respectivos itens.\"},{\"name\":\"10 - FORNECEDOR\",\"description\":\"Consulta