          \\u003cdiv id=\\\"divErroLgpdCadastroVisitanteAnexo\\\" style=\\\"display:none; color:red; font-size:11px; margin-top:5px;\\\"\\u003e\\r\\n                    É necessário concordar com o tratamento dos dados pessoais para continuar.\\r\\n                \\u003c/div\\u003e\\r\\n            \\u003c/div\\u003e\\r\\n        \\u003c/div\\u003e\\r\\n    \\u003c/div\\u003e\\r\\n    \\u003chr /\\u003e\\r\\n\\r\\n    \\u003c!-- AÃ§Ãµes --\\u003e\\r\\n    \\u003cdiv class=\\\"row-fluid\\\"\\u003e\\r\\n        \\u003cdiv class=\\\"span4\\\"\\u003e\\r\\n            \\u003cdiv class=\\\"areaBotao2\\\" \\u003e\\r\\n                \\u003cdiv class=\\\"ico-botao ico-voltar-branco-15\\\"\\u003e\\u003c/div\\u003e\\r\\n                \\u003cinput id=\\\"btCadastroVisitanteVoltarCadastroVisitanteAnexo\\\" type=\\\"button\\\" value=\\\"Voltar\\\" class=\\\"campoBotao\\\" onclick=\\\"btCadastroVisitanteVoltar_ClickCadastroVisitanteAnexo()\\\" data-testid=\\\"cadastro-visitante-button-voltar-CadastroVisitanteAnexo\\\" aria-label=\\\"Voltar\\\"/\\u003e\\r\\n            \\u003c/div\\u003e\\r\\n            \\u003cdiv class=\\\"areaBotao2\\\"\\u003e\\r\\n                \\u003cdiv class=\\\"ico-botao ico-download-branco-15\\\"\\u003e\\u003c/div\\u003e\\r\\n                \\u003cinput id=\\\"btCadastroVisitanteConfirmarCadastroVisitanteAnexo\\\" type=\\\"button\\\" value=\\\"Continuar\\\" class=\\\"campoBotao\\\" onclick=\\\"btCadastroVisitanteConfirmar_ClickCadastroVisitanteAnexo()\\\" data-testid=\\\"cadastro-visitante-button-confirmar-CadastroVisitanteAnexo\\\" aria-label=\\\"Continuar\\\"/\\u003e\\r\\n            \\u003c/div\\u003e\\r\\n            \\u003cspan id=\\\"carregandoSalvarCadastroVisitanteAnexo\\\" style=\\\"display:none\\\" \\u003e\\u003cimg src=\\\"Imagens/carregando.gif\\\" width=\\\"18px\\\" height=\\\"18px\\\" /\\u003e\\u003c/span\\u003e\\r\\n        \\u003c/div\\u003e\\r\\n    \\u003c/div\\u003e\\r\\n\\u003c/div\\u003e\\r\\n\\r\\n\\u003cscript type=\\\"text/javascript\\\"\\u003e\\r\\n    var sNmGridCadastroVisitanteAnexo = \\\"\\\";\\r\\n    var objJsonConfigCamposCadastroVisitanteAnexo = null;\\r\\n    var bFlExibirCheckboxLgpdCadastroVisitanteAnexo = false;\\r\\n\\r\\n    // ConfiguraÃ§Ã£o JSON dos campos\\r\\n    \\r\\n\\r\\n    $(document).ready(function () {\\r\\n\\r\\n        switch (\\\"CadastroVisitanteAnexo\\\") {\\r\\n            case \\\"CadastroVisitanteForum\\\":\\r\\n                sNmGridCadastroVisitanteAnexo = \\\"#gridForum\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteAnexo\\\").val(\\\"Continuar\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexo\\\":\\r\\n                sNmGridCadastroVisitanteAnexo = \\\"#gridAnexo\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteAnexo\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexoProposta\\\":\\r\\n                sNmGridCadastroVisitanteAnexo = \\\"#gridAnexoProposta\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteAnexo\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexoLance\\\":\\r\\n                sNmGridCadastroVisitanteAnexo = \\\"#gridAnexoLance\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteAnexo\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexoNegociacao\\\":\\r\\n                sNmGridCadastroVisitanteAnexo = \\\"#gridAnexoNegociacao\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteAnexo\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexoHabilitacao\\\":\\r\\n                sNmGridCadastroVisitanteAnexo = \\\"#gridAnexoHabilitacao\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteAnexo\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexoRecurso\\\":\\r\\n                sNmGridCadastroVisitanteAnexo = \\\"#gridAnexoRecurso\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteAnexo\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexoContraRazoes\\\":\\r\\n                sNmGridCadastroVisitanteAnexo = \\\"#gridAnexoContraRazoes\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteAnexo\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexoParecer\\\":\\r\\n                sNmGridCadastroVisitanteAnexo = \\\"#gridAnexoParecer\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteAnexo\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n        }\\r\\n\\r\\n        $(\\\"#rbCPFCadastroVisitanteAnexo, #rbCNPJCadastroVisitanteAnexo\\\").on(\\\"click\\\", rbVisitanteTipoDocumento_ClickCadastroVisitanteAnexo);\\r\\n        $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").on(\\\"blur\\\", tbDocumento_OnBlurCadastroVisitanteAnexo);\\r\\n        var bFlInteresseCertame = objConfiguracao.bFlInteresseCertame;\\r\\n        if (bFlInteresseCertame == 1)\\r\\n            $(\\\"#rbbFlInteresse\\\").show();\\r\\n        else\\r\\n            $(\\\"#rbbFlInteresse\\\").hide();\\r\\n\\r\\n        configurarCamposJsonCadastroVisitanteAnexo();\\r\\n        setTimeout(function() {\\r\\n            var tipoSelecionado = $(\\u0027input[name=\\\"documentoCadastroVisitanteAnexo\\\"]:checked\\u0027).val();\\r\\n\\r\\n            if (!tipoSelecionado) {\\r\\n                $(\\u0027#rbCPFCadastroVisitanteAnexo\\u0027).prop(\\u0027checked\\u0027, true);\\r\\n                configurarCamposPorTipoCadastroVisitanteAnexo(\\u00271\\u0027);\\r\\n                configurarVisibilidadeLGPDCadastroVisitanteAnexo();\\r\\n            }\\r\\n        }, 500);\\r\\n\\r\\n\\r\\n    });\\r\\n\\r\\n    function reiniciaFormularioCadastroVisitanteAnexo(bParcial) {\\r\\n        var bFlRetiradaEditalPreCadastro = objConfiguracao.bFlRetiradaEditalPreCadastro;\\r\\n        if (bFlRetiradaEditalPreCadastro == 1 \\u0026\\u0026 $(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val() == \\\"CNPJ\\\")\\r\\n            $(\\\"#divPreCadastroCadastroVisitanteAnexo\\\").show();\\r\\n        else\\r\\n            $(\\\"#divPreCadastroCadastroVisitanteAnexo\\\").hide();\\r\\n\\r\\n        $(\\\"#uniform-rbCNPJCadastroVisitanteAnexo\\\").show();\\r\\n        $(\\\"#lblCNPJCadastroVisitanteAnexo\\\").show();\\r\\n        $(\\\"#tbCEPCadastroVisitanteAnexo\\\").mask(\\\"99.999-999\\\");\\r\\n\\r\\n        $(\\\"#ddlPaisCadastroVisitanteAnexo\\\").val(\\\"0\\\");\\r\\n        $(\\\"#ddlPaisCadastroVisitanteAnexo option\\\").remove();\\r\\n        $(\\\"#ddlPaisCadastroVisitanteAnexo\\\").parent().children().first().text(\\\"\\\");\\r\\n\\r\\n        $(\\\"#ddlEstadoCadastroVisitanteAnexo\\\").val(\\\"0\\\");\\r\\n        $(\\\"#ddlEstadoCadastroVisitanteAnexo option\\\").remove();\\r\\n        $(\\\"#ddlEstadoCadastroVisitanteAnexo\\\").parent().children().first().text(\\\"\\\");\\r\\n\\r\\n        $(\\\"#ddlCidadeCadastroVisitanteAnexo\\\").val(\\\"0\\\");\\r\\n        $(\\\"#ddlCidadeCadastroVisitanteAnexo option\\\").remove();\\r\\n        $(\\\"#ddlCidadeCadastroVisitanteAnexo\\\").parent().children().first().text(\\\"\\\");\\r\\n\\r\\n        if (typeof objParametroCadastroVisitanteAnexo.frmValidacao != \\\"undefined\\\")\\r\\n            objParametroCadastroVisitanteAnexo.frmValidacao.resetForm();\\r\\n\\r\\n        if (!bParcial) {\\r\\n            $.uniform.update($(\\\"#rbCPFCadastroVisitanteAnexo\\\").attr(\\\"checked\\\", true));\\r\\n            $.uniform.update($(\\\"#rbCNPJCadastroVisitanteAnexo\\\").attr(\\\"checked\\\", false));\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").unmask();\\r\\n\\r\\n            if (adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n                $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").mask(\\\"999.999.999-99\\\");\\r\\n\\r\\n            $(\\\"#painelCadastroCadastroVisitanteAnexo input:text\\\").not(\\\"#tbnCdVisitanteCadastroVisitanteAnexo, #tbnCdEmpresaCadastroVisitanteAnexo, #tbnCdEnderecoCadastroVisitanteAnexo\\\").val(\\\"\\\");\\r\\n        }\\r\\n        else\\r\\n            $(\\\"#painelCadastroCadastroVisitanteAnexo input:text\\\").not(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").val(\\\"\\\");\\r\\n\\r\\n\\r\\n        var tipoDocumento = $(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val();\\r\\n\\r\\n        if (tipoDocumento == \\\"CNPJ\\\") {\\r\\n            $(\\\"#spanRGCadastroVisitanteAnexo\\\").hide();\\r\\n            $(\\\"#spanNomeCadastroVisitanteAnexo\\\").removeClass(\\\"span3\\\").addClass(\\\"span5\\\");\\r\\n            $(\\\"#lblNomeCadastroVisitanteAnexo\\\").text(\\\"Razão social\\\");\\r\\n            $(\\\"#divEnderecoCadastroVisitanteAnexo\\\").removeClass(\\\"span10\\\").addClass(\\\"span6\\\");\\r\\n            $(\\\"#divEnderecoCadastroVisitanteAnexo\\\").css(\\\"margin-left\\\", \\\"27px\\\");\\r\\n\\r\\n            setTimeout(function() {\\r\\n                configurarCamposPorTipoCadastroVisitanteAnexo(\\u00272\\u0027);\\r\\n                configurarVisibilidadeLGPDCadastroVisitanteAnexo();\\r\\n            }, 10);\\r\\n        }\\r\\n        else if (tipoDocumento == \\\"CPF\\\") {\\r\\n            $(\\\"#spanRGCadastroVisitanteAnexo\\\").show();\\r\\n            $(\\\"#spanNomeCadastroVisitanteAnexo\\\").removeClass(\\\"span5\\\").addClass(\\\"span3\\\");\\r\\n            $(\\\"#lblNomeCadastroVisitanteAnexo\\\").text(\\\"Nome\\\");\\r\\n            $(\\\"#divEnderecoCadastroVisitanteAnexo\\\").removeClass(\\\"span6\\\").addClass(\\\"span10\\\");\\r\\n            $(\\\"#divEnderecoCadastroVisitanteAnexo\\\").css(\\\"margin-left\\\", \\\"-1px\\\");\\r\\n\\r\\n            setTimeout(function() {\\r\\n                configurarCamposPorTipoCadastroVisitanteAnexo(\\u00271\\u0027);\\r\\n                configurarVisibilidadeLGPDCadastroVisitanteAnexo();\\r\\n            }, 10);\\r\\n        }\\r\\n\\r\\n        CarregarRegiaoCadastroVisitanteAnexo(enumTipoRegiao.PAIS);\\r\\n    }\\r\\n\\r\\n    function CarregarRegiaoCadastroVisitanteAnexo(_enumTipoRegiao) {\\r\\n        var dtoRegiao = { sCdCodigo: \\\"\\\", tmpTipoRegiao: _enumTipoRegiao };\\r\\n        var sIdElemento = \\\"ddlPaisCadastroVisitanteAnexo\\\";\\r\\n\\r\\n        $(\\\"#carregandoPaisCadastroVisitanteAnexo, #carregandoEstadoCadastroVisitanteAnexo, #carregandoCidadeCadastroVisitanteAnexo\\\").hide();\\r\\n        $(\\\"#carregandoPaisCadastroVisitanteAnexo, #carregandoEstadoCadastroVisitanteAnexo, #carregandoCidadeCadastroVisitanteAnexo\\\").removeClass(\\\"select\\\");\\r\\n\\r\\n        switch (_enumTipoRegiao) {\\r\\n            case enumTipoRegiao.PAIS:\\r\\n                dtoRegiao.sCdCodigo = \\\"0\\\";\\r\\n                sIdElemento = \\\"ddlPaisCadastroVisitanteAnexo\\\";\\r\\n                CarregaRegiaoPaisCadastroVisitanteAnexo(dtoRegiao);\\r\\n                break;\\r\\n            case enumTipoRegiao.ESTADO:\\r\\n                $.uniform.update(\\\"#ddlPaisCadastroVisitanteAnexo\\\");\\r\\n                dtoRegiao.sCdCodigo = $(\\\"#ddlPaisCadastroVisitanteAnexo option:selected\\\").val();\\r\\n                dtoRegiao.sCdPais = $(\\\"#ddlPaisCadastroVisitanteAnexo option:selected\\\").val();\\r\\n                sIdElemento = \\\"ddlEstadoCadastroVisitanteAnexo\\\";\\r\\n                CarregaRegiaoEstadoCadastroVisitanteAnexo(dtoRegiao);\\r\\n                break;\\r\\n            case enumTipoRegiao.CIDADE:\\r\\n                $.uniform.update(\\\"#ddlEstadoCadastroVisitanteAnexo\\\");\\r\\n                dtoRegiao.sCdCodigo = $(\\\"#ddlEstadoCadastroVisitanteAnexo option:selected\\\").val();\\r\\n                dtoRegiao.sCdPais = $(\\\"#ddlPaisCadastroVisitanteAnexo option:selected\\\").val();\\r\\n                sIdElemento = \\\"ddlCidadeCadastroVisitanteAnexo\\\";\\r\\n                CarregaRegiaoCidadeCadastroVisitanteAnexo(dtoRegiao);\\r\\n                break;\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function CarregaRegiaoPaisCadastroVisitanteAnexo(dtoRegiao) {\\r\\n        chamadaWebService(\\r\\n            \\\"WebService/Servicos.asmx/PesquisarRegiao\\\",\\r\\n            \\\"dtoRegiao:\\\" + JSON.stringify(dtoRegiao),\\r\\n            function (_retorno) {\\r\\n                var arrRetorno = _retorno.d;\\r\\n\\r\\n                var sSelect = $(\\\"\\u003cselect\\u003e\\\");\\r\\n                sSelect.append($(\\u0027\\u003coption\\u003e\\u003c/option\\u003e\\u0027).val(\\\"0\\\").html(\\\"Selecione\\\"));\\r\\n                $(arrRetorno).each(function () {\\r\\n                    sSelect.append($(\\u0027\\u003coption\\u003e\\u003c/option\\u003e\\u0027).val(this.sCdCodigo).html(this.sDsRegiao));\\r\\n                });\\r\\n\\r\\n                $(\\\"#ddlPaisCadastroVisitanteAnexo option\\\").remove();\\r\\n                $(\\\"#ddlPaisCadastroVisitanteAnexo\\\").append(sSelect.html());\\r\\n                $(\\\"#ddlPaisCadastroVisitanteAnexo\\\").val(\\\"0\\\");\\r\\n                $.uniform.update(\\\"#ddlPaisCadastroVisitanteAnexo\\\");\\r\\n                $(\\\"#ddlPaisCadastroVisitanteAnexo\\\").unbind(\\\"change\\\");\\r\\n                $(\\\"#ddlPaisCadastroVisitanteAnexo\\\").bind(\\\"change\\\", function () { CarregarRegiaoCadastroVisitanteAnexo(enumTipoRegiao.ESTADO); });\\r\\n                $(\\\"#ddlPaisCadastroVisitanteAnexo\\\").trigger(\\\"change\\\");\\r\\n\\r\\n                $(\\\"#carregandoPaisCadastroVisitanteAnexo\\\").hide();\\r\\n                $(\\\"#carregandoPaisCadastroVisitanteAnexo\\\").removeClass(\\\"select\\\");\\r\\n            },\\r\\n            function () {\\r\\n                $(\\\"#carregandoPaisCadastroVisitanteAnexo\\\").hide();\\r\\n                $(\\\"#carregandoPaisCadastroVisitanteAnexo\\\").removeClass(\\\"select\\\");\\r\\n            }\\r\\n        );\\r\\n    }\\r\\n\\r\\n    function CarregaRegiaoEstadoCadastroVisitanteAnexo(dtoRegiao) {\\r\\n        chamadaWebService(\\r\\n            \\\"WebService/Servicos.asmx/PesquisarRegiao\\\",\\r\\n            \\\"dtoRegiao:\\\" + JSON.stringify(dtoRegiao),\\r\\n            function (_retorno) {\\r\\n                var arrRetorno = _retorno.d;\\r\\n\\r\\n                var sSelect = $(\\\"\\u003cselect\\u003e\\\");\\r\\n                sSelect.append($(\\u0027\\u003coption\\u003e\\u003c/option\\u003e\\u0027).val(\\\"0\\\").html(\\\"Selecione\\\"));\\r\\n                $(arrRetorno).each(function () {\\r\\n                    sSelect.append($(\\u0027\\u003coption\\u003e\\u003c/option\\u003e\\u0027).val(this.sCdCodigo).html(this.sDsRegiao));\\r\\n                });\\r\\n\\r\\n                $(\\\"#ddlEstadoCadastroVisitanteAnexo option\\\").remove();\\r\\n                $(\\\"#ddlEstadoCadastroVisitanteAnexo\\\").append(sSelect.html());\\r\\n                $(\\\"#ddlEstadoCadastroVisitanteAnexo\\\").val(\\\"0\\\");\\r\\n                $.uniform.update(\\\"#ddlEstadoCadastroVisitanteAnexo\\\");\\r\\n                $(\\\"#ddlEstadoCadastroVisitanteAnexo\\\").unbind(\\\"change\\\");\\r\\n                $(\\\"#ddlEstadoCadastroVisitanteAnexo\\\").bind(\\\"change\\\", function () { CarregarRegiaoCadastroVisitanteAnexo(enumTipoRegiao.CIDADE); });\\r\\n                $(\\\"#ddlEstadoCadastroVisitanteAnexo\\\").trigger(\\\"change\\\");\\r\\n\\r\\n                $(\\\"#carregandoEstadoCadastroVisitanteAnexo\\\").hide();\\r\\n                $(\\\"#carregandoEstadoCadastroVisitanteAnexo\\\").removeClass(\\\"select\\\");\\r\\n            },\\r\\n            function () {\\r\\n                $(\\\"#carregandoEstadoCadastroVisitanteAnexo\\\").hide();\\r\\n                $(\\\"#carregandoEstadoCadastroVisitanteAnexo\\\").removeClass(\\\"select\\\");\\r\\n            }\\r\\n        );\\r\\n    }\\r\\n\\r\\n    function CarregaRegiaoCidadeCadastroVisitanteAnexo(dtoRegiao) {\\r\\n        chamadaWebService(\\r\\n            \\\"WebService/Servicos.asmx/PesquisarRegiao\\\",\\r\\n            \\\"dtoRegiao:\\\" + JSON.stringify(dtoRegiao),\\r\\n            function (_retorno) {\\r\\n                var arrRetorno = _retorno.d;\\r\\n\\r\\n                var sSelect = $(\\\"\\u003cselect\\u003e\\\");\\r\\n                sSelect.append($(\\u0027\\u003coption\\u003e\\u003c/option\\u003e\\u0027).val(\\\"0\\\").html(\\\"Selecione\\\"));\\r\\n                $(arrRetorno).each(function () {\\r\\n                    sSelect.append($(\\u0027\\u003coption\\u003e\\u003c/option\\u003e\\u0027).val(this.sCdCodigo).html(this.sDsRegiao));\\r\\n                });\\r\\n\\r\\n                $(\\\"#ddlCidadeCadastroVisitanteAnexo option\\\").remove();\\r\\n                $(\\\"#ddlCidadeCadastroVisitanteAnexo\\\").append(sSelect.html());\\r\\n                $(\\\"#ddlCidadeCadastroVisitanteAnexo\\\").val(\\\"0\\\");\\r\\n                $.uniform.update(\\\"#ddlCidadeCadastroVisitanteAnexo\\\");\\r\\n                $(\\\"#ddlCidadeCadastroVisitanteAnexo\\\").trigger(\\\"change\\\");\\r\\n\\r\\n                $(\\\"#carregandoCidadeCadastroVisitanteAnexo\\\").hide();\\r\\n                $(\\\"#carregandoCidadeCadastroVisitanteAnexo\\\").removeClass(\\\"select\\\");\\r\\n\\r\\n                setTimeout(function () {\\r\\n                    $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteAnexo\\\").removeClass(\\\"desativado\\\");\\r\\n                    $(\\\"#carregandoSalvarCadastroVisitanteAnexo\\\").fadeOut();\\r\\n\\r\\n                    if ($(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").val() != \\\"\\\" \\u0026\\u0026 $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").val() != \\\"___.___.___-__\\\")\\r\\n                        $(\\\"#\\\" + objParametroCadastroVisitanteAnexo.nIdFormularioValidacao).valid();\\r\\n\\r\\n                }, 1000);\\r\\n            },\\r\\n            function () {\\r\\n                $(\\\"#carregandoCidadeCadastroVisitanteAnexo\\\").hide();\\r\\n                $(\\\"#carregandoCidadeCadastroVisitanteAnexo\\\").removeClass(\\\"select\\\");\\r\\n            }\\r\\n        );\\r\\n    }\\r\\n\\r\\n    function preparaValidacaoVisitanteCadastroVisitanteAnexo() {\\r\\n        if (adquirirIdIdioma(\\\"/\\\") != \\\"1\\\")\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").attr(\\\"maxlength\\\", \\\"14\\\");\\r\\n\\r\\n        var bFlInteresseCertame = objConfiguracao.bFlInteresseCertame;\\r\\n\\r\\n        objParametroCadastroVisitanteAnexo.frmValidacao = $(\\\"#\\\" + objParametroCadastroVisitanteAnexo.nIdFormularioValidacao).validate({\\r\\n            errorPlacement: function (error, element) {\\r\\n                if (element[0].tagName === \\\"SELECT\\\")\\r\\n                    error.insertAfter(element.parent());\\r\\n                else if (element[0].type === \\\"radio\\\") {\\r\\n\\r\\n\\r\\n                    if ($($(\\\"label[for=\\u0027tbDocumentoCadastroVisitanteAnexo\\u0027][class=\\u0027error\\u0027]\\\")[0]).css(\\\"display\\\") == \\\"none\\\" \\u0026\\u0026 $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").val() != \\\"\\\") {\\r\\n                        error.insertAfter($(\\\"#tbDocumentoCadastroVisitanteAnexo\\\"));\\r\\n                    }\\r\\n\\r\\n                    if ($(\\\"input[name=\\u0027InteresseCertameCadastroVisitanteAnexo\\u0027]:checked\\\").length == 0 \\u0026\\u0026 bFlInteresseCertame == 1) {\\r\\n                        error.insertAfter($(\\\"#lblConsultarCertameCadastroVisitanteAnexo\\\"));\\r\\n                    }\\r\\n                }\\r\\n                else\\r\\n                    error.insertAfter(element);\\r\\n                return true;\\r\\n            },\\r\\n            rules: {\\r\\n                tbDocumentoCadastroVisitanteAnexo: {\\r\\n                    required: true,\\r\\n                    validaCPFCNPJ: function () {\\r\\n                        if (adquirirIdIdioma(\\\"/\\\") != \\\"1\\\")\\r\\n                            return \\\"\\\";\\r\\n                        else\\r\\n                            return $(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val();\\r\\n                    }\\r\\n                },\\r\\n                tbRGCadastroVisitanteAnexo: { required: true, number: true },\\r\\n                tbNomeCadastroVisitanteAnexo: { required: true },\\r\\n                tbEmailCadastroVisitanteAnexo: { required: true, validaEmail: true },\\r\\n                tbTelefoneCadastroVisitanteAnexo: { required: true },\\r\\n                tbEnderecoCadastroVisitanteAnexo: { required: true },\\r\\n                tbContatoCadastroVisitanteAnexo: { required: true },\\r\\n                tbNumeroCadastroVisitanteAnexo: { required: true },\\r\\n                tbBairroCadastroVisitanteAnexo: { required: true },\\r\\n                tbCEPCadastroVisitanteAnexo: { required: true },\\r\\n                ddlPaisCadastroVisitanteAnexo: { validaSelectValorInvalido: \\\"0\\\" },\\r\\n                ddlEstadoCadastroVisitanteAnexo: { validaSelectValorInvalido: \\\"0\\\" },\\r\\n                ddlCidadeCadastroVisitanteAnexo: { validaSelectValorInvalido: \\\"0\\\" },\\r\\n\\r\\n                InteresseCertameCadastroVisitanteAnexo: {\\r\\n                    required: function () {\\r\\n                        if (bFlInteresseCertame == 1)\\r\\n                            return true;\\r\\n                        else\\r\\n                            return false;\\r\\n                    }\\r\\n                },\\r\\n\\r\\n                documentoCadastroVisitanteAnexo: {\\r\\n                    required: function () {\\r\\n                        if ($($(\\\"label[for=\\u0027rbParticiparCertameCadastroVisitanteAnexo\\u0027][class=\\u0027error\\u0027]\\\")[0]).css(\\\"display\\\") == \\\"none\\\" \\u0026\\u0026 $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").val() != \\\"\\\")\\r\\n                            return true;\\r\\n                        else\\r\\n                            return false;\\r\\n                    }\\r\\n                }\\r\\n            },\\r\\n            messages: {\\r\\n                tbDocumentoCadastroVisitanteAnexo: {\\r\\n                    required: function () {\\r\\n\\r\\n                        $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteAnexo\\\").removeClass(\\\"desativado\\\");\\r\\n                        $(\\\"#carregandoSalvarCadastroVisitanteAnexo\\\").fadeOut();\\r\\n\\r\\n                        if ($(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val() == \\\"CNPJ\\\")\\r\\n                            return \\\"O campo {0} é obrigatório\\\".format(\\\"CNPJ\\\");\\r\\n                        else if ($(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val() == \\\"CPF\\\")\\r\\n                            return \\\"O campo {0} é obrigatório\\\".format(\\\"CPF\\\");\\r\\n                    },\\r\\n                    validaCPFCNPJ: function () {\\r\\n\\r\\n                        $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteAnexo\\\").removeClass(\\\"desativado\\\");\\r\\n                        $(\\\"#carregandoSalvarCadastroVisitanteAnexo\\\").fadeOut();\\r\\n\\r\\n                        if ($(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val() == \\\"CNPJ\\\")\\r\\n                            return \\\"O campo {0} é inválido\\\".format(\\\"CNPJ\\\");\\r\\n                        else if ($(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val() == \\\"CPF\\\")\\r\\n                            return \\\"O campo {0} é inválido\\\".format(\\\"CPF\\\");\\r\\n                    }\\r\\n                },\\r\\n                tbRGCadastroVisitanteAnexo: {\\r\\n                    required: \\\"O campo {0} é obrigatório\\\".format(\\\"RG\\\"),\\r\\n                    number: \\\"O campo {0} é inválido\\\".format(\\\"RG\\\")\\r\\n                },\\r\\n                tbNomeCadastroVisitanteAnexo: { required: \\\"O campo {0} é obrigatório\\\".format(\\\"Nome\\\") },\\r\\n                tbEmailCadastroVisitanteAnexo: {\\r\\n                    required: \\\"O campo {0} é obrigatório\\\".format(\\\"E-mail\\\"),\\r\\n                    validaEmail: \\\"O endereço de e-mail {0} é inválido.\\\".format(\\\"\\\")\\r\\n                },\\r\\n                tbTelefoneCadastroVisitanteAnexo: { required: \\\"O campo {0} é obrigatório\\\".format(\\\"Telefone\\\") },\\r\\n                tbEnderecoCadastroVisitanteAnexo: { required: \\\"O campo {0} é obrigatório\\\".format(\\\"Endereço\\\") },\\r\\n                tbContatoCadastroVisitanteAnexo: { required: \\\"O campo {0} é obrigatório\\\".format(\\\"Contato\\\") },\\r\\n                tbNumeroCadastroVisitanteAnexo: { required: \\\"O campo {0} é obrigatório\\\".format(\\\"Número\\\") },\\r\\n                tbBairroCadastroVisitanteAnexo: { required: \\\"O campo {0} é obrigatório\\\".format(\\\"Bairro\\\") },\\r\\n                tbCEPCadastroVisitanteAnexo: { required: \\\"O campo {0} é obrigatório\\\".format(\\\"CEP\\\") },\\r\\n                ddlPaisCadastroVisitanteAnexo: { validaSelectValorInvalido: \\\"Selecione o país\\\" },\\r\\n                ddlEstadoCadastroVisitanteAnexo: { validaSelectValorInvalido: \\\"Selecione o estado\\\" },\\r\\n                ddlCidadeCadastroVisitanteAnexo: { validaSelectValorInvalido: \\\"Selecione a cidade\\\" },\\r\\n                documentoCadastroVisitanteAnexo: {\\r\\n                    required: function () {\\r\\n                        if ($($(\\\"label[for=\\u0027tbDocumentoCadastroVisitanteAnexo\\u0027][class=\\u0027error\\u0027]\\\")[0]).css(\\\"display\\\") == \\\"none\\\" \\u0026\\u0026 $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").val() != \\\"\\\")\\r\\n                            return \\\"Selecione um documento.\\\"\\r\\n                        else\\r\\n                            return \\\"\\\";\\r\\n                    }\\r\\n                },\\r\\n                InteresseCertameCadastroVisitanteAnexo: {\\r\\n                    required: function () {\\r\\n                        if ($(\\\"input[name=\\u0027InteresseCertameCadastroVisitanteAnexo\\u0027]:checked\\\").length == 0 \\u0026\\u0026 bFlInteresseCertame == 1)\\r\\n                            return \\\"É necessário selecionar o tipo de interesse em baixar o anexo do certame.\\\"\\r\\n                        else\\r\\n                            return \\\"\\\";\\r\\n                    }\\r\\n                }\\r\\n\\r\\n            }\\r\\n        });\\r\\n    }\\r\\n\\r\\n    function SalvarVisitanteCadastroVisitanteAnexo() {\\r\\n        var dtoVisitante = adquirirCookie(\\\"CK_VISITANTE_TEMP\\\", \\\"/\\\");\\r\\n\\r\\n        if (dtoVisitante == \\\"\\\") {\\r\\n            dtoVisitante = {\\r\\n                nCdVisitante: Number($(\\\"#tbnCdVisitanteCadastroVisitanteAnexo\\\").val()) \\u003e 0 ? Number($(\\\"#tbnCdVisitanteCadastroVisitanteAnexo\\\").val()) : 0,\\r\\n                nCdEndereco: Number($(\\\"#tbnCdEnderecoCadastroVisitanteAnexo\\\").val()) \\u003e 0 ? Number($(\\\"#tbnCdEnderecoCadastroVisitanteAnexo\\\").val()) : 0,\\r\\n                nCdEmpresa: Number($(\\\"#tbnCdEmpresaCadastroVisitanteAnexo\\\").val()) \\u003e 0 ? Number($(\\\"#tbnCdEmpresaCadastroVisitanteAnexo\\\").val()) : 0,\\r\\n                sDsCpf: \\\"\\\",\\r\\n                sDsCnpj: \\\"\\\",\\r\\n                sDsRg: $(\\\"#tbRGCadastroVisitanteAnexo\\\").val(),\\r\\n                sNmVisitante: kendo.htmlEncode($(\\\"#tbNomeCadastroVisitanteAnexo\\\").val()),\\r\\n                sDsEmail: $(\\\"#tbEmailCadastroVisitanteAnexo\\\").val(),\\r\\n                sDsTelefone: $(\\\"#tbTelefoneCadastroVisitanteAnexo\\\").val(),\\r\\n                sDsEndereco: kendo.htmlEncode($(\\\"#tbEnderecoCadastroVisitanteAnexo\\\").val()),\\r\\n                sNrEndereco: kendo.htmlEncode($(\\\"#tbNumeroCadastroVisitanteAnexo\\\").val()),\\r\\n                sDsComplemento: kendo.htmlEncode($(\\\"#tbComplementoCadastroVisitanteAnexo\\\").val()),\\r\\n                sNmBairro: kendo.htmlEncode($(\\\"#tbBairroCadastroVisitanteAnexo\\\").val()),\\r\\n                sCdCep: $(\\\"#tbCEPCadastroVisitanteAnexo\\\").val(),\\r\\n                sCdPais: $(\\\"#ddlPaisCadastroVisitanteAnexo option:selected\\\").val(),\\r\\n                sCdEstado: $(\\\"#ddlEstadoCadastroVisitanteAnexo option:selected\\\").val(),\\r\\n                nCdCidade: $(\\\"#ddlCidadeCadastroVisitanteAnexo option:selected\\\").val(),\\r\\n                sDsTipoDocumento: \\\"\\\",\\r\\n                bFlInteresseCertame: $(\\\"input[name=\\u0027InteresseCertameCadastroVisitanteAnexo\\u0027]:checked\\\").val(),\\r\\n                sNmContato: kendo.htmlEncode($(\\\"#tbContatoCadastroVisitanteAnexo\\\").val()),\\r\\n                bFlConsentimentoLGPD: $(\\\"#cbConsentimentoLgpdCadastroVisitanteAnexo\\\").is(\\u0027:checked\\u0027) ? 1 : 0,\\r\\n                dtoAnexo: {\\r\\n                    nCdAnexo: objParametroCadastroVisitanteAnexo.nCdAnexoClicado,\\r\\n                    nSqAnexo: objParametroCadastroVisitanteAnexo.nSqAnexoClicado\\r\\n                },\\r\\n                dtoEdital: {\\r\\n                    nCdEdital: objParametroCadastroVisitanteAnexo.nCdEditalClicado,\\r\\n                    nCdOrigem: objParametroCadastroVisitanteAnexo.nCdOrigemClicado\\r\\n                },\\r\\n                dtoProcesso: {\\r\\n                    nCdProcesso: objParametroCadastroVisitanteAnexo.nCdOrigemClicado,\\r\\n                    nCdModulo: objParametroCadastroVisitanteAnexo.nCdModuloClicado,\\r\\n                    dtoIdioma: {\\r\\n                        nCdIdioma: adquirirIdIdioma(\\\"/\\\")\\r\\n                    }\\r\\n                }\\r\\n            };\\r\\n\\r\\n            if ($(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val() == \\\"CNPJ\\\") {\\r\\n                dtoVisitante.sDsTipoDocumento = \\\"CNPJ\\\";\\r\\n\\r\\n                if (adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n                    dtoVisitante.sDsCnpj = $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").val().replace(/[^a-z0-9]/gi, \\\"\\\");\\r\\n                else\\r\\n                    dtoVisitante.sDsCnpj = $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").val();\\r\\n            }\\r\\n            else if ($(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val() == \\\"CPF\\\") {\\r\\n                dtoVisitante.sDsTipoDocumento = \\\"CPF\\\";\\r\\n\\r\\n                if (adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n                    dtoVisitante.sDsCpf = $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").val().replace(/[^0-9]/g, \\\"\\\");\\r\\n                else\\r\\n                    dtoVisitante.sDsCpf = $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").val();\\r\\n            }\\r\\n        }\\r\\n        else {\\r\\n            dtoVisitante = JSON.parse(dtoVisitante);\\r\\n            dtoVisitante.dtoAnexo.nCdAnexo = objParametroCadastroVisitanteAnexo.nCdAnexoClicado;\\r\\n            dtoVisitante.dtoAnexo.nSqAnexo = objParametroCadastroVisitanteAnexo.nSqAnexoClicado;\\r\\n        }\\r\\n\\r\\n        criarCookie(\\\"CK_VISITANTE_TEMP\\\", JSON.stringify(dtoVisitante), \\\"/\\\");\\r\\n\\r\\n        $(\\\"#carregandoSalvarCadastroVisitanteAnexo\\\").fadeIn();\\r\\n\\r\\n        chamadaWebService(\\r\\n            \\\"WebService/Servicos.asmx/SalvarVisitante\\\",\\r\\n            \\\"dtoVisitante:\\\" + JSON.stringify(dtoVisitante),\\r\\n            function (_retorno) {\\r\\n                var objRetorno = _retorno.d;\\r\\n                if (objRetorno.nCdCodigo \\u003c= 0) {\\r\\n                    Alerta(objRetorno.sDsConteudo, \\\"/\\\");\\r\\n                    $(\\\"#carregandoSalvarCadastroVisitanteAnexo\\\").fadeOut();\\r\\n                }\\r\\n                else {\\r\\n\\r\\n                    dtoVisitante.nCdVisitante = objRetorno.nCdCodigo;\\r\\n                    dtoVisitante.nCdEndereco = objRetorno.oComplemento;\\r\\n                    criarCookie(\\\"CK_VISITANTE_TEMP\\\", JSON.stringify(dtoVisitante), \\\"/\\\");\\r\\n                    var dtoAnexo;\\r\\n\\r\\n                    switch (objParametroCadastroVisitanteAnexo.nIdFormularioValidacao) {\\r\\n                        case \\\"uc_MuralDetalheForum\\\":\\r\\n                            $(\\\"#tbnCdVisitanteCadastroVisitanteAnexo\\\").val(objRetorno.nCdCodigo);\\r\\n                            MuralDetalheForum_EnviarMensagem(objParametroCadastroVisitanteAnexo.nCdMensagemClicado);\\r\\n                            btCadastroVisitanteVoltar_ClickCadastroVisitanteAnexo();\\r\\n                            break;\\r\\n                        case \\\"uc_MuralDetalheAnexo\\\":\\r\\n                            var oAnexoClicado = $.grep(objParametroCadastroVisitanteAnexo.arrAnexos, function (a) { return (a.nCdAnexo == objParametroCadastroVisitanteAnexo.nCdAnexoClicado \\u0026\\u0026 a.nSqAnexo == objParametroCadastroVisitanteAnexo.nSqAnexoClicado); })[0];\\r\\n\\r\\n                            var sLocal = \\\"EditalAnexos\\\";\\r\\n                            if (objParametroCadastroVisitanteAnexo.nCdModuloClicado == MURAL.MODULO.Cotacao\\r\\n                                \\u0026\\u0026 objParametroCadastroVisitanteAnexo.nCdOrigemClicado != -2147483648) {\\r\\n                                sLocal = \\\"CotacaoAnexos\\\";\\r\\n                            }\\r\\n\\r\\n                            if (objParametroCadastroVisitanteAnexo.nCdModuloClicado == MURAL.MODULO.Credenciamento) {\\r\\n                                if (objRetorno.nCdOrigem != -2147483648)\\r\\n                                    sLocal = \\\"EditalCredenciamentoAnexo\\\";\\r\\n                                else\\r\\n                                    sLocal = \\\"EditalAnexos\\\";\\r\\n                            }\\r\\n                            if (objParametroCadastroVisitanteAnexo.nCdModuloClicado == MURAL.MODULO.Licitacao\\r\\n                                \\u0026\\u0026 objParametroCadastroVisitanteAnexo.nCdOrigemClicado != -2147483648) {\\r\\n                                sLocal = \\\"Licitacao/Anexo\\\";\\r\\n                            }\\r\\n\\r\\n                            dtoAnexo = {\\r\\n                                sNmLocalAnexo: sLocal,\\r\\n                                sNmArquivo: oAnexoClicado.sNmArquivo\\r\\n                            }\\r\\n                            break;\\r\\n                        case \\\"uc_MuralDetalheAnexoProposta\\\":\\r\\n                        case \\\"uc_MuralDetalheAnexoLance\\\":\\r\\n                        case \\\"uc_MuralDetalheAnexoNegociacao\\\":\\r\\n                            var oAnexoClicado;\\r\\n                            var i = 0;\\r\\n                            while (oAnexoClicado == undefined) {\\r\\n                                oAnexoClicado = $.grep(objParametroCadastroVisitanteAnexo.arrAnexos[i].items, function (a) { return (a.nCdAnexo == objParametroCadastroVisitanteAnexo.nCdAnexoClicado \\u0026\\u0026 a.nSqAnexo == objParametroCadastroVisitanteAnexo.nSqAnexoClicado); })[0];\\r\\n                                i++;\\r\\n                            }\\r\\n                            var sLocal = \\\"PregaoEletronico\\\";\\r\\n                            if (objParametroCadastroVisitanteAnexo.nCdModuloClicado == MURAL.MODULO.Licitacao\\r\\n                                \\u0026\\u0026 objParametroCadastroVisitanteAnexo.nCdOrigemClicado != -2147483648) {\\r\\n                                sLocal = \\\"Licitacao/AnexoPropostaComercial/\\\";\\r\\n                            }\\r\\n                            dtoAnexo = {\\r\\n                                sNmLocalAnexo: sLocal,\\r\\n                                sNmArquivo: oAnexoClicado.sNmArquivo\\r\\n                            }\\r\\n                            break;\\r\\n                        case \\\"uc_MuralDetalheAnexoHabilitacao\\\":\\r\\n                            var oAnexoClicado;\\r\\n                            var i = 0;\\r\\n                            while (oAnexoClicado == undefined) {\\r\\n                                oAnexoClicado = $.grep(objParametroCadastroVisitanteAnexo.arrAnexos[i].items, function (a) { return (a.nCdAnexo == objParametroCadastroVisitanteAnexo.nCdAnexoClicado \\u0026\\u0026 a.nSqAnexo == objParametroCadastroVisitanteAnexo.nSqAnexoClicado); })[0];\\r\\n                                i++;\\r\\n                            }\\r\\n                            var sLocal = \\\"PregaoEletronico\\\";\\r\\n                            if (objParametroCadastroVisitanteAnexo.nCdModuloClicado == MURAL.MODULO.Licitacao\\r\\n                                \\u0026\\u0026 objParametroCadastroVisitanteAnexo.nCdOrigemClicado != -2147483648) {\\r\\n                                sLocal = \\\"Licitacao/AnexoHabilitacao/\\\";\\r\\n                            }\\r\\n                            dtoAnexo = {\\r\\n                                sNmLocalAnexo: sLocal,\\r\\n                                sNmArquivo: oAnexoClicado.sNmArquivo\\r\\n                            }\\r\\n                            break;\\r\\n                        case \\\"uc_MuralDetalheAnexoRecurso\\\":\\r\\n                            var oAnexoClicado = $.grep(objParametroCadastroVisitanteAnexo.arrAnexos, function (a) { return (a.nCdAnexo == objParametroCadastroVisitanteAnexo.nCdAnexoClicado \\u0026\\u0026 a.nSqAnexo == objParametroCadastroVisitanteAnexo.nSqAnexoClicado); })[0];\\r\\n\\r\\n                            var sLocal = \\\"PregaoEletronico/Recursos\\\";\\r\\n\\r\\n                            if (objParametroCadastroVisitanteAnexo.nCdModuloClicado == MURAL.MODULO.Licitacao\\r\\n                                \\u0026\\u0026 objParametroCadastroVisitanteAnexo.nCdOrigemClicado != -2147483648) {\\r\\n                                sLocal = \\\"Licitacao/AnexoRecurso/\\\";\\r\\n                            }\\r\\n                            dtoAnexo = {\\r\\n                                sNmLocalAnexo: sLocal,\\r\\n                                sNmArquivo: oAnexoClicado.sNmArquivo\\r\\n                            }\\r\\n                            break;\\r\\n                        case \\\"uc_MuralDetalheAnexoContraRazoes\\\":\\r\\n                            var oAnexoClicado = $.grep(objParametroCadastroVisitanteAnexo.arrAnexos, function (a) { return (a.nCdAnexo == objParametroCadastroVisitanteAnexo.nCdAnexoClicado \\u0026\\u0026 a.nSqAnexo == objParametroCadastroVisitanteAnexo.nSqAnexoClicado); })[0];\\r\\n\\r\\n                            var sLocal = \\\"PregaoEletronico/Recursos\\\";\\r\\n\\r\\n                            if (objParametroCadastroVisitanteAnexo.nCdModuloClicado == MURAL.MODULO.Licitacao\\r\\n                                \\u0026\\u0026 objParametroCadastroVisitanteAnexo.nCdOrigemClicado != -2147483648) {\\r\\n                                sLocal = \\\"Licitacao/AnexoRecursoContrarrazao/\\\";\\r\\n                            }\\r\\n                            dtoAnexo = {\\r\\n                                sNmLocalAnexo: sLocal,\\r\\n                                sNmArquivo: oAnexoClicado.sNmArquivo\\r\\n                            }\\r\\n                            break;\\r\\n                        case \\\"uc_MuralDetalheAnexoParecer\\\":\\r\\n                            var oAnexoClicado = $.grep(objParametroCadastroVisitanteAnexo.arrAnexos, function (a) { return (a.nCdAnexo == objParametroCadastroVisitanteAnexo.nCdAnexoClicado \\u0026\\u0026 a.nSqAnexo == objParametroCadastroVisitanteAnexo.nSqAnexoClicado); })[0];\\r\\n\\r\\n                            var sLocal = \\\"PregaoEletronico/Recursos\\\";\\r\\n\\r\\n                            if (objParametroCadastroVisitanteAnexo.nCdModuloClicado == MURAL.MODULO.Licitacao\\r\\n                                \\u0026\\u0026 objParametroCadastroVisitanteAnexo.nCdOrigemClicado != -2147483648) {\\r\\n                                sLocal = \\\"Licitacao/AnexoRecursoParecer/\\\";\\r\\n                            }\\r\\n                            dtoAnexo = {\\r\\n                                sNmLocalAnexo: sLocal,\\r\\n                                sNmArquivo: oAnexoClicado.sNmArquivo\\r\\n                            }\\r\\n                            break;\\r\\n                    }\\r\\n\\r\\n                    if (objParametroCadastroVisitanteAnexo.nIdFormularioValidacao != \\u0027uc_MuralDetalheForum\\u0027) {\\r\\n                        chamadaWebService(\\r\\n                            \\\"WebService/Servicos.asmx/AnexoExiste\\\",\\r\\n                            \\\"dtoAnexo:\\\" + JSON.stringify(dtoAnexo),\\r\\n                            function (_retorno) {\\r\\n                                if (_retorno.d != \\\"\\\") {\\r\\n                                    Alerta(_retorno.d, \\\"/\\\");\\r\\n                                    btCadastroVisitanteVoltar_ClickCadastroVisitanteAnexo();\\r\\n                                }\\r\\n                                else {\\r\\n                                    window.open(\\\"Download.aspx\\\" + oAnexoClicado.sDsParametroCriptografado, \\\"_self\\\");\\r\\n                                    btCadastroVisitanteVoltar_ClickCadastroVisitanteAnexo();\\r\\n                                }\\r\\n                            },\\r\\n                        );\\r\\n                    }\\r\\n                }\\r\\n            },\\r\\n            function () {\\r\\n                Alerta(\\\"Não foi possível recuperar os dados desse registro!\\\", \\\"/\\\");\\r\\n                btCadastroVisitanteVoltar_ClickCadastroVisitanteAnexo();\\r\\n            }\\r\\n        );\\r\\n\\r\\n    }\\r\\n    function SalvarEmpresaCadastroVisitanteAnexo() {\\r\\n        var dtoVisitante = adquirirCookie(\\\"CK_VISITANTE_TEMP\\\", \\\"/\\\");\\r\\n\\r\\n        if (dtoVisitante == \\\"\\\") {\\r\\n            dtoVisitante = {\\r\\n                nCdVisitante: Number($(\\\"#tbnCdVisitanteCadastroVisitanteAnexo\\\").val()) \\u003e 0 ? Number($(\\\"#tbnCdVisitanteCadastroVisitanteAnexo\\\").val()) : 0,\\r\\n                nCdEndereco: Number($(\\\"#tbnCdEnderecoCadastroVisitanteAnexo\\\").val()) \\u003e 0 ? Number($(\\\"#tbnCdEnderecoCadastroVisitanteAnexo\\\").val()) : 0,\\r\\n                nCdEmpresa: Number($(\\\"#tbnCdEmpresaCadastroVisitanteAnexo\\\").val()) \\u003e 0 ? Number($(\\\"#tbnCdEmpresaCadastroVisitanteAnexo\\\").val()) : 0,\\r\\n                sDsCpf: \\\"\\\",\\r\\n                sDsCnpj: \\\"\\\",\\r\\n                sDsRg: $(\\\"#tbRGCadastroVisitanteAnexo\\\").val(),\\r\\n                sNmVisitante: kendo.htmlEncode($(\\\"#tbNomeCadastroVisitanteAnexo\\\").val()),\\r\\n                sDsEmail: $(\\\"#tbEmailCadastroVisitanteAnexo\\\").val(),\\r\\n                sDsTelefone: $(\\\"#tbTelefoneCadastroVisitanteAnexo\\\").val(),\\r\\n                sDsEndereco: kendo.htmlEncode($(\\\"#tbEnderecoCadastroVisitanteAnexo\\\").val()),\\r\\n                sNrEndereco: kendo.htmlEncode($(\\\"#tbNumeroCadastroVisitanteAnexo\\\").val()),\\r\\n                sDsComplemento: kendo.htmlEncode($(\\\"#tbComplementoCadastroVisitanteAnexo\\\").val()),\\r\\n                sNmBairro: kendo.htmlEncode($(\\\"#tbBairroCadastroVisitanteAnexo\\\").val()),\\r\\n                sCdCep: $(\\\"#tbCEPCadastroVisitanteAnexo\\\").val(),\\r\\n                sCdPais: $(\\\"#ddlPaisCadastroVisitanteAnexo option:selected\\\").val(),\\r\\n                sCdEstado: $(\\\"#ddlEstadoCadastroVisitanteAnexo option:selected\\\").val(),\\r\\n                nCdCidade: $(\\\"#ddlCidadeCadastroVisitanteAnexo option:selected\\\").val(),\\r\\n                sDsTipoDocumento: \\\"\\\",\\r\\n                bFlInteresseCertame: $(\\\"input[name=\\u0027InteresseCertameCadastroVisitanteAnexo\\u0027]:checked\\\").val(),\\r\\n                sNmContato: kendo.htmlEncode($(\\\"#tbContatoCadastroVisitanteAnexo\\\").val()),\\r\\n                bFlConsentimentoLGPD: $(\\\"#cbConsentimentoLgpdCadastroVisitanteAnexo\\\").is(\\u0027:checked\\u0027) ? 1 : 0,\\r\\n                dtoAnexo: {\\r\\n                    nCdAnexo: objParametroCadastroVisitanteAnexo.nCdAnexoClicado,\\r\\n                    nSqAnexo: objParametroCadastroVisitanteAnexo.nSqAnexoClicado\\r\\n                },\\r\\n                dtoEdital: {\\r\\n                    nCdEdital: objParametroCadastroVisitanteAnexo.nCdEditalClicado,\\r\\n                    nCdOrigem: objParametroCadastroVisitanteAnexo.nCdOrigemClicado\\r\\n                },\\r\\n                dtoProcesso: {\\r\\n                    nCdProcesso: objParametroCadastroVisitanteAnexo.nCdOrigemClicado,\\r\\n                    nCdModulo: objParametroCadastroVisitanteAnexo.nCdModuloClicado,\\r\\n                    dtoIdioma: {\\r\\n                        nCdIdioma: adquirirIdIdioma(\\\"/\\\")\\r\\n                    }\\r\\n                }\\r\\n            };\\r\\n\\r\\n            if ($(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val() == \\\"CNPJ\\\") {\\r\\n                dtoVisitante.sDsTipoDocumento = \\\"CNPJ\\\";\\r\\n\\r\\n                if (adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n                    dtoVisitante.sDsCnpj = $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").val().replace(/[^a-z0-9]/gi, \\\"\\\");\\r\\n                else\\r\\n                    dtoVisitante.sDsCnpj = $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").val();\\r\\n            }\\r\\n            else if ($(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val() == \\\"CPF\\\") {\\r\\n                dtoVisitante.sDsTipoDocumento = \\\"CPF\\\";\\r\\n\\r\\n                if (adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n                    dtoVisitante.sDsCpf = $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").val().replace(/[^0-9]/g, \\\"\\\");\\r\\n                else\\r\\n                    dtoVisitante.sDsCpf = $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").val();\\r\\n            }\\r\\n        }\\r\\n        else {\\r\\n            dtoVisitante = JSON.parse(dtoVisitante);\\r\\n            dtoVisitante.dtoAnexo.nCdAnexo = objParametroCadastroVisitanteAnexo.nCdAnexoClicado;\\r\\n            dtoVisitante.dtoAnexo.nSqAnexo = objParametroCadastroVisitanteAnexo.nSqAnexoClicado;\\r\\n        }\\r\\n        let checkbox = $(\\u0027#cbPreCadastroCadastroVisitanteAnexo\\u0027);\\r\\n        if (checkbox.is(\\\":checked\\\")) {\\r\\n            chamadaWebService(\\r\\n                \\\"WebService/Servicos.asmx/SalvarEmpresa\\\",\\r\\n                \\\"dtoVisitante:\\\" + JSON.stringify(dtoVisitante),\\r\\n\\r\\n                function (_retorno) {\\r\\n                    if (_retorno.d == 1) {\\r\\n                        Alerta(\\\"Pré-cadastro realizado com sucesso.\\\", \\\"/\\\");\\r\\n                        btCadastroVisitanteVoltar_ClickCadastroVisitanteAnexo();\\r\\n                    }\\r\\n                    else {\\r\\n                        Alerta(\\\"CNPJ já cadastrado no sistema.\\\", \\\"/\\\");\\r\\n                        btCadastroVisitanteVoltar_ClickCadastroVisitanteAnexo();\\r\\n                    }\\r\\n                },\\r\\n            );\\r\\n        }\\r\\n    }\\r\\n\\r\\n\\r\\n    function btCadastroVisitanteVoltar_ClickCadastroVisitanteAnexo() {\\r\\n        reiniciaFormularioCadastroVisitanteAnexo(false);\\r\\n        objParametroCadastroVisitanteAnexo.nCdAnexoClicado = 0;\\r\\n        objParametroCadastroVisitanteAnexo.nCdMensagem