\r\\n            $(\\\"#carregandoSalvarCadastroVisitanteAnexo\\\").fadeOut();\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function desabilitarCpfCadastroVisitanteAnexo() {\\r\\n\\r\\n        reiniciaFormularioCadastroVisitanteAnexo(true);\\r\\n\\r\\n        $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").unmask();\\r\\n\\r\\n        if ($(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val() == \\\"CNPJ\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").mask(\\\"**.***.***/****-**\\\");\\r\\n        else if ($(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val() == \\\"CPF\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").mask(\\\"999.999.999-99\\\");\\r\\n    }\\r\\n\\r\\n    function desabilitarBotoesCertameCadastroVisitanteAnexo() {\\r\\n\\r\\n        reiniciaFormularioCadastroVisitanteAnexo(true);\\r\\n\\r\\n        $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").unmask();\\r\\n\\r\\n        if ($(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val() == \\\"CNPJ\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").mask(\\\"**.***.***/****-**\\\");\\r\\n        else if ($(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val() == \\\"CPF\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").mask(\\\"999.999.999-99\\\");\\r\\n    }\\r\\n\\r\\n    // FunÃ§Ã£o para configurar campos baseado no JSON\\r\\n    function configurarCamposJsonCadastroVisitanteAnexo() {\\r\\n        try {\\r\\n            if (!objJsonConfigCamposCadastroVisitanteAnexo) {\\r\\n                return;\\r\\n            }\\r\\n\\r\\n            var tipoSelecionado = $(\\u0027input[name=\\\"documentoCadastroVisitanteAnexo\\\"]:checked\\u0027).val();\\r\\n            if (!tipoSelecionado) {\\r\\n                $(\\u0027#rbCPFCadastroVisitanteAnexo\\u0027).prop(\\u0027checked\\u0027, true);\\r\\n                tipoSelecionado = \\u0027CPF\\u0027;\\r\\n            }\\r\\n\\r\\n            if (tipoSelecionado) {\\r\\n                var tipoConvertido = tipoSelecionado === \\u0027CPF\\u0027 ? \\u00271\\u0027 : \\u00272\\u0027;\\r\\n                configurarCamposPorTipoCadastroVisitanteAnexo(tipoConvertido);\\r\\n            }\\r\\n\\r\\n        } catch (e) {\\r\\n            console.error(\\u0027Erro ao configurar campos JSON:\\u0027, e);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    // FunÃ§Ã£o para configurar campos por tipo (CPF/CNPJ)\\r\\n    function configurarCamposPorTipoCadastroVisitanteAnexo(sTipoPessoa) {\\r\\n        try {\\r\\n            if (!objJsonConfigCamposCadastroVisitanteAnexo || typeof objJsonConfigCamposCadastroVisitanteAnexo !== \\u0027object\\u0027) {\\r\\n                return;\\r\\n            }\\r\\n\\r\\n            var config = null;\\r\\n            if (sTipoPessoa === \\u00271\\u0027) {\\r\\n                config = objJsonConfigCamposCadastroVisitanteAnexo.pessoaFisica;\\r\\n\\r\\n            } else if (sTipoPessoa === \\u00272\\u0027) {\\r\\n                config = objJsonConfigCamposCadastroVisitanteAnexo.pessoaJuridica;\\r\\n            }\\r\\n\\r\\n            if (!config) {\\r\\n                return;\\r\\n            }\\r\\n\\r\\n            var temContato = config.camposObrigatorios \\u0026\\u0026 config.camposObrigatorios.some(function(campo) {\\r\\n                return campo.toLowerCase() === \\u0027contato\\u0027 || campo.toLowerCase() === \\u0027nomecontato\\u0027;\\r\\n            });\\r\\n\\r\\n            // Mapeamento dos campos para containers no formulÃ¡rio\\r\\n            var mapeamentoCampos = {\\r\\n                \\u0027nome\\u0027: \\u0027#spanNomeCadastroVisitanteAnexo\\u0027,\\r\\n                \\u0027razaosocial\\u0027: \\u0027#spanNomeCadastroVisitanteAnexo\\u0027,\\r\\n                \\u0027rg\\u0027: \\u0027#spanRGCadastroVisitanteAnexo\\u0027,\\r\\n                \\u0027email\\u0027: { elemento: \\u0027#tbEmailCadastroVisitanteAnexo\\u0027, container: \\u0027.span3\\u0027 },\\r\\n                \\u0027telefone\\u0027: { elemento: \\u0027#tbTelefoneCadastroVisitanteAnexo\\u0027, container: \\u0027.span2\\u0027 },\\r\\n                \\u0027contato\\u0027: \\u0027#divContatoCadastroVisitanteAnexo\\u0027,\\r\\n                \\u0027endereco\\u0027: \\u0027#divEnderecoCadastroVisitanteAnexo\\u0027,\\r\\n                \\u0027numero\\u0027: \\u0027#divNumeroCadastroVisitanteAnexo\\u0027,\\r\\n                \\u0027complemento\\u0027: { elemento: \\u0027#tbComplementoCadastroVisitanteAnexo\\u0027, container: \\u0027.span5\\u0027 },\\r\\n                \\u0027bairro\\u0027: { elemento: \\u0027#tbBairroCadastroVisitanteAnexo\\u0027, container: \\u0027.span5\\u0027 },\\r\\n                \\u0027cep\\u0027: { elemento: \\u0027#tbCEPCadastroVisitanteAnexo\\u0027, container: \\u0027.span2\\u0027 },\\r\\n                \\u0027pais\\u0027: { elemento: \\u0027#ddlPaisCadastroVisitanteAnexo\\u0027, container: \\u0027.span4\\u0027 },\\r\\n                \\u0027estado\\u0027: { elemento: \\u0027#ddlEstadoCadastroVisitanteAnexo\\u0027, container: \\u0027.span4\\u0027 },\\r\\n                \\u0027cidade\\u0027: { elemento: \\u0027#ddlCidadeCadastroVisitanteAnexo\\u0027, container: \\u0027.span4\\u0027 }\\r\\n            };\\r\\n\\r\\n            // Lista de todos os campos controlÃ¡veis\\r\\n            var todosCampos = [\\r\\n                \\u0027#spanRGCadastroVisitanteAnexo\\u0027,\\r\\n                { elemento: \\u0027#tbEmailCadastroVisitanteAnexo\\u0027, container: \\u0027.span3\\u0027 },\\r\\n                { elemento: \\u0027#tbTelefoneCadastroVisitanteAnexo\\u0027, container: \\u0027.span2\\u0027 },\\r\\n                \\u0027#divContatoCadastroVisitanteAnexo\\u0027,\\r\\n                \\u0027#divEnderecoCadastroVisitanteAnexo\\u0027,\\r\\n                \\u0027#divNumeroCadastroVisitanteAnexo\\u0027,\\r\\n                { elemento: \\u0027#tbComplementoCadastroVisitanteAnexo\\u0027, container: \\u0027.span5\\u0027 },\\r\\n                { elemento: \\u0027#tbBairroCadastroVisitanteAnexo\\u0027, container: \\u0027.span5\\u0027 },\\r\\n                { elemento: \\u0027#tbCEPCadastroVisitanteAnexo\\u0027, container: \\u0027.span2\\u0027 },\\r\\n                { elemento: \\u0027#ddlPaisCadastroVisitanteAnexo\\u0027, container: \\u0027.span4\\u0027 },\\r\\n                { elemento: \\u0027#ddlEstadoCadastroVisitanteAnexo\\u0027, container: \\u0027.span4\\u0027 },\\r\\n                { elemento: \\u0027#ddlCidadeCadastroVisitanteAnexo\\u0027, container: \\u0027.span4\\u0027 }\\r\\n            ];\\r\\n\\r\\n            // Ocultar todos os campos primeiro\\r\\n            todosCampos.forEach(function(campo) {\\r\\n                if (typeof campo === \\u0027string\\u0027) {\\r\\n                    $(campo).hide();\\r\\n                } else {\\r\\n                    var elemento = $(campo.elemento);\\r\\n                    if (elemento.length \\u003e 0) {\\r\\n                        var containerParaOcultar = elemento.closest(campo.container);\\r\\n                        if (containerParaOcultar.length \\u003e 0) {\\r\\n                            containerParaOcultar.hide();\\r\\n                        }\\r\\n                    }\\r\\n                }\\r\\n            });\\r\\n\\r\\n            // Mostrar apenas os campos obrigatÃ³rios\\r\\n            if (config.camposObrigatorios \\u0026\\u0026 config.camposObrigatorios.length \\u003e 0) {\\r\\n                config.camposObrigatorios.forEach(function(campoConfig) {\\r\\n                    var campoLowerCase = campoConfig.toLowerCase();\\r\\n                    var mapeamento = mapeamentoCampos[campoLowerCase];\\r\\n\\r\\n                    if (campoLowerCase === \\u0027nome\\u0027 || campoLowerCase === \\u0027razaosocial\\u0027) {\\r\\n                        $(\\u0027#spanNomeCadastroVisitanteAnexo\\u0027).show();\\r\\n                        return;\\r\\n                    }\\r\\n\\r\\n                    if (typeof mapeamento === \\u0027string\\u0027) {\\r\\n                        $(mapeamento).show();\\r\\n                    } else if (typeof mapeamento === \\u0027object\\u0027) {\\r\\n                        var elemento = $(mapeamento.elemento);\\r\\n                        if (elemento.length \\u003e 0) {\\r\\n                            var containerParaMostrar = elemento.closest(mapeamento.container);\\r\\n                            if (containerParaMostrar.length \\u003e 0) {\\r\\n                                containerParaMostrar.show();\\r\\n                            }\\r\\n                        }\\r\\n                    }\\r\\n                });\\r\\n\\r\\n                // Sempre garantir que Nome esteja visÃ­vel\\r\\n                $(\\u0027#spanNomeCadastroVisitanteAnexo\\u0027).show();\\r\\n\\r\\n                // VerificaÃ§Ã£o final especÃ­fica para o campo Contato\\r\\n                var contatoConfigurado = config.camposObrigatorios \\u0026\\u0026 config.camposObrigatorios.some(function(campo) {\\r\\n                    var c = campo.toLowerCase();\\r\\n                    return c === \\u0027contato\\u0027 || c === \\u0027nomecontato\\u0027;\\r\\n                });\\r\\n\\r\\n                if (!contatoConfigurado) {\\r\\n                    $(\\u0027#divContatoCadastroVisitanteAnexo\\u0027).hide();\\r\\n                    console.log(\\u0027Campo Contato forÃ§adamente oculto pois nÃ£o estÃ¡ na configuraÃ§Ã£o JSON\\u0027);\\r\\n                } else {\\r\\n                    $(\\u0027#divContatoCadastroVisitanteAnexo\\u0027).show();\\r\\n                    console.log(\\u0027Campo Contato exibido conforme configuraÃ§Ã£o JSON\\u0027);\\r\\n                }\\r\\n\\r\\n            } else {\\r\\n                // Se nÃ£o hÃ¡ configuraÃ§Ã£o JSON, mostrar todos os campos (comportamento padrÃ£o)\\r\\n                todosCampos.forEach(function(campo) {\\r\\n                    if (typeof campo === \\u0027string\\u0027) {\\r\\n                        $(campo).show();\\r\\n                    } else {\\r\\n                        var elemento = $(campo.elemento);\\r\\n                        if (elemento.length \\u003e 0) {\\r\\n                            var containerParaMostrar = elemento.closest(campo.container);\\r\\n                            if (containerParaMostrar.length \\u003e 0) {\\r\\n                                containerParaMostrar.show();\\r\\n                            }\\r\\n                        }\\r\\n                    }\\r\\n                });\\r\\n                $(\\u0027#spanNomeCadastroVisitanteAnexo\\u0027).show();\\r\\n            }\\r\\n\\r\\n        } catch (e) {\\r\\n            console.error(\\u0027Erro na configuraÃ§Ã£o de campos por tipo:\\u0027, e);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    // FunÃ§Ã£o para configurar visibilidade do LGPD\\r\\n    function configurarVisibilidadeLGPDCadastroVisitanteAnexo() {\\r\\n        try {\\r\\n            var tipoSelecionado = $(\\u0027input[name=\\\"documentoCadastroVisitanteAnexo\\\"]:checked\\u0027).val();\\r\\n            var mostrarLGPD = false;\\r\\n\\r\\n            if (!tipoSelecionado) {\\r\\n                $(\\u0027#divConsentimentoLgpdCadastroVisitanteAnexo\\u0027).hide();\\r\\n                $(\\u0027#cbConsentimentoLgpdCadastroVisitanteAnexo\\u0027).prop(\\u0027checked\\u0027, false);\\r\\n                return;\\r\\n            }\\r\\n\\r\\n            var exigirLGPDPorPadrao = $(\\u0027#painelCadastroCadastroVisitanteAnexo\\u0027).data(\\u0027exigirLgpd\\u0027);\\r\\n            if (exigirLGPDPorPadrao === true \\u0026\\u0026 \\\"CadastroVisitanteAnexo\\\" === \\\"CadastroVisitanteForum\\\") {\\r\\n                if (tipoSelecionado === \\u0027CPF\\u0027) {\\r\\n                    mostrarLGPD = true;\\r\\n                }\\r\\n            }\\r\\n\\r\\n            else if (objJsonConfigCamposCadastroVisitanteAnexo \\u0026\\u0026 tipoSelecionado) {\\r\\n                var config = null;\\r\\n                if (tipoSelecionado === \\u0027CPF\\u0027) {\\r\\n                    config = objJsonConfigCamposCadastroVisitanteAnexo.pessoaFisica;\\r\\n                } else if (tipoSelecionado === \\u0027CNPJ\\u0027) {\\r\\n                    config = objJsonConfigCamposCadastroVisitanteAnexo.pessoaJuridica;\\r\\n                }\\r\\n\\r\\n                if (config \\u0026\\u0026 config.exigirConsentimentoLGPD !== undefined) {\\r\\n                    mostrarLGPD = config.exigirConsentimentoLGPD;\\r\\n                }\\r\\n            } else if (typeof bFlExibirCheckboxLgpdCadastroVisitanteAnexo !== \\u0027undefined\\u0027) {\\r\\n                mostrarLGPD = bFlExibirCheckboxLgpdCadastroVisitanteAnexo;\\r\\n            }\\r\\n\\r\\n            var divLgpd = $(\\u0027#divConsentimentoLgpdCadastroVisitanteAnexo\\u0027);\\r\\n            if (divLgpd.length \\u003e 0) {\\r\\n                if (mostrarLGPD) {\\r\\n                    divLgpd.show();\\r\\n                } else {\\r\\n                    divLgpd.hide();\\r\\n                    $(\\u0027#cbConsentimentoLgpdCadastroVisitanteAnexo\\u0027).prop(\\u0027checked\\u0027, false);\\r\\n                }\\r\\n            }\\r\\n\\r\\n        } catch (e) {\\r\\n        }\\r\\n    }\\r\\n\\r\\n\\u003c/script\\u003e\\r\\n\\r\\n\\r\\n    \\r\\n\\u003cscript type=\\\"text/javascript\\\"\\u003e\\r\\n\\r\\n    //Todos os objetos com  o nome dinâmico são a partir do userControl de Cadastro de visitante, pois este é usado por outras telas a partir de agora.\\r\\n    var objParametroCadastroVisitanteAnexo;\\r\\n\\r\\n    MuralDetalheAnexo_Load(\\u0027{\\\"nCdAnexo\\\":4728668,\\\"nCdAnexoClicado\\\":0,\\\"nSqAnexoClicado\\\":0,\\\"nCdEditalClicado\\\":588,\\\"nCdOrigemClicado\\\":588,\\\"nCdModuloClicado\\\":59,\\\"arrAnexos\\\":[],\\\"divAnexo\\\":\\\"divAnexo\\\",\\\"nIdFormularioValidacao\\\":\\\"\\\"}\\u0027);\\r\\n\\r\\n    function MuralDetalheAnexo_Load(_objParametros) {\\r\\n        objParametroCadastroVisitanteAnexo = JSON.parse(_objParametros);\\r\\n\\r\\n        removerCookie(\\\"CK_VISITANTE_TEMP\\\", \\\"/\\\");\\r\\n\\r\\n        var sSchema = [{\\r\\n            nCdAnexo: { type: \\\"number\\\" },\\r\\n            nSqAnexo: { type: \\\"number\\\" },\\r\\n            sDsAnexo: { type: \\\"string\\\" },\\r\\n            tDtAnexo: { type: \\\"string\\\" }\\r\\n        }];\\r\\n\\r\\n        var bFlEscondeOrigem = objParametroCadastroVisitanteAnexo.bFlEscondeOrigem ?? false;\\r\\n        var lBlDescricao = \\\"Descrição\\\";\\r\\n\\r\\n        if (objParametroCadastroVisitanteAnexo.nCdModuloClicado == 53) {\\r\\n            bFlEscondeOrigem = true;\\r\\n            lBlDescricao = \\\"Arquivos\\\";\\r\\n        }\\r\\n\\r\\n        var sColunas = [\\r\\n            { field: \\\"sDsAnexo\\\", title: lBlDescricao, width: \\\"200px\\\", template: \\u0027#=formataAnexo(nCdAnexo, sDsAnexo, nSqAnexo, bFlRetificacao, nNrVersaoRerratificacaoPNCP)#\\u0027 },\\r\\n            { field: \\\"sNmArquivo\\\", title: \\\"Origem\\\", width: \\\"80px\\\", template: \\u0027#=formataTextoGrid(sDsOrigem)#\\u0027, hidden: bFlEscondeOrigem},\\r\\n            { field: \\\"tDtAnexo\\\", title: \\\"Data\\\", template: \\u0027#=formataDataHora(tDtAnexo)#\\u0027, width: \\\"40px\\\" }\\r\\n        ];\\r\\n\\r\\n        objParametroCadastroVisitanteAnexo.nCdAnexoClicado = 0;\\r\\n        objParametroCadastroVisitanteAnexo.nSqAnexoClicado = 0;\\r\\n        objParametroCadastroVisitanteAnexo.arrAnexos = [];\\r\\n        objParametroCadastroVisitanteAnexo.nIdFormularioValidacao = \\\"uc_MuralDetalheAnexo\\\";\\r\\n        \\r\\n        var sLocal = \\\"EditalAnexos\\\";\\r\\n        if (objParametroCadastroVisitanteAnexo.nCdModuloClicado == (8))\\r\\n            sLocal = \\\"CotacaoAnexos\\\";\\r\\n        if (objParametroCadastroVisitanteAnexo.nCdModuloClicado == (53) \\u0026\\u0026 objParametroCadastroVisitanteAnexo.nCdOrigemClicado != -2147483648)\\r\\n            sLocal = \\\"EditalCredenciamentoAnexo\\\";\\r\\n\\r\\n        var dtoAnexo = {\\r\\n            nCdAnexo: objParametroCadastroVisitanteAnexo.nCdAnexo,\\r\\n            sNmLocalAnexo: sLocal,\\r\\n            nCdModulo: objParametroCadastroVisitanteAnexo.nCdModuloClicado,\\r\\n            nCdOrigem: objParametroCadastroVisitanteAnexo.nCdOrigemClicado,\\r\\n            bFlPublico: 1\\r\\n        }\\r\\n        \\r\\n        CarregaGrid(\\r\\n            sSchema,\\r\\n            \\\"WebService/Servicos.asmx/PesquisarAnexos\\\",\\r\\n            \\\"dtoAnexo:\\\" + JSON.stringify(dtoAnexo),\\r\\n            function (data) {\\r\\n                objParametroCadastroVisitanteAnexo.arrAnexos = data.items;\\r\\n                reiniciaFormularioCadastroVisitanteAnexo(false);\\r\\n            },\\r\\n            \\\"gridAnexo\\\",\\r\\n            sColunas,\\r\\n            278\\r\\n        );\\r\\n\\r\\n        $(\\\".campo-uniform-CadastroVisitanteAnexo\\\").uniform();\\r\\n\\r\\n        //hack para resolver problema em versões antigas\\r\\n        var divElements = document.querySelectorAll(\\\"div[id^=\\u0027uniform-ddl\\u0027]\\\");\\r\\n\\r\\n        for (var i = 0; i \\u003c divElements.length; i++) {\\r\\n            var divElement = divElements[i];\\r\\n            var childDiv = divElement.querySelector(\\\"div\\\");\\r\\n\\r\\n\\r\\n\\r\\n            if (childDiv \\u0026\\u0026 childDiv.id === divElement.id) {\\r\\n                var spanElement = divElement.getElementsByTagName(\\\"span\\\")[0];\\r\\n\\r\\n\\r\\n\\r\\n                if (spanElement) {\\r\\n                    spanElement.parentNode.removeChild(spanElement);\\r\\n                }\\r\\n\\r\\n\\r\\n\\r\\n                divElement.className = \\\"\\\";\\r\\n            }\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function formataAnexo(_nCdAnexo, _sDsAnexo, _nSqAnexo, _bFlRetificacao, _nNrVersaoRerratificacaoPNCP) {\\r\\n        var sDsTag = \\\"\\\";\\r\\n        if (_bFlRetificacao) {\\r\\n            _sDsAnexo = \\\"\\u003cspan\\u003e\\\" + _sDsAnexo + \\\"\\u003c/span\\u003e\\\" + \\\"\\u003cspan class=\\u0027badget-retificado\\u0027\\u003eRetificação\\u003c/span\\u003e\\\"\\r\\n        }\\r\\n        if (_nNrVersaoRerratificacaoPNCP \\u003e 0 \\u0026\\u0026 0 == 1) {\\r\\n            sDsTag = \\\"\\u003cspan class=\\u0027badget-retificado\\u0027\\u003eRetificação \\\" + _nNrVersaoRerratificacaoPNCP + \\\"\\u003c/span\\u003e\\\"\\r\\n        }\\r\\n        return \\\"\\u003cdiv onclick=\\u0027btBaixaAnexo(\\\" + _nCdAnexo + \\\", \\\" + _nSqAnexo + \\\")\\u0027 class=\\u0027areaClique\\u0027\\u003e\\\" + _sDsAnexo + sDsTag + \\\"\\u003c/div\\u003e\\\";\\r\\n    }\\r\\n\\r\\n    function btBaixaAnexo(_nCdAnexo, _nSqAnexo) {\\r\\n       \\r\\n        var lstOrigemAnexoIgnoraCadastro = [];\\r\\n        lstOrigemAnexoIgnoraCadastro.push(20);\\r\\n\\r\\n        var bFlCadastroParaEfetuarDownloadAnexoAreaPublica = objConfiguracao.bFlCadastroParaEfetuarDownloadAnexoAreaPublica \\u0026\\u0026 !lstOrigemAnexoIgnoraCadastro.includes(objParametroCadastroVisitanteAnexo.nCdModuloClicado);\\r\\n\\r\\n        objParametroCadastroVisitanteAnexo.nCdAnexoClicado = _nCdAnexo;\\r\\n        objParametroCadastroVisitanteAnexo.nSqAnexoClicado = _nSqAnexo;\\r\\n\\r\\n        var objVisitanteTemp = adquirirCookie(\\\"CK_VISITANTE_TEMP\\\", \\\"/\\\");\\r\\n\\r\\n        var bFlPermiteCadastro = 0;\\r\\n        var cwAnexoVisitante = { nCdAnexo: _nCdAnexo, nSqAnexo: _nSqAnexo, nIdTipoOrigem: objParametroCadastroVisitanteAnexo.nCdModuloClicado, nCdOrigem: objParametroCadastroVisitanteAnexo.nCdOrigemClicado };\\r\\n        chamadaWebServiceAsync(\\\"WebService/Servicos.asmx/ValidarSalvarVisitante\\\", \\\"cwAnexoVisitante:\\\" + JSON.stringify(cwAnexoVisitante), function (_retorno) { bFlPermiteCadastro = _retorno.d; }, function () { bFlPermiteCadastro = 1; });\\r\\n        \\r\\n        if (bFlCadastroParaEfetuarDownloadAnexoAreaPublica \\u003e 0 \\u0026\\u0026 objVisitanteTemp == \\\"\\\" \\u0026\\u0026 bFlPermiteCadastro \\u003e 0) {\\r\\n            \\r\\n            preparaValidacaoVisitanteCadastroVisitanteAnexo();\\r\\n\\r\\n            $(\\\"#gridAnexo\\\").animate({ opacity: 0 }, 300, function () {\\r\\n\\r\\n                $(\\\"#gridAnexo\\\").hide();\\r\\n                $(\\\"#painelCadastroCadastroVisitanteAnexo\\\").show();\\r\\n\\r\\n                $(\\\"#painelCadastroCadastroVisitanteAnexo\\\").animate({ opacity: 1 }, 300, function () {\\r\\n\\r\\n                    if (adquirirIdIdioma(\\\"/\\\") != \\\"1\\\") {\\r\\n                        $(\\\"#uniform-rbCNPJCadastroVisitanteAnexo\\\").hide();\\r\\n                        $(\\\"#lblCNPJCadastroVisitanteAnexo\\\").hide();\\r\\n                    }\\r\\n                    else {\\r\\n                        $(\\\"#uniform-rbCNPJCadastroVisitanteAnexo\\\").show();\\r\\n                        $(\\\"#lblCNPJCadastroVisitanteAnexo\\\").show();\\r\\n                    }\\r\\n\\r\\n                    CarregarRegiaoCadastroVisitanteAnexo(enumTipoRegiao.PAIS);\\r\\n                });\\r\\n            });\\r\\n        }\\r\\n        else {\\r\\n            if (objVisitanteTemp != \\\"\\\" \\u0026\\u0026 bFlPermiteCadastro \\u003e 0)\\r\\n                SalvarVisitanteCadastroVisitanteAnexo();\\r\\n            else {\\r\\n                var oAnexoClicado = $.grep(objParametroCadastroVisitanteAnexo.arrAnexos, function (a) { return a.nCdAnexo == objParametroCadastroVisitanteAnexo.nCdAnexoClicado \\u0026\\u0026 a.nSqAnexo == objParametroCadastroVisitanteAnexo.nSqAnexoClicado; })[0];\\r\\n                if (oAnexoClicado.sDsOrigem == \\\"Recurso\\\") {\\r\\n                    var link = \\u0027/upload/IntencaoDeRecursoERecursoAnexos/\\u0027 + oAnexoClicado.sNmArquivo;\\r\\n                    window.open(link);\\r\\n                } else if (oAnexoClicado.sDsOrigem == \\\"Publicidade\\\") {\\r\\n                    var link = \\u0027/upload/EditalAnexosPublicidade/\\u0027 + oAnexoClicado.sNmArquivo;\\r\\n                    window.open(link);\\r\\n                }\\r\\n                else\\r\\n                    abrirDownloadAnexoComTratamento(oAnexoClicado);\\r\\n            }\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function abrirDownloadAnexoComTratamento(_oAnexoClicado) {\\r\\n        if (!_oAnexoClicado || !_oAnexoClicado.sDsParametroCriptografado) {\\r\\n            Alerta(\\\"Não foi possível recuperar os dados desse registro!\\\", \\\"/\\\");\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        var sUrlDownload = \\\"Download.aspx\\\" + _oAnexoClicado.sDsParametroCriptografado;\\r\\n               \\r\\n        $.ajax({\\r\\n            type: \\\"HEAD\\\",\\r\\n            url: sUrlDownload,\\r\\n            cache: false,\\r\\n            success: function () {\\r\\n                window.open(sUrlDownload, \\\"_self\\\");\\r\\n            },\\r\\n            error: function () {\\r\\n                Alerta(\\\"Não foi possível recuperar os dados desse registro!\\\", \\\"/\\\");\\r\\n            }\\r\\n        });\\r\\n    }\\r\\n\\r\\n\\u003c/script\\u003e\\r\\n\\r\\n\\u003cdiv class=\\\"aspNetHidden\\\"\\u003e\\r\\n\\r\\n\\t\\u003cinput type=\\\"hidden\\\" name=\\\"__VIEWSTATEGENERATOR\\\" id=\\\"__VIEWSTATEGENERATOR\\\" value=\\\"C21772F6\\\" /\\u003e\\r\\n\\u003c/div\\u003e\\u003c/form\\u003e\"}"
