            "mimeType": "text/css",
            "text": "@charset \"UTF-8\";\r\n/* CSS Document */\r\n\r\n\r\n/* ------------------------ GERAL ----------------------- */\r\n\r\nbody { font-size: 14px; }\r\n.conteudo {width: 570px !important;}\r\n\r\n.hide_640 {display: none !important;}\r\n.show_640 {display: block !important}\r\n\r\n\r\n/*--------------------------------------------------------------------------------------------*/\r\n/*--------------------------------------- CABECALHO ------------------------------------------*/\r\n\r\n#cabecalho {\r\n\tpadding: 0px 0px 3px;\r\n\tbackground-position: center 7px;\r\n}\r\n\r\n#cabecalho .conteudo {\tbackground-image: none !important; }\r\n\r\n#cabecalho #marca {\r\n\twidth: 220px;\r\n\theight: auto;\r\n\tfloat: left;\r\n}\r\n\r\n#cabecalho .usuario {\r\n\tmargin-top: 3px;\r\n\tfloat: right;\r\n}\r\n\r\n#cabecalho .usuario a {\r\n\tfont-size: 0.8em;\r\n}\r\n\r\n\r\n/*--------------------------------------------------------------------------------------------*/\r\n/*------------------------------------------ MENU --------------------------------------------*/\r\n\r\n#menu {\r\n\tpadding: 12px 0px;\r\n}\r\n\r\n#menu h3 {\r\n\tcolor: #eee;\r\n}\r\n\r\n#menu div.selector  {\r\n\twidth: 98%;\r\n}\r\n\r\n/*--------------------------------------------------------------------------------------------*/\r\n/*----------------------------------------- CORPO --------------------------------------------*/\r\n\r\n.coluna_esquerda,\r\n.coluna_direita {\r\n\twidth: 100%;\r\n}\r\n\r\n\r\n/*---------------------- PAINÉIS ----------------------*/\r\n\r\n.painel.pregao {\r\n\twidth: 44%;\r\n\tmargin: 0 5% 0 0;\r\n}\r\n\r\n.painel.banners {\r\n\tmargin-top: 10px;\r\n}\r\n\r\n\r\n.painel.banners a {\r\n\tmargin: 1.5%;\r\n    width: 21.5%;\r\n}\r\n\r\n.painel.banners a img {\r\n\twidth:100%;\r\n}"
          },
