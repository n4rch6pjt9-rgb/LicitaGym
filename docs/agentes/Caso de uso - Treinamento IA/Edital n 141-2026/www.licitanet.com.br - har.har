40\\/documentos\\/202440_editais_1790268630.zip\"}],\"files\":[],\"requestsClarification\":[],\"challengeRequests\":[],\"biddingLaw\":2,\"totalItemsMeepp\":false,\"hasMeeppItems\":false,\"isInversion\":false,\"isGuarantee\":false},{\"identifier\":203270,\"status\":\"RECEBENDO PROPOSTA\",\"description\":\"AQUISI\\u00c7\\u00c3O DE TENDAS TIPO PIRAMIDAL.\",\"datStartSession\":\"22\\/10\\/2026 09:00:00\",\"datFinishSession\":null,\"datPublication\":\"30\\/09\\/2026 15:42:42\",\"datClarificationRequestLimit\":\"19\\/10\\/2026\",\"allowedClarificationRequest\":true,\"document\":\"18.468.033\\/0001-26\",\"buyer\":\"MUNIC\\u00cdPIO DE PATROC\\u00cdNIO\\/MG\",\"phone\":\"3438391800\",\"email\":\"licitacaoptc@patrocinio.mg.gov.br\",\"city\":\"Patroc\\u00ednio\",\"uf\":\"MG\",\"crier\":\"Vanessa Patricia Ferreira\",\"documentCrier\":\"09607308697\",\"numBatches\":4,\"year\":2026,\"number\":\"137\",\"biddingProcess\":\"200\",\"isSuspended\":false,\"isCanceled\":false,\"typeBid\":1,\"typeBidText\":\"Menor Pre\\u00e7o por Item\",\"decree\":1,\"typeModel\":1,\"typeModelText\":\"Modo Aberto\",\"disputeMode\":1,\"disputeModeText\":\"PREG\\u00c3O ELETR\\u00d4NICO\",\"isRevoked\":false,\"isPriceRecord\":true,\"isCovid\":false,\"typeRegionalBenefit\":1,\"regionalCities\":[],\"regionalBenefit\":\"N\\u00e3o se aplica\",\"regionalBenefitCeiling\":10,\"isExclusiveRegionalBenefit\":false,\"acquisition\":\"Bens\",\"isAutomaticDispute\":false,\"notices\":[{\"identifier\":413886,\"datUpload\":\"2026-09-30 15:36:24\",\"name\":\"203270_editais_1790793383.zip\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/203270\\/documentos\\/203270_editais_1790793383.zip\"}],\"files\":[],\"requestsClarification\":[{\"orderDate\":\"09\\/10\\/2026 17:41:35\",\"replyDate\":null,\"order\":\"Esclarecimento quanto ao material da calha \\u2013 Itens 02, 03 e 04 Prezados Senhores, A empresa interessada em participar do certame referente ao Edital n\\u00ba 137\\/2026 \\u2013 Processo n\\u00ba 200\\/2026, vem, respeitosamente, solicitar esclarecimento quanto \\u00e0 especifica\\u00e7\\u00e3o t\\u00e9cnica dos Itens 02, 03 e 04, especificamente no que se refere ao material de fabrica\\u00e7\\u00e3o da calha. Considerando a necessidade de elabora\\u00e7\\u00e3o da proposta de forma precisa e em estrita conformidade com as exig\\u00eancias do edital, solicitamos esclarecer: 1. Qual \\u00e9 o material especificamente exigido para a fabrica\\u00e7\\u00e3o da calha dos Itens 02, 03 e 04? 2. Existe especifica\\u00e7\\u00e3o quanto ao tipo de material, tais como a\\u00e7o galvanizado, alum\\u00ednio, PVC, lona ou outro material? 3. Caso o edital n\\u00e3o estabele\\u00e7a material espec\\u00edfico, ser\\u00e1 aceita calha fabricada em material tecnicamente adequado e compat\\u00edvel com o objeto, desde que atenda integralmente \\u00e0s demais especifica\\u00e7\\u00f5es e \\u00e0 finalidade prevista? O esclarecimento \\u00e9 necess\\u00e1rio para assegurar a isonomia entre os participantes, possibilitar a correta composi\\u00e7\\u00e3o dos custos e garantir que as propostas apresentadas estejam em plena conformidade com as especifica\\u00e7\\u00f5es do certame. Diante do exposto, solicitamos que seja informado, de forma objetiva, qual material dever\\u00e1 ser utilizado na fabrica\\u00e7\\u00e3o da calha dos Itens 02, 03 e 04, bem como eventual especifica\\u00e7\\u00e3o de espessura, acabamento ou demais caracter\\u00edsticas t\\u00e9cnicas, caso sejam exigidas.\",\"reply\":\"\"}],\"challengeRequests\":[],\"biddingLaw\":2,\"totalItemsMeepp\":false,\"hasMeeppItems\":true,\"isInversion\":false,\"isGuarantee\":false},{\"identifier\":203734,\"status\":\"RECEBENDO PROPOSTA\",\"description\":\"REGISTRO DE PRE\\u00c7OS PARA FUTURA E EVENTUAL CONTRATA\\u00c7\\u00c3O DE EMPRESA ESPECIALIZADA, PARA PERFURA\\u00c7\\u00c3O DE PO\\u00c7OS ARTESIANOS (TUBULARES) E SERVI\\u00c7OS DE INSTAL\\u00c7A\\u00c7\\u00c3O EL\\u00c9TRICAS E HIDR\\u00c1ULICAS, NA \\u00c1REA URBANA E RUAL DO MUNIC\