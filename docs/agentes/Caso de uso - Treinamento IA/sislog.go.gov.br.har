      exibaLoad();\r\n            var novoUrl = url + '?interno=sim';\r\n            principal.carregueConteudoComPost(novoUrl, contentIndex, {}, function () { removaLoad(); });\r\n        };\r\n\r\n        return {\r\n            abrirInterno: abrirInterno\r\n        }\r\n    }();\r\n\r\n</script>\r\n\r\n        <section id=\"page-container\" class=\"pt-8\">\r\n\r\n            <div class='containerNotificacao containerNotificacaoGeral'> </div>\r\n\r\n            <div id=\"page-content\">\r\n                \r\n<style>\r\n    .form-horizontal .form-group {\r\n        margin-right: 0px;\r\n        margin-left: 0px;\r\n    }\r\n\r\n    #content .widget {\r\n        padding-bottom: 50px !important;\r\n        overflow: auto;\r\n    }\r\n</style>\r\n\r\n<style type=\"text/css\">\r\n    #formularioPadrao {\r\n        overflow-x: inherit !important;\r\n    }\r\n\r\n    .form-horizontal .form-group {\r\n        margin-left: 0px !important;\r\n        margin-right: 0px !important;\r\n    }\r\n\r\n    .bwizard-steps li.active, .bwizard-steps li.active:focus, .bwizard-steps li.active:hover {\r\n        background: #65a1ab !important;\r\n    }\r\n\r\n        .bwizard-steps li.active small {\r\n            color: #F9F9F9 !important;\r\n        }\r\n\r\n    .bwizard-steps li:focus, .bwizard-steps li:hover {\r\n        background: #F0F3F4 !important;\r\n    }\r\n\r\n    .bwizard-steps.clickable li:hover:not(.active) a {\r\n        color: #242a30;\r\n    }\r\n\r\n    .bwizard .well {\r\n        margin: 10px 0 0 0;\r\n        background: none;\r\n        overflow-x: auto;\r\n    }\r\n\r\n    .bwizard-steps .label {\r\n        float: left !important;\r\n        padding: 0 !important;\r\n        height: 30px !important;\r\n        width: 30px !important;\r\n        line-height: 31px !important;\r\n        text-align: center !important;\r\n        margin-right: 10px !important;\r\n        top: 0 !important;\r\n        background: #6d7479 !important;\r\n        -webkit-border-radius: 50% !important;\r\n        -moz-border-radius: 50% !important;\r\n        border-radius: 50% !important;\r\n    }\r\n\r\n    .bwizard-steps li {\r\n        /*float: none !important;*/\r\n        display: table-cell !important;\r\n        padding: 10px !important;\r\n        line-height: 20px !important;\r\n        background: #f0f3f4 !important;\r\n        -webkit-border-radius: 0 !important;\r\n        -moz-border-radius: 0 !important;\r\n        border-radius: 0 !important;\r\n        border-right: solid 1px #DBDDDE;\r\n        border-right-style: dotted;\r\n    }\r\n\r\n        .bwizard-steps li a {\r\n            margin-left: 0px !important;\r\n            display: block !important;\r\n            text-decoration: none !important;\r\n        }\r\n\r\n    .bwizard-steps a {\r\n        color: #333;\r\n    }\r\n\r\n    .bwizard-steps .active a {\r\n        color: #fff;\r\n        cursor: default;\r\n    }\r\n\r\n\r\n    .complementos {\r\n        webkit-border-radius: 5px 5px 0 0;\r\n        -moz-border-radius: 5px 5px 0 0;\r\n        border-radius: 5px 5px 0 0;\r\n        border: 1px solid rgba(59,161,191,1);\r\n    }\r\n</style>\r\n\r\n<style>\r\n    .jconfirm {\r\n        position: fixed;\r\n        top: 0;\r\n        left: 0;\r\n        right: 0;\r\n        bottom: 0;\r\n        z-index: 99999999;\r\n        font-family: inherit;\r\n        overflow: hidden;\r\n        color: #595a5a;\r\n    }\r\n\r\n        .jconfirm .jconfirm-box div.jconfirm-title-c .jconfirm-title {\r\n            font-size: inherit;\r\n            font-family: inherit;\r\n            display: inline-block;\r\n            vertical-align: middle;\r\n            padding-bottom: 15px;\r\n            color: #595a5a;\r\n        }\r\n</style>\r\n\r\n\r\n<div class=\"container-page\">\r\n\r\n<input id=\"hdnCodLicitacao\" name=\"Id\" type=\"hidden\" value=\"114655\" />        <form asp-formhelper=\"true\" data=\"data-parsley-validate\" id=\"formularioPadrao\" replace-id=\"formularioPadrao\">\r\n\r\n            <div class=\"row justify-content-center\">\r\n                <div class=\"col-xl-12 col-lg-12\">\r\n                    <div class=\"accordion accordion-ungrouped accordion-arrow-toggler\" id=\"popularArticles\" data-aos=\"fade-up\">\r\n\r\n                        <div class=\"card\" style=\"text-align:left; margin-top:20px; margin-bottom: 20px; padding:unset\" style=\"text-align:left; margin-top:20px; margin-bottom: 20px; padding:unset\">\r\n                            <div class=\"card-header\" id=\"headingOne\" style=\"width:100%\">\r\n                                <div class=\"card-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-target=\"#collapseOne\" aria-expanded=\"true\">\r\n                                    Informações, Prazos e Ata\r\n                                </div>\r\n                            </div>\r\n\r\n                            <div id=\"collapseOne\" class=\"bg-gray-50 border-top collapse show\" data-parent=\"#popularArticles\">\r\n                                <div class=\"card-body\">\r\n                                    <!--Informações-->\r\n                                    \r\n<div>\r\n\r\n    <h5>Dados</h5>\r\n\r\n\r\n    <ol>\r\n        <li><b>Número da Contratação:</b> 114655</li>\r\n        <li><b>Sequencial/Ano:</b> 105/2025</li>\r\n        <li><b>Forma de Disputa:</b> Lote</li>\r\n        <li><b>Resumo do Objeto:</b> Aquisi&#xE7;&#xE3;o de equipamentos para academia</li>\r\n        <li><b>Modalidade:</b> Preg&#xE3;o Eletr&#xF4;nico</li>\r\n        <li><b>Orgão:</b> SECRETARIA DE ESTADO DA CASA MILITAR</li>\r\n    </ol>\r\n\r\n</div>\r\n\r\n<div>\r\n\r\n    <h5>Prazos</h5>\r\n\r\n\r\n<ol>\r\n        <li><b>Data de Publicação no DOE:</b> 19/08/2025 08:00:00</li>\r\n\r\n        <li><b>Inicio da Sessão Pública:</b> 03/09/2025 09:00:00</li>\r\n\r\n        <li><b>Início da Fase de Lances:</b> 03/09/2025 09:10:00</li>\r\n\r\n        <li><b>Início Encerramento do 1º Item/Lote:</b> 03/09/2025 09:20:00</li>\r\n\r\n        <li><b>Tipo de Encerramento:</b> Fechamento com Prorroga&#xE7;&#xE3;o Autom&#xE1;tica 2&#x2B;2</li>\r\n\r\n        <li><b>Intervalo de Encerramento:</b> 2 minutos</li>\r\n\r\n</ol>\r\n\r\n</div>\r\n\r\n<div>\r\n    <p>\r\n        Para participar da contratação clique aqui > <a class=\"btn btn-sm btn-primary font-size-sm\" href=\"/Login\">Participar</a> e faça seu login e consulte a contratação. Caso não possua cadastro, clique aqui > <a class=\"btn btn-sm btn-primary font-size-sm\" href=\"/PreCadastroFornecedor\">Cadastro</a> e realize seu cadastro.\r\n</p>\r\n</div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"card\" style=\"text-align:left; margin-top:20px; margin-bottom: 20px; padding:unset\" style=\"text-align:left; margin-top:20px; margin-bottom: 20px; padding:unset\">\r\n                            <div class=\"card-header\" id=\"headingTwo\" style=\"width:100%\">\r\n                                <div class=\"card-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-target=\"#collapseTwo\" aria-expanded=\"false\">\r\n                                    Avisos e mensages da contratação\r\n                                </div>\r\n                            </div>\r\n\r\n                            <div id=\"collapseTwo\" class=\"bg-gray-50 border-top collapse\" data-parent=\"#popularArticles\" style=\"width:100%\">\r\n                                <div class=\"card-body\">\r\n                                    <!--Avisos-->\r\n                                    \r\n\r\n<div>\r\n    <fieldset><legend>Avisos</legend></fieldset>\r\n    <div id=\"divListaAviCertame\" class=\"col-md-12\">\r\n<table class=\"table table-striped table-bordered table-hover nowrap\" style=\"min-height:30%\">\r\n    <thead>\r\n        <tr>\r\n            <th width=\"20%\">Data/Hora do Aviso</th>\r\n            <th width=\"80%\">Descrição do Aviso</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n\r\n                <tr>\r\n                    <td style=\"text-align:center\" colspan=\"2\">Nenhum aviso cadastrado.</td>\r\n                </tr>\r\n\r\n    </tbody>\r\n\r\n</table>\r\n\r\n<script>\r\n    $(document).ready(function () {\r\n\r\n    })\r\n</script></div>\r\n</div>\r\n\r\n<div class=\"clear-fix\">&nbsp;</div>\r\n\r\n<div>\r\n    <fieldset><legend>Mensagens</legend></fieldset>\r\n\r\n    <table class=\"table table-striped table-bordered table-hover nowrap\" style=\"min-height:30%\">\r\n        <thead>\r\n            <tr>\r\n                <td width='200px'><b>Data/Hora</b></td>\r\n                <td width='*'><b>Mensagem</b></td>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n\r\n                        <tr>\r\n                            <td>02/09/2025 22:13:18</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">A proposta de valor R$ 1.701.450,00 do lote (Lote 01 - Equipamentos de For&#xE7;a) foi excluido(a) pelo Fornecedor.</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 08:46:44</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">A proposta de valor R$ 35.793,36 do lote (Lote 07: Acess&#xF3;rios) foi excluido(a) pelo Fornecedor.</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:00:13</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Bom dia a todos!</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:00:25</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Bem-vindos ao Preg&#xE3;o Eletr&#xF4;nico n&#xBA; 105/2025-SECAMI</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:00:37</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Informamos que o Preg&#xE3;o Eletr&#xF4;nico n&#xBA; 105/2025-SECAMI &#xE9; do tipo Menor Pre&#xE7;o por Lote</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:08:47</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Prezados, bom dia, n&#xE3;o localizei bot&#xE3;o onde diz INFORME SEU LANCE.</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:15:00</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Caro(s) Participante(s), avisamos que em 5(cinco) minutos ser&#xE1; iniciado o fechamento com prorroga&#xE7;&#xE3;o autom&#xE1;tica 2 &#x2B; 2 para o lote (Lote 01 - Equipamentos de For&#xE7;a)!</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:16:14</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Prezados, infelizmente enviamos lance para lote errado, por favor desconsiderar nosso lance.</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:17:00</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Caro(s) Participante(s), avisamos que em 5(cinco) minutos ser&#xE1; iniciado o fechamento com prorroga&#xE7;&#xE3;o autom&#xE1;tica 2 &#x2B; 2 para o lote (Lote 02: Equipamentos para ergometria)!</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:18:32</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Favor, especificar qual lote o lance foi inserido errado. A empresa dever&#xE1; solicitar a exclus&#xE3;o clicando no bot&#xE3;o &quot;Solicitar Exclus&#xE3;o&quot;</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:18:47</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">O lance de valor R$ 990.000,00 do lote (Lote 01 - Equipamentos de For&#xE7;a) foi solicitado exclus&#xE3;o pelo Fornecedor. Motivo: lance lote errado, obrigada</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:19:00</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Caro(s) Participante(s), avisamos que em 5(cinco) minutos ser&#xE1; iniciado o fechamento com prorroga&#xE7;&#xE3;o autom&#xE1;tica 2 &#x2B; 2 para o lote (Lote 03: Bancos e equipamento multifuncional)!</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:20:00</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Caro(s) Participante(s), informamos que para o lote (Lote 01 - Equipamentos de For&#xE7;a) foi iniciado o Fechamento com Prorroga&#xE7;&#xE3;o Autom&#xE1;tica 2 &#x2B; 2, ou seja, transcorrer&#xE1; 2(dois) minutos, prorrogado por mais 2(dois) minutos sempre que houver novo lance, findo o qual ser&#xE1; automaticamente encerrada a etapa competitiva!</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:21:00</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Caro(s) Participante(s), avisamos que em 5(cinco) minutos ser&#xE1; iniciado o fechamento com prorroga&#xE7;&#xE3;o autom&#xE1;tica 2 &#x2B; 2 para o lote (Lote 04: Halteres, Dumbbell, e Racks para halteres e Dumbbell)!</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:22:00</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Caro(s) Participante(s), informamos que para o lote (Lote 02: Equipamentos para ergometria) foi iniciado o Fechamento com Prorroga&#xE7;&#xE3;o Autom&#xE1;tica 2 &#x2B; 2, ou seja, transcorrer&#xE1; 2(dois) minutos, prorrogado por mais 2(dois) minutos sempre que houver novo lance, findo o qual ser&#xE1; automaticamente encerrada a etapa competitiva!</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:23:00</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Caro(s) Participante(s), avisamos que em 5(cinco) minutos ser&#xE1; iniciado o fechamento com prorroga&#xE7;&#xE3;o autom&#xE1;tica 2 &#x2B; 2 para o lote (Lote 05: Anilhas e Suporte)!</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:24:00</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Caro(s) Participante(s), informamos que para o lote (Lote 03: Bancos e equipamento multifuncional) foi iniciado o Fechamento com Prorroga&#xE7;&#xE3;o Autom&#xE1;tica 2 &#x2B; 2, ou seja, transcorrer&#xE1; 2(dois) minutos, prorrogado por mais 2(dois) minutos sempre que houver novo lance, findo o qual ser&#xE1; automaticamente encerrada a etapa competitiva!</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:25:00</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Caro(s) Participante(s), avisamos que em 5(cinco) minutos ser&#xE1; iniciado o fechamento com prorroga&#xE7;&#xE3;o autom&#xE1;tica 2 &#x2B; 2 para o lote (Lote 06: Wall ball, sand bag, Barras e Rack)!</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:26:00</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Caro(s) Participante(s), informamos que para o lote (Lote 04: Halteres, Dumbbell, e Racks para halteres e Dumbbell) foi iniciado o Fechamento com Prorroga&#xE7;&#xE3;o Autom&#xE1;tica 2 &#x2B; 2, ou seja, transcorrer&#xE1; 2(dois) minutos, prorrogado por mais 2(dois) minutos sempre que houver novo lance, findo o qual ser&#xE1; automaticamente encerrada a etapa competitiva!</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:27:00</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Caro(s) Participante(s), avisamos que em 5(cinco) minutos ser&#xE1; iniciado o fechamento com prorroga&#xE7;&#xE3;o autom&#xE1;tica 2 &#x2B; 2 para o lote (Lote 07: Acess&#xF3;rios)!</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:28:00</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Caro(s) Participante(s), informamos que para o lote (Lote 05: Anilhas e Suporte) foi iniciado o Fechamento com Prorroga&#xE7;&#xE3;o Autom&#xE1;tica 2 &#x2B; 2, ou seja, transcorrer&#xE1; 2(dois) minutos, prorrogado por mais 2(dois) minutos sempre que houver novo lance, findo o qual ser&#xE1; automaticamente encerrada a etapa competitiva!</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>03/09/2025 09:29:00</td>\r\n                            <td style=\"text-align: justify; padding: 1.0pt 3.0pt 1.0pt 3.0pt \">Caro(s) Participante(s), avisamos que em 5(cinco) minutos ser&#xE1; iniciado o fechamento com prorroga&#xE7;&#xE3;o autom&#