            "mimeType": "application/json",
            "text": "{\"d\":\"\\u003cform method=\\\"post\\\" action=\\\"../Servicos.asmx\\\" id=\\\"uc_MuralDetalheChat\\\"\\u003e\\r\\n\\u003cdiv class=\\\"aspNetHidden\\\"\\u003e\\r\\n\\u003cinput type=\\\"hidden\\\" name=\\\"__VIEWSTATE\\\" id=\\\"__VIEWSTATE\\\" value=\\\"R4/pQBSXlZvXitQefhHMKoisKxz5GDUqlSfVF7+06Df06fyajGKRItaa9M+ntQ29Qn4i0w==\\\" /\\u003e\\r\\n\\u003c/div\\u003e\\r\\n\\r\\n\\r\\n\\u003cdiv class=\\\"row-fluid\\\"\\u003e\\r\\n    \\u003cdiv class=\\\"span12\\\"\\u003e\\u003ch3\\u003eÚltima atualização em: \\u003clabel id=\\\"lblDataUltimaAtualizacao\\\"\\u003e\\u003c/label\\u003e\\u003c/h3\\u003e\\u003c/div\\u003e\\r\\n\\u003c/div\\u003e\\r\\n\\r\\n\\u003cdiv id=\\\"gridChat\\\"\\u003e\\r\\n\\u003c/div\\u003e\\r\\n\\r\\n\\u003cscript type=\\\"text/javascript\\\"\\u003e\\r\\n\\r\\n    var objParametroChat;\\r\\n\\r\\n    MuralDetalheChat_Load(\\u0027{\\\"nCdProcesso\\\":588,\\\"nCdModulo\\\":59,\\\"nAltura\\\":200,\\\"objTempo\\\":null,\\\"divChat\\\":\\\"divChat\\\"}\\u0027);\\r\\n\\r\\n    function MuralDetalheChat_Load(_objParametros) {\\r\\n        objParametroChat = JSON.parse(_objParametros);\\r\\n        objParametroChat.objTempo = setInterval(MuralDetalheChat_CarregarChat, 5000);\\r\\n        MuralDetalheChat_CarregarChat();\\r\\n    }\\r\\n\\r\\n    function MuralDetalheChat_CarregarChat() {\\r\\n        var sSchema = [{\\r\\n            nCdMensagem: { type: \\\"number\\\" },\\r\\n            sDsMensagem: { type: \\\"string\\\" },\\r\\n            tDtMensagem: { type: \\\"string\\\" },\\r\\n            nIdMensagem: { type: \\\"string\\\" },\\r\\n            sNmEmpresa: { type: \\\"string\\\" },\\r\\n            bFlMostraParticipante: { type: \\\"number\\\" },\\r\\n            sNmApelido: { type: \\\"string\\\" },\\r\\n            sNmRemetente: { type: \\\"string\\\" },\\r\\n            bFlCoordenador: { type: \\\"number\\\" },\\r\\n            bFlComprador: { type: \\\"number\\\" },\\r\\n            bFlVendedor: { type: \\\"number\\\" },\\r\\n            bFlCliente: { type: \\\"number\\\" },\\r\\n            bFlTransportadora: { type: \\\"number\\\" },\\r\\n            sNmExibicao: { type: \\\"string\\\" },\\r\\n            nIdTipo: { type: \\\"number\\\" },\\r\\n            sCdUsuario: { type: \\\"string\\\" }\\r\\n        }];\\r\\n        \\r\\n        var sColunas = [\\r\\n            { field: \\\"sCdUsuario\\\", title: \\\"Usuário\\\", width: \\\"15%\\\", template: \\u0027#=formataNomeChat(sCdUsuario, nIdMensagem, sNmEmpresa, bFlMostraParticipante, sNmApelido, sNmRemetente, bFlCoordenador, bFlComprador, bFlVendedor, bFlCliente, bFlTransportadora, sNmExibicao, nIdTipo)#\\u0027 },\\r\\n            { field: \\\"tDtMensagem\\\", title: \\\"Data\\\", width: \\\"15%\\\", template: \\u0027#=formataDataHora(tDtMensagem)#\\u0027 },\\r\\n            { field: \\\"sDsMensagem\\\", title: \\\"Mensagem\\\" }\\r\\n        ];\\r\\n        \\r\\n        var dtoProcesso = {\\r\\n            nCdProcesso: objParametroChat.nCdProcesso,\\r\\n            nCdModulo: objParametroChat.nCdModulo,\\r\\n            dtoIdioma: {\\r\\n                nCdIdioma: adquirirIdIdioma(\\\"/\\\")\\r\\n            }\\r\\n        }\\r\\n\\r\\n        CarregaGrid(\\r\\n            sSchema,\\r\\n            \\\"WebService/Servicos.asmx/PesquisarProcessoDetalheChat\\\",\\r\\n            \\\"dtoProcesso: \\\" + JSON.stringify(dtoProcesso),\\r\\n            function (data) { $(\\\"#lblDataUltimaAtualizacao\\\").text(formataDataHora(new Date())); },\\r\\n            \\\"gridChat\\\",\\r\\n            sColunas,\\r\\n            objParametroChat.nAltura,\\r\\n            null\\r\\n        );\\r\\n    }\\r\\n\\r\\n    function formataNomeChat(_sCdUsuario, _nIdMensagem, _sNmEmpresa, _bFlMostraParticipante, _sNmApelido, _sNmRemetente, _bFlCoordenador, _bFlComprador, _bFlVendedor, _bFlCliente, _bFlTransportadora, _sNmExibicao, _nIdTipo) {\\r\\n        var sRetorno = \\\"\\\";\\r\\n       \\r\\n        if (_nIdMensagem == 1) {\\r\\n            sRetorno = \\\"Sistema\\\";\\r\\n        }\\r\\n        else if (_nIdMensagem == 2)\\r\\n        {\\r\\n            sRetorno = _sNmExibicao;\\r\\n        }\\r\\n        else\\r\\n        {\\r\\n            if (_bFlMostraParticipante == 1) {\\r\\n                if (_bFlCoordenador)\\r\\n                    sRetorno = _sNmRemetente;\\r\\n                else\\r\\n                    sRetorno = _sNmApelido;\\r\\n            }\\r\\n            else\\r\\n                sRetorno = _sNmApelido;\\r\\n        }\\r\\n\\r\\n        return sRetorno;\\r\\n    }\\r\\n\\r\\n\\u003c/script\\u003e\\r\\n\\r\\n\\r\\n\\u003cdiv class=\\\"aspNetHidden\\\"\\u003e\\r\\n\\r\\n\\t\\u003cinput type=\\\"hidden\\\" name=\\\"__VIEWSTATEGENERATOR\\\" id=\\\"__VIEWSTATEGENERATOR\\\" value=\\\"C21772F6\\\" /\\u003e\\r\\n\\u003c/div\\u003e\\u003c/form\\u003e\"}"
          },
