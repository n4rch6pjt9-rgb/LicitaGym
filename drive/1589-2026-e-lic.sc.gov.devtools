talhe.sNmEmpresa });\r\n\r\n        if (objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL_SIMPLIFICADO && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.PORTAL_DA_TRANSPARENCIA) {\r\n            if (window.location.href.includes(\"nNmTela=ES\") || window.location.href.includes(\"nNmTela=E\") || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Convite || window.location.href.includes(\"nNmTela=PT\") || (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && oMuralProcessoDetalhe.nCdSituacao > 0 && oMuralProcessoDetalhe.nCdSituacao <= 10)) {\r\n                arrResumoDetalhe.push({ ordem: 6, id: \"lblDataInicioProposta\", resource: MURALDETALHES.RESOURCES.Inicio_das_propostas, valor: formataDataHora(oMuralProcessoDetalhe.tDtInicial, false) });\r\n                arrResumoDetalhe.push({ ordem: 7, id: \"lblDataTerminoProposta\", resource: MURALDETALHES.RESOURCES.Termino_das_propostas, valor: formataDataHora(oMuralProcessoDetalhe.tDtFinal, false) });\r\n            } else {\r\n                arrResumoDetalhe.push({ ordem: 6, id: \"lblDataInicioProposta\", resource: MURALDETALHES.RESOURCES.Inicio_dos_lances, valor: formataDataHora(oMuralProcessoDetalhe.tDtInicial, false) });\r\n\r\n                if (oMuralProcessoDetalhe.nCdModulo.toString() != MURALDETALHES.MODULO.PregaoPresencial)\r\n                    arrResumoDetalhe.push({ ordem: 7, id: \"lblDataTerminoProposta\", resource: MURALDETALHES.RESOURCES.Termino_dos_lances, valor: formataDataHora(oMuralProcessoDetalhe.tDtFinal, false) });\r\n            }\r\n\r\n            var tDtFinalizacao = formataDataHora(oMuralProcessoDetalhe.tDtFinalizacao, false)\r\n            if (tDtFinalizacao != '') {\r\n                arrResumoDetalhe.push({ ordem: 8, id: \"lblDataTerminoProposta\", resource: MURALDETALHES.RESOURCES.Homologacao, valor: tDtFinalizacao });\r\n            }\r\n        }\r\n\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.CompraDireta || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Convite || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico) {\r\n            if (oMuralProcessoDetalhe.sDsTipoProcesso == \"\" || typeof oMuralProcessoDetalhe.sDsTipoProcesso == \"undefined\")\r\n                oMuralProcessoDetalhe.sDsTipoProcesso = MURALDETALHES.RESOURCES.Nao_informado;\r\n\r\n            if (objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL_SIMPLIFICADO && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.PORTAL_DA_TRANSPARENCIA)\r\n                arrResumoDetalhe.push({ ordem: 9, id: \"lblTipoProcesso\", resource: MURALDETALHES.RESOURCES.Tipo_processo, valor: oMuralProcessoDetalhe.sDsTipoProcesso });\r\n\r\n            if ((oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.CompraDireta || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico) && (objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL_SIMPLIFICADO && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.PORTAL_DA_TRANSPARENCIA)) {\r\n                arrResumoDetalhe.push({ ordem: 11, id: \"lblUnidadeCompradora\", resource: MURALDETALHES.RESOURCES.Unidade_compradora, valor: oMuralProcessoDetalhe.sNmEmpresa });\r\n                arrResumoDetalhe.push({ ordem: 12, id: \"lblProrrogacaoAutomatica\", resource: MURALDETALHES.RESOURCES.Prorragacao_automatica, valor: (oMuralProcessoDetalhe.bFlProrroga == 1 ? MURALDETALHES.RESOURCES.Sim : MURALDETALHES.RESOURCES.Nao) });\r\n                arrResumoDetalhe.push({ ordem: 13, id: \"lblProrrogarPor\", resource: MURALDETALHES.RESOURCES.Prorrogar_por, valor: validarNumeroNulo(oMuralProcessoDetalhe.nVlProrroga) + MURALDETALHES.RESOURCES.Min });\r\n                arrResumoDetalhe.push({ ordem: 14, id: \"lblProrrogarCondicao\", resource: MURALDETALHES.RESOURCES.Condicao, valor: validarNumeroNulo(oMuralProcessoDetalhe.nVlProrrogaCondicao) + MURALDETALHES.RESOURCES.Min });\r\n            }\r\n        }\r\n        else if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoPresencial)\r\n            arrResumoDetalhe.push({ ordem: 10, id: \"lblUnidadeCompradora\", resource: MURALDETALHES.RESOURCES.Unidade_compradora, valor: oMuralProcessoDetalhe.sNmEmpresa });\r\n\r\n        if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL || objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL_SIMPLIFICADO || objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.PORTAL_DA_TRANSPARENCIA) {\r\n            if (formataDataHora(oMuralProcessoDetalhe.tDtPublicacao, true) != \"\")\r\n                arrResumoDetalhe.push({ ordem: 18, id: \"lblDataPublicacao\", resource: MURALDETALHES.RESOURCES.Data_da_publicacao, valor: formataDataHora(oMuralProcessoDetalhe.tDtPublicacao, false) });\r\n\r\n            if (formataDataHora(oMuralProcessoDetalhe.tDtHomologacao, true) != \"\" && formataDataHora(oMuralProcessoDetalhe.tDtHomologacao, true) != formataDataHora('01/01/0001 00:00:00', true) && formataDataHora(oMuralProcessoDetalhe.tDtHomologacao, true) != '01/01/0001 01:00:00')\r\n                arrResumoDetalhe.push({ ordem: 19, id: \"lblDataHomologacao\", resource: MURALDETALHES.RESOURCES.Data_da_homologacao, valor: formataDataHora(oMuralProcessoDetalhe.tDtHomologacao, false) });\r\n        }\r\n\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Cotacao)\r\n            arrResumoDetalhe.push({ ordem: 20, id: \"lblVazio\", resource: \"\", valor: \"\" });\r\n\r\n    }\r\n}\r\n\r\n/*Carrega os detalhes se for EDITAL SIMPLIFICADO*/\r\nif (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL_SIMPLIFICADO) {\r\n    arrResumoDetalhe.push({ ordem: 4, id: \"lblEditalTitulo\", resource: MURALDETALHES.RESOURCES.Edital, valor: oMuralProcessoDetalhe.sDsTitulo != '\u0013\u0012\u0012\u0013' ? oMuralProcessoDetalhe.sDsTitulo : MURAL.RESOURCES.Nao_informado });\r\n    arrResumoDetalhe.push({ ordem: 5, id: \"lblTipoEdital\", resource: \"Tipo\", valor: oMuralProcessoDetalhe.sNmEditalTipo == '\u0013\u0012\u0012\u0013' ? MURAL.RESOURCES.Nao_informado : oMuralProcessoDetalhe.sNmEditalTipo });\r\n    arrResumoDetalhe.push({ ordem: 6, id: \"lblAvaliacaoEdital\", resource: \"Tipo de avaliação\", valor: oMuralProcessoDetalhe.sNmEditalAvaliacao == '\u0013\u0012\u0012\u0013' ? MURAL.RESOURCES.Nao_informado : oMuralProcessoDetalhe.sNmEditalAvaliacao });\r\n    arrResumoDetalhe.push({ ordem: 7, id: \"lblInicioEnvioProposta\", resource: \"Inicio de envio de proposta\", valor: (oMuralProcessoDetalhe.sDtInicioProposta == null ? MURAL.RESOURCES.Nao_informado : oMuralProcessoDetalhe.sDtInicioProposta.split(\" \", 1)) });\r\n    arrResumoDetalhe.push({ ordem: 8, id: \"lblFimEnvioProposta\", resource: \"Fim de envio de proposta\", valor: (oMuralProcessoDetalhe.sDtFimProposta == null ? MURAL.RESOURCES.Nao_informado : oMuralProcessoDetalhe.sDtFimProposta.split(\" \", 1)) });\r\n\r\n    if (true) {\r\n        arrEditalSimplificado.push(\"lblNumeroEdital\");\r\n    }\r\n    arrEditalSimplificado.push(\"lblEditalTitulo\");\r\n    arrEditalSimplificado.push(\"lblTipoEdital\");\r\n    arrEditalSimplificado.push(\"lblAvaliacaoEdital\");\r\n    arrEditalSimplificado.push(\"lblInicioEnvioProposta\");\r\n    arrEditalSimplificado.push(\"lblFimEnvioProposta\");\r\n    arrEditalSimplificado.push(\"lblSituacao\");\r\n    arrEditalSimplificado.push(\"lblObjeto\");\r\n\r\n}\r\n\r\nif (arrEditalSimplificado.length > 0) {\r\n    arrResumoDetalhe = arrResumoDetalhe.filter(f => arrEditalSimplificado.indexOf(f.id) != -1);\r\n}\r\n\r\n        $(\"#grupoResumo\").children().remove();\r\n\r\n        var templateDetalhe = \"<li><span class='destaquePalavra'>[label]: </span><span id='[idLabel]'>[valorLabel]</span></li> \";\r\n        var sConteudo = \"\";\r\n        arrResumoDetalhe.sort(ordenarArrayPor(\"ordem\"));\r\n\r\n        $(arrResumoDetalhe).each(function (indice) {\r\n            if (this.valor == \"\" && this.id != 'lblVazioObjeto') {\r\n                sConteudo += \"<li><span class='destaquePalavra'></span><span></span></li>\";\r\n            }\r\n            else if (this.id == 'lblVazioObjeto') {\r\n                sConteudo += '';\r\n            }\r\n            else {\r\n                sConteudo += templateDetalhe.split(\"[label]\").join(this.resource).split(\"[idLabel]\").join(this.id).split(\"[valorLabel]\").join(this.valor).split(\"[span]\").join(\"span4\");\r\n            }\r\n\r\n            if (((indice + 1) % 3) == 0) {\r\n                $(\"#grupoResumo\").append(\"<ul class='nav-detalhes'>\" + sConteudo + \"</ul>\");\r\n                sConteudo = \"\";\r\n            }\r\n            else {\r\n                if (arrResumoDetalhe.length == (indice + 1)) {\r\n                    $(\"#grupoResumo\").append(\"<ul class='nav-detalhes'>\" + sConteudo + \"</ul>\");\r\n                    sConteudo = \"\";\r\n                }\r\n            }\r\n        });\r\n\r\n        if (objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL_SIMPLIFICADO)\r\n            $(\".oculta-edital\").show();\r\n        else if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.PORTAL_DA_TRANSPARENCIA)\r\n            $(\".oculta-transparencia\").hide();\r\n        else\r\n            $(\".oculta-edital\").hide();\r\n\r\n\r\n\r\n\r\n        $(\"#areaDetalhes\").find(\"[data-acao='relatorio'], [data-acao='historico'], [data-acao='relhis'], [data-acao='edital'], [data-acao='anexo'], [data-acao='anexoproposta'], [data-acao='anexolance'], [data-acao='anexonegociacao'], [data-acao='anexohabilitacao'], [data-acao='anexorecurso'], [data-acao='notas']\").show();\r\n        if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL_SIMPLIFICADO) {\r\n            $('.editalSimplificadoBotoes').show();\r\n            $('#divForum').show();\r\n            $('#divDetalhes > div.row-fluid.oculta-edital.painel-funcionalidades-forum').attr('style', 'display:block; !important');\r\n            $('#divDetalhes > div.row-fluid.oculta-edital.painel-funcionalidades-forum').attr('class', 'row-fluid painel-funcionalidades-forum');\r\n            $(\"#lblFimEnvioProposta\").closest(\"ul\").css(\"width\", \"720px\");\r\n\r\n            if (oMuralProcessoDetalhe.sDsDetalhe != '\u0013\u0012\u0012\u0013') {\r\n                $('#divEditalDescricao').show();\r\n                $(\"#divEditalDescricao .row-fluid div:first\").append(oMuralProcessoDetalhe.sDsDetalhe);\r\n            }\r\n\r\n            if (oMuralProcessoDetalhe.lstClasses != null && oMuralProcessoDetalhe.lstClasses.length > 0) {\r\n                $('#divLinhaFornecimento').show();\r\n                $(\"#treeview-kendo\").kendoTreeView({\r\n                    dataSource: getDataSource(oMuralProcessoDetalhe.lstClasses),\r\n                });\r\n            }\r\n        }\r\n\r\n        if (nCdModulo == MURALDETALHES.MODULO.Cotacao) {\r\n            $(\"#areaDetalhes\").find(\"[data-acao='relatorio'], [data-acao='historico'], [data-acao='anexoproposta'], [data-acao='anexolance'], [data-acao='anexonegociacao'], [data-acao='anexohabilitacao'], [data-acao='anexorecurso'], [data-acao='anexocontrarazoes'], [data-acao='anexoparecer'], [data-acao='relhis'], [data-acao='edital']\").hide();\r\n            $(\"#areaDetalhes\").find(\"[data-acao='anexo']\").show();\r\n        }\r\n        else {\r\n            if (objConfiguracao.bFlRelatorioPublico <= 0)\r\n                $(\"#areaDetalhes\").find(\"[data-acao='relatorio']\").hide();\r\n\r\n            if (objConfiguracao.bFlHistoricoPublico <= 0)\r\n                $(\"#areaDetalhes\").find(\"[data-acao='historico']\").hide();\r\n\r\n            if (0 == 1 && 1 == 1) {\r\n                if (objConfiguracao.bFlRelatorioPublico > 0 && objConfiguracao.bFlHistoricoPublico <= 0) {\r\n                    $(\"#divRelatorio\").parent().removeClass(\"span4\");\r\n                    $(\"#divRelatorio\").parent().addClass(\"span12\");\r\n                    $(\"#divHistorico\").parent().remove();\r\n                }\r\n                else if (objConfiguracao.bFlRelatorioPublico <= 0 && objConfiguracao.bFlHistoricoPublico > 0) {\r\n                    $(\"#divHistorico\").parent().removeClass(\"span8\");\r\n                    $(\"#divHistorico\").parent().addClass(\"span12\");\r\n                }\r\n            } else {\r\n                if (0 != 1) {\r\n                    $(\"#divRelatorio\").parent().removeClass(\"span4\");\r\n                    $(\"#divRelatorio\").parent().addClass(\"span12\");\r\n                    $(\"#divHistorico\").parent().remove();\r\n                }\r\n\r\n                if (1 != 1) {\r\n                    $(\"#divHistorico\").parent().removeClass(\"span8\");\r\n                    $(\"#divHistorico\").parent().addClass(\"span12\");\r\n                }\r\n            }\r\n            if (objConfiguracao.bFlRelatorioPublico <= 0 && objConfiguracao.bFlHistoricoPublico <= 0)\r\n                $(\"#areaDetalhes\").find(\"[data-acao='relhis']\").hide();\r\n\r\n            if (oMuralProcessoDetalhe.nCdEdital >= 0) {\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexo']\").show();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexoproposta']\").show();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexolance']\").show();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexonegociacao']\").show();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexohabilitacao']\").show();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexorecurso']\").show();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexocontrarazoes']\").show();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexoparecer']\").show();\r\n            }\r\n            else {\r\n\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexo']\").hide();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexoproposta']\").hide();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexolance']\").hide();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexonegociacao']\").hide();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexohabilitacao']\").hide();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexorecurso']\").hide();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexocontrarazoes']\").hide();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexoparecer']\").hide();\r\n            }\r\n\r\n            if (nCdModulo == MURALDETALHES.MODULO.PregaoEletronico) {\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexoproposta']\").show();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexolance']\").show();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexonegociacao']\").show();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexohabilitacao']\").show();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexorecurso']\").show();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexocontrarazoes']\").show();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexoparecer']\").show();\r\n            }\r\n            else {\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexoproposta']\").hide();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexolance']\").hide();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexonegociacao']\").hide();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexohabilitacao']\").hide();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexorecurso']\").hide();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexocontrarazoes']\").hide();\r\n                $(\"#areaDetalhes\").find(\"[data-acao='anexoparecer']\").hide();\r\n            }\r\n\r\n            if (nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n\r\n                switch (oMuralProcessoDetalhe.nCdTipoModalidade) {\r\n                    case enumTipoModalidadeLicitacao.Pre_qualificacao:\r\n                    case enumTipoModalidadeLicitacao.Credenciamento:\r\n                        $(\".painel-funcionalidades-relhis\").hide();\r\n                        $('#btnRelatorio').remove()\r\n                        break;\r\n                    default:\r\n                        $(\"#areaDetalhes\").find(\"[data-acao='anexoproposta']\").show();\r\n                        $(\"#areaDetalhes\").find(\"[data-acao='anexolance']\").show();\r\n                        $(\"#areaDetalhes\").find(\"[data-acao='anexonegociacao']\").show();\r\n                        $(\"#areaDetalhes\").find(\"[data-acao='anexohabilitacao']\").show();\r\n                        $(\"#areaDetalhes\").find(\"[data-acao='anexorecurso']\").show();\r\n                        $(\"#areaDetalhes\").find(\"[data-acao='anexocontrarazoes']\").show();\r\n                        $(\"#areaDetalhes\").find(\"[data-acao='anexoparecer']\").show();\r\n                    break;\r\n                }\r\n            }\r\n\r\n        }\r\n\r\n        if (nCdModulo == MURALDETALHES.MODULO.CompraDireta && !window.location.href.includes(\"nNmTela=E\") && !window.location.href.includes(\"nNmTela=ES\") && !window.location.href.includes(\"nNmTela=PT\")) {\r\n            document.getElementById(\"lblObjeto\").closest(\"li\").style.width = '100%'\r\n            document.getElementById(\"lblUnidadeCompradora\").closest(\"li\").style.width = '65%'\r\n            document.getElementById(\"lblUnidadeCompradora\").closest(\"ul\").children[1].style.width = '0%'\r\n        }\r\n        else {\r\n            if (document.getElementById(\"lblObjeto\") != null) {\r\n                document.getElementById(\"lblObjeto\").closest(\"li\").style.width = '33%'\r\n            }\r\n        }\r\n\r\n        /*HISTORICO*/\r\n        if (0 != 1 || nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n            $('#btnHistorico').remove()\r\n            $(\"#divHistorico\").parent().remove();\r\n        }\r\n\r\n        /*RELATORIO*/\r\n        if (1 != 1) {\r\n            $(\"#divRelatorio\").parent().remove();\r\n            $('#btnRelatorio').remove()\r\n        }\r\n\r\n        var bFlSituacaoExibeAnexos = false;\r\n\r\n        switch (oMuralProcessoDetalhe.nCdSituacao) {\r\n            case enumPregaoSituacao.Negociação_Habilitação_Aceitabilidade:\r\n            case enumPregaoSituacao.Período_de_intenção_de_recurso:\r\n            case enumPregaoSituacao.Encerramento_da_sessão_pública:\r\n            case enumPregaoSituacao.Julgamento_da_intencao:\r\n            case enumPregaoSituacao.Período_para_razões_do_recurso:\r\n            case enumPregaoSituacao.Período_para_contra_razões:\r\n            case enumPregaoSituacao.Julgamento_do_recurso:\r\n            case enumPregaoSituacao.Reajuste_de_preços:\r\n            case enumPregaoSituacao.Adjudicação:\r\n            case enumPregaoSituacao.Aguardando_homologação:\r\n            case enumPregaoSituacao.Homologado:\r\n            case enumPregaoSituacao.Homologacao_pendente:\r\n            case enumPregaoSituacao.Homologado_com_pedido:\r\n            case enumPregaoSituacao.Homologado_com_registro_de_preco:\r\n            case enumPregaoSituacao.Em_homologacao_parcial:\r\n            case enumPregaoSituacao.Homologado_com_contrato:\r\n                bFlSituacaoExibeAnexos = true;\r\n                break;\r\n        }\r\n        /*ANEXOS*/\r\n        if (nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n            if (0 == 0) {\r\n                $(\"#divAnexoProposta\").parent().remove();\r\n            }\r\n            if (0 == 0) {\r\n                $(\"#divAnexoNegociacao\").parent().remove();\r\n            }\r\n            if (0 == 0) {\r\n                $(\"#divAnexoLance\").parent().remove();\r\n            }\r\n            if (0 == 0) {\r\n                $(\"#divAnexoHabilitacao\").parent().remove();\r\n            }\r\n            if (0 == 0) {\r\n                $(\"#divAnexoRecurso\").parent().remove();\r\n                $(\"#divAnexoContraRazoes\").parent().remove();\r\n                $(\"#divAnexoParecer\").parent().remove();\r\n            }\r\n        }\r\n        else {\r\n            if (1 == 0 || !bFlSituacaoExibeAnexos) {\r\n                $(\"#divAnexoProposta\").parent().remove();\r\n            }\r\n\r\n            if (0 == 0 || !bFlSituacaoExibeAnexos) {\r\n                $(\"#divAnexoLance\").parent().remove();\r\n            }\r\n\r\n            if (0 == 0 || !bFlSituacaoExibeAnexos) {\r\n                $(\"#divAnexoNegociacao\").parent().remove();\r\n            }\r\n\r\n            if (1 == 0 || !bFlSituacaoExibeAnexos) {\r\n                $(\"#divAnexoHabilitacao\").parent().remove();\r\n            }\r\n\r\n            if (0 == 0 || !bFlSituacaoExibeAnexos) {\r\n                $(\"#divAnexoRecurso\").parent().remove();\r\n                $(\"#divAnexoContraRazoes\").parent().remove();\r\n                $(\"#divAnexoParecer\").parent().remove();\r\n            }\r\n        }\r\n        if (0 != 1 && 1 != 1) {\r\n            $(\"#areaDetalhes\").find(\"[data-acao='relhis']\").hide();\r\n        }\r\n\r\n        if (objConfiguracao.bFlForumPublico <= 0)\r\n            $(\"#areaDetalhes\").find(\"[data-acao='forum']\").hide();\r\n        else {\r\n            if (\r\n                (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.CompraDireta && objConfiguracao.bFlForumPublicoCompraDireta <= 0) ||\r\n                (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Convite && objConfiguracao.bFlForumPublicoConvite <= 0) ||\r\n                (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && objConfiguracao.bFlForumPublicoPregaoEletronico <= 0) ||\r\n                (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoPresencial && objConfiguracao.bFlForumPublicoPregaoPresencial <= 0) ||\r\n                (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Cotacao && objConfiguracao.bFlForumPublicoCotacao <= 0)\r\n            )\r\n                $(\"#areaDetalhes\").find(\"[data-acao='forum']\").hide();\r\n        }\r\n\r\n        /*CHAT*/\r\n        if (isExibirChatAreaPublica())\r\n            $(\"#areaDetalhes\").find(\"[data-acao='chat']\").show();\r\n        else\r\n            $(\"#areaDetalhes\").find(\"[data-acao='chat']\").hide();\r\n        /*FAQ*/\r\n        if (isExibirFaq())\r\n            $(\"#areaDetalhes\").find(\"[data-acao='faq']\").show();\r\n        else\r\n            $(\"#areaDetalhes\").find(\"[data-acao='faq']\").hide();\r\n        /*ANEXO PROCESSO*/\r\n        if (isExibirAnexoProcesso())\r\n            $(\"#areaDetalhes\").find(\"[data-acao='anexo']\").show();\r\n\r\n\r\n        if (oMuralProcessoDetalhe.bFlPermiteImpugnacao <= 0) {\r\n            $(\".painel-funcionalidades-impugnacao\").hide();\r\n            $(\"#areaDetalhes\").find(\"[data-acao='impugnacao']\").hide();\r\n        } else {\r\n            $(\"#areaDetalhes\").find(\"[data-acao='impugnacao']\").show();\r\n        }\r\n\r\n        $(\"#grupoResumo\").show();\r\n        $(\"#carregandoResumo\").hide();\r\n\r\n        if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL || objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL_SIMPLIFICADO)\r\n            $(\".oculta-edital\").hide();\r\n        else if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.PORTAL_DA_TRANSPARENCIA) {\r\n            $(\".oculta-transparencia\").hide();\r\n        }\r\n        /*ESCLARECIMENTOS*/\r\n        if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL_SIMPLIFICADO)\r\n            $(\"#areaDetalhes\").find(\"[data-acao='forum']\").show();\r\n\r\n        /*NOTAS*/\r\n        if (IndExibirNotasPublica())\r\n            $(\"#areaDetalhes\").find(\"[data-acao='notas']\").show();\r\n        else\r\n            $(\"#areaDetalhes\").find(\"[data-acao='notas']\").hide();\r\n\r\n        if (\r\n            (\r\n                objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.MURAL ||\r\n                objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.MURAL_ESTATISTICO ||\r\n                objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.MURAL_PESQUISA_AGRUPADA\r\n            ) &&\r\n            oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao\r\n        ) {\r\n            if (oMuralProcessoDetalhe.bFlExibeHabilitacaoMural)\r\n                $(\"#areaDetalhes\").find(\"[data-acao='habilitacao']\").show();\r\n            else\r\n                $(\"#areaDetalhes\").find(\"[data-acao='habilitacao']\").hide();\r\n\r\n            if (oMuralProcessoDetalhe.bFlExibeClassificacaoMural)\r\n                $(\"#areaDetalhes\").find(\"[data-acao='classificacao']\").show();\r\n            else\r\n                $(\"#areaDetalhes\").find(\"[data-acao='classificacao']\").hide();\r\n        }\r\n        else {\r\n            $(\"#areaDetalhes\").find(\"[data-acao='habilitacao']\").hide();\r\n            $(\"#areaDetalhes\").find(\"[data-acao='classificacao']\").hide();\r\n        }\r\n\r\n        OcultarImpugnacao();\r\n        HideBotoes();\r\n        ShowBotoes();\r\n        AlterarTituloDetalhesDoProcesso();\r\n    }\r\n\r\n    function AlterarTituloDetalhesDoProcesso() {\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n            var sDefaultOpt = '\u0013\u0012\u0012\u0013';\r\n            var sLabel = (oMuralProcessoDetalhe.sDsLabelSecaoResultado\r\n                && oMuralProcessoDetalhe.sDsLabelSecaoResultado.trim() !== ''\r\n                && oMuralProcessoDetalhe.sDsLabelSecaoResultado !== sDefaultOpt)\r\n                ? oMuralProcessoDetalhe.sDsLabelSecaoResultado\r\n                : 'Resultado';\r\n            $('#HeadDetalhesDoProcesso').find('span').first().text(sLabel);\r\n        }\r\n    }\r\n\r\n    function OcultarImpugnacao() {\r\n        if ( false && oMuralProcessoDetalhe.nCdModulo != MURALDETALHES.MODULO.Licitacao && oMuralProcessoDetalhe.bFlPermiteImpugnacao) {\r\n            $(\"#divImpugnar\").hide();\r\n        }\r\n    }\r\n\r\n    function ShowBotoes() {\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n            $('#btnNotas').show();\r\n        }\r\n    }\r\n\r\n    function HideBotoes() {\r\n\r\n        if ( false && oMuralProcessoDetalhe.nCdModulo != MURALDETALHES.MODULO.Licitacao && oMuralProcessoDetalhe.bFlPermiteImpugnacao) {\r\n            $(\"#btnImpugnar\").hide();\r\n        }\r\n    }\r\n\r\n\r\n\r\n    function formataTextoGrid(_sValor, _nQtdDecimal) {\r\n        if (_nQtdDecimal)\r\n            _sValor = validarNumeroNulo(_sValor, _nQtdDecimal);\r\n        else\r\n            _sValor = _sValor;\r\n\r\n        return \"<span title='\" + _sValor + \"'>\" + _sValor + \"</span>\";\r\n    }\r\n\r\n    function formataTextoRanking(_sValor) {\r\n        _sValor = _sValor > 0 ? _sValor : \"\";\r\n        return \"<span title='nNrRanking'>\" + _sValor + \"</span>\";\r\n    }\r\n\r\n    function formataIconeFase(_sIcone, _sFase) {\r\n        if (_sFase != \"\" && _sIcone != \"\")\r\n            return \"<img title='\" + _sFase + \"' alt='\" + _sFase + \"' src='/\" + _sIcone + \"' />\";\r\n        else\r\n            return \"\";\r\n    }\r\n    function formataTextoDataGrid(_tDtData, _bFlExibeSegundos) {\r\n        return formataTextoGrid(formataDataHora(_tDtData, _bFlExibeSegundos));\r\n    }\r\n    function formataVencedor(bFlVencedor, sNrRanking, nStLance, sLanceProposta = \"\") {\r\n        var sRetorno = \"\";\r\n\r\n        if (bFlVencedor == \"1\") {\r\n            switch (oMuralProcessoDetalhe.nCdModulo) {\r\n                case MURALDETALHES.MODULO.CompraDireta:\r\n\r\n                    switch (oMuralProcessoDetalhe.nIdModalidade) {\r\n                        case enumTipoAvaliacao.MAIORTAXA:\r\n                            sRetorno = MURALDETALHES.RESOURCES.Maior_taxa;\r\n                            break;\r\n                        case enumTipoAvaliacao.MENORTAXA:\r\n                            sRetorno = MURALDETALHES.RESOURCES.Menor_taxa;\r\n                            break;\r\n                        case enumTipoAvaliacao.MENORPRECO:\r\n                            sRetorno = MURALDETALHES.RESOURCES.Menor_preco;\r\n                            break;\r\n                        default:\r\n                            sRetorno = MURALDETALHES.RESOURCES.Lance_vencedor;\r\n                    }\r\n                    break;\r\n                case MURALDETALHES.MODULO.Convite:\r\n                case MURALDETALHES.MODULO.PregaoEletronico:\r\n\r\n                    switch (oMuralProcessoDetalhe.nIdModalidade) {\r\n                        case enumTipoAvaliacao.MAIORTAXA:\r\n                            sRetorno = MURALDETALHES.RESOURCES.Maior_taxa;\r\n                            break;\r\n                        case enumTipoAvaliacao.MENORTAXA:\r\n                            sRetorno = MURALDETALHES.RESOURCES.Menor_taxa;\r\n                            break;\r\n                        case enumTipoAvaliacao.MENORPRECO:\r\n                            sRetorno = MURALDETALHES.RESOURCES.Menor_preco;\r\n                            break;\r\n                        default:\r\n                            sRetorno = MURALDETALHES.RESOURCES.Lance_vencedor;\r\n                            if (oMuralProcessoDetalhe.nCdSituacao > 0 && oMuralProcessoDetalhe.nCdSituacao <= 10)\r\n                                sRetorno = MURALDETALHES.RESOURCES.Proposta_vencedora;\r\n                    }\r\n                    break;\r\n                case MURALDETALHES.MODULO.PregaoPresencial:\r\n                    sRetorno = MURALDETALHES.RESOURCES.Lance_vencedor;\r\n                    break;\r\n            }\r\n\r\n            return \"<div class='ico-vencedor-azul-25' title='\" + sRetorno + \"' ></div>\";\r\n        }\r\n        else {\r\n            switch (oMuralProcessoDetalhe.nCdModulo) {\r\n                case MURALDETALHES.MODULO.CompraDireta:\r\n                    if (nStLance == enumCompraDiretaLanceSituacao.Invalido)\r\n                        sRetorno = MURALDETALHES.RESOURCES.Lance_invalido;\r\n                    else if (nStLance == enumCompraDiretaLanceSituacao.InvalidoComprador)\r\n                        sRetorno = MURALDETALHES.RESOURCES.Invalido_pelo_comprador;\r\n                    else if (nStLance == enumCompraDiretaLanceSituacao.InvalidoFornecedor)\r\n                        sRetorno = MURALDETALHES.RESOURCES.Invalido_pelo_fornecedor;\r\n                    break;\r\n                case MURALDETALHES.MODULO.Convite:\r\n                    if (nStLance == enumConvitePropostaSituacao.Invalido)\r\n                        sRetorno = MURALDETALHES.RESOURCES.Proposta_invalida;\r\n                    break;\r\n                case MURALDETALHES.MODULO.PregaoEletronico:\r\n                    if (oMuralProcessoDetalhe.nCdSituacao > 0 && oMuralProcessoDetalhe.nCdSituacao <= 10) {\r\n                        if (nStLance == enumPregaoEletronicoPropostaSituacao.Invalidada_pelo_comprador)\r\n                            sRetorno = MURALDETALHES.RESOURCES.Invalido_pelo_comprador;\r\n                    }\r\n                    else {\r\n                        if (nStLance == enumPregaoEletronicoLanceSituacao.Invalido)\r\n                            sRetorno = MURALDETALHES.RESOURCES.Lance_invalido;\r\n                    }\r\n                    break;\r\n                case MURALDETALHES.MODULO.PregaoPresencial:\r\n                    if (nIdProcessoPresencialMuralRanking == 3\r\n                        && nStLance == enumPregaoPresencialPropostaSituacao.Invalido\r\n                        && sLanceProposta == \"Proposta\") {\r\n                        sRetorno = MURALDETALHES.RESOURCES.Proposta_invalida;\r\n\r\n                    } else if (nStLance == enumPregaoPresencialLanceSituacao.Invalido)\r\n                        sRetorno = MURALDETALHES.RESOURCES.Lance_invalido;\r\n                    else if (nStLance == enumPregaoPresencialLanceSituacao.PassouVez)\r\n                        sRetorno = MURALDETALHES.RESOURCES.Passou_vez;\r\n                    else if (nStLance == enumPregaoPresencialLanceSituacao.Desistiu)\r\n                        sRetorno = MURALDETALHES.RESOURCES.Desistiu;\r\n                    break;\r\n            }\r\n\r\n            if (sRetorno != \"\")\r\n                return \"<div class='ico-perdedor-azul-25' title='\" + sRetorno + \"' ></div>\";\r\n            else\r\n                return \"\";\r\n        }\r\n    }\r\n\r\n\r\n    //#region Processo detalhe - LOTE\r\n    function formataLote(sDsLote, nCdLote, nCdSituacao, sIdGrid) {\r\n        return \"<div onclick='btPesquisarProcessoDetalheItemLote_Click(\" + nCdLote + \", \" + nCdSituacao + \", \\\"\" + sIdGrid + \"\\\")' class='areaClique' title='\" + kendo.htmlEncode(sDsLote) + \"'>\" + kendo.htmlEncode(sDsLote) + \"</div>\";\r\n    }\r\n\r\n    function btPesquisarProcessoDetalheItemLote_Click(nCdLote, nCdSituacao, sIdGrid) {\r\n        PesquisarProcessoDetalheItemProduto(oMuralProcessoDetalhe.nCdProcesso, oMuralProcessoDetalhe.sDsProcesso, oMuralProcessoDetalhe.nCdModulo, nCdLote, nCdSituacao, sIdGrid);\r\n    }\r\n\r\n    function formataLanceAnexoHabilitacao(bFlAnexoHabilitacao, nCdLance, nCdLoteLance) {\r\n        if (bFlAnexoHabilitacao === 1)\r\n            return \"<div onclick='btPesquisarLanceAnexoHabilitacao_Click(\" + nCdLance + \",\" + nCdLoteLance + \")' class='areaClique'><img border='0' src='/core/images/icones/ic_anexo.gif' /></div>\";\r\n        return \"\";\r\n    }\r\n\r\n    function btPesquisarLanceAnexoHabilitacao_Click(nCdLance, nCdLoteLance) {\r\n        $(\"#divDetalheLanceAnexoHabilitacao\").data(\"kendoWindow\").setOptions({ width: 550 });\r\n        $(\"#divDetalheLanceAnexoHabilitacao\").data(\"kendoWindow\").open();\r\n        $(\"#divDetalheLanceAnexoHabilitacao\").data(\"kendoWindow\").center();\r\n        CarregarAnexoLanceResultado(nCdLance, nCdLoteLance);\r\n    }\r\n\r\n    function podeExibirAcompanhamentoLanceLicitacao(nCdSituacaoItemLote, nCdFase) {\r\n        var bFlSituacaoPermiteDisputaAberta = \r\n            nCdSituacaoItemLote == enumLicitacaoSituacaoItemLote.EmDisputa || \r\n            nCdSituacaoItemLote == enumLicitacaoSituacaoItemLote.EmAutoEncerramento || \r\n            nCdSituacaoItemLote == enumLicitacaoSituacaoItemLote.EmAplicacaoLC123;\r\n        \r\n        var bFlFaseDisputaAberta = nCdFase == enumLicitacaoFase.DisputaAberta;\r\n\r\n        return bFlSituacaoPermiteDisputaAberta && bFlFaseDisputaAberta && oMuralProcessoDetalhe.bFlApresentaDisputaAreaExterna;\r\n    }\r\n\r\n    function formataAcompanhamentoLanceLote(_nCdLote, _bFlExibeMarca, _bFlExibeModelo, _bFlExibeProcedencia, nCdFase, nStLote) {\r\n        var retornaDiv = true;\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n            if (!podeExibirAcompanhamentoLanceLicitacao(nStLote, nCdFase))\r\n                retornaDiv = false\r\n        }\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && nStLote == 2) {\r\n            retornaDiv = false;\r\n        }\r\n\r\n        if (retornaDiv)\r\n            return \"<div onclick='btAcompanharLancesLote_Click(\" + _nCdLote + \", \" + _bFlExibeMarca + \", \" + _bFlExibeModelo + \", \" + _bFlExibeProcedencia + \")' class='ico-lance-azul-25 areaClique' style='background-size:20px 20px;' title='\" + MURALDETALHES.RESOURCES.Acompanhar_lances + \"'></div >\";\r\n        else\r\n            return \"\";\r\n    }\r\n\r\n    function btAcompanharLancesLote_Click(_nCdLote, _bFlExibeMarca, _bFlExibeModelo, _bFlExibeProcedencia) {\r\n        var sTitulo = (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao) ? MURALDETALHES.RESOURCES.Disputa_aberta.toUpperCase() : MURALDETALHES.RESOURCES.Acompanhar_lances.toUpperCase();\r\n        $(\"#divDetalheAcompanhamentoLance\").data(\"kendoWindow\").setOptions({ minHeight: 465, width: 900, title: sTitulo });\r\n        $(\"#divDetalheAcompanhamentoLance\").data(\"kendoWindow\").open();\r\n        $(\"#divDetalheAcompanhamentoLance\").data(\"kendoWindow\").center();\r\n        $(\"#carregandoDetalheAcompanhamentoLance\").show();\r\n        var objParam = {\r\n            nCdProcesso: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdLote: _nCdLote,\r\n            nCdModulo: oMuralProcessoDetalhe.nCdModulo,\r\n            nIdEstilo: oMuralProcessoDetalhe.nIdEstilo,\r\n            nIdTipoApuracao: oMuralProcessoDetalhe.nIdTipoApuracao,\r\n            bFlExibeMarca: _bFlExibeMarca,\r\n            bFlExibeModelo: _bFlExibeModelo,\r\n            bFlExibeProcedencia: _bFlExibeProcedencia,\r\n            sDsLote: replaceAll(\"\\\"\", \"\", $.grep(arrMuralProcessoDetalheItemProdutoLote, function (a) { return (a.nCdLote == _nCdLote); })[0].sDsLote),\r\n            divDetalheAcompanhamentoLance: \"divDetalheAcompanhamentoLance\"\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheAcompanhamentoLance'\",\r\n            function (_retorno) {\r\n                $(\"#divDetalheAcompanhamentoLance\").prepend(_retorno.d);\r\n                $(\"#carregandoDetalheAcompanhamentoLance\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                $(\"#divDetalheAcompanhamentoLance\").children().not(\"div\").remove();\r\n                $(\"#divDetalheAcompanhamentoLance\").data(\"kendoWindow\").close();\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function formatarDVlLoteLance(_dVlLoteLanceMoeda, _dVlLoteLanceMoedaProcesso, _nNrCasasDecimaisLance, _nNrCasasDecimaisProcesso, _sSgMoedaLance, _sSgMoedaProcesso) {\r\n\r\n        if (_sSgMoedaProcesso == _sSgMoedaLance) {\r\n            if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoPresencial && _dVlLoteLanceMoedaProcesso == 0) {\r\n                return \"--\";           \r\n            } else {\r\n                return formataValorMoeda(_dVlLoteLanceMoedaProcesso, _nNrCasasDecimaisProcesso, _sSgMoedaProcesso, oMuralProcessoDetalhe.nIdModalidade);\r\n\r\n            }\r\n        }\r\n        else\r\n            return formataValorMoeda(_dVlLoteLanceMoedaProcesso, _nNrCasasDecimaisProcesso, _sSgMoedaProcesso, oMuralProcessoDetalhe.nIdModalidade) + \"<br>\" + formataValorMoeda(_dVlLoteLanceMoeda, _nNrCasasDecimaisLance, _sSgMoedaLance, oMuralProcessoDetalhe.nIdModalidade);\r\n    }\r\n    function formatarDvlMelhorLoteLance(_dVlMelhorLanceMoedaVencedor, _dVlMelhorLanceMoedaProcesso, _nNrCasasDecimaisProcesso, _nNrCasasDecimaisVencedor, _sSgMoedaVencedor, _sSgMoedaProcesso, _nCdSituacao) {\r\n        if (oMuralProcessoDetalhe.bFlHouveVencedor > 0 && ((oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.CompraDireta && _nCdSituacao == enumCompraDiretaSituacaoLote.Encerrado) || (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Convite && _nCdSituacao == enumConviteSituacaoLote.Homologado) || (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && validarEnumerador(_nCdSituacao, enumPregaoEletronicoSituacaoLotePermitido)))) {\r\n            if (_sSgMoedaProcesso == _sSgMoedaVencedor) {\r\n                if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoPresencial && _dVlMelhorLanceMoedaProcesso == 0) {\r\n                    return \"--\";\r\n                }else if (MURALDETALHES.MODULO.PregaoEletronico) {\r\n                    if (false) {\r\n                        if (_nCdSituacao != Number(\"25\")) {\r\n                            return \"--\";\r\n                        } else\r\n                            return formataValorMoeda(_dVlMelhorLanceMoedaProcesso, _nNrCasasDecimaisProcesso, _sSgMoedaProcesso, oMuralProcessoDetalhe.nIdModalidade);\r\n                    } else\r\n                        return formataValorMoeda(_dVlMelhorLanceMoedaProcesso, _nNrCasasDecimaisProcesso, _sSgMoedaProcesso, oMuralProcessoDetalhe.nIdModalidade);               \r\n                }else\r\n                    return formataValorMoeda(_dVlMelhorLanceMoedaProcesso, _nNrCasasDecimaisProcesso, _sSgMoedaProcesso, oMuralProcessoDetalhe.nIdModalidade) + \"<br>\" + formataValorMoeda(_dVlMelhorLanceMoedaVencedor, _nNrCasasDecimaisVencedor, _sSgMoedaVencedor, oMuralProcessoDetalhe.nIdModalidade)\r\n            }\r\n        }\r\n        else {\r\n            return \"--\";\r\n        }\r\n    }\r\n    function formataEconomiaLote(_nVlEconomia, _nPcEconomia, _nNrCasasDecimais, _sSgMoeda, _nCdSituacao) {\r\n        if (oMuralProcessoDetalhe.bFlHouveVencedor > 0 && ((oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.CompraDireta && _nCdSituacao == enumCompraDiretaSituacaoLote.Encerrado) || (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Convite && _nCdSituacao == enumConviteSituacaoLote.Homologado) || (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && validarEnumerador(_nCdSituacao, enumPregaoEletronicoSituacaoLotePermitido)))) {\r\n            _nPcEconomia = validarNumeroNulo(_nPcEconomia, objConfiguracao.nQtDecimalPercentual);\r\n            _nVlEconomia = validarNumeroNulo(_nVlEconomia, _nNrCasasDecimais);\r\n            var sEconomia = _nPcEconomia + \"%\";\r\n            var sValor = _sSgMoeda + \" \" + _nVlEconomia;\r\n            return \"<span title='\" + sEconomia + \"'>\" + sEconomia + \"</span> <br> <span title='\" + sValor + \"'>\" + sValor + \"</span>\";\r\n        }\r\n        else\r\n            return \"\";\r\n    }\r\n\r\n    function PesquisarProcessoDetalheItemLote(_nCdProcesso, _nCdModulo, _sDsProcesso) {\r\n        var sSchema = [{\r\n            nCdLote: { type: \"number\" },\r\n            sDsLote: { type: \"string\" },\r\n            dVlReferencia: { type: \"number\" },\r\n            dVlMelhorLanceMoedaVencedor: { type: \"number\" },\r\n            dVlMelhorLanceMoedaProcesso: { type: \"number\" },\r\n            dVlEconomia: { type: \"number\" },\r\n            dPcEconomia: { type: \"number\" },\r\n            nCdSituacao: { type: \"number\" },\r\n            nNrCasasDecimaisVencedor: { type: \"number\" },\r\n            nNrCasasDecimaisProcesso: { type: \"number\" },\r\n            sSgMoedaVencedor: { type: \"string\" },\r\n            sSgMoedaProcesso: { type: \"string\" },\r\n            sStLote: { type: \"string\" },\r\n            sStFase: { type: \"string\" },\r\n            sDsImagemFase: { type: \"string\" },\r\n            bFlExibeMarca: { type: \"number\" },\r\n            bFlExibeModelo: { type: \"number\" },\r\n            bFlExibeProcedencia: { type: \"number\" },\r\n            sDsMarca: { type: \"string\" },\r\n            sDsModelo: { type: \"string\" },\r\n            sDsProcedencia: { type: \"string\" }\r\n        }];\r\n\r\n        var sColunas = [{ field: \"sDsLote\", title: MURALDETALHES.RESOURCES.Lote, template: '#=formataLote(sDsLote, nCdLote, nCdSituacao, \"gridProdutosLote\")#' }];\r\n        if (oMuralProcessoDetalhe.bFlMostraReferencia > 0 && oMuralProcessoDetalhe.nCdModulo != MURALDETALHES.MODULO.Licitacao)\r\n            sColunas.push({ field: \"dVlReferencia\", title: MURALDETALHES.RESOURCES.Valor_de_referencia, template: '#=formataValorMoeda(dVlReferencia, nNrCasasDecimaisProcesso, sSgMoedaProcesso)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-direita\" } });\r\n\r\n        var sLabelMelhorLance = MURALDETALHES.RESOURCES.Melhor_lance;\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Convite || (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && oMuralProcessoDetalhe.nCdSituacao > 0 && oMuralProcessoDetalhe.nCdSituacao <= 10))\r\n            sLabelMelhorLance = MURALDETALHES.RESOURCES.Melhor_proposta;\r\n\r\n        if (oMuralProcessoDetalhe.nCdModulo != MURALDETALHES.MODULO.Licitacao) {\r\n            sColunas.push({ hidden: true, field: \"dVlMelhorLanceMoedaVencedor\", title: sLabelMelhorLance, template: '#=formatarDvlMelhorLoteLance(dVlMelhorLanceMoedaVencedor, dVlMelhorLanceMoedaProcesso, nNrCasasDecimaisProcesso, nNrCasasDecimaisVencedor, sSgMoedaVencedor, sSgMoedaProcesso, nCdSituacao)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-direita\" } });\r\n            sColunas.push({ field: \"sStLote\", title: MURALDETALHES.RESOURCES.Situacao, template: '#=formataTextoGrid(sStLote)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 10%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 10%\" } });\r\n        }\r\n\r\n        if (oMuralProcessoDetalhe.bFlMostraReferencia > 0 && !(oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && (oMuralProcessoDetalhe.nIdModalidade == enumTipoAvaliacao.MAIOROFERTA || oMuralProcessoDetalhe.nIdModalidade == enumTipoAvaliacao.MAIORDESCONTO)))\r\n            sColunas.push({ hidden: true, field: \"dVlEconomia\", title: MURALDETALHES.RESOURCES.Economia, template: '#=formataEconomiaLote(dVlEconomia, dPcEconomia, nNrCasasDecimaisProcesso, sSgMoedaProcesso, nCdSituacao)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-direita\" } });\r\n\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoPresencial)\r\n            sColunas.push({ field: \"sStFase\", title: MURALDETALHES.RESOURCES.Fase, template: '#=formataIconeFase(sDsImagemFase, sStFase)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n            switch (oMuralProcessoDetalhe.nCdTipoModalidade) {\r\n                case enumTipoModalidadeLicitacao.Pre_qualificacao:\r\n                case enumTipoModalidadeLicitacao.Credenciamento:\r\n                    break;\r\n                default:\r\n                    sColunas.push({ field: \"sStFase\", title: MURALDETALHES.RESOURCES.Fase, template: '#=formataTextoGrid(sStFase)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 10%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 10%\" } });\r\n                    sColunas.push({ hidden: true, field: \"nCdSituacao\", title: \" \", template: '#=formataAcompanhamentoLanceLote(nCdLote, bFlExibeMarca, bFlExibeModelo, bFlExibeProcedencia, nCdFase, nStLote)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n                    sColunas.push({ field: \"sStLote\", title: MURALDETALHES.RESOURCES.Situacao, template: '#=formataTextoGrid(sStLote)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 10%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 10%\" } });\r\n                    break;\r\n            }\r\n        }\r\n\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && oMuralProcessoDetalhe.nCdSituacao == 11)\r\n            sColunas.push({ field: \"nCdSituacao\", title: \" \", template: '#=formataAcompanhamentoLanceLote(nCdLote, bFlExibeMarca, bFlExibeModelo, bFlExibeProcedencia, nCdFase, nStLote)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n\r\n        var dtoProcesso = {\r\n            nCdProcesso: _nCdProcesso,\r\n            nCdModulo: _nCdModulo,\r\n            sNrProcesso: _sDsProcesso,\r\n            nCdSituacao: oMuralProcessoDetalhe.nCdSituacao,\r\n            tmpTipoMuralProcesso: objParametroMural.tmpTipoMuralProcesso,\r\n            dtoIdioma: {\r\n                nCdIdioma: adquirirIdIdioma(\"/\")\r\n            }\r\n        }\r\n\r\n        CarregaGrid(\r\n            sSchema,\r\n            \"WebService/Servicos.asmx/PesquisarProcessoDetalheItemLote\",\r\n            \"dtoProcesso:\" + JSON.stringify(dtoProcesso),\r\n            function (data) {\r\n                var bVaiExibirMelhorLance = false;\r\n                var bVaiExibirAcompanhamentoLance = false;\r\n                $(data.items).each(function () {\r\n                    arrMuralProcessoDetalheItemProdutoLote.push(this);\r\n\r\n                    if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n                        if (podeExibirAcompanhamentoLanceLicitacao(this.nStLote, this.nCdFase)) {\r\n                            bVaiExibirAcompanhamentoLance = true;\r\n                        }\r\n                    }\r\n\r\n                    if (\r\n                        oMuralProcessoDetalhe.bFlHouveVencedor > 0 &&\r\n                        (\r\n                            (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.CompraDireta && this.nCdSituacao == enumCompraDiretaSituacaoLote.Encerrado) ||\r\n                            (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Convite && this.nCdSituacao == enumConviteSituacaoLote.Homologado) ||\r\n                            (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && validarEnumerador(this.nCdSituacao, enumPregaoEletronicoSituacaoLotePermitido))\r\n                        ) && !bVaiExibirMelhorLance\r\n                    )\r\n                        bVaiExibirMelhorLance = true;\r\n                });\r\n                var objGrid = $(\"#gridItem\").data(\"kendoGrid\");\r\n                if (bVaiExibirMelhorLance) {\r\n                    objGrid.showColumn(\"dVlMelhorLanceMoedaVencedor\");\r\n                    objGrid.showColumn(\"dVlEconomia\");\r\n                }\r\n\r\n                if (bVaiExibirAcompanhamentoLance) {\r\n                    objGrid.showColumn(\"nCdSituacao\");\r\n                }\r\n\r\n                $(\"thead tr th\").each(function () { $(this).attr(\"title\", $(this).data(\"title\")); });\r\n            },\r\n            \"gridItem\",\r\n            sColunas,\r\n            450,\r\n            PesquisarProcessoDetalheItemLoteLance,\r\n            undefined,\r\n            undefined,\r\n            function () {\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n    function PesquisarProcessoDetalheItemLoteLance(e) {\r\n        var sSchema = [{\r\n            sNrRodada: { type: \"string\" },\r\n            sNrRanking: { type: \"string\" },\r\n            sNmEmpresa: { type: \"string\" },\r\n            dVlLoteLanceMoeda: { type: \"number\" },\r\n            dVlLoteLanceMoedaProcesso: { type: \"number\" },\r\n            tDtLoteLance: { type: \"string\" },\r\n            nStLoteLance: { type: \"number\" },\r\n            sSgMoedaLance: { type: \"string\" },\r\n            sSgMoedaProcesso: { type: \"string\" },\r\n            nNrCasasDecimaisLance: { type: \"number\" },\r\n            nNrCasasDecimaisProcesso: { type: \"number\" },\r\n            bFlVencedor: { type: \"number\" },\r\n            bFlAceitabilidadeLanceVencedor: { type: \"number\" },\r\n            nNrRanking: { type: \"number\" },\r\n            sDsSituacaoProposta: { type: \"string\" },\r\n            sLanceProposta: { type: \"string\" },\r\n            nCdLoteLance: { type: \"number\" }\r\n        }];\r\n        var sColunas = []\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n            switch (oMuralProcessoDetalhe.nCdTipoModalidade) {\r\n                case enumTipoModalidadeLicitacao.Pre_qualificacao:\r\n                    sColunas.push({ field: \"sNmEmpresa\", title: MURALDETALHES.RESOURCES.Empresa, template: '#=formataTextoGrid(sNmEmpresa)#' });\r\n                    sColunas.push(\r\n                        {\r\n                            field: \"dVlLoteLance\",\r\n                            title: MURALDETALHES.RESOURCES.Valor,\r\n                            template: '#=formataValorMoeda(dVlLoteLanceMoedaProcesso, nNrCasasDecimaisProcesso, sSgMoedaProcesso)#',\r\n                            headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 12%\" },\r\n                            attributes: { \"class\": \"kendo-grid-alinhamento-direita\", \"style\": \"width: 12%\" }\r\n                        },\r\n                        { field: \"tDtLoteLance\", title: MURALDETALHES.RESOURCES.Data, template: '#=formataTextoDataGrid(tDtLoteLance, true)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 15%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 15%\" } },\r\n                        { field: \"sDsSituacaoProposta\", title: \"&nbsp;\", template: '#=formataIcones(nStLoteLance,bFlHabilitado)#', headerAttributes: { \"style\": \"width: 12%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 12%\" } }\r\n                    );\r\n\r\n                    if (false)\r\n                        sColunas.push({ field: \"nCdAnexoHabilitacao\", title: MURALDETALHES.RESOURCES.Anexos, template: '#=formataLanceAnexoHabilitacao(bFlAnexoHabilitacao, null, nCdLoteLance)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n                    break;\r\n                case enumTipoModalidadeLicitacao.Credenciamento:\r\n                    if (e.data.nCdLote > 0) {\r\n                        sColunas.push({ field: \"sNmEmpresa\", title: MURALDETALHES.RESOURCES.Empresa, template: '#=formataTextoGrid(sNmEmpresa)#' });\r\n                    } else {\r\n                        sColunas.push(\r\n                            {\r\n                                field: \"dVlLoteLance\",\r\n                                title: MURALDETALHES.RESOURCES.Valor,\r\n                                template: '#=formataValorMoeda(dVlLoteLanceMoedaProcesso, nNrCasasDecimaisProcesso, sSgMoedaProcesso)#',\r\n                                headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 12%\" },\r\n                                attributes: { \"class\": \"kendo-grid-alinhamento-direita\", \"style\": \"width: 12%\" }\r\n                            },\r\n                            { field: \"tDtLoteLance\", title: MURALDETALHES.RESOURCES.Data, template: '#=formataTextoDataGrid(tDtLoteLance, true)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 15%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 15%\" } },\r\n                            { field: \"sDsSituacaoProposta\", title: \"&nbsp;\", template: '#=formataIcones(nStLoteLance,bFlHabilitado)#', headerAttributes: { \"style\": \"width: 12%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 12%\" } }\r\n                        );\r\n                    }\r\n\r\n                    if (false)\r\n                        sColunas.push({ field: \"nCdAnexoHabilitacao\", title: MURALDETALHES.RESOURCES.Anexos, template: '#=formataLanceAnexoHabilitacao(bFlAnexoHabilitacao, null, nCdLoteLance)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n                    break;\r\n                default:\r\n                    sColunas = [\r\n                        { field: \"sNrRanking\", title: MURALDETALHES.RESOURCES.Ranking, template: '#=formataTextoGrid(sNrRanking)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 10%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 10%\" } },\r\n                        { field: \"sNmEmpresa\", title: MURALDETALHES.RESOURCES.Empresa, template: '#=formataTextoGrid(sNmEmpresa)#' },\r\n                        {\r\n                            field: \"dVlLoteLance\",\r\n                            title: MURALDETALHES.RESOURCES.Valor,\r\n                            template: '#=formataValorMoeda(dVlLoteLanceMoedaProcesso, nNrCasasDecimaisProcesso, sSgMoedaProcesso)#',\r\n                            headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 12%\" },\r\n                            attributes: { \"class\": \"kendo-grid-alinhamento-direita\", \"style\": \"width: 12%\" }\r\n                        },\r\n                        { field: \"tDtLoteLance\", title: MURALDETALHES.RESOURCES.Data, template: '#=formataTextoDataGrid(tDtLoteLance, true)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 15%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 15%\" } },\r\n                        { field: \"sDsSituacaoProposta\", title: \"&nbsp;\", template: '#=formataTrofeuAceitabilidade(bFlAceitabilidadeLanceVencedor, nNrRanking)+formataIcones(nStLoteLance,bFlHabilitado)#', headerAttributes: { \"style\": \"width: 12%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 12%\" } },\r\n                    ];\r\n\r\n                    if (false)\r\n                        sColunas.push({ field: \"nCdAnexoHabilitacao\", title: MURALDETALHES.RESOURCES.Anexos, template: '#=formataLanceAnexoHabilitacao(bFlAnexoHabilitacao, null, nCdLoteLance)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n\r\n                    break;\r\n            }\r\n\r\n        } else {\r\n            sColunas = [\r\n                { field: \"sNmEmpresa\", title: MURALDETALHES.RESOURCES.Empresa, template: '#=formataTextoGrid(sNmEmpresa)#' },\r\n                {\r\n                    field: \"dVlLoteLance\",\r\n                    title: MURALDETALHES.RESOURCES.Valor,\r\n                    template: '#=formataValorMoeda(dVlLoteLanceMoedaProcesso, nNrCasasDecimaisProcesso, sSgMoedaProcesso)#',\r\n                    headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" },\r\n                    attributes: { \"class\": \"kendo-grid-alinhamento-direita\" }\r\n                },\r\n                { field: \"tDtLoteLance\", title: MURALDETALHES.RESOURCES.Data, template: '#=formataTextoDataGrid(tDtLoteLance, true)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } },\r\n                { field: \"bFlVencedor\", title: MURALDETALHES.RESOURCES.Situacao, template: '#=formataVencedor(bFlVencedor, sNrRanking, nStLoteLance, sLanceProposta)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } }\r\n            ];\r\n            if (oMuralProcessoDetalhe.nIdEstilo == 2 || oMuralProcessoDetalhe.nCdModulo == 22)\r\n                sColunas.unshift({ field: \"sNrRanking\", title: MURALDETALHES.RESOURCES.Ranking, template: '#=formataTextoGrid(sNrRanking)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n            if (oMuralProcessoDetalhe.nCdModulo == 22)\r\n                sColunas.unshift({ field: \"sNrRodada\", title: MURALDETALHES.RESOURCES.Rodada, template: '#=formataTextoGrid(sNrRodada)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n\r\n        }\r\n\r\n        var dtoProcesso = {\r\n            nCdLote: e.data.nCdLote,\r\n            nCdModulo: oMuralProcessoDetalhe.nCdModulo,\r\n            nCdProcesso: oMuralProcessoDetalhe.nCdProcesso,\r\n            nIdEstilo: oMuralProcessoDetalhe.nIdEstilo,\r\n            nCdSituacao: oMuralProcessoDetalhe.nCdSituacao,\r\n            nCdTipoModalidade: oMuralProcessoDetalhe.nCdTipoModalidade,\r\n            tmpTipoMuralProcesso: objParametroMural.tmpTipoMuralProcesso,\r\n            dtoIdioma: {\r\n                nCdIdioma: adquirirIdIdioma(\"/\")\r\n            },\r\n            sNrProcesso: oMuralProcessoDetalhe.sNrProcesso\r\n        }\r\n\r\n        var sMensagem = \"\";\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.CompraDireta && e.data.nCdSituacao != enumCompraDiretaSituacaoLote.Encerrado)\r\n            sMensagem = MURALDETALHES.RESOURCES.Situacao_nao_permite_visualizacao;\r\n\r\n        else if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico) {\r\n\r\n            if (false) {\r\n                    if (e.data.nCdSituacao != Number(\"25\")) {\r\n                    sMensagem = MURALDETALHES.RESOURCES.A_situacao_atual_nao_permite_visualizacao;\r\n                }\r\n            } else if (!validarEnumerador(e.data.nCdSituacao, enumPregaoEletronicoSituacaoLotePermitido)) {\r\n                sMensagem = MURALDETALHES.RESOURCES.A_situacao_atual_nao_permite_visualizacao;\r\n            }\r\n        }\r\n        else if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Convite && e.data.nCdSituacao != enumConviteSituacaoItem.Homologado)\r\n            sMensagem = MURALDETALHES.RESOURCES.As_propostas_poderao_ser_visualizadas_assim_que_a_situacao_do_lote_for_homologada;\r\n        else if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoPresencial) {\r\n            //Se não possuir fase de ajuste ou aceitabilidade e lote não estiver homologado não deve mostrar  \r\n            if (e.data.bFlPossuiFaseAceitabilidade == 0 && e.data.nCdSituacao != enumPresencialSituacaoLote.Homologado) {\r\n                sMensagem = MURALDETALHES.RESOURCES.As_propostas_poderao_ser_visualizadas_assim_que_a_aceitabilidade_do_lance_vencedor_for_realizada;\r\n            }\r\n\r\n            //Se tem fase de aceitabilidade mas não possuir lance do tipo 3 com aceitabilidade(bFlAceitabilidadeLanceVencedor) e lote não for homologado não deve mostrar\r\n            if (e.data.bFlPossuiFaseAceitabilidade != 0 && e.data.bFlAceitabilidadeLanceVencedor == 0) {\r\n                sMensagem = MURALDETALHES.RESOURCES.As_propostas_poderao_ser_visualizadas_assim_que_a_aceitabilidade_do_lance_vencedor_for_realizada;\r\n            }\r\n        }\r\n\r\n        if (sMensagem != \"\")\r\n            $(e.detailCell[0]).text(sMensagem);\r\n        else {\r\n            CarregaGridDetalhes(\r\n                \"gridItem\",\r\n                sSchema,\r\n                \"WebService/Servicos.asmx/PesquisarProcessoDetalheItemLoteLance\",\r\n                \"dtoProcesso:\" + JSON.stringify(dtoProcesso),\r\n                sColunas,\r\n                \"nCdLote\",\r\n                e,\r\n                undefined,\r\n                function () {\r\n                    $(e.detailCell[0]).text(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados);\r\n                }\r\n            );\r\n\r\n            $(\"thead tr th\").each(function () { $(this).attr(\"title\", $(this).data(\"title\")); });\r\n        }\r\n    }\r\n    //#endregion\r\n\r\n    //#region Processo detalhe - ITEM\r\n    function formataItem(_sDsItem, _nCdItem, _nCdAnexo) {\r\n        return \"<div onclick='btPesquisarProcessoDetalheItemProduto_Click(\" + _nCdItem + \",\" + _nCdAnexo + \")' title='\" + kendo.htmlEncode(_sDsItem) + \"'  class='areaClique'>\" + kendo.htmlEncode(_sDsItem) + \"</div>\";\r\n    }\r\n\r\n    //#region Processo resultado - ITEM\r\n    function formataItemResultado(_sDsItem, _nCdItem, _nCdAnexo, lstTagsRegiao) {\r\n        var lstHTMLTags = '';\r\n        if (lstTagsRegiao && lstTagsRegiao.trim().length > 0) {\r\n            let regionsArray = lstTagsRegiao.split('[SEP]');\r\n                regionsArray.forEach(region => {\r\n                    region = region.trim();\r\n                    lstHTMLTags += '<div class=\"regiaotag\" title=\"' + MURALDETALHES.RESOURCES.Regiao + '\">' + kendo.htmlEncode(region) + '</div>';\r\n                });\r\n                lstHTMLTags = '<div  id=\"lstTagsRegiao\">' + lstHTMLTags + '</div>';\r\n        }\r\n        return lstHTMLTags + \"<div onclick='btPesquisarProcessoDetalheItemProduto_Click(\" + _nCdItem + \",\" + _nCdAnexo + \")' title='\" + kendo.htmlEncode(_sDsItem) + \"'  class='areaClique'>\" + kendo.htmlEncode(_sDsItem) + \"</div>\" ;\r\n    }\r\n    function btPesquisarProcessoDetalheItemProduto_Click(_nCdItem, _nCdAnexo) {\r\n\r\n        $(\"#divDetalheItem\").data(\"kendoWindow\").setOptions({ width: 700, maxHeight: 400, minHeight: 250 });\r\n        $(\"#divDetalheItem\").data(\"kendoWindow\").open();\r\n        $(\"#divDetalheItem\").data(\"kendoWindow\").center();\r\n\r\n        $(\"#carregandoDetalheItem\").show();\r\n\r\n        var objParam = {\r\n            nCdItem: _nCdItem,\r\n            nCdAnexo: _nCdAnexo,\r\n            nCdModulo: oMuralProcessoDetalhe.nCdModulo,\r\n            divDetalheItem: \"divDetalheItem\"\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheItem'\",\r\n            function (_retorno) {\r\n                $(\"#divDetalheItem\").prepend(_retorno.d);\r\n                $(\"#carregandoDetalheItem\").hide();\r\n                $(\"#divDetalheItemTabstrip\").kendoTabStrip();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                $(\"#divDetalheItem\").children().not(\"div\").remove();\r\n                $(\"#divDetalheItem\").data(\"kendoWindow\").close();\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function formataAcompanhamentoLance(_nCdItem, _bFlExibeMarca, _bFlExibeModelo, _bFlExibeProcedencia, nCdFase, nStItem) {\r\n        var retornaDiv = true;\r\n\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n            if (!podeExibirAcompanhamentoLanceLicitacao(nStItem, nCdFase))\r\n                retornaDiv = false\r\n        }\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && nStItem == 2) {\r\n            retornaDiv = false;\r\n        }\r\n\r\n        if (retornaDiv)\r\n            return \"<div onclick='btAcompanharLances_Click(\" + _nCdItem + \", \" + _bFlExibeMarca + \", \" + _bFlExibeModelo + \", \" + _bFlExibeProcedencia + \")' class='ico-lance-azul-25 areaClique' title='\" + MURALDETALHES.RESOURCES.Acompanhar_lances + \"'></div>\";\r\n        else\r\n            return \"\";\r\n    }\r\n    function btAcompanharLances_Click(_nCdItem, _bFlExibeMarca, _bFlExibeModelo, _bFlExibeProcedencia) {\r\n        var sTitulo = (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao) ? MURALDETALHES.RESOURCES.Disputa_aberta.toUpperCase() : MURALDETALHES.RESOURCES.Acompanhar_lances.toUpperCase();\r\n        $(\"#divDetalheAcompanhamentoLance\").data(\"kendoWindow\").setOptions({ minHeight: 465, width: 900, title: sTitulo });\r\n        $(\"#divDetalheAcompanhamentoLance\").data(\"kendoWindow\").open();\r\n        $(\"#divDetalheAcompanhamentoLance\").data(\"kendoWindow\").center();\r\n        $(\"#carregandoDetalheAcompanhamentoLance\").show();\r\n\r\n        var objParam = {\r\n            nCdProcesso: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdItem: _nCdItem,\r\n            nCdModulo: oMuralProcessoDetalhe.nCdModulo,\r\n            nIdEstilo: oMuralProcessoDetalhe.nIdEstilo,\r\n            bFlExibeMarca: _bFlExibeMarca,\r\n            bFlExibeModelo: _bFlExibeModelo,\r\n            nIdTipoApuracao: oMuralProcessoDetalhe.nIdTipoApuracao,\r\n            bFlExibeProcedencia: _bFlExibeProcedencia,\r\n            sDsItem: replaceAll(\"\\\"\", \"\", $.grep(arrMuralProcessoDetalheItemProduto, function (a) { return (a.nCdItem == _nCdItem); })[0].sDsItem.toString()),\r\n            divDetalheAcompanhamentoLance: \"divDetalheAcompanhamentoLance\"\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheAcompanhamentoLance'\",\r\n            function (_retorno) {\r\n                $(\"#divDetalheAcompanhamentoLance\").prepend(_retorno.d);\r\n                $(\"#carregandoDetalheAcompanhamentoLance\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                $(\"#divDetalheAcompanhamentoLance\").children().not(\"div\").remove();\r\n                $(\"#divDetalheAcompanhamentoLance\").data(\"kendoWindow\").close();\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function formatarDVlItemLance(_dVlLoteLanceMoeda, _dVlLoteLanceMoedaProcesso, _nNrCasasDecimaisLance, _nNrCasasDecimaisProcesso, _sSgMoedaLance, _sSgMoedaProcesso) {\r\n\r\n        if (_sSgMoedaProcesso == _sSgMoedaLance) {\r\n\r\n\r\n            if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoPresencial && _dVlLoteLanceMoedaProcesso == 0) {\r\n                return \"--\";\r\n            }\r\n            else {\r\n                return formataValorMoeda(_dVlLoteLanceMoedaProcesso, _nNrCasasDecimaisProcesso, _sSgMoedaProcesso, oMuralProcessoDetalhe.nIdModalidade);\r\n            }\r\n        }\r\n        else\r\n            return formataValorMoeda(_dVlLoteLanceMoedaProcesso, _nNrCasasDecimaisProcesso, _sSgMoedaProcesso, oMuralProcessoDetalhe.nIdModalidade) + \"<br>\" + formataValorMoeda(_dVlLoteLanceMoeda, _nNrCasasDecimaisLance, _sSgMoedaLance, oMuralProcessoDetalhe.nIdModalidade);\r\n    }\r\n    function formatarDvlMelhorItemLance(_dVlMelhorLanceMoedaVencedor, _dVlMelhorLanceMoedaProcesso, _nNrCasasDecimaisProcesso, _nNrCasasDecimaisVencedor, _sSgMoedaVencedor, _sSgMoedaProcesso, _nCdSituacao) {\r\n        if (oMuralProcessoDetalhe.bFlHouveVencedor > 0 && ((oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.CompraDireta && _nCdSituacao == enumCompraDiretaSituacaoItem.Encerrado) || (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Convite && _nCdSituacao == enumConviteSituacaoItem.Homologado) || (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && validarEnumerador(_nCdSituacao, enumPregaoEletronicoSituacaoItemPermitido)))) {\r\n\r\n            if (_sSgMoedaProcesso == _sSgMoedaVencedor) {\r\n                if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoPresencial && _dVlMelhorLanceMoedaProcesso == 0) {\r\n                    return \"--\";\r\n                } else if (MURALDETALHES.MODULO.PregaoEletronico) {\r\n                    if (false) {\r\n                        if (_nCdSituacao != Number(\"25\")) {\r\n                            return \"--\";\r\n                        } else {\r\n                            return formataValorMoeda(_dVlMelhorLanceMoedaProcesso, _nNrCasasDecimaisProcesso, _sSgMoedaProcesso, oMuralProcessoDetalhe.nIdModalidade);\r\n                        }\r\n                    } else\r\n                        return formataValorMoeda(_dVlMelhorLanceMoedaProcesso, _nNrCasasDecimaisProcesso, _sSgMoedaProcesso, oMuralProcessoDetalhe.nIdModalidade);\r\n                }\r\n                else {\r\n                    return formataValorMoeda(_dVlMelhorLanceMoedaProcesso, _nNrCasasDecimaisProcesso, _sSgMoedaProcesso, oMuralProcessoDetalhe.nIdModalidade) + \"<br>\" + formataValorMoeda(_dVlMelhorLanceMoedaVencedor, _nNrCasasDecimaisVencedor, _sSgMoedaVencedor, oMuralProcessoDetalhe.nIdModalidade)\r\n                }\r\n            }\r\n            else\r\n                return \"--\";\r\n        }\r\n        else {\r\n            return \"--\";\r\n        }\r\n    }\r\n    function formataEconomiaItem(_nVlEconomia, _nPcEconomia, _nNrCasasDecimais, _sSgMoeda, _nCdSituacao) {\r\n        if (oMuralProcessoDetalhe.bFlHouveVencedor > 0 && ((oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.CompraDireta && _nCdSituacao == enumCompraDiretaSituacaoItem.Encerrado) || (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Convite && _nCdSituacao == enumConviteSituacaoItem.Homologado) || (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && validarEnumerador(_nCdSituacao, enumPregaoEletronicoSituacaoLotePermitido)))) {\r\n            _nPcEconomia = validarNumeroNulo(_nPcEconomia, objConfiguracao.nQtDecimalPercentual);\r\n            _nVlEconomia = validarNumeroNulo(_nVlEconomia, _nNrCasasDecimais);\r\n            var sEconomia = _nPcEconomia + \"%\";\r\n            var sValor = _sSgMoeda + \" \" + _nVlEconomia;\r\n            return \"<span title='\" + sEconomia + \"'>\" + sEconomia + \"</span> <br> <span title='\" + sValor + \"'>\" + sValor + \"</span>\";\r\n        }\r\n        else\r\n            return \"\";\r\n    }\r\n\r\n    function PesquisarProcessoDetalheItemProduto(_nCdProcesso, _sDsProcesso, _nCdModulo, _nCdLote, _nCdSituacao, _sIdGrid) {\r\n        nCdLoteAtual = _nCdLote || 0;\r\n        \r\n        var sSchema = [{\r\n            nCdItem: { type: \"number\" },\r\n            sDsItem: { type: \"string\" },\r\n            dVlReferencia: { type: \"number\" },\r\n            dVlMelhorLanceMoedaVencedor: { type: \"number\" },\r\n            dVlMelhorLanceMoedaProcesso: { type: \"number\" },\r\n            dVlEconomia: { type: \"number\" },\r\n            dQtItem: { type: \"number\" },\r\n            dPcEconomia: { type: \"number\" },\r\n            nCdSituacao: { type: \"number\" },\r\n            nNrCasasDecimaisVencedor: { type: \"number\" },\r\n            nNrCasasDecimaisProcesso: { type: \"number\" },\r\n            bFlExibeMarca: { type: \"number\" },\r\n            bFlExibeModelo: { type: \"number\" },\r\n            bFlExibeProcedencia: { type: \"number\" },\r\n            sDsMarca: { type: \"string\" },\r\n            sDsModelo: { type: \"string\" },\r\n            sDsProcedencia: { type: \"string\" },\r\n            nCdProduto: { type: \"number\" },\r\n            sDsUnidadeMedida: { type: \"string\" },\r\n            sSgMoedaVencedor: { type: \"string\" },\r\n            sSgMoedaProcesso: { type: \"string\" },\r\n            sStItem: { type: \"string\" },\r\n            sStFase: { type: \"string\" },\r\n            sDsImagemFase: { type: \"string\" }\r\n        }];\r\n\r\n        var sColunas = []\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n\r\n            sColunas.push({ field: \"sDsItem\", title: MURALDETALHES.RESOURCES.Item, template: '#=formataItemResultado(sDsItem, nCdItem, nCdAnexo,lstTagsRegiao)#' });\r\n\r\n            switch (oMuralProcessoDetalhe.nCdTipoModalidade) {\r\n                case enumTipoModalidadeLicitacao.Pre_qualificacao:\r\n                case enumTipoModalidadeLicitacao.Credenciamento:\r\n                    sColunas.push({ field: \"sDsUnidadeMedida\", title: MURALDETALHES.RESOURCES.Unidade_medida, template: '#=formataTextoGrid(sDsUnidadeMedida)#', headerAttributes: { \"style\": \"width: 10%\" }, attributes: { \"style\": \"width: 10%\" } });\r\n                    if (oMuralProcessoDetalhe.bFlMostraReferencia > 0)\r\n                        sColunas.push({ field: \"dVlReferencia\", title: MURALDETALHES.RESOURCES.Valor_de_referencia, template: '#=formataValorMoeda(dVlReferencia, nNrCasasDecimaisProcesso, sSgMoedaProcesso)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-direita\", \"style\": \"width: 12%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-direita\", \"style\": \"width: 12%\" } });\r\n                    break;\r\n                default:\r\n                    sColunas.push({ hidden: oMuralProcessoDetalhe.nCdFase == 10, field: \"dQtItem\", title: MURALDETALHES.RESOURCES.Quantidade, template: '#=formataTextoGrid(dQtItem, objConfiguracao.nQtDecimalQuantidade)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 10%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-direita\", \"style\": \"width: 10%\" } });\r\n                    sColunas.push({ field: \"sDsUnidadeMedida\", title: MURALDETALHES.RESOURCES.Unidade_medida, template: '#=formataTextoGrid(sDsUnidadeMedida)#', headerAttributes: { \"style\": \"width: 10%\" }, attributes: { \"style\": \"width: 10%\" } });\r\n                    sColunas.push({ field: \"sStItem\", title: MURALDETALHES.RESOURCES.Situacao, template: '#=formataTextoGrid(sStItem)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, headerAttributes: { \"style\": \"width: 10%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 10%\" } });\r\n                    sColunas.push({ field: \"sStFase\", title: MURALDETALHES.RESOURCES.Fase, template: '#=formataTextoGrid(sStFase)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, headerAttributes: { \"style\": \"width: 10%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 10%\" } });\r\n                    sColunas.push({ hidden: true, field: \"nCdSituacao\", title: \" \", template: '#=formataAcompanhamentoLance(nCdItem, bFlExibeMarca, bFlExibeModelo, bFlExibeProcedencia, nCdFase, nStItem)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 10%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 10%\" } });\r\n                    break;\r\n            }\r\n        }\r\n        else {\r\n            sColunas = [\r\n                { field: \"sDsItem\", title: MURALDETALHES.RESOURCES.Item, template: '#=formataItemResultado(sDsItem, nCdItem, null,lstTagsRegiao)#' },\r\n                { field: \"sDsMarca\", title: MURALDETALHES.RESOURCES.Marca, template: '#=formataTextoGrid(sDsMarca)#', hidden: true },\r\n                { field: \"sDsModelo\", title: MURALDETALHES.RESOURCES.Modelo, template: '#=formataTextoGrid(sDsModelo)#', hidden: true },\r\n                { field: \"sDsProcedencia\", title: MURALDETALHES.RESOURCES.Procedencia, template: '#=formataTextoGrid(sDsProcedencia)#', hidden: true },\r\n                { field: \"dQtItem\", title: MURALDETALHES.RESOURCES.Quantidade, template: '#=formataTextoGrid(dQtItem, objConfiguracao.nQtDecimalQuantidade)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-direita\" } },\r\n                { field: \"sDsUnidadeMedida\", title: MURALDETALHES.RESOURCES.Unidade_medida, template: '#=formataTextoGrid(sDsUnidadeMedida)#' }\r\n            ];\r\n\r\n            if (_nCdLote <= 0) {\r\n\r\n                if (oMuralProcessoDetalhe.bFlMostraReferencia > 0)\r\n                    sColunas.push({ field: \"dVlReferencia\", title: MURALDETALHES.RESOURCES.Valor_de_referencia, template: '#=formataValorMoeda(dVlReferencia, nNrCasasDecimaisProcesso, sSgMoedaProcesso)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-direita\" } });\r\n\r\n                var sLabelMelhorLance = MURALDETALHES.RESOURCES.Melhor_lance;\r\n                if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Convite || (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && oMuralProcessoDetalhe.nCdSituacao > 0 && oMuralProcessoDetalhe.nCdSituacao <= 10))\r\n                    sLabelMelhorLance = MURALDETALHES.RESOURCES.Melhor_proposta;\r\n\r\n                sColunas.push({ hidden: true, field: \"dVlMelhorLanceMoedaVencedor\", title: sLabelMelhorLance, template: '#=formatarDvlMelhorItemLance(dVlMelhorLanceMoedaVencedor, dVlMelhorLanceMoedaProcesso, nNrCasasDecimaisProcesso, nNrCasasDecimaisVencedor, sSgMoedaVencedor, sSgMoedaProcesso, nCdSituacao)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-direita\" } });\r\n\r\n                if (oMuralProcessoDetalhe.bFlMostraReferencia > 0 && !(oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && (oMuralProcessoDetalhe.nIdModalidade == enumTipoAvaliacao.MAIOROFERTA || oMuralProcessoDetalhe.nIdModalidade == enumTipoAvaliacao.MAIORDESCONTO)))\r\n                    sColunas.push({ hidden: true, field: \"dVlEconomia\", title: MURALDETALHES.RESOURCES.Economia, template: '#=formataEconomiaItem(dVlEconomia, dPcEconomia, nNrCasasDecimaisProcesso, sSgMoedaProcesso, nCdSituacao)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-direita\" } });\r\n\r\n                sColunas.push({ field: \"sStItem\", title: MURALDETALHES.RESOURCES.Situacao, template: '#=formataTextoGrid(sStItem)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n\r\n                if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && oMuralProcessoDetalhe.nCdSituacao == 11)\r\n                    sColunas.push({ field: \"nCdSituacao\", title: \" \", template: '#=formataAcompanhamentoLance(nCdItem, bFlExibeMarca, bFlExibeModelo, bFlExibeProcedencia, nCdFase, nStItem)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n\r\n                if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoPresencial)\r\n                    sColunas.push({ field: \"sStFase\", title: MURALDETALHES.RESOURCES.Fase, template: '#=formataIconeFase(sDsImagemFase, sStFase)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n            }\r\n        }\r\n\r\n        var dtoProcesso = {\r\n            nCdProcesso: _nCdProcesso,\r\n            nCdModulo: _nCdModulo,\r\n            sNrProcesso: _sDsProcesso,\r\n            nCdLote: _nCdLote,\r\n            nCdSituacao: oMuralProcessoDetalhe.nCdSituacao,\r\n            tmpTipoMuralProcesso: objParametroMural.tmpTipoMuralProcesso,\r\n            dtoIdioma: {\r\n                nCdIdioma: adquirirIdIdioma(\"/\")\r\n            }\r\n        }\r\n\r\n        var sIdGrid = _nCdLote > 0 || _nCdLote == -1 ? _sIdGrid : \"gridItem\";\r\n\r\n        CarregaGrid(\r\n            sSchema,\r\n            \"WebService/Servicos.asmx/PesquisarProcessoDetalheItemProduto\",\r\n            \"dtoProcesso:\" + JSON.stringify(dtoProcesso),\r\n            function (data) {\r\n                var iTotalQtdColunaExibidas = 0;\r\n                var bVaiExibirMarca = false;\r\n                var bVaiExibirModelo = false;\r\n                var bVaiExibirProcedencia = false;\r\n                var bVaiExibirMelhorLance = false;\r\n                var bVaiExibirAcompanhamentoLance = false;\r\n\r\n                $(data.items).each(function () {\r\n                    arrMuralProcessoDetalheItemProduto.push(this);\r\n\r\n                    if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n                        if (podeExibirAcompanhamentoLanceLicitacao(this.nStItem, this.nCdFase)) {\r\n                            bVaiExibirAcompanhamentoLance = true;\r\n                        }\r\n                    }\r\n\r\n                    if (_nCdLote > 0 || _nCdLote == -1) {\r\n                        if (oMuralProcessoDetalhe.nCdSituacao > 10) {\r\n\r\n                            if (this.bFlExibeMarca > 0 || this.bFlExibeModelo > 0 || this.bFlExibeProcedencia > 0) {\r\n                                var iQtdColunaExibidas = 0;\r\n                                iQtdColunaExibidas += this.bFlExibeMarca > 0 ? 1 : 0;\r\n                                iQtdColunaExibidas += this.bFlExibeModelo > 0 ? 1 : 0;\r\n                                iQtdColunaExibidas += this.bFlExibeProcedencia > 0 ? 1 : 0;\r\n                                if (iTotalQtdColunaExibidas <= iQtdColunaExibidas)\r\n                                    iTotalQtdColunaExibidas = iQtdColunaExibidas;\r\n                                if (this.bFlExibeMarca > 0 && !bVaiExibirMarca)\r\n                                    bVaiExibirMarca = true;\r\n                                if (this.bFlExibeModelo > 0 && !bVaiExibirModelo)\r\n                                    bVaiExibirModelo = true;\r\n                                if (this.bFlExibeProcedencia > 0 && !bVaiExibirProcedencia)\r\n                                    bVaiExibirProcedencia = true;\r\n                            }\r\n                        }\r\n                    }\r\n                    else {\r\n                        if (oMuralProcessoDetalhe.bFlHouveVencedor > 0 &&\r\n                            (\r\n                                (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.CompraDireta && this.nCdSituacao == enumCompraDiretaSituacaoLote.Encerrado) ||\r\n                                (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Convite && this.nCdSituacao == enumConviteSituacaoLote.Homologado) ||\r\n                                (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && validarEnumerador(this.nCdSituacao, enumPregaoEletronicoSituacaoLotePermitido))\r\n                            ) && !bVaiExibirMelhorLance)\r\n                            bVaiExibirMelhorLance = true;\r\n                    }\r\n\r\n                });\r\n\r\n                if (_nCdLote > 0 || _nCdLote == -1) {\r\n                    let parentComponent = $(\"#\" + sIdGrid).parent();\r\n\r\n                    parentComponent.children().first().animate({ opacity: 0 }, 300, function () {\r\n                        parentComponent.children().hide();\r\n\r\n                        //Obter botão voltar\r\n                        parentComponent.parent().parent().parent().find(\".grade-produto-lote\").show();\r\n                        parentComponent.find(\".grade-produto-lote\").animate({ opacity: 1 }, 300, function () {\r\n                            var objGrid = $(\"#\" + sIdGrid).data(\"kendoGrid\");\r\n                            if (bVaiExibirMarca)\r\n                                objGrid.showColumn(\"sDsMarca\");\r\n\r\n                            if (bVaiExibirModelo)\r\n                                objGrid.showColumn(\"sDsModelo\");\r\n\r\n                            if (bVaiExibirProcedencia)\r\n                                objGrid.showColumn(\"sDsProcedencia\");\r\n\r\n                            $(\"#\" + sIdGrid).find(\".k-grid-content\").height(423);\r\n                        });\r\n                    });\r\n                }\r\n                else {\r\n                    var objGrid = $(\"#gridItem\").data(\"kendoGrid\");\r\n                    if (bVaiExibirMelhorLance) {\r\n                        objGrid.showColumn(\"dVlMelhorLanceMoedaVencedor\");\r\n                        objGrid.showColumn(\"dVlEconomia\");\r\n                    }\r\n\r\n                    if (bVaiExibirAcompanhamentoLance) {\r\n                        objGrid.showColumn(\"nCdSituacao\");\r\n                    }\r\n                }\r\n\r\n                $(\"thead tr th\").each(function () { $(this).attr(\"title\", $(this).data(\"title\")); });\r\n            },\r\n            sIdGrid,\r\n            sColunas,\r\n            450,\r\n            ((_nCdLote > 0 || _nCdLote == -1) && oMuralProcessoDetalhe.nCdTipoModalidade == enumTipoModalidadeLicitacao.Credenciamento) ? null : PesquisarProcessoDetalheItemProdutoLance,\r\n            undefined,\r\n            undefined,\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                    btAcao_Click(\"voltar\");\r\n                }\r\n            );\r\n    }\r\n\r\n    function formataTrofeuAceitabilidade(bFlAceitabilidadeLanceVencedor, nNrRanking) {\r\n        if (bFlAceitabilidadeLanceVencedor == 1 && nNrRanking == 1)\r\n            return \"<i class='fa-solid fa-trophy' style='color: gold; margin-right: 3px;' title='Vencedor'></i>\";\r\n        return \"\";\r\n    }\r\n\r\n    function formataIcones(nStLance, bFlHabilitado) {\r\n        var retorno = '<div style=\"display: inline-flex; gap: 5px;\">';  \r\n\r\n        if (bFlHabilitado === 0) {\r\n            retorno += \"<span class='fa-solid fa-handshake' title= '\" + MURALDETALHES.RESOURCES.Inalibitado + \"' style='color: red;'></span>\";\r\n        } else {\r\n            retorno += \"<span class='fa-solid fa-handshake' title= '\" + MURALDETALHES.RESOURCES.Habilitado + \"' style='color: green;'></span>\";\r\n            \r\n            \r\n        }\r\n\r\n        if (nStLance === 2) {\r\n            retorno += '<span class=\"fa-solid fa-ban\" title=\"Proposta desclassificada\" style=\"color: red;\"></span>';\r\n        }\r\n\r\n        retorno += '</div>';\r\n        return retorno;\r\n    }\r\n\r\n    function PesquisarProcessoDetalheItemProdutoLance(e) {\r\n        var sSchema = [{\r\n            sNrRodada: { type: \"string\" },\r\n            sNrRanking: { type: \"string\" },\r\n            sNmEmpresa: { type: \"string\" },\r\n            dVlLanceMoeda: { type: \"number\" },\r\n            dVlLanceMoedaProcesso: { type: \"number\" },\r\n            sSgMoedaLance: { type: \"string\" },\r\n            nStLance: { type: \"number\" },\r\n            sDsMarca: { type: \"string\" },\r\n            sDsModelo: { type: \"string\" },\r\n            sDsProcedencia: { type: \"string\" },\r\n            sSgMoedaProcesso: { type: \"string\" },\r\n            nNrCasasDecimaisLance: { type: \"number\" },\r\n            nNrCasasDecimaisProcesso: { type: \"number\" },\r\n            bFlVencedor: { type: \"number\" },\r\n            bFlAceitabilidadeLanceVencedor: { type: \"number\" },\r\n            nNrRanking: { type: \"number\" },\r\n            sDsSituacaoProposta: { type: \"string\" },\r\n            nCdLance: { type: \"number\" }\r\n        }];\r\n\r\n        var sColunas = [];\r\n\r\n        var bFlOcultarEmpresaItens = (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Credenciamento && \r\n                                      oMuralProcessoDetalhe.nCdTipoModalidade == enumTipoModalidadeLicitacao.Credenciamento &&\r\n                                      nCdLoteAtual > 0);\r\n\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n            switch (oMuralProcessoDetalhe.nCdTipoModalidade) {\r\n                case enumTipoModalidadeLicitacao.Pre_qualificacao:\r\n                case enumTipoModalidadeLicitacao.Credenciamento:\r\n                    if (!bFlOcultarEmpresaItens) {\r\n                        sColunas.push({ field: \"sNmEmpresa\", title: MURALDETALHES.RESOURCES.Empresa, template: '#=formataTextoGrid(sNmEmpresa)#' });\r\n                    }\r\n                    break;\r\n\r\n                default:\r\n                    sColunas = [\r\n                        { field: \"sNrRanking\", title: MURALDETALHES.RESOURCES.Ranking, template: '#=formataTextoGrid(sNrRanking)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 10%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 10%\" } },\r\n                        { field: \"sNmEmpresa\", title: MURALDETALHES.RESOURCES.Empresa, template: '#=formataTextoGrid(sNmEmpresa)#' },\r\n                        {\r\n                            field: \"dVlLance\", title: MURALDETALHES.RESOURCES.Valor,\r\n                            template: '#=formataValorMoeda(dVlLanceMoeda, nNrCasasDecimaisProcesso, sSgMoedaProcesso)#',\r\n                            headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 12%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-direita\", \"style\": \"width: 12%\" }\r\n                        },\r\n                        { field: \"tDtLance\", title: MURALDETALHES.RESOURCES.Data, template: '#=formataTextoDataGrid(tDtLance, true)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 15%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 15%\" } },\r\n                        { field: \"sDsSituacaoProposta\", title: \"&nbsp;\", template: '#=formataTrofeuAceitabilidade(bFlAceitabilidadeLanceVencedor, nNrRanking)+formataIcones(nStLance,bFlHabilitado)#', headerAttributes: { \"style\": \"width: 12%\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\", \"style\": \"width: 12%\" } },\r\n                    ];\r\n\r\n                    if (false)\r\n                        sColunas.push({ field: \"nCdAnexoHabilitacao\", title: MURALDETALHES.RESOURCES.Anexos, template: '#=formataLanceAnexoHabilitacao(bFlAnexoHabilitacao, nCdLance, null)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n\r\n                    break;\r\n            }\r\n        }\r\n        else {\r\n            if (!bFlOcultarEmpresaItens) {\r\n                sColunas = [{ field: \"sNmEmpresa\", title: MURALDETALHES.RESOURCES.Empresa, template: '#=formataTextoGrid(sNmEmpresa)#' }];\r\n            } else {\r\n                sColunas = [];\r\n            }\r\n            \r\n            if (oMuralProcessoDetalhe.nCdSituacao > 10) {\r\n                if (e.data.bFlExibeMarca > 0)\r\n                    sColunas.push({ field: \"sDsMarca\", title: MURALDETALHES.RESOURCES.Marca });\r\n\r\n                if (e.data.bFlExibeModelo > 0)\r\n                    sColunas.push({ field: \"sDsModelo\", title: MURALDETALHES.RESOURCES.Modelo });\r\n\r\n                if (e.data.bFlExibeProcedencia > 0)\r\n                    sColunas.push({ field: \"sDsProcedencia\", title: MURALDETALHES.RESOURCES.Procedencia });\r\n            }\r\n\r\n            sColunas.push({\r\n                field: \"dVlLance\",\r\n                title: MURALDETALHES.RESOURCES.Valor,\r\n\r\n                template: '#=formatarDVlItemLance(dVlLanceMoeda, dVlLanceMoedaProcesso, nNrCasasDecimaisLance, nNrCasasDecimaisProcesso, sSgMoedaLance, sSgMoedaProcesso)#',\r\n                headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" },\r\n                attributes: { \"class\": \"kendo-grid-alinhamento-direita\" }\r\n            });\r\n\r\n            sColunas.push({ field: \"tDtLance\", title: MURALDETALHES.RESOURCES.Data, template: '#=formataTextoDataGrid(tDtLance, true)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n            sColunas.push({ field: \"bFlVencedor\", title: MURALDETALHES.RESOURCES.Situacao, template: '#=formataVencedor(bFlVencedor, sNrRanking, nStLance, sLanceProposta)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n\r\n            if (oMuralProcessoDetalhe.nIdEstilo == 2 || oMuralProcessoDetalhe.nCdModulo == 22)\r\n                sColunas.unshift({ field: \"sNrRanking\", title: MURALDETALHES.RESOURCES.Ranking, template: '#=formataTextoGrid(sNrRanking)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n            if (oMuralProcessoDetalhe.nCdModulo == 22)\r\n                sColunas.unshift({ field: \"sNrRodada\", title: MURALDETALHES.RESOURCES.Rodada, template: '#=formataTextoGrid(sNrRodada)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } });\r\n        }\r\n\r\n        var dtoProcesso = {\r\n            nCdItem: e.data.nCdItem,\r\n            nCdProcesso: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdModulo: oMuralProcessoDetalhe.nCdModulo,\r\n            nCdSituacao: oMuralProcessoDetalhe.nCdSituacao,\r\n            nIdEstilo: oMuralProcessoDetalhe.nIdEstilo,\r\n            nCdTipoModalidade : oMuralProcessoDetalhe.nCdTipoModalidade,\r\n            nCdLote: nCdLoteAtual,\r\n            tmpTipoMuralProcesso: objParametroMural.tmpTipoMuralProcesso,\r\n            dtoIdioma: {\r\n                nCdIdioma: adquirirIdIdioma(\"/\")\r\n            },\r\n            sNrProcesso: oMuralProcessoDetalhe.sNrProcesso\r\n        }\r\n\r\n        var sIdGrid = nCdLoteAtual > 0 ? \"gridProdutosLote\" : \"gridItem\";\r\n        var sMensagem = \"\";\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.CompraDireta && e.data.nCdSituacao != enumCompraDiretaSituacaoItem.Encerrado)\r\n            sMensagem = MURALDETALHES.RESOURCES.Os_lances_poderao_ser_visualizados_assim_que_a_situacao_do_item_for_encerrada;\r\n        else if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && !validarEnumerador(e.data.nCdSituacao, enumPregaoEletronicoSituacaoItemPermitido))\r\n            sMensagem = MURALDETALHES.RESOURCES.A_situacao_atual_nao_permite_visualizacao;\r\n        else if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico) {\r\n            if (false) {\r\n                    if (e.data.nCdSituacao != Number(\"25\")) {\r\n                    sMensagem = MURALDETALHES.RESOURCES.A_situacao_atual_nao_permite_visualizacao;\r\n                }\r\n            } else if (!validarEnumerador(e.data.nCdSituacao, enumPregaoEletronicoSituacaoLotePermitido)) {\r\n                sMensagem = MURALDETALHES.RESOURCES.A_situacao_atual_nao_permite_visualizacao;\r\n            }\r\n        }\r\n        else if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Convite && e.data.nCdSituacao != enumConviteSituacaoItem.Homologado)\r\n            sMensagem = MURALDETALHES.RESOURCES.As_propostas_poderao_ser_visualizados_assim_que_a_situacao_do_item_for_homologada;\r\n        else if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoPresencial && e.data.nCdSituacao != enumPresencialSituacaoLote.Homologado && e.data.bFlAceitabilidadeLanceVencedor == 0)\r\n            sMensagem = MURALDETALHES.RESOURCES.As_propostas_poderao_ser_visualizadas_assim_que_a_aceitabilidade_do_lance_vencedor_for_realizada;\r\n        else if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoPresencial) {\r\n            //Caso não tenha sido configurado com a fase de negociação(bFlPossuiFaseAceitabilidade) só deve apresentar quando o item estiver na situação homologado\r\n            if (e.data.bFlPossuiFaseAceitabilidade == 0 && e.data.nCdSituacao != enumPresencialSituacaoLote.Homologado) {\r\n                sMensagem = MURALDETALHES.RESOURCES.As_propostas_poderao_ser_visualizadas_assim_que_a_aceitabilidade_do_lance_vencedor_for_realizada;\r\n            }\r\n            //Se possuir a fase de aceitabilidade mas a aceitabilidade ainda não foi feita o valor não deve ser mostrado\r\n            if (e.data.bFlPossuiFaseAceitabilidade != 0 && e.data.bFlAceitabilidadeLanceVencedor == 0) {\r\n                sMensagem = MURALDETALHES.RESOURCES.As_propostas_poderao_ser_visualizadas_assim_que_a_aceitabilidade_do_lance_vencedor_for_realizada;\r\n            }\r\n        }\r\n\r\n        if (sMensagem != \"\")\r\n            $(e.detailCell[0]).text(sMensagem);\r\n        else {\r\n            CarregaGridDetalhes(\r\n                sIdGrid,\r\n                sSchema,\r\n                \"WebService/Servicos.asmx/PesquisarProcessoDetalheItemProdutoLance\",\r\n                \"dtoProcesso:\" + JSON.stringify(dtoProcesso),\r\n                sColunas,\r\n                \"nCdItem\",\r\n                e,\r\n                undefined,\r\n                function () {\r\n                    $(e.detailCell[0]).text(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados);\r\n                }\r\n            );\r\n\r\n            $(\"thead tr th\").each(function () { $(this).attr(\"title\", $(this).data(\"title\")); });\r\n        }\r\n    }\r\n    //#endregion\r\n\r\n    //#region Processo Habilitação - ITEM/LOTE\r\n\r\n    function PesquisarProcessoHabilitacao(_nCdProcesso, _nCdModulo) {\r\n        var sSchema = [{\r\n            sDsItemLote: { type: \"string\" }\r\n        }];\r\n\r\n        let sColunas = [];\r\n        if (oMuralProcessoDetalhe.nIdTipoApuracao == 1)\r\n            sColunas.push({ field: \"sDsItem\", title: MURALDETALHES.RESOURCES.Item, template: '#=formataItem(sDsItemLote, nCdItemLote, null)#' });\r\n        else\r\n            sColunas.push({ field: \"sDsLote\", title: MURALDETALHES.RESOURCES.Lote, template: '#=formataLote(sDsItemLote, nCdItemLote, nCdSituacao, \"gridProdutosLoteHabilitacao\")#' });\r\n\r\n        var dtoProcesso = {\r\n            nCdProcesso: _nCdProcesso,\r\n            nCdModulo: _nCdModulo,\r\n            nIdTipoApuracao: oMuralProcessoDetalhe.nIdTipoApuracao,\r\n            tmpTipoMuralProcesso: objParametroMural.tmpTipoMuralProcesso,\r\n            dtoIdioma: {\r\n                nCdIdioma: adquirirIdIdioma(\"/\")\r\n            }\r\n        }\r\n\r\n        CarregaGrid(\r\n            sSchema,\r\n            \"WebService/Servicos.asmx/PesquisarProcessoHabilitacao\",\r\n            \"dtoProcesso:\" + JSON.stringify(dtoProcesso),\r\n            function (data) {\r\n                $(\"thead tr th\").each(function () { $(this).attr(\"title\", $(this).data(\"title\")); });\r\n            },\r\n            \"gridHabilitacao\",\r\n            sColunas,\r\n            450,\r\n            PesquisarProcessoHabilitacaoItemLote,\r\n            undefined,\r\n            undefined,\r\n            function () {\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n    function PesquisarProcessoHabilitacaoItemLote(e) {\r\n        var sSchema = [{\r\n            sNmEmpresa: { type: \"string\" },\r\n            sDsStatus: { type: \"string\" },\r\n            sDsJustificativa: { type: \"string\" }\r\n        }];\r\n\r\n        var sColunas = [];\r\n        \r\n        sColunas.push({ field: \"sNmEmpresa\", title: MURALDETALHES.RESOURCES.Empresa, template: '#=formataTextoGrid(sNmEmpresa)#' });\r\n        sColunas.push({ field: \"sDsStatus\", title: MURALDETALHES.RESOURCES.Status, template: '#=formataTextoGrid(sDsStatus)#' });\r\n\r\n        if (oMuralProcessoDetalhe.nCdFase == 10) { // Código da fase de pré-qualificação\r\n            sColunas.push(\r\n                { field: \"tDtFimHabilitacao\", title: MURALDETALHES.RESOURCES.Termino_da_habilitacao, template: '#=formataTextoDataGrid(tDtFimHabilitacao)#' },\r\n                { field: \"sDsJustificativa\", title: MURALDETALHES.RESOURCES.Justificativa, template: '#=formataTextoGrid(sDsJustificativa)#' },\r\n            )\r\n        } else {\r\n            sColunas.push({ field: \"sDsJustificativa\", title: MURALDETALHES.RESOURCES.Justificativa, template: '#=formataTextoGrid(sDsJustificativa)#' });\r\n        }\r\n\r\n        var dtoProcesso = {\r\n            nCdItemLote: e.data.nCdItemLote,\r\n            nIdTipoApuracao: oMuralProcessoDetalhe.nIdTipoApuracao,\r\n            nCdModulo: oMuralProcessoDetalhe.nCdModulo,\r\n            tmpTipoMuralProcesso: objParametroMural.tmpTipoMuralProcesso,\r\n            dtoIdioma: {\r\n                nCdIdioma: adquirirIdIdioma(\"/\")\r\n            }\r\n        }\r\n        var sMensagem = \"\";\r\n\r\n        if (sMensagem != \"\")\r\n            $(e.detailCell[0]).text(sMensagem);\r\n        else {\r\n            CarregaGridDetalhes(\r\n                \"gridHabilitacao\",\r\n                sSchema,\r\n                \"WebService/Servicos.asmx/PesquisarProcessoHabilitacaoItemLote\",\r\n                \"dtoProcesso:\" + JSON.stringify(dtoProcesso),\r\n                sColunas,\r\n                \"nCdItemLote\",\r\n                e,\r\n                undefined,\r\n                function () {\r\n                    $(e.detailCell[0]).text(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados);\r\n                }\r\n            );\r\n\r\n            $(\"thead tr th\").each(function () { $(this).attr(\"title\", $(this).data(\"title\")); });\r\n        }\r\n    }\r\n\r\n    //#endregion\r\n\r\n    //#region Processo Classificação - ITEM/LOTE\r\n\r\n    function formataValorMoedaNotaEquivalente(dVlNotaEquivalente, nNrCasasDecimais, sSgMoeda) {\r\n        if (dVlNotaEquivalente === 0)\r\n            return \"\";\r\n        else\r\n            return formataValorMoeda(dVlNotaEquivalente, nNrCasasDecimais, sSgMoeda);\r\n    }\r\n\r\n    function PesquisarProcessoClassificacao(_nCdProcesso, _nCdModulo) {\r\n        var sSchema = [{\r\n            sDsItemLote: { type: \"string\" }\r\n        }];\r\n\r\n        let sColunas = [];\r\n        if (oMuralProcessoDetalhe.nIdTipoApuracao == 1)\r\n            sColunas.push({ field: \"sDsItem\", title: MURALDETALHES.RESOURCES.Item, template: '#=formataItem(sDsItemLote, nCdItemLote, null)#' });\r\n        else\r\n            sColunas.push({ field: \"sDsLote\", title: MURALDETALHES.RESOURCES.Lote, template: '#=formataLote(sDsItemLote, nCdItemLote, nCdSituacao, \"gridProdutosLoteClassificacao\")#' });\r\n\r\n        var dtoProcesso = {\r\n            nCdProcesso: _nCdProcesso,\r\n            nCdModulo: _nCdModulo,\r\n            nIdTipoApuracao: oMuralProcessoDetalhe.nIdTipoApuracao,\r\n            tmpTipoMuralProcesso: objParametroMural.tmpTipoMuralProcesso,\r\n            dtoIdioma: {\r\n                nCdIdioma: adquirirIdIdioma(\"/\")\r\n            }\r\n        }\r\n\r\n        CarregaGrid(\r\n            sSchema,\r\n            \"WebService/Servicos.asmx/PesquisarProcessoClassificacaoItemLote\",\r\n            \"dtoProcesso:\" + JSON.stringify(dtoProcesso),\r\n            function (data) {\r\n                $(\"thead tr th\").each(function () { $(this).attr(\"title\", $(this).data(\"title\")); });\r\n            },\r\n            \"gridClassificacao\",\r\n            sColunas,\r\n            450,\r\n            PesquisarProcessoClassificacaoItemLote,\r\n            undefined,\r\n            undefined,\r\n            function () {\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n    function PesquisarProcessoClassificacaoItemLote(e) {\r\n        var sSchema = [{\r\n            nNrRanking: { type: \"number\" },\r\n            sNmEmpresa: { type: \"string\" },\r\n            sDsStatus: { type: \"string\" },\r\n            dVlProposta: { type: \"number\" },\r\n            dVlNotaEquivalente: { type: \"number\" },\r\n            sDsJustificativa: { type: \"string\" },\r\n            sSgMoeda: { type: \"string\" },\r\n            nNrCasasDecimais: { type: \"number\" },\r\n        }];\r\n\r\n        var sColunas = [\r\n            { field: \"nNrRanking\", title: MURALDETALHES.RESOURCES.Ranking, template: '#=formataTextoRanking(nNrRanking)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-centro\" } }\r\n        ];\r\n        \r\n        sColunas.push({ field: \"sNmEmpresa\", title: MURALDETALHES.RESOURCES.Empresa, template: '#=formataTextoGrid(sNmEmpresa)#' });\r\n        \r\n        sColunas.push(\r\n            { field: \"sDsStatus\", title: MURALDETALHES.RESOURCES.Status, template: '#=formataTextoGrid(sDsStatus)#' },\r\n            { field: \"dVlProposta\", title: MURALDETALHES.RESOURCES.Proposta, template: '#=formataValorMoeda(dVlProposta, nNrCasasDecimais, sSgMoeda)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-direita\" } },\r\n            { field: \"dVlNotaEquivalente\", title: MURALDETALHES.RESOURCES.Nota_equivalente, template: '#=formataValorMoedaNotaEquivalente(dVlNotaEquivalente, nNrCasasDecimais)#', headerAttributes: { \"class\": \"kendo-grid-alinhamento-centro\" }, attributes: { \"class\": \"kendo-grid-alinhamento-direita\" } },\r\n            { field: \"sDsJustificativa\", title: MURALDETALHES.RESOURCES.Justificativa, template: '#=formataTextoGrid(sDsJustificativa)#' }\r\n        );\r\n\r\n        var dtoProcesso = {\r\n            nCdItemLote: e.data.nCdItemLote,\r\n            nIdTipoApuracao: oMuralProcessoDetalhe.nIdTipoApuracao,\r\n            nCdModulo: oMuralProcessoDetalhe.nCdModulo,\r\n            tmpTipoMuralProcesso: objParametroMural.tmpTipoMuralProcesso,\r\n            dtoIdioma: {\r\n                nCdIdioma: adquirirIdIdioma(\"/\")\r\n            }\r\n        }\r\n        var sMensagem = \"\";\r\n\r\n        if (sMensagem != \"\")\r\n            $(e.detailCell[0]).text(sMensagem);\r\n        else {\r\n            CarregaGridDetalhes(\r\n                \"gridClassificacao\",\r\n                sSchema,\r\n                \"WebService/Servicos.asmx/PesquisarProcessoClassificacaoItemLoteEmpresas\",\r\n                \"dtoProcesso:\" + JSON.stringify(dtoProcesso),\r\n                sColunas,\r\n                \"nCdItemLote\",\r\n                e,\r\n                undefined,\r\n                function () {\r\n                    $(e.detailCell[0]).text(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados);\r\n                }\r\n            );\r\n\r\n            $(\"thead tr th\").each(function () { $(this).attr(\"title\", $(this).data(\"title\")); });\r\n        }\r\n    }\r\n\r\n    //#endregion\r\n\r\n\r\n    function CarregarAnexo() {\r\n        $(\"#carregandoAnexo\").show();\r\n\r\n        var objParam = {\r\n            nCdAnexo: oMuralProcessoDetalhe.nCdAnexo,\r\n            nCdAnexoClicado: 0,\r\n            nSqAnexoClicado: 0,\r\n            nCdEditalClicado: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdOrigemClicado: oMuralProcessoDetalhe.nCdOrigem,\r\n            nCdModuloClicado: oMuralProcessoDetalhe.nCdModulo,\r\n            arrAnexos: [],\r\n            divAnexo: \"divAnexo\",\r\n            nIdFormularioValidacao: \"\",\r\n            frmValidacao: undefined\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheAnexo'\",\r\n            function (_retorno) {\r\n                $(\"#divAnexo .row-fluid div:first\").append(_retorno.d);\r\n                $(\"#carregandoAnexo\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function CarregarAnexoProposta() {\r\n        $(\"#carregandoAnexoProposta\").show();\r\n\r\n        var objParam = {\r\n            nCdAnexo: oMuralProcessoDetalhe.nCdAnexo,\r\n            nCdAnexoClicado: 0,\r\n            nSqAnexoClicado: 0,\r\n            nCdEditalClicado: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdOrigemClicado: oMuralProcessoDetalhe.nCdOrigem,\r\n            nCdModuloClicado: oMuralProcessoDetalhe.nCdModulo,\r\n            arrAnexos: [],\r\n            divAnexoProposta: \"divAnexoProposta\",\r\n            nIdFormularioValidacao: \"\",\r\n            frmValidacao: undefined\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheAnexoProposta'\",\r\n            function (_retorno) {\r\n                $(\"#divAnexoProposta .row-fluid div:first\").append(_retorno.d);\r\n                $(\"#carregandoAnexoProposta\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function CarregarAnexoLance() {\r\n        $(\"#carregandoAnexoLance\").show();\r\n\r\n        var objParam = {\r\n            nCdAnexo: oMuralProcessoDetalhe.nCdAnexo,\r\n            nCdAnexoClicado: 0,\r\n            nSqAnexoClicado: 0,\r\n            nCdEditalClicado: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdOrigemClicado: oMuralProcessoDetalhe.nCdOrigem,\r\n            nCdModuloClicado: oMuralProcessoDetalhe.nCdModulo,\r\n            arrAnexos: [],\r\n            divAnexoLance: \"divAnexoLance\",\r\n            nIdFormularioValidacao: \"\",\r\n            frmValidacao: undefined\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheAnexoLance'\",\r\n            function (_retorno) {\r\n                $(\"#divAnexoLance .row-fluid div:first\").append(_retorno.d);\r\n                $(\"#carregandoAnexoLance\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function CarregarAnexoNegociacao() {\r\n        $(\"#carregandoAnexoNegociacao\").show();\r\n\r\n        var objParam = {\r\n            nCdAnexo: oMuralProcessoDetalhe.nCdAnexo,\r\n            nCdAnexoClicado: 0,\r\n            nSqAnexoClicado: 0,\r\n            nCdEditalClicado: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdOrigemClicado: oMuralProcessoDetalhe.nCdOrigem,\r\n            nCdModuloClicado: oMuralProcessoDetalhe.nCdModulo,\r\n            arrAnexos: [],\r\n            divAnexoNegociacao: \"divAnexoNegociacao\",\r\n            nIdFormularioValidacao: \"\",\r\n            frmValidacao: undefined\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheAnexoNegociacao'\",\r\n            function (_retorno) {\r\n                $(\"#divAnexoNegociacao .row-fluid div:first\").append(_retorno.d);\r\n                $(\"#carregandoAnexoNegociacao\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function CarregarAnexoLanceResultado(nCdLance, nCdLoteLance) {\r\n        $(\"#carregandoAnexoLanceResultado\").show();\r\n\r\n        var objParam = {\r\n            nCdOrigem: oMuralProcessoDetalhe.nCdOrigem,\r\n            nCdModulo: oMuralProcessoDetalhe.nCdModulo,\r\n            nCdProposta: nCdLance,\r\n            nCdLoteProposta: nCdLoteLance\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheAnexoLanceResultado'\",\r\n            function (_retorno) {\r\n                $(\"#divDetalheLanceAnexoHabilitacao .row-fluid div:first\").append(_retorno.d);\r\n                $(\"#carregandoAnexoLanceResultado\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function CarregarAnexoHabilitacao() {\r\n        $(\"#carregandoAnexoHabilitacao\").show();\r\n\r\n        var objParam = {\r\n            nCdAnexo: oMuralProcessoDetalhe.nCdAnexo,\r\n            nCdAnexoClicado: 0,\r\n            nSqAnexoClicado: 0,\r\n            nCdEditalClicado: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdOrigemClicado: oMuralProcessoDetalhe.nCdOrigem,\r\n            nCdModuloClicado: oMuralProcessoDetalhe.nCdModulo,\r\n            arrAnexos: [],\r\n            divAnexoHabilitacao: \"divAnexoHabilitacao\",\r\n            nIdFormularioValidacao: \"\",\r\n            frmValidacao: undefined\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheAnexoHabilitacao'\",\r\n            function (_retorno) {\r\n                $(\"#divAnexoHabilitacao .row-fluid div:first\").append(_retorno.d);\r\n                $(\"#carregandoAnexoHabilitacao\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function CarregarAnexoRecurso() {\r\n        $(\"#carregandoAnexoRecurso\").show();\r\n\r\n        var objParam = {\r\n            nCdAnexo: oMuralProcessoDetalhe.nCdAnexo,\r\n            nCdAnexoClicado: 0,\r\n            nSqAnexoClicado: 0,\r\n            nCdEditalClicado: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdOrigemClicado: oMuralProcessoDetalhe.nCdOrigem,\r\n            nCdModuloClicado: oMuralProcessoDetalhe.nCdModulo,\r\n            arrAnexos: [],\r\n            divAnexoRecurso: \"divAnexoRecurso\",\r\n            nIdFormularioValidacao: \"\",\r\n            frmValidacao: undefined\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheAnexoRecurso'\",\r\n            function (_retorno) {\r\n                $(\"#divAnexoRecurso .row-fluid div:first\").append(_retorno.d);\r\n                $(\"#carregandoAnexoRecurso\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function CarregarAnexoContraRazoes() {\r\n        $(\"#carregandoAnexoContraRazoes\").show();\r\n\r\n        var objParam = {\r\n            nCdAnexo: oMuralProcessoDetalhe.nCdAnexo,\r\n            nCdAnexoClicado: 0,\r\n            nSqAnexoClicado: 0,\r\n            nCdEditalClicado: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdOrigemClicado: oMuralProcessoDetalhe.nCdOrigem,\r\n            nCdModuloClicado: oMuralProcessoDetalhe.nCdModulo,\r\n            arrAnexos: [],\r\n            divAnexoContraRazoes: \"divAnexoContraRazoes\",\r\n            nIdFormularioValidacao: \"\",\r\n            frmValidacao: undefined\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheAnexoContraRazoes'\",\r\n            function (_retorno) {\r\n                $(\"#divAnexoContraRazoes .row-fluid div:first\").append(_retorno.d);\r\n                $(\"#carregandoAnexoContraRazoes\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function CarregarAnexoParecer() {\r\n        $(\"#carregandoAnexoParecer\").show();\r\n\r\n        var objParam = {\r\n            nCdAnexo: oMuralProcessoDetalhe.nCdAnexo,\r\n            nCdAnexoClicado: 0,\r\n            nSqAnexoClicado: 0,\r\n            nCdEditalClicado: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdOrigemClicado: oMuralProcessoDetalhe.nCdOrigem,\r\n            nCdModuloClicado: oMuralProcessoDetalhe.nCdModulo,\r\n            arrAnexos: [],\r\n            divAnexoParecer: \"divAnexoParecer\",\r\n            nIdFormularioValidacao: \"\",\r\n            frmValidacao: undefined\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheAnexoParecer'\",\r\n            function (_retorno) {\r\n                $(\"#divAnexoParecer .row-fluid div:first\").append(_retorno.d);\r\n                $(\"#carregandoAnexoParecer\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function CarregarHistorico() {\r\n        $(\"#carregandoHistorico\").show();\r\n\r\n        var objParam = {\r\n            nCdProcesso: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdModulo: oMuralProcessoDetalhe.nCdModulo,\r\n            divHistorico: \"divHistorico\"\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheHistorico'\",\r\n            function (_retorno) {\r\n                $(\"#divHistorico .row-fluid div:first\").append(_retorno.d);\r\n                $(\"#carregandoHistorico\").hide();\r\n            },\r\n            function (x, e) {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function CarregarChat(nAltura) {\r\n        if ($(\"#gridChat\").length == 1)\r\n            $(\"#uc_MuralDetalheChat\").remove()\r\n\r\n        $(\"#carregandoChat\").show();\r\n\r\n        var objParam = {\r\n            nCdProcesso: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdModulo: oMuralProcessoDetalhe.nCdModulo,\r\n            nAltura: (nAltura == null) ? 200 : nAltura,\r\n            objTempo: null,\r\n            divChat: \"divChat\"\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheChat'\",\r\n            function (_retorno) {\r\n                $(\"#divChat .row-fluid div:first\").append(_retorno.d);\r\n                $(\"#carregandoChat\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function CarregarRelatorio() {\r\n        $(\"#carregandoRelatorio\").show();\r\n\r\n        var objParam = {\r\n            nCdProcesso: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdModulo: oMuralProcessoDetalhe.nCdModulo,\r\n            nIdTipoApuracao: oMuralProcessoDetalhe.nIdTipoApuracao,\r\n            nCdSituacao: oMuralProcessoDetalhe.nCdSituacao,\r\n            nCdEmpresa: oMuralProcessoDetalhe.nCdEmpresa,\r\n            divRelatorio: \"divRelatorio\"\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheRelatorio'\",\r\n            function (_retorno) {\r\n                $(\"#divRelatorio .row-fluid div:first\").append(_retorno.d);\r\n                $(\"#carregandoRelatorio\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function CarregarImpugnacao() {\r\n        $(\"#carregandoImpugnacao\").show();\r\n\r\n        var objParam = {\r\n            nCdProcesso: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdModulo: oMuralProcessoDetalhe.nCdModulo,\r\n            bFlPermiteImpugnacaoValidDate: oMuralProcessoDetalhe.bFlPermiteImpugnacaoValidDate,\r\n            bFlPermiteImpugnacao: oMuralProcessoDetalhe.bFlPermiteImpugnacao,\r\n            nCdImpugnacao: 0,\r\n            sNrProtocolo: \"\",\r\n            nCdAnexo: 0,\r\n            nSqAnexo: 0,\r\n            frmValidacao: undefined,\r\n            divImpugnar: \"divImpugnar\"\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheImpugnar'\",\r\n            function (_retorno) {\r\n                $(\"#divImpugnar .row-fluid div:first\").append(_retorno.d);\r\n                $(\"#carregandoImpugnacao\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function CarregarForum(bForumPermitePostagem, nCdModulo) {\r\n        $(\"#carregandoForum\").show();\r\n\r\n        var objParam = {\r\n            nCdProcesso: oMuralProcessoDetalhe.nCdProcesso,\r\n            nCdModulo: nCdModulo,\r\n            bFlPermiteEsclarecer: oMuralProcessoDetalhe.bFlPermiteEsclarecer,\r\n            divForum: \"divForum\",\r\n            nCdMensagemClicado: 0,\r\n            bFlForumPermitePostagem: bForumPermitePostagem,\r\n            frmValidacao: undefined\r\n        };\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify(objParam) + \"', sNomeUserControl:'MuralDetalheForum'\",\r\n            function (_retorno) {\r\n                $(\"#divForum .row-fluid div:first\").append(_retorno.d);\r\n                $(\"#carregandoForum\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function CarregarCadastroFornecedor(obj) {\r\n        var arrResumoDetalhe = [];\r\n        var arrCadastroFornecedor = []\r\n        var sDsClasse;\r\n\r\n        if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL_SIMPLIFICADO) {\r\n\r\n            arrResumoDetalhe.push({ ordem: 1, id: \"lblNomEmpresa\", resource: MURALDETALHES.RESOURCES.Empresa, valor: obj.sNmEmpresa });\r\n            arrResumoDetalhe.push({ ordem: 2, id: \"lblSituacao\", resource: MURALDETALHES.RESOURCES.Situacao, valor: obj.sDsSituacao });\r\n            arrResumoDetalhe.push({ ordem: 3, id: \"lblDataVigencia\", resource: MURALDETALHES.RESOURCES.Vigencia, valor: (obj.sDtVigencia == null ? MURAL.RESOURCES.Nao_informado : obj.sDtVigencia.split(\" \", 1)) });\r\n            arrResumoDetalhe.push({ ordem: 4, id: \"lblDataAprovacao\", resource: MURALDETALHES.RESOURCES.Aprovacao, valor: (obj.sDtAprovacao == null ? MURAL.RESOURCES.Nao_informado : obj.sDtAprovacao.split(\" \", 1)) });\r\n\r\n            arrCadastroFornecedor.push(\"lblNomEmpresa\");\r\n            arrCadastroFornecedor.push(\"lblDataAprovacao\");\r\n            arrCadastroFornecedor.push(\"lblDataVigencia\");\r\n            arrCadastroFornecedor.push(\"lblSituacao\");\r\n        }\r\n\r\n        if (arrCadastroFornecedor.length > 0) {\r\n            arrResumoDetalhe = arrResumoDetalhe.filter(f => arrCadastroFornecedor.indexOf(f.id) != -1);\r\n        }\r\n\r\n        $(\"#grupoCadastroFornecedor\").children().remove();\r\n\r\n        var templateDetalhe = \"<li><span class='destaquePalavra'>[label]: </span><span id='[idLabel]'>[valorLabel]</span></li> \";\r\n        var sConteudo = \"\";\r\n        arrResumoDetalhe.sort(ordenarArrayPor(\"ordem\"));\r\n\r\n        $(arrResumoDetalhe).each(function (indice) {\r\n            if (this.valor == \"\")\r\n                sConteudo += \"<li><span class='destaquePalavra'></span><span></span></li>\";\r\n            else\r\n                sConteudo += templateDetalhe.split(\"[label]\").join(this.resource).split(\"[idLabel]\").join(this.id).split(\"[valorLabel]\").join(this.valor).split(\"[span]\").join(\"span4\");\r\n\r\n            if (((indice + 1) % 2) == 0) {\r\n                $(\"#grupoCadastroFornecedor\").append(\"<ul class='nav-detalhes'>\" + sConteudo + \"</ul>\");\r\n                sConteudo = \"\";\r\n            }\r\n            else {\r\n                if (arrResumoDetalhe.length == (indice + 1)) {\r\n                    $(\"#grupoCadastroFornecedor\").append(\"<ul class='nav-detalhes'>\" + sConteudo + \"</ul>\");\r\n                    sConteudo = \"\";\r\n                }\r\n            }\r\n        });\r\n        trListaMuralProcesso_Click(obj.nCdProcesso, obj.nCdModulo, \"\", true);\r\n\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/PesquisarCaminhoLinhaDeFornecimento\",\r\n            `nCdClasse:${obj.nCdClasse}`,\r\n            function (_retorno) {\r\n                $(\"#hFornecedor\").html(`Cadastro de Consultores - Linha de Fornecimento: ${_retorno.d} (Chamamento: ${obj.sNrEdital})`);\r\n                $(\".painel-funcionalidades-fornecedor\").show();\r\n            },\r\n        );\r\n\r\n    }\r\n\r\n\r\n    //Opa Carga do conteudo scroll, seu eu for add coisa nova vai ser aqui\r\n    function VerificarCargaConteudoScroll() {\r\n        var bAchou = false;\r\n\r\n        $(\"#divHistorico, #divRelatorio, #divChat, #divAnexo, #divAnexoProposta, #divAnexoLance, #divAnexoNegociacao, #divAnexoHabilitacao, #divAnexoLanceResultado, #divAnexoRecurso,  #divAnexoContraRazoes, #divAnexoParecer, #divForum, #divImpugnar, #divNotas\").each(function () {\r\n            var id = \"#\" + this.id;\r\n            if ($(id).data(\"carregado\") == \"0\") {\r\n                bAchou = scrollAtingiuElemento(this.id);\r\n                if (bAchou) {\r\n                    $(id).data(\"carregado\", \"1\");\r\n                    switch (this.id) {\r\n                        case \"divHistorico\":\r\n                            if (objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL_SIMPLIFICADO) {\r\n                                if (objConfiguracao.bFlHistoricoPublico > 0 && $(\"#ddlModulo\").val() != MURALDETALHES.MODULO.Cotacao.toString())\r\n                                    CarregarHistorico();\r\n                            }\r\n                            break;\r\n                        case \"divRelatorio\":\r\n                            if (objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL_SIMPLIFICADO) {\r\n                                if (objConfiguracao.bFlRelatorioPublico > 0 && $(\"#ddlModulo\").val() != MURALDETALHES.MODULO.Cotacao.toString())\r\n                                    CarregarRelatorio();\r\n                            }\r\n                            break;\r\n                        case \"divChat\":\r\n                            if (objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL_SIMPLIFICADO) {\r\n                                if (isExibirChatAreaPublica()) {\r\n                                    CarregarChat();\r\n                                }\r\n                            }\r\n                            break;\r\n                        case \"divAnexo\":\r\n                            if (oMuralProcessoDetalhe.nCdEdital > 0 || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Cotacao || $(\"#ddlModulo\").val() == \"8\" || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao)\r\n                                CarregarAnexo();\r\n                            break;\r\n                        case \"divAnexoProposta\":\r\n                            if (oMuralProcessoDetalhe.nCdEdital > 0 || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico || $(\"#ddlModulo\").val() == \"18\" || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao || $(\"#ddlModulo\").val() == \"59\")\r\n                                CarregarAnexoProposta();\r\n                            break;\r\n                        case \"divAnexoLance\":\r\n                            if (oMuralProcessoDetalhe.nCdEdital > 0 || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico || $(\"#ddlModulo\").val() == \"18\" || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao || $(\"#ddlModulo\").val() == \"59\")\r\n                                CarregarAnexoLance();\r\n                            break;\r\n                        case \"divAnexoNegociacao\":\r\n                            if (oMuralProcessoDetalhe.nCdEdital > 0 || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico || $(\"#ddlModulo\").val() == \"18\" || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao || $(\"#ddlModulo\").val() == \"59\")\r\n                                CarregarAnexoNegociacao();\r\n                            break;\r\n                        case \"divAnexoHabilitacao\":\r\n                            if (oMuralProcessoDetalhe.nCdEdital > 0 || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico || $(\"#ddlModulo\").val() == \"18\" || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao || $(\"#ddlModulo\").val() == \"59\")\r\n                                CarregarAnexoHabilitacao();\r\n                            break;\r\n                        case \"divAnexoRecurso\":\r\n                            if (oMuralProcessoDetalhe.nCdEdital > 0 || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico || $(\"#ddlModulo\").val() == \"18\" || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao || $(\"#ddlModulo\").val() == \"59\")\r\n                                CarregarAnexoRecurso();\r\n                            break;\r\n                        case \"divAnexoContraRazoes\":\r\n                            if (oMuralProcessoDetalhe.nCdEdital > 0 || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico || $(\"#ddlModulo\").val() == \"18\" || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao || $(\"#ddlModulo\").val() == \"59\")\r\n                                CarregarAnexoContraRazoes();\r\n                            break;\r\n                        case \"divAnexoParecer\":\r\n                            if (oMuralProcessoDetalhe.nCdEdital > 0 || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico || $(\"#ddlModulo\").val() == \"18\" || oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao || $(\"#ddlModulo\").val() == \"59\")\r\n                                if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao || $(\"#ddlModulo\").val() == MURALDETALHES.MODULO.Licitacao) { \r\n                                    $('#divAnexoParecer h1').text(\"Anexo - JULGAMENTO DO RECURSO\");\r\n                                }\r\n                                CarregarAnexoParecer();\r\n                            break;\r\n                        case \"divForum\":\r\n                            if (objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL_SIMPLIFICADO) {\r\n                                if (\r\n                                    (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.CompraDireta && objConfiguracao.bFlForumPublicoCompraDireta > 0) ||\r\n                                    (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Convite && objConfiguracao.bFlForumPublicoConvite > 0) ||\r\n                                    (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && objConfiguracao.bFlForumPublicoPregaoEletronico > 0) ||\r\n                                    (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoPresencial && objConfiguracao.bFlForumPublicoPregaoPresencial > 0) ||\r\n                                    (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Cotacao && objConfiguracao.bFlForumPublicoCotacao > 0)\r\n                                )\r\n                                    CarregarForum(oMuralProcessoDetalhe.bFlForumPermitePostagem, oMuralProcessoDetalhe.nCdModulo);\r\n                            }\r\n                            break;\r\n                        case \"divImpugnar\":\r\n                            if (objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL && objParametroMural.tmpTipoMuralProcesso != enumTipoMuralProcesso.EDITAL_SIMPLIFICADO) {\r\n                                if (oMuralProcessoDetalhe.bFlPermiteImpugnacao > 0)\r\n                                    CarregarImpugnacao();\r\n                            }\r\n                            break;\r\n                        case \"divNotas\":\r\n                            CarregarNotas();\r\n                            break;\r\n                    }\r\n                }\r\n            }\r\n\r\n            setTimeout(function () {\r\n                if (window.scrTop <= 200)\r\n                    $(\"#divVoltarTopo\").fadeOut();\r\n                else\r\n                    $(\"#divVoltarTopo\").fadeIn();\r\n            }, 500);\r\n        });\r\n    }\r\n\r\n    function btAcao_Click(acao) {\r\n        switch (acao) {\r\n            case \"faq\":\r\n                AbrirJanelaFAQ();\r\n                break;\r\n            case \"relatorio\":\r\n                scrollParaElemento(\"divRelatorio\");\r\n                break;\r\n            case \"edital\":\r\n                trListaMuralResumoEdital_Click(oMuralProcessoDetalhe.nCdProcesso, oMuralProcessoDetalhe.nCdModulo, oMuralProcessoDetalhe.nCdOrigem, false);\r\n                break;\r\n            case \"historico\":\r\n                scrollParaElemento(\"divHistorico\");\r\n                break;\r\n            case \"chat\":\r\n                scrollParaElemento(\"divChat\");\r\n                break;\r\n            case \"forum\":\r\n                scrollParaElemento(\"divForum\");\r\n                break;\r\n            case \"anexo\":\r\n                scrollParaElemento(\"divAnexo\");\r\n                break;\r\n            case \"anexoproposta\":\r\n                scrollParaElemento(\"divAnexoProposta\");\r\n                break;\r\n            case \"anexolance\":\r\n                scrollParaElemento(\"divAnexoLance\");\r\n                break;\r\n            case \"anexonegociacao\":\r\n                scrollParaElemento(\"divAnexoNegociacao\");\r\n                break;\r\n            case \"anexohabilitacao\":\r\n                scrollParaElemento(\"divAnexoHabilitacao\");\r\n                break;\r\n            case \"anexorecurso\":\r\n                scrollParaElemento(\"divAnexoRecurso\");\r\n                break;\r\n            case \"anexocontrarazoes\":\r\n                scrollParaElemento(\"divAnexoContraRazoes\");\r\n                break;\r\n            case \"anexoparecer\":\r\n                scrollParaElemento(\"divAnexoParecer\");\r\n                break;\r\n            case \"impugnar\":\r\n                scrollParaElemento(\"divImpugnar\");\r\n                break;\r\n            case \"notas\":\r\n                scrollParaElemento(\"divNotas\");\r\n                break;\r\n            case \"topo\":\r\n                scrollParaElemento(\"cabecalho\");\r\n                $(\"#divVoltarTopo\").fadeOut();\r\n                break;\r\n            case \"voltar\":\r\n\r\n                //Destrói a visualização dos itens (se houver)\r\n                btVoltarMuralProcessoDetalheItemLote_Click();\r\n\r\n                //Reseta os objetos e estados de cada painel\r\n                oMuralProcessoDetalhe = \"\";\r\n                arrMuralProcessoDetalheItemProduto = [];\r\n                $(\"#divEdital, #divHistorico, #divRelatorio, #divChat, #divAnexo, #divAnexoProposta, #divAnexoLance, #divAnexoNegociacao, #divAnexoHabilitacao, #divAnexoRecurso, #divAnexoContraRazoes, #divAnexoParecer, #divForum, #divImpugnar, #divNotas\").each(function () { var id = \"#\" + this.id; $(id).data(\"carregado\", \"0\"); });\r\n\r\n                //Destrói a grade de itens\r\n                if (typeof $(\"#gridItem\").data(\"kendoGrid\") != \"undefined\")\r\n                    $(\"#gridItem\").data(\"kendoGrid\").destroy();\r\n\r\n                $(\"#gridItem\").children().remove();\r\n                $(\"#gridItem\").removeAttr(\"data-role\").removeAttr(\"class\").removeAttr(\"style\");\r\n                $(\"#gridItem\").attr(\"class\", \"grade-item\");\r\n\r\n                //Destrói os painéis de detalhes\r\n                $(\"#divAnexo form\").remove();\r\n                $(\"#divAnexoProposta form\").remove();\r\n                $(\"#divAnexoLance form\").remove();\r\n                $(\"#divAnexoNegociacao form\").remove();\r\n                $(\"#divAnexoHabilitacao form\").remove();\r\n                $(\"#divAnexoRecurso form\").remove();\r\n                $(\"#divAnexoContraRazoes form\").remove();\r\n                $(\"#divAnexoParecer form\").remove();\r\n                $(\"#divHistorico form\").remove();\r\n                $(\"#divRelatorio form\").remove();\r\n                $(\"#divForum form\").remove();\r\n                $(\"#divChat form\").remove();\r\n                $(\"#divImpugnar form\").remove();\r\n                $(\"#divNotas form\").remove();\r\n\r\n                if (typeof objParametroChat != \"undefined\")\r\n                    clearInterval(objParametroChat.objTempo);\r\n\r\n\r\n                MuralProcesso_Retorna();\r\n                break;\r\n            case \"voltarUrlMural\":\r\n                var qsParam = (new URL(document.location)).searchParams.get(\"nNmTela\");\r\n                var sUrl = `/Portal/Mural.aspx?${ObterQueryStringFiltroUrlMural()}nNmTela=${qsParam}`;\r\n                localStorage.setItem('bFlUsarFiltroAnterior', true);\r\n                window.location = sUrl;\r\n                break;\r\n            case \"inscreverSemCadastro\":\r\n                window.location = `/Empresa/CadastroExterno/ApresentacaoCadastro`;\r\n                break;\r\n            case \"inscreverComCadastro\":\r\n                $(\"#divLogin\").find('input[type=button],input[type=submit]').first().click();\r\n                break;\r\n        }\r\n    }\r\n\r\n    function btVoltarMuralProcessoDetalheItemLote_Click(el = undefined) {\r\n        if (el) {\r\n            var parentComponent = $(el).parent().parent().parent();\r\n\r\n            if (parentComponent.id === \"HeadDetalhesDoProcesso\") parentComponent.parent();\r\n\r\n            var gridProdutosLote = parentComponent.find(\"[id^='gridProdutosLote']\");\r\n\r\n            if (gridProdutosLote.length > 0) {\r\n                gridProdutosLote.data(\"kendoGrid\").destroy();\r\n                gridProdutosLote.children().remove()\r\n                gridProdutosLote.removeAttr(\"data-role\").removeAttr(\"class\").removeAttr(\"style\");\r\n                gridProdutosLote.attr(\"class\", \"grade-produto-lote\");\r\n                gridProdutosLote.css({ \"display\": \"none\", \"opacity\": \"0\" });\r\n            }\r\n\r\n            parentComponent.find(\".grade-produto-lote\").first().hide();\r\n            gridProdutosLote.parent().find('.grade-item').show();\r\n            gridProdutosLote.parent().find('.grade-item').animate({ opacity: 1 }, 300, function () { });\r\n        }\r\n    }\r\n\r\n    function isExibirChatAreaPublica() {\r\n        var isExibirChat = false;\r\n\r\n        if (1 != 1) {\r\n            return false;\r\n        }\r\n\r\n        // Licitação: considera apenas bFlExibeChatAreaPublica e as situações do parâmetro de modalidade nNrSituacoesApresentaChat (ignora bFlSempreExibirChatAreaPublica)\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n            return oMuralProcessoDetalhe.bFlExibeChatAreaPublica === true;\r\n        }\r\n\r\n        if (1 == 1) {\r\n            return true;\r\n        }\r\n\r\n        if (\r\n            (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.CompraDireta && (oMuralProcessoDetalhe.nCdSituacao == enumCompraDiretaSituacao.Analise_Lances || enumCompraDiretaSituacao.Prazo_Prorrogado || oMuralProcessoDetalhe.nCdSituacao == enumCompraDiretaSituacao.Recebimento_Lances)) ||\r\n            (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.PregaoEletronico && (oMuralProcessoDetalhe.nCdSituacao == enumPregaoSituacao.Em_proposta || oMuralProcessoDetalhe.nCdSituacao == enumPregaoSituacao.Prazo_prorrogado || oMuralProcessoDetalhe.nCdSituacao == enumPregaoSituacao.Anulado || oMuralProcessoDetalhe.nCdSituacao == enumPregaoSituacao.Revogado || oMuralProcessoDetalhe.nCdSituacao == enumPregaoSituacao.Fracassado || oMuralProcessoDetalhe.nCdSituacao == enumPregaoSituacao.Em_disputa_de_lances))\r\n        ) {\r\n            isExibirChat = true;\r\n        }\r\n\r\n        return isExibirChat;\r\n    }\r\n\r\n    function isExibirFaq() {\r\n        return 0 == 1;\r\n    }\r\n\r\n    function isExibirAnexoProcesso() {\r\n        if (oMuralProcessoDetalhe.nCdModulo == MURALDETALHES.MODULO.Licitacao) {\r\n            return 1;\r\n        }\r\n        return 0;\r\n    }\r\n\r\n    function IndExibirNotasPublica() {\r\n        if (objParametroMural.tmpTipoMuralProcesso == enumTipoMuralProcesso.EDITAL_SIMPLIFICADO) return false;\r\n\r\n        switch (oMuralProcessoDetalhe.nCdModulo) {\r\n\r\n            case MURALDETALHES.MODULO.CompraDireta:\r\n                return objConfiguracao.bFlNotaPublicoCompraDireta == 1;\r\n                break;\r\n\r\n            case MURALDETALHES.MODULO.Convite:\r\n                return objConfiguracao.bFlNotaPublicoConvite == 1;\r\n                break;\r\n\r\n            case MURALDETALHES.MODULO.PregaoEletronico:\r\n                return objConfiguracao.bFlNotaPublicoPregaoEletronico == 1;\r\n                break;\r\n\r\n            case MURALDETALHES.MODULO.PregaoPresencial:\r\n                return objConfiguracao.bFlNotaPublicoPresencial == 1;\r\n                break;\r\n\r\n            case MURALDETALHES.MODULO.Cotacao:\r\n                return objConfiguracao.bFlNotaPublicoCotacao == 1;\r\n                break;\r\n\r\n            case MURALDETALHES.MODULO.Licitacao:\r\n                return true;\r\n                break;\r\n\r\n            default:\r\n                return false;\r\n        }\r\n    }\r\n\r\n    function CarregarNotas() {\r\n        $(\"#carregandoNotas\").show();\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/CarregarControle\",\r\n            \"objParametros:'\" + JSON.stringify({ bFlMuralEdital: oMuralProcessoDetalhe.bFlMuralEdital, nCdProcesso: oMuralProcessoDetalhe.nCdProcesso, nCdEdital: oMuralProcessoDetalhe.nCdEdital, nCdModulo: oMuralProcessoDetalhe.nCdModulo }) + \"', sNomeUserControl:'MuralDetalheNota'\",\r\n            function (_retorno) {\r\n                $(\"#divNotas .row-fluid div:first\").append(_retorno.d);\r\n                $(\"#carregandoNotas\").hide();\r\n            },\r\n            function () {\r\n                Alerta(MURALDETALHES.RESOURCES.Nao_foi_possivel_recuperar_dados, \"/\");\r\n                btAcao_Click(\"voltar\");\r\n            }\r\n        );\r\n    }\r\n\r\n    function AbrirJanelaFAQ() {\r\n        chamadaWebService(\r\n            \"WebService/Servicos.asmx/RetornarParametrosFAQ\",\r\n            \"nCdModulo:\" + oMuralProcessoDetalhe.nCdModulo + \", nCdOrigem:\" + oMuralProcessoDetalhe.nCdOrigem,\r\n            function (_retorno) {\r\n                AbrirJanelaTelaInicial(\"/portal/FAQMural.aspx\" + _retorno.d, \"FAQ\", 1000, 520);\r\n            }\r\n        );\r\n    }\r\n\r\n</script>\r\n    </div>\r\n\r\n    <!-- Div Resumo do Edital -->\r\n    <div id=\"divResumoEdital\">\r\n        <div id=\"carregandoResumoEdital\" class=\"carregandoDados\" style=\"display:none\"; ><img src=\"Imagens/carregando.gif\" /></div>\r\n        <iframe id=\"frameResumoEdital\" src=\"\" width=\"800px\" height=\"425px\" ></iframe>\r\n        <div class=\"botoes-kendo-window\" >\r\n            <input id=\"btImprimirEdital\" type=\"button\" value='Imprimir' class=\"campoBotaoSemIcone\" onclick=\"imprimirConteudo($('#frameResumoEdital').contents().find('html')[0])\" style=\"width:20%; display: none;\" />\r\n            <input id=\"btDetalhesDosItens\" type=\"button\" value='Detalhes dos itens' class=\"campoBotaoSemIcone\" style=\"width:25%; display: none;\" />\r\n            <input id=\"btFecharEdital\" type=\"button\" value='Fechar' onclick=\"$('#divResumoEdital').data('kendoWindow').close()\" class=\"campoBotaoSemIcone\" style=\"width:20%; display:none;\" />\r\n        </div>\r\n    </div>\r\n\r\n\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Rodapé -->\r\n            <div id=\"rodape\"><div class='conteudo'>Copyright 2026 - Powered by Paradigma®</div></div>\r\n\r\n        </div>\r\n\r\n    </form>\r\n\r\n</body>\r\n\r\n</html>\r\n"
          },
