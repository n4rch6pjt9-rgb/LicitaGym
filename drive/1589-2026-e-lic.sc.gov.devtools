          "content": {
            "size": 12957,
            "mimeType": "application/x-javascript",
            "text": "﻿var ObjModal;\r\nvar objRetorno;\r\n\r\nvar Class = {\r\n    create: function () {\r\n        return function () {\r\n            if (typeof this.initialize == \"function\")\r\n                this.initialize.apply(this, arguments);\r\n        }\r\n    }\r\n}\r\nvar PTAMessage = Class.create();\r\nPTAMessage.prototype = {\r\n    initialize: function (sTitulo, sMsg, sTipo) {\r\n        this.headertext = sTitulo;\r\n        this.message = sMsg;\r\n        this.type = sTipo;\r\n    },\r\n    show: function () {\r\n        return AbrirJanelaModal(this.headertext, this.message, this.type);\r\n    }\r\n};\r\n\r\n//****Janela Modal ************************\r\nfunction AbrirJanelaModal(sTitulo, sMensagem, sTipo) {\r\n\r\n    if (typeof sMensagem != \"undefined\" && sMensagem != \"\") {\r\n        ObjModal = new Object();\r\n        ObjModal.Titulo = sTitulo;\r\n        ObjModal.Mensagem = sMensagem;\r\n\r\n        var objJanela = null;\r\n        try {\r\n            if (top.frames[\"bottom\"])\r\n                objJanela = top.frames[\"bottom\"].window;\r\n            else\r\n                objJanela = window;\r\n        } catch (e) {\r\n            objJanela = window;\r\n        }\r\n        \r\n        try {\r\n            var oIE = navigator.userAgent.match(/(MSIE |Trident.*rv[ :])([0-9]+)/);\r\n            if (oIE != null && typeof oIE != \"undefined\" && typeof oIE != undefined && oIE[2] > 0)\r\n                window.showModalDialog = false;\r\n        }\r\n        catch (e) { }\r\n\r\n        switch (sTipo) {\r\n            case 'ok':\r\n                ObjModal.BotaoOk = true;\r\n                if (window.showModalDialog) {\r\n                    return objJanela.showModalDialog(PTA_sProjeto + \"core/include/pta_webcontrols/modalDialog.aspx\", ObjModal, \"dialogHeight:230px; dialogWidth:320px; center:1; help:0; scroll:0; status:0; unadorned:1;\");\r\n                } else {\r\n                    return confirm(sMensagem.replace(/<br\\s*[\\/]?>/gi, \"\\n\"));\r\n                }\r\n                break;\r\n            case 'okcancelar':\r\n                ObjModal.BotaoOk = true;\r\n                ObjModal.BotaoCancelar = true;\r\n\r\n                if (window.showModalDialog) {\r\n                    sResult = objJanela.showModalDialog(PTA_sProjeto + \"core/include/pta_webcontrols/modalDialog.aspx\", ObjModal, \"dialogHeight:230px; dialogWidth:320px; center:1; help:0; scroll:0; status:0; unadorned:1;\");\r\n                    return (sResult == 'ok' ? true : false);\r\n                } else {\r\n                    return confirm(sMensagem.replace(/<br\\s*[\\/]?>/gi, \"\\n\"));\r\n                }\r\n\r\n                break;\r\n            case 'prompt':\r\n                ObjModal.BotaoOkPrompt = true;\r\n                ObjModal.BotaoCancelarPrompt = true;\r\n                ObjModal.Prompt = ' ';\r\n\r\n                if (window.showModalDialog) {\r\n                    sResult = objJanela.showModalDialog(PTA_sProjeto + \"core/include/pta_webcontrols/modalDialog.aspx\", ObjModal, \"dialogHeight:230px; dialogWidth:320px; center:1; help:0; scroll:0; status:0; unadorned:1;\");\r\n                    return (sResult == 'ok' ? true : false);\r\n                } else {\r\n                    return confirm(sMensagem.replace(/<br\\s*[\\/]?>/gi, \"\\n\"));\r\n                }\r\n                break;\r\n            case 'simnao':\r\n                ObjModal.BotaoSim = true;\r\n                ObjModal.BotaoNao = true;\r\n\r\n                if (window.showModalDialog) {\r\n                    sResult = objJanela.showModalDialog(PTA_sProjeto + \"core/include/pta_webcontrols/modalDialog.aspx\", ObjModal, \"dialogHeight:230px; dialogWidth:320px; center:1; help:0; scroll:0; status:0; unadorned:1;\");\r\n                    return (sResult == 'sim' ? true : false);\r\n                } else {\r\n                    return confirm(sMensagem.replace(/<br\\s*[\\/]?>/gi, \"\\n\"));\r\n                }\r\n                break;\r\n        }\r\n    }\r\n\r\n    return false;\r\n}\r\n\r\nfunction OK(sTitulo, sMensagem) {\r\n    return AbrirJanelaModal(sTitulo, sMensagem, 'ok')\r\n}\r\n\r\nfunction OKCancelar(sTitulo, sMensagem) {\r\n    return AbrirJanelaModal(sTitulo, sMensagem, 'okcancelar');\r\n}\r\n\r\nfunction Prompt(sTitulo, sMensagem) {\r\n    return AbrirJanelaModal(sTitulo, sMensagem, 'prompt');\r\n}\r\n\r\nfunction SimNao(sTitulo, sMensagem) {\r\n    return AbrirJanelaModal(sTitulo, sMensagem, 'simnao');\r\n}\r\n\r\nvar inativarErro = false;\r\nfunction Erro(sMensagem, sUrl) {\r\n    if (inativarErro == false) {\r\n        ObjModal = new Object();\r\n        ObjModal.BotaoOk = true;\r\n        ObjModal.Titulo = PTA_AVISO;\r\n        ObjModal.Mensagem = sMensagem;\r\n        var objJanela = null;\r\n        try {\r\n            if (top.frames[\"bottom\"])\r\n                objJanela = top.frames[\"bottom\"].window;\r\n            else\r\n                objJanela = window;\r\n        } catch (e) {\r\n            objJanela = window;\r\n        }\r\n\r\n        //if (window.showModalDialog && window.opener) {\t    \r\n\r\n        if (typeof sMensagem != \"undefined\" && sMensagem != null && sMensagem.toString() != \"\") {\r\n            if (window.showModalDialog)\r\n                sResult = objJanela.showModalDialog(PTA_sProjeto + \"core/include/pta_webcontrols/modalDialog.aspx\", ObjModal, \"dialogHeight:230px; dialogWidth:320px; center:1; help:0; scroll:0; status:0; unadorned:1;\");\r\n            else\r\n                AbrirJanelaModal(\"\", sMensagem, 'ok');\r\n        }\r\n\r\n        if (sUrl != '')\r\n            window.location.href = sUrl;\r\n    }\r\n}\r\n//**************************************\r\n\r\n//**************************************\r\n/* Janela Modal com Div Flutuante     */\r\n\r\nfunction _AbrirJanelaModal(sTitulo, sMensagem, sTipo, fCallback) {\r\n    var bFlStatusAcao = null;\r\n\r\n    var sDivMensagem = '<div id=\"divMensagemFlutuante\" title=\"' + sTitulo + '\"><p><span class=\"ui-icon ui-icon-[icon]\" style=\"float:left; margin:0 7px 20px 0;\"></span>' + sMensagem + '</p></div>';\r\n\r\n    var arrDivMensagemBotoes = null;\r\n    switch (sTipo) {\r\n        case 'okcancelar':\r\n            sDivMensagem = sDivMensagem.replace(\"[icon]\", \"alert\");\r\n\r\n            arrDivMensagemBotoes = {\r\n                \"OK\": function () {\r\n                    bFlStatusAcao = true;\r\n\r\n                    $(this).dialog('close');\r\n                },\r\n                \"Cancelar\": function () {\r\n                    bFlStatusAcao = false;\r\n\r\n                    $(this).dialog('close');\r\n                }\r\n            };\r\n            break;\r\n\r\n        case 'simnao':\r\n            sDivMensagem = sDivMensagem.replace(\"[icon]\", \"help\");\r\n\r\n            arrDivMensagemBotoes = {\r\n                \"Sim\": function () {\r\n                    bFlStatusAcao = true;\r\n\r\n                    $(this).dialog('close');\r\n                },\r\n                \"Não\": function () {\r\n                    bFlStatusAcao = false;\r\n\r\n                    $(this).dialog('close');\r\n                }\r\n            };\r\n            break;\r\n\r\n        case 'ok':\r\n            sDivMensagem = sDivMensagem.replace(\"[icon]\", \"info\");\r\n\r\n            arrDivMensagemBotoes = {\r\n                \"OK\": function () {\r\n                    bFlStatusAcao = true;\r\n\r\n                    $(this).dialog('close');\r\n                }\r\n            };\r\n            break;\r\n\r\n        case 'prompt':\r\n            sDivMensagem = sDivMensagem.replace(\"[icon]\", \"help\");\r\n\r\n            arrDivMensagemBotoes = {\r\n                \"OK\": function () {\r\n                    bFlStatusAcao = true;\r\n\r\n                    $(this).dialog('close');\r\n                }\r\n            };\r\n            break;\r\n\r\n        case 'erro':\r\n            sDivMensagem = sDivMensagem.replace(\"[icon]\", \"alert\");\r\n\r\n            arrDivMensagemBotoes = {\r\n                \"OK\": function () {\r\n                    bFlStatusAcao = true;\r\n\r\n                    $(this).dialog('close');\r\n                }\r\n            };\r\n            break;\r\n    }\r\n\r\n    //var objParent = (top.frames[0].document ? top.frames[0].document : document);\r\n    var objParent = document;\r\n\r\n    $('form:first', objParent).after(sDivMensagem);\r\n\r\n    $('#divMensagemFlutuante', objParent).dialog({\r\n        autoOpen: true,\r\n        closeOnEscape: false,\r\n        modal: true,\r\n        buttons: arrDivMensagemBotoes,\r\n        title: sTitulo,\r\n        height: 125,\r\n        minHeight: 125,\r\n        width: 320,\r\n        minWidth: 320,\r\n        open: function (event, ui) {\r\n            $(this).css('minHeight', 125);\r\n            $(this).css('height', 125);\r\n        },\r\n        close: function (event, ui) {\r\n            if ((fCallback) && (typeof (fCallback) === \"function\"))\r\n                try {\r\n                    fCallback(bFlStatusAcao);\r\n                } catch (err) { }\r\n\r\n            $('#divMensagemFlutuante', objParent).remove();\r\n        }\r\n    });\r\n}\r\n\r\nfunction _OK(sTitulo, sMensagem, fCallback, bFlForceParent) {\r\n    if ((bFlForceParent == null) || (bFlForceParent == true))\r\n        if (parent)\r\n            return parent._OK(sTitulo, sMensagem, fCallback, false);\r\n        else\r\n            return _AbrirJanelaModal(sTitulo, sMensagem, 'ok', fCallback);\r\n    else\r\n        return _AbrirJanelaModal(sTitulo, sMensagem, 'ok', fCallback);\r\n}\r\n\r\nfunction _OKCancelar(sTitulo, sMensagem, fCallback, bFlForceParent) {\r\n    if ((bFlForceParent == null) || (bFlForceParent == true))\r\n        if (parent)\r\n            return parent._OKCancelar(sTitulo, sMensagem, fCallback, false);\r\n        else\r\n            return _AbrirJanelaModal(sTitulo, sMensagem, 'okcancelar', fCallback);\r\n    else\r\n        return _AbrirJanelaModal(sTitulo, sMensagem, 'okcancelar', fCallback);\r\n}\r\n\r\nfunction _Prompt(sTitulo, sMensagem, fCallback, bFlForceParent) {\r\n    if ((bFlForceParent == null) || (bFlForceParent == true))\r\n        if (parent)\r\n            return parent._Prompt(sTitulo, sMensagem, fCallback, false);\r\n        else\r\n            return _AbrirJanelaModal(sTitulo, sMensagem, 'prompt', fCallback);\r\n    else\r\n        return _AbrirJanelaModal(sTitulo, sMensagem, 'prompt', fCallback);\r\n}\r\n\r\nfunction _SimNao(sTitulo, sMensagem, fCallback, bFlForceParent) {\r\n    if ((bFlForceParent == null) || (bFlForceParent == true))\r\n        if (parent)\r\n            return parent._SimNao(sTitulo, sMensagem, fCallback, false);\r\n        else\r\n            return _AbrirJanelaModal(sTitulo, sMensagem, 'simnao', fCallback);\r\n    else\r\n        return _AbrirJanelaModal(sTitulo, sMensagem, 'simnao', fCallback);\r\n}\r\n\r\nfunction _Erro(sMensagem, sUrl, bFlForceParent) {\r\n    if ((bFlForceParent == null) || (bFlForceParent == true))\r\n        if (parent)\r\n            return parent._Erro(sTitulo, sMensagem, fCallback, false);\r\n        else\r\n            return _AbrirJanelaModal(\"Erro\", sMensagem, 'erro', function () { if (sUrl != '') window.location.href = sUrl; });\r\n    else\r\n        return _AbrirJanelaModal(\"Erro\", sMensagem, 'erro', function () { if (sUrl != '') window.location.href = sUrl; });\r\n}\r\n\r\n//**************************************\r\n\r\nfunction PaginaErro(sUrl) {\r\n    // Fixo até que a nova pagina de erro seja implementada.\r\n    ObjModal = new Object();\r\n    ObjModal.BotaoOk = true\r\n    ObjModal.Titulo = \"Aviso\"\r\n    ObjModal.Mensagem = PTA_sMsgErro;\r\n    var objJanela = null;\r\n    try {\r\n        if (top.frames[\"bottom\"])\r\n            objJanela = top.frames[\"bottom\"].window;\r\n        else\r\n            objJanela = window;\r\n    } catch (e) {\r\n        objJanela = window;\r\n    }\r\n\r\n    if (window.showModalDialog) {\r\n        sResult = objJanela.showModalDialog(PTA_sProjeto + \"core/include/pta_webcontrols/modalDialog.aspx\", ObjModal, \"dialogHeight:230px; dialogWidth:320px; center:1; help:0; scroll:0; status:0; unadorned:1;\");\r\n    } else {\r\n        AbrirJanelaModal(\"\", PTA_sMsgErro, 'ok');\r\n    }\r\n    if (sUrl != '') {\r\n        self.location.href = sUrl;\r\n    }\r\n    else {\r\n        history.back();\r\n    }\r\n}\r\n\r\nfunction AplicarEstilo(obj, Estilo) {\r\n    obj.className = Estilo;\r\n}\r\n\r\n//**************************************\r\n/* Inicio Controle de Segurança Pagina*/\r\nvar PaginaCorrente;\r\nfunction _nocontextmenu(e) {\r\n    var c = PaginaCorrente;\r\n    if (!c) return;\r\n    if (navigator.appName == \"Netscape\") {\r\n        OK('Aviso', PTA_sMsgSeguranca);\r\n        e.cancelBubble = true;\r\n        e.returnValue = false;\r\n    } else {\r\n        OK('Aviso', PTA_sMsgSeguranca);\r\n        c.event.cancelBubble = true\r\n        c.event.returnValue = false;\r\n    }\r\n    return false;\r\n}\r\nfunction _click(e) {\r\n    var c = PaginaCorrente;\r\n    if (!c && !c.document) return;\r\n    if (c.document.all) if (c.event.button == 2) return false;\r\n    if (navigator.appName.indexOf(\"Netscape\") != -1) {\r\n        if (e.which == 3) return false;\r\n        else if (document.layers && e.target && e.target == \"javascript:void(0)\") routeEvent(e);\r\n    }\r\n}\r\n\r\nvar submeteuFormulario = 0;\r\nfunction controleDoubleClick(obj) {\r\n    if (submeteuFormulario == \"1\") {\r\n        OK(\"\", \"O botão 'OK' ou 'Confirma' foi acionado mais de uma vez enquanto a transação estava em andamento. Aguarde... \");\r\n        return false;\r\n    }\r\n    submeteuFormulario = \"1\";\r\n    return true;\r\n\r\n    //obj.disabled = true;\r\n}\r\n"
          },
