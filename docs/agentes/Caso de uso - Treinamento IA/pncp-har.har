            "text": "{\"valorTotalEstimado\":3373060.18,\"valorTotalHomologado\":2829574.87,\"orcamentoSigilosoCodigo\":1,\"orcamentoSigilosoDescricao\":\"Compra sem sigilo\",\"numeroControlePNCP\":\"01409580000138-1-002061/2025\",\"linkSistemaOrigem\":\"\",\"linkProcessoEletronico\":null,\"anoCompra\":2025,\"sequencialCompra\":2061,\"numeroCompra\":\"114655\",\"processo\":\"202500005017706\",\"orgaoEntidade\":{\"cnpj\":\"01409580000138\",\"razaoSocial\":\"ESTADO DE GOIAS\",\"esferaId\":\"E\",\"poderId\":\"N\"},\"unidadeOrgao\":{\"codigoUnidade\":\"15\",\"nomeUnidade\":\"SECRETARIA DE ESTADO DA CASA MILITAR\",\"municipioNome\":\"Goiânia\",\"codigoIbge\":\"5208707\",\"ufSigla\":\"GO\",\"ufNome\":\"Goiás\"},\"orgaoSubRogado\":null,\"unidadeSubRogada\":null,\"modalidadeId\":6,\"modalidadeNome\":\"Pregão - Eletrônico\",\"justificativaPresencial\":null,\"modoDisputaId\":1,\"modoDisputaNome\":\"Aberto\",\"tipoInstrumentoConvocatorioCodigo\":1,\"tipoInstrumentoConvocatorioNome\":\"Edital\",\"amparoLegal\":{\"codigo\":1,\"nome\":\"Lei 14.133/2021, Art. 28, I\",\"descricao\":\"pregão: modalidade de licitação obrigatória para aquisição de bens e serviços comuns\"},\"objetoCompra\":\"Aquisição de equipamentos e materiais para a modernização da Academia Espaço Saúde, incluindo aparelhos de musculação, ergometria, bancos, halteres, anilhas, barras e acessórios, conforme detalhamento no Estudo Técnico Preliminar (ETP) e Termo de Referência (TR).\",\"informacaoComplementar\":null,\"srp\":false,\"fontesOrcamentarias\":[],\"dataPublicacaoPncp\":\"2025-08-15T17:50:15\",\"dataAberturaProposta\":\"2025-08-19T08:00:00\",\"dataEncerramentoProposta\":\"2025-09-03T09:00:00\",\"situacaoCompraId\":1,\"situacaoCompraNome\":\"Divulgada no PNCP\",\"existeResultado\":true,\"dataInclusao\":\"2025-08-15T17:50:15\",\"dataAtualizacao\":\"2025-08-15T17:50:15\",\"dataAtualizacaoGlobal\":\"2026-06-25T10:24:30\",\"usuarioNome\":\"SISLOG - Sistema de Logística de Goiás\",\"emendaParlamentar\":null}"
