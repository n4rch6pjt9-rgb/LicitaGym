 divErro.hide();\\r\\n            }\\r\\n            return true;\\r\\n        } catch (e) {\\r\\n            return true;\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function rbVisitanteTipoDocumento_ClickCadastroVisitanteAnexo() {\\r\\n        reiniciaFormularioCadastroVisitanteAnexo(true);\\r\\n\\r\\n        $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").unmask();\\r\\n\\r\\n        if ($(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val() == \\\"CNPJ\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").mask(\\\"**.***.***/****-**\\\");\\r\\n        else if ($(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val() == \\\"CPF\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").mask(\\\"999.999.999-99\\\");\\r\\n\\r\\n        // Configurar campos baseado no JSON apÃ³s um pequeno delay\\r\\n        setTimeout(function() {\\r\\n            try {\\r\\n                var tipoSelecionado = $(\\\"input[name=\\u0027documentoCadastroVisitanteAnexo\\u0027]:checked\\\").val();\\r\\n\\r\\n                if (tipoSelecionado) {\\r\\n                    var valorTipo = tipoSelecionado === \\u0027CPF\\u0027 ? \\u00271\\u0027 : \\u00272\\u0027;\\r\\n                    configurarCamposPorTipoCadastroVisitanteAnexo(valorTipo);\\r\\n                    configurarVisibilidadeLGPDCadastroVisitanteAnexo();\\r\\n                }\\r\\n            } catch (e) {\\r\\n                console.error(\\u0027Erro ao configurar campos por tipo:\\u0027, e);\\r\\n            }\\r\\n        }, 100);\\r\\n    }\\r\\n\\r\\n    function tbDocumento_OnBlurCadastroVisitanteAnexo() {\\r\\n\\r\\n        if ($(\\\"#painelCadastroCadastroVisitanteAnexo input:radio\\\").parent().hasClass(\\\"checked\\\")) {\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteAnexo\\\").unmask();\\r\\n\\r\\n            if ($(\\\"#tb