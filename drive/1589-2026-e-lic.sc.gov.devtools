            "text": "{\"d\":\"\\u003cform method=\\\"post\\\" action=\\\"../Servicos.asmx\\\" id=\\\"uc_MuralDetalheImpugnar\\\"\\u003e\\r\\n\\u003cdiv class=\\\"aspNetHidden\\\"\\u003e\\r\\n\\u003cinput type=\\\"hidden\\\" name=\\\"__VIEWSTATE\\\" id=\\\"__VIEWSTATE\\\" value=\\\"lOO9EenCRxgcHlirrZ900/ZwD7IkNirzTaUjJ0YXHmV1IKNP61aDV3KpSyZwkqOaTkVe7A==\\\" /\\u003e\\r\\n\\u003c/div\\u003e\\r\\n\\r\\n\\r\\n\\u003cstyle type=\\\"text/css\\\"\\u003e\\r\\n    #gridImpugnacao tr.k-state-selected {\\r\\n        color: #333333;\\r\\n    }\\r\\n\\r\\n    #gridImpugnacao .texto-quebra-linha {\\r\\n        white-space: pre-line;\\r\\n    }\\r\\n\\u003c/style\\u003e\\r\\n\\r\\n\\u003cdiv id=\\\"painelImpugnar\\\" \\u003e\\r\\n    \\u003cdiv class=\\\"row-fluid\\\"\\u003e\\r\\n        \\u003cdiv class=\\\"span6\\\"\\u003e\\r\\n            \\u003ch3\\u003eDados gerais\\u003c/h3\\u003e\\r\\n            \\u003chr /\\u003e\\r\\n            \\u003cdiv class=\\\"row-fluid\\\"\\u003e\\r\\n                \\u003cdiv class=\\\"span12\\\"\\u003eApós salvar as informações da impugnação do processo, o sistema permitirá a impressão do registro através do botão \\\"Imprimir\\\". \\u003c/div\\u003e\\r\\n            \\u003c/div\\u003e\\r\\n            \\u003cbr /\\u003e\\r\\n            \\r\\n            \\u003cdiv class=\\\"row-fluid\\\"\\u003e\\r\\n                \\u003cdiv class=\\\"span12\\\"\\u003e\\r\\n                    \\u003clabel for=\\\"tbImpuganacaoProtocolo\\\" class=\\\"destaquePalavra\\\"\\u003eProtocolo\\u003c/label\\u003e\\u003cbr /\\u003e\\r\\n                    \\u003clabel id=\\\"tbImpuganacaoProtocolo\\\" style=\\\"font-size: 20px;\\\"\\u003e\\u003c/label\\u003e\\r\\n                \\u003c/div\\u003e\\r\\n            \\u003c/div\\u003e\\r\\n            \\u003cbr /\\u003e\\r\\n            \\u003cdiv class=\\\"row-fluid\\\" id=\\\"divCadastroImpugnacao\\\"\\u003e\\r\\n                \\u003cdiv class=\\\"span12\\\"\\u003e\\r\\n                    \\u003clabel class=\\\"destaquePalavra\\\" for=\\\"rbImpugnarCPF\\\"\\u003eCPF\\u003c/label\\u003e\\r\\n                    \\u003cinput id=\\\"rbImpugnarCPF\\\" onclick=\\\"rbImpugnarTipoDocumento_Change()\\\" type=\\\"radio\\\" name=\\\"documentoImpugnar\\\" value=\\\"CPF\\\" class=\\\"campo-uniform-impugnar\\\" aria-label=\\\"CPF\\\" data-testid=\\\"mural-detalhe-impugnar-radio-impugnar-cpf\\\" /\\u003e\\r\\n                    \\u003clabel class=\\\"destaquePalavra\\\" id=\\\"lblImpugnarCNPJ\\\" for=\\\"rbImpugnarCNPJ\\\"\\u003eCNPJ\\u003c/label\\u003e\\r\\n                    \\u003cinput id=\\\"rbImpugnarCNPJ\\\" onclick=\\\"rbImpugnarTipoDocumento_Change()\\\" type=\\\"radio\\\" name=\\\"documentoImpugnar\\\" value=\\\"CNPJ\\\" class=\\\"campo-uniform-impugnar\\\" aria-label=\\\"CNPJ\\\" data-testid=\\\"mural-detalhe-impugnar-radio-impugnar-cnpj\\\" /\\u003e\\u003cbr /\\u003e\\r\\n                    \\u003cinput id=\\\"tbImpugnarDocumento\\\" onblur=\\\"tbImpugnarDocumento_OnBlur()\\\" name=\\\"tbImpugnarDocumento\\\" type=\\\"text\\\" style=\\\"width: 98%\\\" class=\\\"campo-uniform-impugnar\\\" aria-label=\\\"Documento\\\" data-testid=\\\"mural-detalhe-impugnar-input-impugnar-documento\\\" /\\u003e\\u003cbr /\\u003e\\r\\n                    \\u003clabel class=\\\"destaquePalavra\\\" for=\\\"tbImpugnacaoNome\\\"\\u003eNome\\u003c/label\\u003e\\u003cbr /\\u003e\\r\\n                    \\u003cinput id=\\\"tbImpugnacaoNome\\\" name=\\\"tbImpugnacaoNome\\\" type=\\\"text\\\" style=\\\"width: 98%\\\" maxlength=\\\"250\\\" class=\\\"campo-uniform-impugnar\\\" aria-label=\\\"Nome\\\" data-testid=\\\"mural-detalhe-impugnar-input-impugnacao-nome\\\" /\\u003e\\r\\n                \\u003c/div\\u003e\\r\\n            \\u003c/div\\u003e\\r\\n\\r\\n            \\u003cdiv class=\\\"row-fluid\\\"\\u003e\\r\\n                \\u003cdiv class=\\\"span12\\\"\\u003e\\r\\n                    \\u003clabel class=\\\"destaquePalavra\\\" for=\\\"tbImpugnacaoDescricao\\\"\\u003eDescrição\\u003c/label\\u003e\\u003cbr /\\u003e\\r\\n                    \\u003ctextarea id=\\\"tbImpugnacaoDescricao\\\" name=\\\"tbImpugnacaoDescricao\\\" type=\\\"text\\\" style=\\\"width: 99%; max-width: 99%; height: 170px; max-height: 200px;\\\" rows=\\\"3\\\" class=\\\"campo-uniform-impugnar\\\" aria-label=\\\"Descrição\\\" data-testid=\\\"mural-detalhe-impugnar-textarea-impugnacao-descricao\\\"\\u003e \\u003c/textarea\\u003e\\r\\n                \\u003c/div\\u003e\\r\\n            \\u003c/div\\u003e\\r\\n            \\u003cbr /\\u003e\\r\\n            \\u003cdiv class=\\\"row-fluid\\\"\\u003e\\r\\n                \\u003cdiv class=\\\"span12\\\"\\u003e\\r\\n                    \\u003cdiv class=\\\"areaBotao2\\\" \\u003e\\r\\n                        \\u003cdiv id=\\\"areaBotaoImprimir\\\" style=\\\"display:none;\\\"\\u003e\\r\\n                            \\u003cdiv class=\\\"ico-botao ico-imprimir-branco-15\\\"\\u003e\\u003c/div\\u003e\\r\\n                            \\u003cinput id=\\\"btImpugnarImprimir\\\" onclick=\\\"btImpugnarImprimir_Click()\\\" type=\\\"button\\\" value=\\\"Imprimir\\\" class=\\\"campoBotao\\\" /\\u003e\\r\\n                        \\u003c/div\\u003e\\r\\n                        \\u003cdiv id=\\\"areaBotaoSalvar\\\"\\u003e\\r\\n                            \\u003cdiv class=\\\"ico-botao ico-salvar-branco-15\\\"\\u003e\\u003c/div\\u003e\\r\\n                            \\u003cinput id=\\\"btImpugnarSalvar\\\" onclick=\\\"btImpugnarSalvar_Click()\\\" type=\\\"button\\\" value=\\\"Salvar\\\" class=\\\"campoBotao\\\" /\\u003e\\r\\n                        \\u003c/div\\u003e\\r\\n                    \\u003c/div\\u003e\\r\\n                \\u003c/div\\u003e\\r\\n            \\u003c/div\\u003e\\r\\n        \\u003c/div\\u003e\\r\\n\\r\\n        \\u003cdiv class=\\\"span6\\\"\\u003e\\r\\n            \\u003cdiv id=\\\"painelAnexoImpugnacao\\\" style=\\\"display:none;\\\"\\u003e\\r\\n            \\r\\n                \\u003ch3\\u003eAnexos da impugnação\\u003c/h3\\u003e\\r\\n                \\u003chr /\\u003e\\r\\n                \\r\\n                \\u003cdiv class=\\\"row-fluid\\\"\\u003e\\r\\n                    \\u003cdiv class=\\\"span12\\\"\\u003eVocê poderá adicionar anexos a impugnação assim que obtiver um número de protocolo\\u003c/div\\u003e\\r\\n                \\u003c/div\\u003e\\r\\n                \\u003cinput name=\\\"fuAnexo\\\" id=\\\"fuAnexo\\\" type=\\\"file\\\" aria-label=\\\"Anexo da impugnação\\\" data-testid=\\\"mural-detalhe-impugnar-file-input-anexo\\\" /\\u003e\\r\\n                \\u003cbr /\\u003e\\r\\n                \\u003cdiv id=\\\"gridAnexoImpugnacao\\\"\\u003e\\u003c/div\\u003e\\r\\n                \\u003cbr /\\u003e\\r\\n                \\u003cdiv class=\\\"areaBotao2\\\" \\u003e\\r\\n                    \\u003cdiv class=\\\"ico-botao ico-fechar-branco-15\\\"\\u003e\\u003c/div\\u003e\\r\\n                    \\u003cinput id=\\\"btImpugnarExcluir\\\" onclick=\\\"btImpugnarExcluir_Click()\\\" type=\\\"button\\\" value=\\\"Excluir\\\" class=\\\"campoBotao desativado\\\" /\\u003e\\r\\n                \\u003c/div\\u003e\\r\\n                \\u003cdiv class=\\\"areaBotao2\\\" \\u003e\\r\\n                    \\u003cdiv class=\\\"ico-botao ico-enviar-branco-15\\\"\\u003e\\u003c/div\\u003e\\r\\n                    \\u003cinput id=\\\"btImpugnarFinalizar\\\" onclick=\\\"btImpugnarFinalizar_Click()\\\" type=\\\"button\\\" value=\\\"Finalizar\\\" class=\\\"campoBotao desativado\\\" /\\u003e\\r\\n                \\u003c/div\\u003e\\r\\n            \\u003c/div\\u003e\\r\\n        \\u003c/div\\u003e\\r\\n\\r\\n    \\u003c/div\\u003e\\r\\n\\u003c/div\\u003e\\r\\n\\r\\n\\u003c!-- Div Impressão Impugnação --\\u003e\\r\\n\\u003cdiv id=\\\"divImpressaoImpugnacao\\\"\\u003e\\r\\n    \\u003cdiv id=\\\"carregandoImpressaoImpugnacao\\\" class=\\\"carregandoDados\\\" style=\\\"display:none\\\"; \\u003e\\u003cimg src=\\\"Imagens/carregando.gif\\\" /\\u003e\\u003c/div\\u003e\\r\\n    \\u003ciframe id=\\\"frameImpressaoImpugnacao\\\" src=\\\"\\\" width=\\\"800px\\\" height=\\\"425px\\\" \\u003e\\u003c/iframe\\u003e\\r\\n    \\u003cdiv class=\\\"botoes-kendo-window\\\" \\u003e\\r\\n        \\u003cinput id=\\\"btImprimirImpugnacao\\\" type=\\\"button\\\" value=\\u0027Imprimir\\u0027 class=\\\"campoBotaoSemIcone\\\" onclick=\\\"imprimirConteudo($(\\u0027#frameImpressaoImpugnacao\\u0027).contents().find(\\u0027html\\u0027)[0])\\\" style=\\\"width:20%; display: none;\\\" /\\u003e\\r\\n        \\u003cinput id=\\\"btFecharImpressaoImpugnacao\\\" type=\\\"button\\\" value=\\u0027Fechar\\u0027 onclick=\\\"$(\\u0027#divImpressaoImpugnacao\\u0027).data(\\u0027kendoWindow\\u0027).close()\\\" class=\\\"campoBotaoSemIcone\\\" style=\\\"width:20%; display:none;\\\" /\\u003e\\r\\n    \\u003c/div\\u003e\\r\\n\\u003c/div\\u003e\\r\\n\\r\\n\\u003cbr /\\u003e\\u003cbr /\\u003e\\r\\n\\u003cdiv id=\\\"gridImpugnacao\\\"\\u003e\\u003c/div\\u003e\\r\\n\\u003cbr /\\u003e\\r\\n\\u003cdiv style=\\\"display: none\\\" id=\\\"gridImpugnacaoAnexo\\\"\\u003e\\u003c/div\\u003e\\r\\n\\r\\n\\u003cscript type=\\\"text/javascript\\\"\\u003e\\r\\n\\r\\n    var objParametroImpugnacao;\\r\\n    var dtoImpugnacao;\\r\\n    var sMetodoPesquisar;\\r\\n\\r\\n    MuralDetalheImpugnar_Load(\\u0027{\\\"nCdProcesso\\\":588,\\\"nCdModulo\\\":59,\\\"bFlPermiteImpugnacaoValidDate\\\":1,\\\"bFlPermiteImpugnacao\\\":1,\\\"nCdImpugnacao\\\":0,\\\"sNrProtocolo\\\":\\\"\\\",\\\"nCdAnexo\\\":0,\\\"nSqAnexo\\\":0,\\\"divImpugnar\\\":\\\"divImpugnar\\\"}\\u0027);\\r\\n\\r\\n    function MuralDetalheImpugnar_Load(_objParametros) {\\r\\n        $(\\\".campo-uniform-impugnar\\\").uniform();\\r\\n        $(\\\"#tbImpugnacaoDescricao\\\").off(\\\"keypress.quebraLinha\\\").on(\\\"keypress.quebraLinha\\\", function (event) {\\r\\n            event.stopPropagation();\\r\\n        });\\r\\n\\r\\n        objParametroImpugnacao = JSON.parse(_objParametros);\\r\\n\\r\\n        ocultaCamposImpugnacao(objParametroImpugnacao);\\r\\n        bloqueiaCamposImpugnacao(false);\\r\\n\\r\\n        objParametroImpugnacao.nCdImpugnacao = 0;\\r\\n        objParametroImpugnacao.sNrProtocolo = \\\"\\\";\\r\\n        objParametroImpugnacao.frmValidacao = undefined;\\r\\n\\r\\n        reiniciaFormularioImpugnar(false);\\r\\n\\r\\n        setTimeout(function () {\\r\\n            $(\\\"#divImpressaoImpugnacao\\\").kendoWindow({\\r\\n                actions: [\\\"Close\\\"],\\r\\n                title: \\\"Impressão de impugnação ao edital\\\".toUpperCase(),\\r\\n                modal: true,\\r\\n                draggable: false,\\r\\n                resizable: false,\\r\\n                animation: { open: true, close: true },\\r\\n                close: function (e) { scrollBodyFuncional(true, \\\"/\\\"); },\\r\\n                open: function () { scrollBodyFuncional(false, \\\"/\\\"); },\\r\\n                visible: false\\r\\n            });\\r\\n\\r\\n            var arrArquivosRemovidos = [];\\r\\n            var arrExtensoesPermitidas = [\\\".avi\\\",\\\".ai\\\",\\\".bmp\\\",\\\".cdr\\\",\\\".cdt\\\",\\\".cmx\\\",\\\".csv\\\",\\\".doc\\\",\\\".docm\\\",\\\".docx\\\",\\\".dot\\\",\\\".dwg\\\",\\\".e3s\\\",\\\".edrw\\\",\\\".eml\\\",\\\".gif\\\",\\\".jfif\\\",\\\".jpeg\\\",\\\".jpg\\\",\\\".mp3\\\",\\\".mp4\\\",\\\".msg\\\",\\\".ods\\\",\\\".odt\\\",\\\".p7s\\\",\\\".pdf\\\",\\\".png\\\",\\\".ppt\\\",\\\".pptx\\\",\\\".psd\\\",\\\".qrp\\\",\\\".rtf\\\",\\\".sdw\\\",\\\".shs\\\",\\\".swf\\\",\\\".tif\\\",\\\".txt\\\",\\\".uni\\\",\\\".vsd\\\",\\\".xls\\\",\\\".xlsx\\\",\\\".xlt\\\",\\\".xml\\\",\\\".xps\\\",\\\".zip\\\",\\\".7z\\\",\\\".rar\\\"];\\r\\n\\r\\n            if ($(\\\"#fuAnexo\\\").data(\\\"kendoUpload\\\")) {\\r\\n                $(\\\"#fuAnexo\\\").data(\\\"kendoUpload\\\").destroy();\\r\\n            }\\r\\n\\r\\n            $(\\\"#fuAnexo\\\").kendoUpload({\\r\\n                async: { saveUrl: \\\"WebService/Servicos.asmx/UploadAnexos\\\", autoUpload: !exigeAnexo(), batch: true },\\r\\n                localization: { select: \\\"Adicionar item\\\", cancel: \\\"\\\", retry: \\\"Tentar novamente\\\" },\\r\\n                complete: function (e) { $(\\\".k-dropzone\\\").show(); },\\r\\n                upload: function (e) {\\r\\n                    var fArquivos = e.files;\\r\\n\\r\\n                    //Se não houver nenhum arquivo válido, interrompe o upload\\r\\n                    if (fArquivos.length \\u003c= 0) {\\r\\n                        setTimeout(function () { $(\\\".k-dropzone\\\").show(); }, 100);\\r\\n                        e.preventDefault();\\r\\n                    } else {\\r\\n                        //Parâmetros adicionais para envio ao WebService (atualmente, somente o caminho de onde devem ser salvo as imagens)\\r\\n                        e.data = { nCdImpugnacao: objParametroImpugnacao.nCdImpugnacao, nCdAnexo: objParametroImpugnacao.nCdAnexo, nSqAnexo: objParametroImpugnacao.nSqAnexo, nCdModulo: objParametroImpugnacao.nCdModulo };\\r\\n                        $(\\\".k-filename\\\").text(\\\"Enviando arquivo {0}\\\".format(fArquivos.length) + ((fArquivos.length \\u003e 1) ? \\\"s...\\\" : \\\"...\\\"));\\r\\n\\r\\n                        //Alterações no botão Cancelar (para evitar alterar o .CSS e .JS original do KendoUI)\\r\\n                        setTimeout(function () {\\r\\n                            $(\\\".k-upload-action\\\").css(\\\"width\\\", 100);\\r\\n                            $(\\\".k-upload-action\\\").css(\\\"height\\\", 20);\\r\\n                            $(\\\".k-upload\\\").find(\\\".k-upload-action\\\").find(\\\".k-icon\\\").css(\\\"width\\\", 14);\\r\\n                            $(\\\".k-upload\\\").find(\\\".k-upload-action\\\").find(\\\".k-icon\\\").css(\\\"height\\\", 15);\\r\\n                            $(\\\".k-dropzone\\\").hide();\\r\\n                        }, 100);\\r\\n                    }\\r\\n                },\\r\\n                select: function (e) {\\r\\n                    var arrArquivosAdicionados = [];\\r\\n                    arrArquivosRemovidos = [];\\r\\n\\r\\n                    //Validação da quantidade de arquivos (5)\\r\\n                    if (e.files.length \\u003e 5) {\\r\\n                        Alerta(\\\"Não foi possível anexar este(s) arquivo(s). O limite máximo permitido é de {0} imagens por vez.\\\".format(5), \\\"/\\\");\\r\\n                        throw (\\\"Não foi possível anexar este(s) arquivo(s). O limite máximo permitido é de {0} imagens por vez.\\\".format(5));\\r\\n                    }\\r\\n\\r\\n                    //Para cada arquivo, verificar a extensão (mesma lista das telas internas) e o limite em bytes.\\r\\n                    //O conteúdo do arquivo (MimeType/magic bytes) é validado no servidor.\\r\\n                    $(e.files).each(function () {\\r\\n                        if ($.inArray((this.extension || \\\"\\\").toLowerCase(), arrExtensoesPermitidas) \\u003c 0) {\\r\\n                            this.motivo = \\\"Não foi possível anexar arquivo. Extensão não permitida.\\\\u003cbr\\\\u003eApenas (.avi, .ai, .bmp, .cdr, .cdt, .cmx, .csv, .doc, .docm, .docx, .dot, .dwg, .e3s, .edrw, .eml, .gif, .jfif, .jpeg, .jpg, .mp3, .mp4, .msg, .ods, .odt, .p7s, .pdf, .png, .ppt, .pptx, .psd, .qrp, .rtf, .sdw, .shs, .swf, .tif, .txt, .uni, .vsd, .xls, .xlsx, .xlt, .xml, .xps, .zip, .7z, .rar)\\\";\\r\\n                            arrArquivosRemovidos.push(this);\\r\\n                        }\\r\\n                        else if (this.size \\u003e 30720000) {\\r\\n                            this.motivo = \\\"Não foi possível anexar esta imagem. O tamanho máximo permitido é de {0} kb.\\\".format(30720000);\\r\\n                            arrArquivosRemovidos.push(this);\\r\\n                        }\\r\\n                        else {\\r\\n                            arrArquivosAdicionados.push(this);\\r\\n                        }\\r\\n                    });\\r\\n\\r\\n                    var sItensRemovidos = \\\"\\\";\\r\\n                    var arrMotivos = [];\\r\\n                    $(arrArquivosRemovidos).each(function () {\\r\\n                        sItensRemovidos += \\\"- \\\" + this.name + \\\";\\u003cbr\\u003e\\\";\\r\\n                        if ($.inArray(this.motivo, arrMotivos) \\u003c 0)\\r\\n                            arrMotivos.push(this.motivo);\\r\\n                    });\\r\\n\\r\\n                    //Havendo arquivo inválido, a seleção inteira é descartada (o servidor também rejeita o lote inteiro)\\r\\n                    if (sItensRemovidos != \\\"\\\") {\\r\\n                        Alerta(arrMotivos.join(\\\"\\u003cbr\\u003e\\\") + (\\\"\\u003cbr\\u003e\\u003cbr\\u003e \\\" + sItensRemovidos), \\\"/\\\");\\r\\n                        e.preventDefault();\\r\\n                        return;\\r\\n                    }\\r\\n\\r\\n                    if (exigeAnexo() \\u0026\\u0026 objParametroImpugnacao.nCdImpugnacao === 0) {\\r\\n\\r\\n                        dtoImpugnacao = {\\r\\n                            sDsCpf: \\\"\\\",\\r\\n                            sDsCnpj: \\\"\\\",\\r\\n                            nCdImpugnacao: objParametroImpugnacao.nCdImpugnacao,\\r\\n                            sNrProtocolo: objParametroImpugnacao.sNrProtocolo,\\r\\n                            sNmImpugnador: kendo.htmlEncode($(\\\"#tbImpugnacaoNome\\\").val()),\\r\\n                            sDsImpugnacao: kendo.htmlEncode($(\\\"#tbImpugnacaoDescricao\\\").val()),\\r\\n                            sDsTipoDocumento: \\\"\\\",\\r\\n                            dtoProcesso: {\\r\\n                                nCdProcesso: objParametroImpugnacao.nCdProcesso,\\r\\n                                nCdModulo: objParametroImpugnacao.nCdModulo,\\r\\n                                dtoIdioma: {\\r\\n                                    nCdIdioma: adquirirIdIdioma(\\\"/\\\")\\r\\n                                }\\r\\n                            }\\r\\n                        };\\r\\n\\r\\n                        var nDocumento;\\r\\n                        if (adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n                            nDocumento = $(\\\"#tbImpugnarDocumento\\\").val().replace(/[^a-z0-9]/gi, \\\"\\\");\\r\\n                        else\\r\\n                            nDocumento = $(\\\"#tbImpugnarDocumento\\\").val();\\r\\n\\r\\n                        if ($(\\\"input[name=\\u0027documentoImpugnar\\u0027]:checked\\\").val() == \\\"CNPJ\\\") {\\r\\n                            dtoImpugnacao.sDsCnpj = nDocumento;\\r\\n                            dtoImpugnacao.sDsTipoDocumento = \\\"CNPJ\\\";\\r\\n                        }\\r\\n                        else if ($(\\\"input[name=\\u0027documentoImpugnar\\u0027]:checked\\\").val() == \\\"CPF\\\") {\\r\\n                            dtoImpugnacao.sDsCpf = nDocumento;\\r\\n                            dtoImpugnacao.sDsTipoDocumento = \\\"CPF\\\";\\r\\n                        }\\r\\n\\r\\n                        chamadaWebService(\\r\\n                            \\\"WebService/Servicos.asmx/SalvarImpugnacao\\\",\\r\\n                            \\\"dtoImpugnacao:\\\" + JSON.stringify(dtoImpugnacao),\\r\\n                            function (_retorno) {\\r\\n                                var objRetorno = _retorno.d;\\r\\n\\r\\n                                if (validarNumeroNulo(objRetorno.nCdCodigo) \\u003e 0) {\\r\\n                                    $(\\\"#tbImpuganacaoProtocolo\\\").text(objRetorno.sDsConteudo);\\r\\n                                    objParametroImpugnacao.nCdImpugnacao = objRetorno.nCdCodigo;\\r\\n                                    objParametroImpugnacao.sNrProtocolo = objRetorno.sDsConteudo;\\r\\n\\r\\n                                    $(\\\"#fuAnexo\\\").data(\\\"kendoUpload\\\").upload();\\r\\n                                    $(\\\"#fuAnexo\\\").data(\\\"kendoUpload\\\").options.async.autoUpload = true;\\r\\n\\r\\n                                    bloqueiaCamposImpugnacao(true);\\r\\n                                } else\\r\\n                                    Alerta(objRetorno.sDsConteudo, \\\"/\\\");\\r\\n                            },\\r\\n                            function (x, e) {\\r\\n                                Alerta(\\\"Não foi possível recuperar os dados desse registro!\\\", \\\"/\\\");\\r\\n                            }\\r\\n                        );\\r\\n                    }\\r\\n                },\\r\\n                error: function (e) {\\r\\n                    Alerta(e.XMLHttpRequest.responseText, \\\"/\\\");\\r\\n                    $(\\\".k-upload-files\\\").remove();\\r\\n                    $(\\\".k-dropzone\\\").show();\\r\\n                },\\r\\n                success: function (e) {\\r\\n                    //Limpa o array de arquivos removidos para uso na validação de quando for IE\\r\\n                    arrArquivosRemovidos = [];\\r\\n\\r\\n                    if (e.response.length \\u003e 0) {\\r\\n                        if (e.response[0].nCdAnexo == 0) {\\r\\n                            $(\\\".k-upload-files\\\").remove();\\r\\n                            setTimeout(function () { $(\\\".k-dropzone\\\").show(); }, 100);\\r\\n                            Alerta(e.response[0].sNmArquivo, \\\"/\\\");\\r\\n                        } else {\\r\\n\\r\\n                            //Para cada retorno de sucesso, adiciona na caixa de texto. No caso do IE, que não se consegue validar totalmente o arquivo,\\r\\n                            //o retorno de seu sucesso ou não irá vir do server. Se estiver inválido, adiciona no array de ArquivosRemovidos.\\r\\n                            $(e.response).each(function () {\\r\\n                                if (this.nCdAnexo \\u003e 0)\\r\\n                                    objParametroImpugnacao.nCdAnexo = this.nCdAnexo;\\r\\n\\r\\n                                if (this.nSqAnexo \\u003e objParametroImpugnacao.nSqAnexo)\\r\\n                                    objParametroImpugnacao.nSqAnexo = this.nSqAnexo;\\r\\n                            });\\r\\n\\r\\n                            //Se for IE, executa o retorno ao usuário sobre o estado de alguma imagem com problema. Isso foi necessário, pois uma das validações (tamanho e MimeType)\\r\\n                            //não é disponibilizado pelo IE. A única maneira seria utilizar um ActiveX, o que na maioria dos casos, vai falhar por conta de segurança.\\r\\n                            if ($.browser.msie) {\\r\\n                                var sItensRemovidos = \\\"\\\";\\r\\n                                $(arrArquivosRemovidos).each(function () { sItensRemovidos += this.sNmArquivo + \\\";\\u003cbr\\u003e\\\"; });\\r\\n\\r\\n                                //Alerta ao usuário de que as imagens inválidas foram descartadas\\r\\n                                if (sItensRemovidos != \\\"\\\")\\r\\n                                    Alerta(\\\"Os seguintes arquivos não serão adicionados\\\" + (\\\"\\u003cbr\\u003e\\u003cbr\\u003e \\\" + sItensRemovidos), \\\"/\\\");\\r\\n                            }\\r\\n\\r\\n                            $(\\\".k-upload-files\\\").remove();\\r\\n\\r\\n                            setTimeout(function () { $(\\\".k-dropzone\\\").show(); }, 100);\\r\\n\\r\\n                            carregarAnexosImpugnacao();\\r\\n                        }\\r\\n                    }\\r\\n                }\\r\\n            });\\r\\n\\r\\n            preparaValidacaoImpugnacao();\\r\\n\\r\\n            if (exigeAnexo()) {\\r\\n                $(\\\"#painelAnexoImpugnacao\\\").show();\\r\\n            }\\r\\n                        \\r\\n        }, 100);\\r\\n\\r\\n        var dtoImpugnacao = {\\r\\n            dtoProcesso: {\\r\\n                nCdProcesso: objParametroImpugnacao.nCdProcesso,\\r\\n                nCdModulo: objParametroImpugnacao.nCdModulo\\r\\n            },\\r\\n            dtoIdioma: {\\r\\n                nCdIdioma: adquirirIdIdioma(\\\"/\\\")\\r\\n            }\\r\\n        }\\r\\n\\r\\n        switch (objParametroImpugnacao.nCdModulo) {\\r\\n            case 59:\\r\\n                sMetodoPesquisar = \\\"PesquisarProcessoDetalheImpugnacaoLicitacao\\\";\\r\\n                break;\\r\\n            case 18:\\r\\n                sMetodoPesquisar = \\\"PesquisarProcessoDetalheImpugnacaoPregaoEletronico\\\";\\r\\n                break;\\r\\n            case 22:\\r\\n                sMetodoPesquisar = \\\"PesquisarProcessoDetalheImpugnacaoPregaoPresencial\\\";\\r\\n                break;\\r\\n            case 23:\\r\\n                sMetodoPesquisar = \\\"PesquisarProcessoDetalheImpugnacaoConvite\\\";\\r\\n                break;\\r\\n        }\\r\\n\\r\\n        var sSchema = [{\\r\\n            nCdImpugnacao: { type: \\\"number\\\" },\\r\\n            sDsImpugnacao: { type: \\\"string\\\" },\\r\\n            tDtImpugnacao: { type: \\\"string\\\" },\\r\\n            nCdAnexoImpugnacao: { type: \\\"number\\\" },\\r\\n            sDsParecer: { type: \\\"string\\\" },\\r\\n            tDtParecer: { type: \\\"string\\\" },\\r\\n            nCdAnexoParecer: { type: \\\"number\\\" }\\r\\n        }];\\r\\n\\r\\n        var sColunas = [];\\r\\n\\r\\n        sColunas.push(\\r\\n            { field: \\\"sDsImpugnacao\\\", title: \\\"Descrição\\\", template: \\u0027#=kendo.htmlEncode(sDsImpugnacao)#\\u0027, attributes: { \\\"class\\\": \\\"texto-quebra-linha\\\" } },\\r\\n            { field: \\\"sDsTipoSituacaoMap\\\", title: \\\"Situação\\\", width: \\\"80px\\\", template: \\u0027#=formataTipoSituacaoMap(sDsTipoSituacaoMap)#\\u0027 },\\r\\n            { field: \\\"nCdAnexoImpugnacao\\\", title: \\\"Anexos\\\", filterable: false, width: \\\"80px\\\", template: \\u0027#=formataAbrirListaImpugnacaoAnexo(nCdAnexoImpugnacao, uid)#\\u0027 },\\r\\n            { field: \\\"tDtImpugnacao\\\", title: \\\"Data\\\", width: \\\"15%\\\", template: \\u0027#=formataDataHora(tDtImpugnacao, true)#\\u0027 }\\r\\n        );\\r\\n\\r\\n        CarregaGrid(\\r\\n            sSchema,\\r\\n            \\\"WebService/Servicos.asmx/\\\" + sMetodoPesquisar,\\r\\n            \\\"dtoImpugnacao:\\\" + JSON.stringify(dtoImpugnacao),\\r\\n            null,\\r\\n            \\\"gridImpugnacao\\\",\\r\\n            sColunas,\\r\\n            300,\\r\\n            CarregarRespostas,\\r\\n            undefined,\\r\\n            undefined,\\r\\n            function () {\\r\\n                Alerta(\\\"Não foi possível recuperar os dados desse registro!\\\", \\\"/\\\");\\r\\n                btAcao_Click(\\\"voltar\\\");\\r\\n            }\\r\\n        );\\r\\n\\r\\n    }\\r\\n\\r\\n    function formataTipoSituacaoMap(sDsTipoSituacaoMap) {\\r\\n        return `\\u003cdiv class=\\\"texto-centralizado\\\"\\u003e${sDsTipoSituacaoMap}\\u003c/div\\u003e`;\\r\\n    }\\r\\n\\r\\n    function formataAbrirListaImpugnacaoAnexo(nCdAnexo, uid) {\\r\\n        return nCdAnexo \\u003e 0 ? \\u0027\\u003cdiv onclick=\\\"abrirImpugnacaoAnexo(\\u0027 + nCdAnexo + \\u0027, \\\\\\u0027\\u0027 + uid + \\u0027\\\\\\u0027 )\\\" class=\\\"texto-centralizado areaClique anexo-link\\\"\\u003e\\u003ci class=\\\"ico-download-azul-25\\\"\\u003e\\u003c/i\\u003e\\u003c/a\\u003e\\u0027 : \\\"\\\";\\r\\n    }\\r\\n\\r\\n    function abrirImpugnacaoAnexo(nCdAnexo, uid) {\\r\\n\\r\\n        $(\\\"#gridImpugnacao tr\\\").removeClass(\\\"k-state-selected\\\");\\r\\n\\r\\n        CarregaGrid(null,\\r\\n            \\\"WebService/Servicos.asmx/PesquisarImpugnacaoAnexos\\\",\\r\\n            \\\"dtoAnexo:\\\" + JSON.stringify({ nCdAnexo: nCdAnexo }),\\r\\n            function (data) {\\r\\n\\r\\n                $(\\u0027[data-uid=\\u0027 + uid + \\u0027]\\u0027).addClass(\\\"k-state-selected\\\");\\r\\n                $(\\\"#gridImpugnacaoAnexo\\\").show()\\r\\n            },\\r\\n            \\\"gridImpugnacaoAnexo\\\",\\r\\n            [\\r\\n                { field: \\\"sDsAnexo\\\", title: \\\"Descrição\\\", filterable: false, width: \\\"200px\\\", template: \\u0027#=formataImpugnacaoAnexo(nCdAnexo, sDsAnexo, nSqAnexo)#\\u0027 },\\r\\n                { field: \\\"tDtAnexo\\\", title: \\\"Data\\\", filterable: false, template: \\u0027#=formataDataHora(tDtAnexo)#\\u0027, width: \\\"40px\\\" }\\r\\n            ],\\r\\n            250, null, null,\\r\\n            function () { }\\r\\n        );\\r\\n    }\\r\\n\\r\\n    function formataImpugnacaoAnexo(nCdAnexo, sDsAnexo, nSqAnexo) {\\r\\n        return \\\"\\u003cdiv onclick=\\u0027btBaixaImpugnacaoAnexo(\\\" + nCdAnexo + \\\", \\\" + nSqAnexo + \\\")\\u0027 class=\\u0027areaClique\\u0027\\u003e\\\" + kendo.htmlEncode(sDsAnexo) + \\\"\\u003c/div\\u003e\\\";\\r\\n    }\\r\\n\\r\\n    function btBaixaImpugnacaoAnexo(nCdAnexo, nSqAnexo) {\\r\\n        var arrAnexos = $(\\\"#gridImpugnacaoAnexo\\\").data(\\\"kendoGrid\\\").dataSource.data();\\r\\n        var oAnexoClicado = $.grep(arrAnexos,\\r\\n            function (a) { return a.nCdAnexo == nCdAnexo \\u0026\\u0026 a.nSqAnexo == nSqAnexo; })[0];\\r\\n        window.open(\\\"Download.aspx\\\" + oAnexoClicado.sDsParametroCriptografado, \\\"_self\\\");\\r\\n    }\\r\\n\\r\\n    function CarregarRespostas(e) {\\r\\n\\r\\n        var sSchema = [{\\r\\n            nCdImpugnacao: { type: \\\"number\\\" },\\r\\n            sDsImpugnacao: { type: \\\"string\\\" },\\r\\n            tDtImpugnacao: { type: \\\"string\\\" },\\r\\n            nCdAnexoImpugnacao: { type: \\\"number\\\" },\\r\\n            sDsParecer: { type: \\\"string\\\" },\\r\\n            tDtParecer: { type: \\\"string\\\" },\\r\\n            nCdAnexoParecer: { type: \\\"number\\\" }\\r\\n        }];\\r\\n\\r\\n        var sColunas = [\\r\\n            { field: \\\"sDsParecer\\\", title: \\\"Parecer\\\", template: \\u0027#=kendo.htmlEncode(sDsParecer)#\\u0027, attributes: { \\\"class\\\": \\\"texto-quebra-linha\\\" } },\\r\\n            { field: \\\"nCdAnexoParecer\\\", title: \\\"Anexos\\\", width: \\\"80px\\\", filterable: false, template: \\u0027#=formataAbrirListaImpugnacaoAnexo(nCdAnexoParecer, uid)#\\u0027 },\\r\\n            { field: \\\"tDtParecer\\\", title: \\\"Data\\\", width: \\\"15%\\\", template: \\u0027#=formataDataHora(tDtParecer, true)#\\u0027 }\\r\\n        ];\\r\\n\\r\\n        var dtoImpugnacao = {\\r\\n            nCdImpugnacao: e.data.nCdImpugnacao,\\r\\n            dtoProcesso: {\\r\\n                nCdProcesso: objParametroImpugnacao.nCdProcesso,\\r\\n                nCdModulo: objParametroImpugnacao.nCdModulo\\r\\n            },\\r\\n            dtoIdioma: {\\r\\n                nCdIdioma: adquirirIdIdioma(\\\"/\\\")\\r\\n            }\\r\\n        }\\r\\n\\r\\n        switch (objParametroImpugnacao.nCdModulo) {\\r\\n            case 59:\\r\\n                sMetodoPesquisar = \\\"PesquisarProcessoDetalheImpugnacaoLicitacao\\\";\\r\\n                break;\\r\\n            case 18:\\r\\n                sMetodoPesquisar = \\\"PesquisarProcessoDetalheImpugnacaoPregaoEletronico\\\";\\r\\n                break;\\r\\n            case 22:\\r\\n                sMetodoPesquisar = \\\"PesquisarProcessoDetalheImpugnacaoPregaoPresencial\\\";\\r\\n                break;\\r\\n            case 23:\\r\\n                sMetodoPesquisar = \\\"PesquisarProcessoDetalheImpugnacaoConvite\\\";\\r\\n                break;\\r\\n        }\\r\\n\\r\\n        CarregaGridDetalhes(\\r\\n            \\\"gridImpugnacao\\\",\\r\\n            sSchema,\\r\\n            \\\"WebService/Servicos.asmx/\\\" + sMetodoPesquisar,\\r\\n            \\\"dtoImpugnacao:\\\" + JSON.stringify(dtoImpugnacao),\\r\\n            sColunas,\\r\\n            \\\"nCdMensagem\\\",\\r\\n            e,\\r\\n            undefined,\\r\\n            function () {\\r\\n                $(e.detailCell[0]).text(\\\"Não foi possível recuperar os dados desse registro!\\\");\\r\\n            }\\r\\n        );\\r\\n    }\\r\\n\\r\\n    function ocultaCamposImpugnacao(objParametroImpugnacao) {\\r\\n        if (objParametroImpugnacao.nCdModulo == 59 \\u0026\\u0026 !true) {\\r\\n            $(\\\"#divCadastroImpugnacao\\\").hide();\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function bloqueiaCamposImpugnacao(bBloqueia) {\\r\\n        $(\\\"#painelImpugnar div:nth(1) :input:not(:button)\\\").attr(\\u0027disabled\\u0027, bBloqueia);\\r\\n        if (bBloqueia) {\\r\\n            $(\\\"#areaBotaoSalvar\\\").hide();\\r\\n            $(\\\"#areaBotaoImprimir\\\").fadeIn();\\r\\n        } else {\\r\\n            $(\\\"#areaBotaoSalvar\\\").fadeIn();\\r\\n            $(\\\"#areaBotaoImprimir\\\").hide();\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function btImpugnarImprimir_Click() {\\r\\n        if ($(\\\"#uc_MuralDetalheImpugnar\\\").valid()) {\\r\\n            if ($(\\\"#tbImpuganacaoProtocolo\\\").text() == \\\"\\\") {\\r\\n                Alerta(\\\"É necessário salvar a impugnação para liberar sua impressão!\\\", \\\"/\\\");\\r\\n                return;\\r\\n            }\\r\\n\\r\\n            $(\\\"#carregandoImpressaoImpugnacao\\\").show();\\r\\n            $(\\\"#divImpressaoImpugnacao\\\").data(\\\"kendoWindow\\\").open();\\r\\n            $(\\\"#divImpressaoImpugnacao\\\").data(\\\"kendoWindow\\\").center();\\r\\n            $(\\\"#divImpressaoImpugnacao\\\").scrollTop(0);\\r\\n\\r\\n            var dtoImpugnacaoImpressao = {\\r\\n                nCdImpugnacao: objParametroImpugnacao.nCdImpugnacao,\\r\\n                dtoProcesso: {\\r\\n                    nCdModulo: objParametroImpugnacao.nCdModulo,\\r\\n                    dtoIdioma: {\\r\\n                        nCdIdioma: adquirirIdIdioma(\\\"/\\\")\\r\\n                    }\\r\\n                }\\r\\n            };\\r\\n\\r\\n            chamadaWebService(\\r\\n                \\\"WebService/Servicos.asmx/PesquisarImpugnacaoImpressao\\\",\\r\\n                \\\"dtoImpugnacao:\\\" + JSON.stringify(dtoImpugnacaoImpressao),\\r\\n                function (_retorno) {\\r\\n                    $(\\\"#carregandoImpressaoImpugnacao\\\").hide();\\r\\n\\r\\n                    $(\\\"#frameImpressaoImpugnacao\\\").contents().find(\\\"html\\\").html(_retorno.d);\\r\\n                    $(\\\"#divImpressaoImpugnacao\\\").data(\\\"kendoWindow\\\").center();\\r\\n\\r\\n                    $(\\\"#btFecharImpressaoImpugnacao\\\").show();\\r\\n                    $(\\\"#btImprimirImpugnacao\\\").show();\\r\\n                },\\r\\n                function (x, e) {\\r\\n                    Alerta(\\\"Não foi possível recuperar os dados desse registro!\\\", \\\"/\\\");\\r\\n                }\\r\\n            );\\r\\n        }\\r\\n        else {\\r\\n            if ($(\\\"#tbImpuganacaoProtocolo\\\").text() == \\\"\\\")\\r\\n                Alerta(\\\"É necessário salvar a impugnação para liberar sua impressão!\\\", \\\"/\\\");\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function exigeAnexo() {\\r\\n        return (objParametroImpugnacao.nCdModulo == 18 \\u0026\\u0026 \\u0027False\\u0027 === \\u0027True\\u0027) ||\\r\\n            (objParametroImpugnacao.nCdModulo == 22 \\u0026\\u0026 \\u0027False\\u0027 === \\u0027True\\u0027) ||\\r\\n            (objParametroImpugnacao.nCdModulo == 59 \\u0026\\u0026 \\u0027True\\u0027 === \\u0027True\\u0027);\\r\\n    }\\r\\n\\r\\n    function btImpugnarSalvar_Click() {\\r\\n        if ($(\\\"#uc_MuralDetalheImpugnar\\\").valid()) {\\r\\n            \\r\\n            if (objParametroImpugnacao.nCdModulo == 59 \\u0026\\u0026 objParametroImpugnacao.bFlPermiteImpugnacaoValidDate \\u003c= 0\\r\\n            ) {\\r\\n                Alerta(\\\"O prazo limite de envio de impugnação foi encerrado.\\\", \\\"/\\\");\\r\\n                return;\\r\\n            }\\r\\n            else {\\r\\n                if (objParametroImpugnacao.bFlPermiteImpugnacao \\u003c= 0) {\\r\\n                    Alerta(\\\"O prazo limite de envio de impugnação foi encerrado.\\\", \\\"/\\\");\\r\\n\\r\\n                    return;\\r\\n                }\\r\\n            }\\r\\n\\r\\n            dtoImpugnacao = {\\r\\n                sDsCpf: \\\"\\\",\\r\\n                sDsCnpj: \\\"\\\",\\r\\n                nCdImpugnacao: objParametroImpugnacao.nCdImpugnacao,\\r\\n                sNrProtocolo: objParametroImpugnacao.sNrProtocolo,\\r\\n                sNmImpugnador: kendo.htmlEncode($(\\\"#tbImpugnacaoNome\\\").val()),\\r\\n                sDsImpugnacao: kendo.htmlEncode($(\\\"#tbImpugnacaoDescricao\\\").val()),\\r\\n                sDsTipoDocumento: \\\"\\\",\\r\\n                dtoProcesso: {\\r\\n                    nCdProcesso: objParametroImpugnacao.nCdProcesso,\\r\\n                    nCdModulo: objParametroImpugnacao.nCdModulo,\\r\\n                    dtoIdioma: {\\r\\n                        nCdIdioma: adquirirIdIdioma(\\\"/\\\")\\r\\n                    }\\r\\n                }\\r\\n            };\\r\\n\\r\\n            var nDocumento;                    \\r\\n            if (adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n                nDocumento = $(\\\"#tbImpugnarDocumento\\\").val().replace(/[^a-z0-9]/gi, \\\"\\\");\\r\\n            else\\r\\n                nDocumento = $(\\\"#tbImpugnarDocumento\\\").val();                    \\r\\n\\r\\n            if ($(\\\"input[name=\\u0027documentoImpugnar\\u0027]:checked\\\").val() == \\\"CNPJ\\\") {\\r\\n                dtoImpugnacao.sDsCnpj = nDocumento;\\r\\n                dtoImpugnacao.sDsTipoDocumento = \\\"CNPJ\\\";\\r\\n            }\\r\\n            else if ($(\\\"input[name=\\u0027documentoImpugnar\\u0027]:checked\\\").val() == \\\"CPF\\\") {\\r\\n                dtoImpugnacao.sDsCpf = nDocumento;\\r\\n                dtoImpugnacao.sDsTipoDocumento = \\\"CPF\\\";\\r\\n            }\\r\\n\\r\\n            if (exigeAnexo()) {\\r\\n                Alerta(\\\"O anexo deve ser preenchido.\\\", \\\"/\\\");\\r\\n\\r\\n                $(\\\"#painelAnexoImpugnacao\\\").show();\\r\\n            } else {\\r\\n                chamadaWebService(\\r\\n                    \\\"WebService/Servicos.asmx/SalvarImpugnacao\\\",\\r\\n                    \\\"dtoImpugnacao:\\\" + JSON.stringify(dtoImpugnacao),\\r\\n                    function (_retorno) {\\r\\n                        var objRetorno = _retorno.d;\\r\\n\\r\\n                        if (validarNumeroNulo(objRetorno.nCdCodigo) \\u003e 0) {\\r\\n                            $(\\\"#tbImpuganacaoProtocolo\\\").text(objRetorno.sDsConteudo);\\r\\n                            objParametroImpugnacao.nCdImpugnacao = objRetorno.nCdCodigo;\\r\\n                            objParametroImpugnacao.sNrProtocolo = objRetorno.sDsConteudo;\\r\\n\\r\\n                            $(\\\"#fuAnexo\\\").data(\\\"kendoUpload\\\").upload();\\r\\n                            $(\\\"#fuAnexo\\\").data(\\\"kendoUpload\\\").options.async.autoUpload = true;\\r\\n                            $(\\\"#painelAnexoImpugnacao\\\").show();\\r\\n\\r\\n                            bloqueiaCamposImpugnacao(true);\\r\\n                            $(\\\"#gridImpugnacao\\\").data(\\\"kendoGrid\\\").dataSource.read();\\r\\n                        }\\r\\n                        else\\r\\n                            Alerta(objRetorno.sDsConteudo, \\\"/\\\");\\r\\n                    },\\r\\n                    function (x, e) {\\r\\n                        Alerta(\\\"Não foi possível recuperar os dados desse registro!\\\", \\\"/\\\");\\r\\n                    }\\r\\n                );\\r\\n            }\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function reiniciaFormularioImpugnar(bParcial) {\\r\\n        if (adquirirIdIdioma(\\\"/\\\") != \\\"1\\\") {\\r\\n            $(\\\"#uniform-rbImpugnarCNPJ\\\").hide();\\r\\n            $(\\\"#lblImpugnarCNPJ\\\").hide();\\r\\n        }\\r\\n        else {\\r\\n            $(\\\"#uniform-rbImpugnarCNPJ\\\").show();\\r\\n            $(\\\"#lblImpugnarCNPJ\\\").show();\\r\\n        }\\r\\n\\r\\n        $(\\\"#painelImpugnar input:text\\\").val(\\\"\\\");\\r\\n        $(\\\"#painelImpugnar textarea\\\").val(\\\"\\\");\\r\\n\\r\\n        $(\\\"#areaBotaoImprimir\\\").hide();\\r\\n        $(\\\"#areaBotaoSalvar\\\").fadeIn();\\r\\n\\r\\n        if (!$(\\\"#btImpugnarExcluir\\\").hasClass(\\\"desativado\\\"))\\r\\n            $(\\\"#btImpugnarExcluir\\\").toggleClass(\\\"desativado\\\");\\r\\n        \\r\\n        if (!$(\\\"#btImpugnarFinalizar\\\").hasClass(\\\"desativado\\\"))\\r\\n            $(\\\"#btImpugnarFinalizar\\\").toggleClass(\\\"desativado\\\");\\r\\n\\r\\n        if (typeof objParametroImpugnacao.frmValidacao != \\\"undefined\\\")\\r\\n            objParametroImpugnacao.frmValidacao.resetForm();\\r\\n\\r\\n        if (!bParcial) {\\r\\n            $.uniform.update($(\\\"#rbImpugnarCPF\\\").attr(\\\"checked\\\", true));\\r\\n            $.uniform.update($(\\\"#rbImpugnarCNPJ\\\").attr(\\\"checked\\\", false));\\r\\n            $(\\\"#tbImpugnarDocumento\\\").unmask();\\r\\n            \\r\\n            const idioma = adquirirIdIdioma(\\\"/\\\");\\r\\n            if (idioma == \\\"1\\\")\\r\\n                $(\\\"#tbImpugnarDocumento\\\").mask(\\\"999.999.999-99\\\");\\r\\n            else if (idioma == \\\"4\\\") {\\r\\n                $(\\\"#tbImpugnarDocumento\\\").off(\\\"input.ruc\\\").on(\\\"input.ruc\\\", function () {\\r\\n                    var raw = $(this).val().replace(/\\\\D/g, \\\"\\\").slice(0, 9);\\r\\n                    $(this).val(raw.length \\u003e 1 ? raw.slice(0, -1) + \\\"-\\\" + raw.slice(-1) : raw);\\r\\n                });\\r\\n            }\\r\\n\\r\\n            $(\\\"#painelAnexoImpugnacao\\\").hide();\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function carregarAnexosImpugnacao() {\\r\\n        cbAnexoTodos_Click(false);\\r\\n\\r\\n        var sSchema = [{\\r\\n            nCdAnexo: { type: \\\"number\\\" },\\r\\n            nSqAnexo: { type: \\\"number\\\" },\\r\\n            sDsAnexo: { type: \\\"string\\\" },\\r\\n            sNmArquivo: { type: \\\"string\\\" },\\r\\n            sDsParametroCriptografado: { type: \\\"string\\\" },\\r\\n            tDtAnexo: { type: \\\"string\\\" }\\r\\n        }];\\r\\n\\r\\n        var sColunas = [\\r\\n            { field: \\\"sDsAnexo\\\", title: \\\"Descrição\\\", template: \\u0027#=formataAnexoImpugnacao(nCdAnexo, sDsAnexo, sNmArquivo, sDsParametroCriptografado)#\\u0027, width: \\\"80px\\\" },\\r\\n            { field: \\\"tDtAnexo\\\", title: \\\"Data\\\", template: \\u0027#=formataDataHora(tDtAnexo, true)#\\u0027, width: \\\"40px\\\" },\\r\\n            { field: \\\"nSqAnexo\\\", title: \\\" \\\", template: \\u0027#=formataSequencia(nCdAnexo, nSqAnexo, sNmArquivo)#\\u0027, width: \\\"10px\\\", headerTemplate: \\u0027\\u003cinput type=\\\\\\\"checkbox\\\\\\\" title=\\\\\\\"Selecionar todos\\\\\\\"  onclick=\\\\\\\"cbAnexoTodos_Click(this.checked)\\\\\\\"/\\u003e\\u0027 }\\r\\n        ];\\r\\n\\r\\n        var sParametros = \\\"nCdAnexo: \\\" + JSON.parse(objParametroImpugnacao.nCdAnexo);\\r\\n\\r\\n        var dtoAnexo = {\\r\\n            nCdAnexo: JSON.parse(objParametroImpugnacao.nCdAnexo),\\r\\n            sNmLocalAnexo: \\\"EditalAnexosImpugnacao\\\"\\r\\n        }\\r\\n\\r\\n        CarregaGrid(\\r\\n            sSchema,\\r\\n            \\\"WebService/Servicos.asmx/PesquisarAnexos\\\",\\r\\n            \\\"dtoAnexo:\\\" + JSON.stringify(dtoAnexo),\\r\\n            function (data) {\\r\\n                if (data.items.length \\u003e 0) {\\r\\n                    if ($(\\\"#btImpugnarExcluir\\\").hasClass(\\\"desativado\\\"))\\r\\n                        $(\\\"#btImpugnarExcluir\\\").toggleClass(\\\"desativado\\\");\\r\\n                    \\r\\n                    if ($(\\\"#btImpugnarFinalizar\\\").hasClass(\\\"desativado\\\"))\\r\\n                        $(\\\"#btImpugnarFinalizar\\\").toggleClass(\\\"desativado\\\");\\r\\n\\r\\n                    $(\\\"#gridAnexoImpugnacao\\\").show();\\r\\n                }\\r\\n\\r\\n                setTimeout(function () { $(\\\"input[type=checkbox]\\\").uniform(); }, 100);\\r\\n            },\\r\\n            \\\"gridAnexoImpugnacao\\\",\\r\\n            sColunas,\\r\\n            297\\r\\n        );\\r\\n    }\\r\\n\\r\\n    function tbImpugnarDocumento_OnBlur() {\\r\\n\\r\\n        $(\\\"#tbImpugnarDocumento\\\").unmask();\\r\\n\\r\\n        if ($(\\\"#tbImpugnarDocumento\\\").val() != \\\"\\\") {\\r\\n\\r\\n            if ($(\\\"input[name=\\u0027documentoImpugnar\\u0027]:checked\\\").val() == \\\"CNPJ\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n                $(\\\"#tbImpugnarDocumento\\\").mask(\\\"**.***.***/****-**\\\");\\r\\n            else if ($(\\\"input[name=\\u0027documentoImpugnar\\u0027]:checked\\\").val() == \\\"CPF\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n                $(\\\"#tbImpugnarDocumento\\\").mask(\\\"999.999.999-99\\\");\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function rbImpugnarTipoDocumento_Change() {\\r\\n\\r\\n        reiniciaFormularioImpugnar(true);\\r\\n        \\r\\n        if ($(\\\"input[name=\\u0027documentoImpugnar\\u0027]:checked\\\").val() == \\\"CNPJ\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n            $(\\\"#tbImpugnarDocumento\\\").mask(\\\"**.***.***/****-**\\\");\\r\\n        else if ($(\\\"input[name=\\u0027documentoImpugnar\\u0027]:checked\\\").val() == \\\"CPF\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n            $(\\\"#tbImpugnarDocumento\\\").mask(\\\"999.999.999-99\\\");\\r\\n    }\\r\\n\\r\\n    function formataSequencia(_nCdAnexo, _nSqAnexo, _sNmArquivo) {\\r\\n        return \\\"\\u003cinput type=\\u0027checkbox\\u0027 title=\\\\\\\"Selecione\\\\\\\" data-sequencia=\\u0027\\\" + _nSqAnexo + \\\"\\u0027 data-nome=\\u0027\\\" + _sNmArquivo + \\\"\\u0027 /\\u003e\\\";\\r\\n    }\\r\\n\\r\\n    function cbAnexoTodos_Click(_bMarcar) {\\r\\n        $(\\\"#painelImpugnar :input:checkbox\\\").each(function () {\\r\\n            $.uniform.update($(this).attr(\\\"checked\\\", _bMarcar));\\r\\n        });\\r\\n    }\\r\\n\\r\\n    function formataAnexoImpugnacao(_nCdAnexo, _sDsAnexo, _sNmArquivo, _sDsParametroCriptografado) {\\r\\n        return \\\"\\u003cdiv onclick=\\u0027btBaixarImpugnacaoAnexo(\\\\\\\"\\\" + _sDsParametroCriptografado + \\\"\\\\\\\")\\u0027 class=\\u0027areaClique\\u0027\\u003e\\\" + kendo.htmlEncode(_sDsAnexo) + \\\"\\u003c/div\\u003e\\\";\\r\\n    }\\r\\n\\r\\n    function btBaixarImpugnacaoAnexo(_sDsParametroCriptografado) {\\r\\n        window.open(\\\"Download.aspx\\\" + _sDsParametroCriptografado, \\\"_self\\\");\\r\\n    }\\r\\n\\r\\n    function btImpugnarExcluir_Click() {\\r\\n        var lstDtoAnexos = [];\\r\\n        $(\\\"#gridAnexoImpugnacao :checkbox:checked\\\").each(function () {\\r\\n            var dtoAnexo = { nCdAnexo: 0, nSqAnexo: 0 };\\r\\n            dtoAnexo.nCdAnexo = objParametroImpugnacao.nCdAnexo;\\r\\n            dtoAnexo.nSqAnexo = $(this).data(\\\"sequencia\\\");\\r\\n            dtoAnexo.sNmArquivo = $(this).data(\\\"nome\\\");\\r\\n\\r\\n            lstDtoAnexos.push(dtoAnexo);\\r\\n        });\\r\\n\\r\\n        var dtoImpugnacao = {\\r\\n            nCdImpugnacao: objParametroImpugnacao.nCdImpugnacao,\\r\\n            dtoProcesso: { nCdModulo: objParametroImpugnacao.nCdModulo }\\r\\n        };\\r\\n\\r\\n        if (lstDtoAnexos.length \\u003e 0) {\\r\\n\\r\\n            chamadaWebService(\\r\\n                \\\"WebService/Servicos.asmx/RemoverAnexosImpugnacao\\\",\\r\\n                \\\"lstDtoAnexos:\\\" + JSON.stringify(lstDtoAnexos) + \\\", dtoImpugnacao: \\\" + JSON.stringify(dtoImpugnacao),\\r\\n                function (_retorno) {\\r\\n                    if (Number(_retorno.d) \\u003e 0) {\\r\\n                        Alerta(\\\"Operação efetuada com sucesso.\\\", \\\"/\\\");\\r\\n                        carregarAnexosImpugnacao();\\r\\n                    }\\r\\n                    else\\r\\n                        Alerta(_retorno.d, \\\"/\\\");\\r\\n                },\\r\\n                function () {\\r\\n                }\\r\\n            );\\r\\n        }\\r\\n        else\\r\\n            Alerta(\\\"Para realizar a operação, selecione ao menos um registro.\\\", \\\"/\\\");\\r\\n    }\\r\\n\\r\\n    function btImpugnarFinalizar_Click() {\\r\\n        if (exigeAnexo() \\u0026\\u0026 objParametroImpugnacao.nCdAnexo == 0) {\\r\\n            Alerta(\\\"O anexo deve ser preenchido.\\\", \\\"/\\\");\\r\\n\\r\\n            $(\\\"#painelAnexoImpugnacao\\\").show();\\r\\n        } else {\\r\\n            $(\\\"#divImpugnar\\\").parent().load(location.href + \\\" #divImpugnar\\\");\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function preparaValidacaoImpugnacao() {\\r\\n\\r\\n        if (adquirirIdIdioma(\\\"/\\\") != \\\"1\\\")\\r\\n            $(\\\"#tbImpugnarDocumento\\\").attr(\\\"maxlength\\\", \\\"14\\\");\\r\\n\\r\\n        objParametroImpugnacao.frmValidacao = $(\\\"#uc_MuralDetalheImpugnar\\\").validate({\\r\\n            errorPlacement: function (error, element) {\\r\\n                if (element[0].type === \\\"radio\\\") {\\r\\n                    if ($($(\\\"label[for=\\u0027tbImpugnarDocumento\\u0027][class=\\u0027error\\u0027]\\\")[0]).css(\\\"display\\\") == \\\"none\\\" \\u0026\\u0026 $(\\\"#tbImpugnarDocumento\\\").val() != \\\"\\\")\\r\\n                        error.insertAfter($(\\\"#tbImpugnarDocumento\\\"));\\r\\n                }\\r\\n                else\\r\\n                    error.insertAfter(element);\\r\\n                return true;\\r\\n            },\\r\\n            rules: {\\r\\n                tbImpugnarDocumento: {\\r\\n                    required: true,\\r\\n                    validaCPFCNPJ: function () {\\r\\n                        if (adquirirIdIdioma(\\\"/\\\") != \\\"1\\\")\\r\\n                            return \\\"\\\";\\r\\n                        else\\r\\n                            return $(\\\"input[name=\\u0027documentoImpugnar\\u0027]:checked\\\").val();\\r\\n                    }\\r\\n                },\\r\\n                tbImpugnacaoNome: { required: true },\\r\\n                tbImpugnacaoDescricao: { required: true, maxlength: 10000 },\\r\\n                documentoImpugnar: {\\r\\n                    required: function () {\\r\\n                        if ($($(\\\"label[for=\\u0027tbImpugnarDocumento\\u0027][class=\\u0027error\\u0027]\\\")[0]).css(\\\"display\\\") == \\\"none\\\" \\u0026\\u0026 $(\\\"#tbImpugnarDocumento\\\").val() != \\\"\\\")\\r\\n                            return true;\\r\\n                        else\\r\\n                            return false;\\r\\n                    }\\r\\n                }\\r\\n            },\\r\\n            messages: {\\r\\n                tbImpugnarDocumento: {\\r\\n                    required: function () {\\r\\n                        //Módulo licitação pode não precisar fazer cadastro\\r\\n                        if (objParametroImpugnacao.nCdModulo == 59 \\u0026\\u0026 !true)\\r\\n                            return;\\r\\n                        if ($(\\\"input[name=\\u0027documentoImpugnar\\u0027]:checked\\\").val() == \\\"CNPJ\\\")\\r\\n                            return \\\"O campo {0} é obrigatório\\\".format(\\\"CNPJ\\\");\\r\\n                        else if ($(\\\"input[name=\\u0027documentoImpugnar\\u0027]:checked\\\").val() == \\\"CPF\\\")\\r\\n                            return \\\"O campo {0} é obrigatório\\\".format(\\\"CPF\\\");\\r\\n                    },\\r\\n                    validaCPFCNPJ: function () {\\r\\n                        //Módulo licitação pode não precisar fazer cadastro\\r\\n                        if (objParametroImpugnacao.nCdModulo == 59 \\u0026\\u0026 !true)\\r\\n                            return;\\r\\n                        if ($(\\\"input[name=\\u0027documentoImpugnar\\u0027]:checked\\\").val() == \\\"CNPJ\\\")\\r\\n                            return \\\"O campo {0} é inválido\\\".format(\\\"CNPJ\\\");\\r\\n                        else if ($(\\\"input[name=\\u0027documentoImpugnar\\u0027]:checked\\\").val() == \\\"CPF\\\")\\r\\n                            return \\\"O campo {0} é inválido\\\".format(\\\"CPF\\\");\\r\\n                    }\\r\\n                },\\r\\n                tbImpugnacaoNome: {\\r\\n                    required: function () {\\r\\n                        //Módulo licitação pode não precisar fazer cadastro\\r\\n                        if (objParametroImpugnacao.nCdModulo == 59 \\u0026\\u0026 !true)\\r\\n                            return;\\r\\n                        return \\\"O campo {0} é obrigatório\\\".format(\\\"Nome\\\");\\r\\n                    }\\r\\n                },\\r\\n                tbImpugnacaoDescricao: {\\r\\n                    required: \\\"O campo {0} é obrigatório\\\".format(\\\"Descrição\\\"),\\r\\n                    maxlength: \\\"O campo excedeu o limite de {0} caracteres.\\\"\\r\\n                },\\r\\n                documentoImpugnar: {\\r\\n                    required: function () {\\r\\n                        //Módulo licitação pode não precisar fazer cadastro\\r\\n                        if (objParametroImpugnacao.nCdModulo == 59 \\u0026\\u0026 !true)\\r\\n                            return;\\r\\n                        if ($($(\\\"label[for=\\u0027tbImpugnarDocumento\\u0027][class=\\u0027error\\u0027]\\\")[0]).css(\\\"display\\\") == \\\"none\\\" \\u0026\\u0026 $(\\\"#tbImpugnarDocumento\\\").val() != \\\"\\\")\\r\\n                            return \\\"Selecione um documento.\\\"\\r\\n                        else\\r\\n                            return \\\"\\\";\\r\\n                    }\\r\\n                }\\r\\n            }\\r\\n        });\\r\\n    }\\r\\n\\u003c/script\\u003e\\r\\n\\r\\n\\u003cdiv class=\\\"aspNetHidden\\\"\\u003e\\r\\n\\r\\n\\t\\u003cinput type=\\\"hidden\\\" name=\\\"__VIEWSTATEGENERATOR\\\" id=\\\"__VIEWSTATEGENERATOR\\\" value=\\\"C21772F6\\\" /\\u003e\\r\\n\\u003c/div\\u003e\\u003c/form\\u003e\"}"
          },
