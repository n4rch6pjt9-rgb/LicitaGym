       \\u003c/div\\u003e\\r\\n        \\u003cdiv class=\\\"span4\\\"\\u003e\\r\\n            \\u003clabel for=\\\"ddlCidadeCadastroVisitanteForum\\\"\\u003eCidade\\u003c/label\\u003e\\u003cbr /\\u003e\\r\\n            \\u003cselect id=\\\"ddlCidadeCadastroVisitanteForum\\\" name=\\\"ddlCidadeCadastroVisitanteForum\\\" style=\\\"width:96%\\\" class=\\\"campo-uniform-CadastroVisitanteForum\\\" data-testid=\\\"cadastro-visitante-select-cidade-CadastroVisitanteForum\\\"\\u003e\\u003c/select\\u003e\\r\\n            \\u003cdiv id=\\\"carregandoCidadeCadastroVisitanteForum\\\" class=\\\"carregandoDados\\\" style=\\\"display:none\\\"; \\u003e\\u003cimg src=\\\"Imagens/carregando.gif\\\" width=\\\"18px\\\" height=\\\"18px\\\" /\\u003e\\u003c/div\\u003e\\r\\n        \\u003c/div\\u003e\\r\\n    \\u003c/div\\u003e\\r\\n    \\u003cdiv id=\\\"divPreCadastroCadastroVisitanteForum\\\"\\u003e\\r\\n       \\u003cinput id=\\\"cbPreCadastroCadastroVisitanteForum\\\" type=\\\"checkbox\\\" name=\\\"PreCadastroCadastroVisitanteForum\\\" class=\\\"campo-uniform-CadastroVisitanteForum\\\" data-testid=\\\"cadastro-visitante-checkbox-pre-cadastro-CadastroVisitanteForum\\\" /\\u003e\\r\\n       \\u003clabel for=\\\"PreCadastroCadastroVisitanteForum\\\"\\u003e Criar um prÃ©-cadastro\\u003c/label\\u003e\\r\\n    \\u003c/div\\u003e\\r\\n    \\r\\n    \\u003c!-- Consentimento LGPD --\\u003e\\r\\n    \\u003cdiv id=\\\"divConsentimentoLgpdCadastroVisitanteForum\\\" style=\\\"display: none; margin-top: 10px;\\\"\\u003e\\r\\n        \\u003cdiv class=\\\"row-fluid\\\"\\u003e\\r\\n            \\u003cdiv class=\\\"span12\\\"\\u003e\\r\\n                \\u003cinput id=\\\"cbConsentimentoLgpdCadastroVisitanteForum\\\" type=\\\"checkbox\\\" name=\\\"ConsentimentoLgpdCadastroVisitanteForum\\\" class=\\\"campo-uniform-CadastroVisitanteForum\\\" data-testid=\\\"cadastro-visitante-checkbox-consentimento-lgpd-CadastroVisitanteForum\\\" /\\u003e\\r\\n                \\u003clabel for=\\\"cbConsentimentoLgpdCadastroVisitanteForum\\\" style=\\\"margin-left: 5px; font-size: 11px; line-height: 1.4;\\\"\\u003eDeclaro estar ciente e de acordo que os dados pessoais informados poderão ser utilizados pelo sistema para fins operacionais e administrativos, em conformidade com a legislação vigente de proteção de dados pessoais (Lei nº 13.709/2018 – LGPD).\\u003c/label\\u003e\\r\\n                \\u003cdiv id=\\\"divErroLgpdCadastroVisitanteForum\\\" style=\\\"display:none; color:red; font-size:11px; margin-top:5px;\\\"\\u003e\\r\\n                    É necessário concordar com o tratamento dos dados pessoais para continuar.\\r\\n                \\u003c/div\\u003e\\r\\n            \\u003c/div\\u003e\\r\\n        \\u003c/div\\u003e\\r\\n    \\u003c/div\\u003e\\r\\n    \\u003chr /\\u003e\\r\\n\\r\\n    \\u003c!-- AÃ§Ãµes --\\u003e\\r\\n    \\u003cdiv class=\\\"row-fluid\\\"\\u003e\\r\\n        \\u003cdiv class=\\\"span4\\\"\\u003e\\r\\n            \\u003cdiv class=\\\"areaBotao2\\\" \\u003e\\r\\n                \\u003cdiv class=\\\"ico-botao ico-voltar-branco-15\\\"\\u003e\\u003c/div\\u003e\\r\\n                \\u003cinput id=\\\"btCadastroVisitanteVoltarCadastroVisitanteForum\\\" type=\\\"button\\\" value=\\\"Voltar\\\" class=\\\"campoBotao\\\" onclick=\\\"btCadastroVisitanteVoltar_ClickCadastroVisitanteForum()\\\" data-testid=\\\"cadastro-visitante-button-voltar-CadastroVisitanteForum\\\" aria-label=\\\"Voltar\\\"/\\u003e\\r\\n            \\u003c/div\\u003e\\r\\n            \\u003cdiv class=\\\"areaBotao2\\\"\\u003e\\r\\n                \\u003cdiv class=\\\"ico-botao ico-download-branco-15\\\"\\u003e\\u003c/div\\u003e\\r\\n                \\u003cinput id=\\\"btCadastroVisitanteConfirmarCadastroVisitanteForum\\\" type=\\\"button\\\" value=\\\"Continuar\\\" class=\\\"campoBotao\\\" onclick=\\\"btCadastroVisitanteConfirmar_ClickCadastroVisitanteForum()\\\" data-testid=\\\"cadastro-visitante-button-confirmar-CadastroVisitanteForum\\\" aria-label=\\\"Continuar\\\"/\\u003e\\r\\n            \\u003c/div\\u003e\\r\\n            \\u003cspan id=\\\"carregandoSalvarCadastroVisitanteForum\\\" style=\\\"display:none\\\" \\u003e\\u003cimg src=\\\"Imagens/carregando.gif\\\" width=\\\"18px\\\" height=\\\"18px\\\" /\\u003e\\u003c/span\\u003e\\r\\n        \\u003c/div\\u003e\\r\\n    \\u003c/div\\u003e\\r\\n\\u003c/div\\u003e\\r\\n\\r\\n\\u003cscript type=\\\"text/javascript\\\"\\u003e\\r\\n    var sNmGridCadastroVisitanteForum = \\\"\\\";\\r\\n    var objJsonConfigCamposCadastroVisitanteForum = null;\\r\\n    var bFlExibirCheckboxLgpdCadastroVisitanteForum = false;\\r\\n\\r\\n    // ConfiguraÃ§Ã£o JSON dos campos\\r\\n    \\r\\n\\r\\n    $(document).ready(function () {\\r\\n\\r\\n        switch (\\\"CadastroVisitanteForum\\\") {\\r\\n            case \\\"CadastroVisitanteForum\\\":\\r\\n                sNmGridCadastroVisitanteForum = \\\"#gridForum\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteForum\\\").val(\\\"Continuar\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexo\\\":\\r\\n                sNmGridCadastroVisitanteForum = \\\"#gridAnexo\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteForum\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexoProposta\\\":\\r\\n                sNmGridCadastroVisitanteForum = \\\"#gridAnexoProposta\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteForum\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexoLance\\\":\\r\\n                sNmGridCadastroVisitanteForum = \\\"#gridAnexoLance\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteForum\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexoNegociacao\\\":\\r\\n                sNmGridCadastroVisitanteForum = \\\"#gridAnexoNegociacao\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteForum\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexoHabilitacao\\\":\\r\\n                sNmGridCadastroVisitanteForum = \\\"#gridAnexoHabilitacao\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteForum\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexoRecurso\\\":\\r\\n                sNmGridCadastroVisitanteForum = \\\"#gridAnexoRecurso\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteForum\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexoContraRazoes\\\":\\r\\n                sNmGridCadastroVisitanteForum = \\\"#gridAnexoContraRazoes\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteForum\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n            case \\\"CadastroVisitanteAnexoParecer\\\":\\r\\n                sNmGridCadastroVisitanteForum = \\\"#gridAnexoParecer\\\";\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteForum\\\").val(\\\"Baixar arquivo\\\");\\r\\n                break;\\r\\n        }\\r\\n\\r\\n        $(\\\"#rbCPFCadastroVisitanteForum, #rbCNPJCadastroVisitanteForum\\\").on(\\\"click\\\", rbVisitanteTipoDocumento_ClickCadastroVisitanteForum);\\r\\n        $(\\\"#tbDocumentoCadastroVisitanteForum\\\").on(\\\"blur\\\", tbDocumento_OnBlurCadastroVisitanteForum);\\r\\n        var bFlInteresseCertame = objConfiguracao.bFlInteresseCertame;\\r\\n        if (bFlInteresseCertame == 1)\\r\\n            $(\\\"#rbbFlInteresse\\\").show();\\r\\n        else\\r\\n            $(\\\"#rbbFlInteresse\\\").hide();\\r\\n\\r\\n        configurarCamposJsonCadastroVisitanteForum();\\r\\n        setTimeout(function() {\\r\\n            var tipoSelecionado = $(\\u0027input[name=\\\"documentoCadastroVisitanteForum\\\"]:checked\\u0027).val();\\r\\n\\r\\n            if (!tipoSelecionado) {\\r\\n                $(\\u0027#rbCPFCadastroVisitanteForum\\u0027).prop(\\u0027checked\\u0027, true);\\r\\n                configurarCamposPorTipoCadastroVisitanteForum(\\u00271\\u0027);\\r\\n                configurarVisibilidadeLGPDCadastroVisitanteForum();\\r\\n            }\\r\\n        }, 500);\\r\\n\\r\\n\\r\\n    });\\r\\n\\r\\n    function reiniciaFormularioCadastroVisitanteForum(bParcial) {\\r\\n        var bFlRetiradaEditalPreCadastro = objConfiguracao.bFlRetiradaEditalPreCadastro;\\r\\n        if (bFlRetiradaEditalPreCadastro == 1 \\u0026\\u0026 $(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CNPJ\\\")\\r\\n            $(\\\"#divPreCadastroCadastroVisitanteForum\\\").show();\\r\\n        else\\r\\n            $(\\\"#divPreCadastroCadastroVisitanteForum\\\").hide();\\r\\n\\r\\n        $(\\\"#uniform-rbCNPJCadastroVisitanteForum\\\").show();\\r\\n        $(\\\"#lblCNPJCadastroVisitanteForum\\\").show();\\r\\n        $(\\\"#tbCEPCadastroVisitanteForum\\\").mask(\\\"99.999-999\\\");\\r\\n\\r\\n        $(\\\"#ddlPaisCadastroVisitanteForum\\\").val(\\\"0\\\");\\r\\n        $(\\\"#ddlPaisCadastroVisitanteForum option\\\").remove();\\r\\n        $(\\\"#ddlPaisCadastroVisitanteForum\\\").parent().children().first().text(\\\"\\\");\\r\\n\\r\\n        $(\\\"#ddlEstadoCadastroVisitanteForum\\\").val(\\\"0\\\");\\r\\n        $(\\\"#ddlEstadoCadastroVisitanteForum option\\\").remove();\\r\\n        $(\\\"#ddlEstadoCadastroVisitanteForum\\\").parent().children().first().text(\\\"\\\");\\r\\n\\r\\n        $(\\\"#ddlCidadeCadastroVisitanteForum\\\").val(\\\"0\\\");\\r\\n        $(\\\"#ddlCidadeCadastroVisitanteForum option\\\").remove();\\r\\n        $(\\\"#ddlCidadeCadastroVisitanteForum\\\").parent().children().first().text(\\\"\\\");\\r\\n\\r\\n        if (typeof objParametroCadastroVisitanteForum.frmValidacao != \\\"undefined\\\")\\r\\n            objParametroCadastroVisitanteForum.frmValidacao.resetForm();\\r\\n\\r\\n        if (!bParcial) {\\r\\n            $.uniform.update($(\\\"#rbCPFCadastroVisitanteForum\\\").attr(\\\"checked\\\", true));\\r\\n            $.uniform.update($(\\\"#rbCNPJCadastroVisitanteForum\\\").attr(\\\"checked\\\", false));\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteForum\\\").unmask();\\r\\n\\r\\n            if (adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n                $(\\\"#tbDocumentoCadastroVisitanteForum\\\").mask(\\\"999.999.999-99\\\");\\r\\n\\r\\n            $(\\\"#painelCadastroCadastroVisitanteForum input:text\\\").not(\\\"#tbnCdVisitanteCadastroVisitanteForum, #tbnCdEmpresaCadastroVisitanteForum, #tbnCdEnderecoCadastroVisitanteForum\\\").val(\\\"\\\");\\r\\n        }\\r\\n        else\\r\\n            $(\\\"#painelCadastroCadastroVisitanteForum input:text\\\").not(\\\"#tbDocumentoCadastroVisitanteForum\\\").val(\\\"\\\");\\r\\n\\r\\n\\r\\n        var tipoDocumento = $(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val();\\r\\n\\r\\n        if (tipoDocumento == \\\"CNPJ\\\") {\\r\\n            $(\\\"#spanRGCadastroVisitanteForum\\\").hide();\\r\\n            $(\\\"#spanNomeCadastroVisitanteForum\\\").removeClass(\\\"span3\\\").addClass(\\\"span5\\\");\\r\\n            $(\\\"#lblNomeCadastroVisitanteForum\\\").text(\\\"Razão social\\\");\\r\\n            $(\\\"#divEnderecoCadastroVisitanteForum\\\").removeClass(\\\"span10\\\").addClass(\\\"span6\\\");\\r\\n            $(\\\"#divEnderecoCadastroVisitanteForum\\\").css(\\\"margin-left\\\", \\\"27px\\\");\\r\\n\\r\\n            setTimeout(function() {\\r\\n                configurarCamposPorTipoCadastroVisitanteForum(\\u00272\\u0027);\\r\\n                configurarVisibilidadeLGPDCadastroVisitanteForum();\\r\\n            }, 10);\\r\\n        }\\r\\n        else if (tipoDocumento == \\\"CPF\\\") {\\r\\n            $(\\\"#spanRGCadastroVisitanteForum\\\").show();\\r\\n            $(\\\"#spanNomeCadastroVisitanteForum\\\").removeClass(\\\"span5\\\").addClass(\\\"span3\\\");\\r\\n            $(\\\"#lblNomeCadastroVisitanteForum\\\").text(\\\"Nome\\\");\\r\\n            $(\\\"#divEnderecoCadastroVisitanteForum\\\").removeClass(\\\"span6\\\").addClass(\\\"span10\\\");\\r\\n            $(\\\"#divEnderecoCadastroVisitanteForum\\\").css(\\\"margin-left\\\", \\\"-1px\\\");\\r\\n\\r\\n            setTimeout(function() {\\r\\n                configurarCamposPorTipoCadastroVisitanteForum(\\u00271\\u0027);\\r\\n                configurarVisibilidadeLGPDCadastroVisitanteForum();\\r\\n            }, 10);\\r\\n        }\\r\\n\\r\\n        CarregarRegiaoCadastroVisitanteForum(enumTipoRegiao.PAIS);\\r\\n    }\\r\\n\\r\\n    function CarregarRegiaoCadastroVisitanteForum(_enumTipoRegiao) {\\r\\n        var dtoRegiao = { sCdCodigo: \\\"\\\", tmpTipoRegiao: _enumTipoRegiao };\\r\\n        var sIdElemento = \\\"ddlPaisCadastroVisitanteForum\\\";\\r\\n\\r\\n        $(\\\"#carregandoPaisCadastroVisitanteForum, #carregandoEstadoCadastroVisitanteForum, #carregandoCidadeCadastroVisitanteForum\\\").hide();\\r\\n        $(\\\"#carregandoPaisCadastroVisitanteForum, #carregandoEstadoCadastroVisitanteForum, #carregandoCidadeCadastroVisitanteForum\\\").removeClass(\\\"select\\\");\\r\\n\\r\\n        switch (_enumTipoRegiao) {\\r\\n            case enumTipoRegiao.PAIS:\\r\\n                dtoRegiao.sCdCodigo = \\\"0\\\";\\r\\n                sIdElemento = \\\"ddlPaisCadastroVisitanteForum\\\";\\r\\n                CarregaRegiaoPaisCadastroVisitanteForum(dtoRegiao);\\r\\n                break;\\r\\n            case enumTipoRegiao.ESTADO:\\r\\n                $.uniform.update(\\\"#ddlPaisCadastroVisitanteForum\\\");\\r\\n                dtoRegiao.sCdCodigo = $(\\\"#ddlPaisCadastroVisitanteForum option:selected\\\").val();\\r\\n                dtoRegiao.sCdPais = $(\\\"#ddlPaisCadastroVisitanteForum option:selected\\\").val();\\r\\n                sIdElemento = \\\"ddlEstadoCadastroVisitanteForum\\\";\\r\\n                CarregaRegiaoEstadoCadastroVisitanteForum(dtoRegiao);\\r\\n                break;\\r\\n            case enumTipoRegiao.CIDADE:\\r\\n                $.uniform.update(\\\"#ddlEstadoCadastroVisitanteForum\\\");\\r\\n                dtoRegiao.sCdCodigo = $(\\\"#ddlEstadoCadastroVisitanteForum option:selected\\\").val();\\r\\n                dtoRegiao.sCdPais = $(\\\"#ddlPaisCadastroVisitanteForum option:selected\\\").val();\\r\\n                sIdElemento = \\\"ddlCidadeCadastroVisitanteForum\\\";\\r\\n                CarregaRegiaoCidadeCadastroVisitanteForum(dtoRegiao);\\r\\n                break;\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function CarregaRegiaoPaisCadastroVisitanteForum(dtoRegiao) {\\r\\n        chamadaWebService(\\r\\n            \\\"WebService/Servicos.asmx/PesquisarRegiao\\\",\\r\\n            \\\"dtoRegiao:\\\" + JSON.stringify(dtoRegiao),\\r\\n            function (_retorno) {\\r\\n                var arrRetorno = _retorno.d;\\r\\n\\r\\n                var sSelect = $(\\\"\\u003cselect\\u003e\\\");\\r\\n                sSelect.append($(\\u0027\\u003coption\\u003e\\u003c/option\\u003e\\u0027).val(\\\"0\\\").html(\\\"Selecione\\\"));\\r\\n                $(arrRetorno).each(function () {\\r\\n                    sSelect.append($(\\u0027\\u003coption\\u003e\\u003c/option\\u003e\\u0027).val(this.sCdCodigo).html(this.sDsRegiao));\\r\\n                });\\r\\n\\r\\n                $(\\\"#ddlPaisCadastroVisitanteForum option\\\").remove();\\r\\n                $(\\\"#ddlPaisCadastroVisitanteForum\\\").append(sSelect.html());\\r\\n                $(\\\"#ddlPaisCadastroVisitanteForum\\\").val(\\\"0\\\");\\r\\n                $.uniform.update(\\\"#ddlPaisCadastroVisitanteForum\\\");\\r\\n                $(\\\"#ddlPaisCadastroVisitanteForum\\\").unbind(\\\"change\\\");\\r\\n                $(\\\"#ddlPaisCadastroVisitanteForum\\\").bind(\\\"change\\\", function () { CarregarRegiaoCadastroVisitanteForum(enumTipoRegiao.ESTADO); });\\r\\n                $(\\\"#ddlPaisCadastroVisitanteForum\\\").trigger(\\\"change\\\");\\r\\n\\r\\n                $(\\\"#carregandoPaisCadastroVisitanteForum\\\").hide();\\r\\n                $(\\\"#carregandoPaisCadastroVisitanteForum\\\").removeClass(\\\"select\\\");\\r\\n            },\\r\\n            function () {\\r\\n                $(\\\"#carregandoPaisCadastroVisitanteForum\\\").hide();\\r\\n                $(\\\"#carregandoPaisCadastroVisitanteForum\\\").removeClass(\\\"select\\\");\\r\\n            }\\r\\n        );\\r\\n    }\\r\\n\\r\\n    function CarregaRegiaoEstadoCadastroVisitanteForum(dtoRegiao) {\\r\\n        chamadaWebService(\\r\\n            \\\"WebService/Servicos.asmx/PesquisarRegiao\\\",\\r\\n            \\\"dtoRegiao:\\\" + JSON.stringify(dtoRegiao),\\r\\n            function (_retorno) {\\r\\n                var arrRetorno = _retorno.d;\\r\\n\\r\\n                var sSelect = $(\\\"\\u003cselect\\u003e\\\");\\r\\n                sSelect.append($(\\u0027\\u003coption\\u003e\\u003c/option\\u003e\\u0027).val(\\\"0\\\").html(\\\"Selecione\\\"));\\r\\n                $(arrRetorno).each(function () {\\r\\n                    sSelect.append($(\\u0027\\u003coption\\u003e\\u003c/option\\u003e\\u0027).val(this.sCdCodigo).html(this.sDsRegiao));\\r\\n                });\\r\\n\\r\\n                $(\\\"#ddlEstadoCadastroVisitanteForum option\\\").remove();\\r\\n                $(\\\"#ddlEstadoCadastroVisitanteForum\\\").append(sSelect.html());\\r\\n                $(\\\"#ddlEstadoCadastroVisitanteForum\\\").val(\\\"0\\\");\\r\\n                $.uniform.update(\\\"#ddlEstadoCadastroVisitanteForum\\\");\\r\\n                $(\\\"#ddlEstadoCadastroVisitanteForum\\\").unbind(\\\"change\\\");\\r\\n                $(\\\"#ddlEstadoCadastroVisitanteForum\\\").bind(\\\"change\\\", function () { CarregarRegiaoCadastroVisitanteForum(enumTipoRegiao.CIDADE); });\\r\\n                $(\\\"#ddlEstadoCadastroVisitanteForum\\\").trigger(\\\"change\\\");\\r\\n\\r\\n                $(\\\"#carregandoEstadoCadastroVisitanteForum\\\").hide();\\r\\n                $(\\\"#carregandoEstadoCadastroVisitanteForum\\\").removeClass(\\\"select\\\");\\r\\n            },\\r\\n            function () {\\r\\n                $(\\\"#carregandoEstadoCadastroVisitanteForum\\\").hide();\\r\\n                $(\\\"#carregandoEstadoCadastroVisitanteForum\\\").removeClass(\\\"select\\\");\\r\\n            }\\r\\n        );\\r\\n    }\\r\\n\\r\\n    function CarregaRegiaoCidadeCadastroVisitanteForum(dtoRegiao) {\\r\\n        chamadaWebService(\\r\\n            \\\"WebService/Servicos.asmx/PesquisarRegiao\\\",\\r\\n            \\\"dtoRegiao:\\\" + JSON.stringify(dtoRegiao),\\r\\n            function (_retorno) {\\r\\n                var arrRetorno = _retorno.d;\\r\\n\\r\\n                var sSelect = $(\\\"\\u003cselect\\u003e\\\");\\r\\n                sSelect.append($(\\u0027\\u003coption\\u003e\\u003c/option\\u003e\\u0027).val(\\\"0\\\").html(\\\"Selecione\\\"));\\r\\n                $(arrRetorno).each(function () {\\r\\n                    sSelect.append($(\\u0027\\u003coption\\u003e\\u003c/option\\u003e\\u0027).val(this.sCdCodigo).html(this.sDsRegiao));\\r\\n                });\\r\\n\\r\\n                $(\\\"#ddlCidadeCadastroVisitanteForum option\\\").remove();\\r\\n                $(\\\"#ddlCidadeCadastroVisitanteForum\\\").append(sSelect.html());\\r\\n                $(\\\"#ddlCidadeCadastroVisitanteForum\\\").val(\\\"0\\\");\\r\\n                $.uniform.update(\\\"#ddlCidadeCadastroVisitanteForum\\\");\\r\\n                $(\\\"#ddlCidadeCadastroVisitanteForum\\\").trigger(\\\"change\\\");\\r\\n\\r\\n                $(\\\"#carregandoCidadeCadastroVisitanteForum\\\").hide();\\r\\n                $(\\\"#carregandoCidadeCadastroVisitanteForum\\\").removeClass(\\\"select\\\");\\r\\n\\r\\n                setTimeout(function () {\\r\\n                    $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteForum\\\").removeClass(\\\"desativado\\\");\\r\\n                    $(\\\"#carregandoSalvarCadastroVisitanteForum\\\").fadeOut();\\r\\n\\r\\n                    if ($(\\\"#tbDocumentoCadastroVisitanteForum\\\").val() != \\\"\\\" \\u0026\\u0026 $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val() != \\\"___.___.___-__\\\")\\r\\n                        $(\\\"#\\\" + objParametroCadastroVisitanteForum.nIdFormularioValidacao).valid();\\r\\n\\r\\n                }, 1000);\\r\\n            },\\r\\n            function () {\\r\\n                $(\\\"#carregandoCidadeCadastroVisitanteForum\\\").hide();\\r\\n                $(\\\"#carregandoCidadeCadastroVisitanteForum\\\").removeClass(\\\"select\\\");\\r\\n            }\\r\\n        );\\r\\n    }\\r\\n\\r\\n    function preparaValidacaoVisitanteCadastroVisitanteForum() {\\r\\n        if (adquirirIdIdioma(\\\"/\\\") != \\\"1\\\")\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteForum\\\").attr(\\\"maxlength\\\", \\\"14\\\");\\r\\n\\r\\n        var bFlInteresseCertame = objConfiguracao.bFlInteresseCertame;\\r\\n\\r\\n        objParametroCadastroVisitanteForum.frmValidacao = $(\\\"#\\\" + objParametroCadastroVisitanteForum.nIdFormularioValidacao).validate({\\r\\n            errorPlacement: function (error, element) {\\r\\n                if (element[0].tagName === \\\"SELECT\\\")\\r\\n                    error.insertAfter(element.parent());\\r\\n                else if (element[0].type === \\\"radio\\\") {\\r\\n\\r\\n\\r\\n                    if ($($(\\\"label[for=\\u0027tbDocumentoCadastroVisitanteForum\\u0027][class=\\u0027error\\u0027]\\\")[0]).css(\\\"display\\\") == \\\"none\\\" \\u0026\\u0026 $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val() != \\\"\\\") {\\r\\n                        error.insertAfter($(\\\"#tbDocumentoCadastroVisitanteForum\\\"));\\r\\n                    }\\r\\n\\r\\n                    if ($(\\\"input[name=\\u0027InteresseCertameCadastroVisitanteForum\\u0027]:checked\\\").length == 0 \\u0026\\u0026 bFlInteresseCertame == 1) {\\r\\n                        error.insertAfter($(\\\"#lblConsultarCertameCadastroVisitanteForum\\\"));\\r\\n                    }\\r\\n                }\\r\\n                else\\r\\n                    error.insertAfter(element);\\r\\n                return true;\\r\\n            },\\r\\n            rules: {\\r\\n                tbDocumentoCadastroVisitanteForum: {\\r\\n                    required: true,\\r\\n                    validaCPFCNPJ: function () {\\r\\n                        if (adquirirIdIdioma(\\\"/\\\") != \\\"1\\\")\\r\\n                            return \\\"\\\";\\r\\n                        else\\r\\n                            return $(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val();\\r\\n                    }\\r\\n                },\\r\\n                tbRGCadastroVisitanteForum: { required: true, number: true },\\r\\n                tbNomeCadastroVisitanteForum: { required: true },\\r\\n                tbEmailCadastroVisitanteForum: { required: true, validaEmail: true },\\r\\n                tbTelefoneCadastroVisitanteForum: { required: true },\\r\\n                tbEnderecoCadastroVisitanteForum: { required: true },\\r\\n                tbContatoCadastroVisitanteForum: { required: true },\\r\\n                tbNumeroCadastroVisitanteForum: { required: true },\\r\\n                tbBairroCadastroVisitanteForum: { required: true },\\r\\n                tbCEPCadastroVisitanteForum: { required: true },\\r\\n                ddlPaisCadastroVisitanteForum: { validaSelectValorInvalido: \\\"0\\\" },\\r\\n                ddlEstadoCadastroVisitanteForum: { validaSelectValorInvalido: \\\"0\\\" },\\r\\n                ddlCidadeCadastroVisitanteForum: { validaSelectValorInvalido: \\\"0\\\" },\\r\\n\\r\\n                InteresseCertameCadastroVisitanteForum: {\\r\\n                    required: function () {\\r\\n                        if (bFlInteresseCertame == 1)\\r\\n                            return true;\\r\\n                        else\\r\\n                            return false;\\r\\n                    }\\r\\n                },\\r\\n\\r\\n                documentoCadastroVisitanteForum: {\\r\\n                    required: function () {\\r\\n                        if ($($(\\\"label[for=\\u0027rbParticiparCertameCadastroVisitanteForum\\u0027][class=\\u0027error\\u0027]\\\")[0]).css(\\\"display\\\") == \\\"none\\\" \\u0026\\u0026 $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val() != \\\"\\\")\\r\\n                            return true;\\r\\n                        else\\r\\n                            return false;\\r\\n                    }\\r\\n                }\\r\\n            },\\r\\n            messages: {\\r\\n                tbDocumentoCadastroVisitanteForum: {\\r\\n                    required: function () {\\r\\n\\r\\n                        $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteForum\\\").removeClass(\\\"desativado\\\");\\r\\n                        $(\\\"#carregandoSalvarCadastroVisitanteForum\\\").fadeOut();\\r\\n\\r\\n                        if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CNPJ\\\")\\r\\n                            return \\\"O campo {0} é obrigatório\\\".format(\\\"CNPJ\\\");\\r\\n                        else if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CPF\\\")\\r\\n                            return \\\"O campo {0} é obrigatório\\\".format(\\\"CPF\\\");\\r\\n                    },\\r\\n                    validaCPFCNPJ: function () {\\r\\n\\r\\n                        $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteForum\\\").removeClass(\\\"desativado\\\");\\r\\n                        $(\\\"#carregandoSalvarCadastroVisitanteForum\\\").fadeOut();\\r\\n\\r\\n                        if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CNPJ\\\")\\r\\n                            return \\\"O campo {0} é inválido\\\".format(\\\"CNPJ\\\");\\r\\n                        else if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CPF\\\")\\r\\n                            return \\\"O campo {0} é inválido\\\".format(\\\"CPF\\\");\\r\\n                    }\\r\\n                },\\r\\n                tbRGCadastroVisitanteForum: {\\r\\n                    required: \\\"O campo {0} é obrigatório\\\".format(\\\"RG\\\"),\\r\\n                    number: \\\"O campo {0} é inválido\\\".format(\\\"RG\\\")\\r\\n                },\\r\\n                tbNomeCadastroVisitanteForum: { required: \\\"O campo {0} é obrigatório\\\".format(\\\"Nome\\\") },\\r\\n                tbEmailCadastroVisitanteForum: {\\r\\n                    required: \\\"O campo {0} é obrigatório\\\".format(\\\"E-mail\\\"),\\r\\n                    validaEmail: \\\"O endereço de e-mail {0} é inválido.\\\".format(\\\"\\\")\\r\\n                },\\r\\n                tbTelefoneCadastroVisitanteForum: { required: \\\"O campo {0} é obrigatório\\\".format(\\\"Telefone\\\") },\\r\\n                tbEnderecoCadastroVisitanteForum: { required: \\\"O campo {0} é obrigatório\\\".format(\\\"Endereço\\\") },\\r\\n                tbContatoCadastroVisitanteForum: { required: \\\"O campo {0} é obrigatório\\\".format(\\\"Contato\\\") },\\r\\n                tbNumeroCadastroVisitanteForum: { required: \\\"O campo {0} é obrigatório\\\".format(\\\"Número\\\") },\\r\\n                tbBairroCadastroVisitanteForum: { required: \\\"O campo {0} é obrigatório\\\".format(\\\"Bairro\\\") },\\r\\n                tbCEPCadastroVisitanteForum: { required: \\\"O campo {0} é obrigatório\\\".format(\\\"CEP\\\") },\\r\\n                ddlPaisCadastroVisitanteForum: { validaSelectValorInvalido: \\\"Selecione o país\\\" },\\r\\n                ddlEstadoCadastroVisitanteForum: { validaSelectValorInvalido: \\\"Selecione o estado\\\" },\\r\\n                ddlCidadeCadastroVisitanteForum: { validaSelectValorInvalido: \\\"Selecione a cidade\\\" },\\r\\n                documentoCadastroVisitanteForum: {\\r\\n                    required: function () {\\r\\n                        if ($($(\\\"label[for=\\u0027tbDocumentoCadastroVisitanteForum\\u0027][class=\\u0027error\\u0027]\\\")[0]).css(\\\"display\\\") == \\\"none\\\" \\u0026\\u0026 $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val() != \\\"\\\")\\r\\n                            return \\\"Selecione um documento.\\\"\\r\\n                        else\\r\\n                            return \\\"\\\";\\r\\n                    }\\r\\n                },\\r\\n                InteresseCertameCadastroVisitanteForum: {\\r\\n                    required: function () {\\r\\n                        if ($(\\\"input[name=\\u0027InteresseCertameCadastroVisitanteForum\\u0027]:checked\\\").length == 0 \\u0026\\u0026 bFlInteresseCertame == 1)\\r\\n                            return \\\"É necessário selecionar o tipo de interesse em baixar o anexo do certame.\\\"\\r\\n                        else\\r\\n                            return \\\"\\\";\\r\\n                    }\\r\\n                }\\r\\n\\r\\n            }\\r\\n        });\\r\\n    }\\r\\n\\r\\n    function SalvarVisitanteCadastroVisitanteForum() {\\r\\n        var dtoVisitante = adquirirCookie(\\\"CK_VISITANTE_TEMP\\\", \\\"/\\\");\\r\\n\\r\\n        if (dtoVisitante == \\\"\\\") {\\r\\n            dtoVisitante = {\\r\\n                nCdVisitante: Number($(\\\"#tbnCdVisitanteCadastroVisitanteForum\\\").val()) \\u003e 0 ? Number($(\\\"#tbnCdVisitanteCadastroVisitanteForum\\\").val()) : 0,\\r\\n                nCdEndereco: Number($(\\\"#tbnCdEnderecoCadastroVisitanteForum\\\").val()) \\u003e 0 ? Number($(\\\"#tbnCdEnderecoCadastroVisitanteForum\\\").val()) : 0,\\r\\n                nCdEmpresa: Number($(\\\"#tbnCdEmpresaCadastroVisitanteForum\\\").val()) \\u003e 0 ? Number($(\\\"#tbnCdEmpresaCadastroVisitanteForum\\\").val()) : 0,\\r\\n                sDsCpf: \\\"\\\",\\r\\n                sDsCnpj: \\\"\\\",\\r\\n                sDsRg: $(\\\"#tbRGCadastroVisitanteForum\\\").val(),\\r\\n                sNmVisitante: kendo.htmlEncode($(\\\"#tbNomeCadastroVisitanteForum\\\").val()),\\r\\n                sDsEmail: $(\\\"#tbEmailCadastroVisitanteForum\\\").val(),\\r\\n                sDsTelefone: $(\\\"#tbTelefoneCadastroVisitanteForum\\\").val(),\\r\\n                sDsEndereco: kendo.htmlEncode($(\\\"#tbEnderecoCadastroVisitanteForum\\\").val()),\\r\\n                sNrEndereco: kendo.htmlEncode($(\\\"#tbNumeroCadastroVisitanteForum\\\").val()),\\r\\n                sDsComplemento: kendo.htmlEncode($(\\\"#tbComplementoCadastroVisitanteForum\\\").val()),\\r\\n                sNmBairro: kendo.htmlEncode($(\\\"#tbBairroCadastroVisitanteForum\\\").val()),\\r\\n                sCdCep: $(\\\"#tbCEPCadastroVisitanteForum\\\").val(),\\r\\n                sCdPais: $(\\\"#ddlPaisCadastroVisitanteForum option:selected\\\").val(),\\r\\n                sCdEstado: $(\\\"#ddlEstadoCadastroVisitanteForum option:selected\\\").val(),\\r\\n                nCdCidade: $(\\\"#ddlCidadeCadastroVisitanteForum option:selected\\\").val(),\\r\\n                sDsTipoDocumento: \\\"\\\",\\r\\n                bFlInteresseCertame: $(\\\"input[name=\\u0027InteresseCertameCadastroVisitanteForum\\u0027]:checked\\\").val(),\\r\\n                sNmContato: kendo.htmlEncode($(\\\"#tbContatoCadastroVisitanteForum\\\").val()),\\r\\n                bFlConsentimentoLGPD: $(\\\"#cbConsentimentoLgpdCadastroVisitanteForum\\\").is(\\u0027:checked\\u0027) ? 1 : 0,\\r\\n                dtoAnexo: {\\r\\n                    nCdAnexo: objParametroCadastroVisitanteForum.nCdAnexoClicado,\\r\\n                    nSqAnexo: objParametroCadastroVisitanteForum.nSqAnexoClicado\\r\\n                },\\r\\n                dtoEdital: {\\r\\n                    nCdEdital: objParametroCadastroVisitanteForum.nCdEditalClicado,\\r\\n                    nCdOrigem: objParametroCadastroVisitanteForum.nCdOrigemClicado\\r\\n                },\\r\\n                dtoProcesso: {\\r\\n                    nCdProcesso: objParametroCadastroVisitanteForum.nCdOrigemClicado,\\r\\n                    nCdModulo: objParametroCadastroVisitanteForum.nCdModuloClicado,\\r\\n                    dtoIdioma: {\\r\\n                        nCdIdioma: adquirirIdIdioma(\\\"/\\\")\\r\\n                    }\\r\\n                }\\r\\n            };\\r\\n\\r\\n            if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CNPJ\\\") {\\r\\n                dtoVisitante.sDsTipoDocumento = \\\"CNPJ\\\";\\r\\n\\r\\n                if (adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n                    dtoVisitante.sDsCnpj = $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val().replace(/[^a-z0-9]/gi, \\\"\\\");\\r\\n                else\\r\\n                    dtoVisitante.sDsCnpj = $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val();\\r\\n            }\\r\\n            else if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CPF\\\") {\\r\\n                dtoVisitante.sDsTipoDocumento = \\\"CPF\\\";\\r\\n\\r\\n                if (adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n                    dtoVisitante.sDsCpf = $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val().replace(/[^0-9]/g, \\\"\\\");\\r\\n                else\\r\\n                    dtoVisitante.sDsCpf = $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val();\\r\\n            }\\r\\n        }\\r\\n        else {\\r\\n            dtoVisitante = JSON.parse(dtoVisitante);\\r\\n            dtoVisitante.dtoAnexo.nCdAnexo = objParametroCadastroVisitanteForum.nCdAnexoClicado;\\r\\n            dtoVisitante.dtoAnexo.nSqAnexo = objParametroCadastroVisitanteForum.nSqAnexoClicado;\\r\\n        }\\r\\n\\r\\n        criarCookie(\\\"CK_VISITANTE_TEMP\\\", JSON.stringify(dtoVisitante), \\\"/\\\");\\r\\n\\r\\n        $(\\\"#carregandoSalvarCadastroVisitanteForum\\\").fadeIn();\\r\\n\\r\\n        chamadaWebService(\\r\\n            \\\"WebService/Servicos.asmx/SalvarVisitante\\\",\\r\\n            \\\"dtoVisitante:\\\" + JSON.stringify(dtoVisitante),\\r\\n            function (_retorno) {\\r\\n                var objRetorno = _retorno.d;\\r\\n                if (objRetorno.nCdCodigo \\u003c= 0) {\\r\\n                    Alerta(objRetorno.sDsConteudo, \\\"/\\\");\\r\\n                    $(\\\"#carregandoSalvarCadastroVisitanteForum\\\").fadeOut();\\r\\n                }\\r\\n                else {\\r\\n\\r\\n                    dtoVisitante.nCdVisitante = objRetorno.nCdCodigo;\\r\\n                    dtoVisitante.nCdEndereco = objRetorno.oComplemento;\\r\\n                    criarCookie(\\\"CK_VISITANTE_TEMP\\\", JSON.stringify(dtoVisitante), \\\"/\\\");\\r\\n                    var dtoAnexo;\\r\\n\\r\\n                    switch (objParametroCadastroVisitanteForum.nIdFormularioValidacao) {\\r\\n                        case \\\"uc_MuralDetalheForum\\\":\\r\\n                            $(\\\"#tbnCdVisitanteCadastroVisitanteForum\\\").val(objRetorno.nCdCodigo);\\r\\n                            MuralDetalheForum_EnviarMensagem(objParametroCadastroVisitanteForum.nCdMensagemClicado);\\r\\n                            btCadastroVisitanteVoltar_ClickCadastroVisitanteForum();\\r\\n                            break;\\r\\n                        case \\\"uc_MuralDetalheAnexo\\\":\\r\\n                            var oAnexoClicado = $.grep(objParametroCadastroVisitanteForum.arrAnexos, function (a) { return (a.nCdAnexo == objParametroCadastroVisitanteForum.nCdAnexoClicado \\u0026\\u0026 a.nSqAnexo == objParametroCadastroVisitanteForum.nSqAnexoClicado); })[0];\\r\\n\\r\\n                            var sLocal = \\\"EditalAnexos\\\";\\r\\n                            if (objParametroCadastroVisitanteForum.nCdModuloClicado == MURAL.MODULO.Cotacao\\r\\n                                \\u0026\\u0026 objParametroCadastroVisitanteForum.nCdOrigemClicado != -2147483648) {\\r\\n                                sLocal = \\\"CotacaoAnexos\\\";\\r\\n                            }\\r\\n\\r\\n                            if (objParametroCadastroVisitanteForum.nCdModuloClicado == MURAL.MODULO.Credenciamento) {\\r\\n                                if (objRetorno.nCdOrigem != -2147483648)\\r\\n                                    sLocal = \\\"EditalCredenciamentoAnexo\\\";\\r\\n                                else\\r\\n                                    sLocal = \\\"EditalAnexos\\\";\\r\\n                            }\\r\\n                            if (objParametroCadastroVisitanteForum.nCdModuloClicado == MURAL.MODULO.Licitacao\\r\\n                                \\u0026\\u0026 objParametroCadastroVisitanteForum.nCdOrigemClicado != -2147483648) {\\r\\n                                sLocal = \\\"Licitacao/Anexo\\\";\\r\\n                            }\\r\\n\\r\\n                            dtoAnexo = {\\r\\n                                sNmLocalAnexo: sLocal,\\r\\n                                sNmArquivo: oAnexoClicado.sNmArquivo\\r\\n                            }\\r\\n                            break;\\r\\n                        case \\\"uc_MuralDetalheAnexoProposta\\\":\\r\\n                        case \\\"uc_MuralDetalheAnexoLance\\\":\\r\\n                        case \\\"uc_MuralDetalheAnexoNegociacao\\\":\\r\\n                            var oAnexoClicado;\\r\\n                            var i = 0;\\r\\n                            while (oAnexoClicado == undefined) {\\r\\n                                oAnexoClicado = $.grep(objParametroCadastroVisitanteForum.arrAnexos[i].items, function (a) { return (a.nCdAnexo == objParametroCadastroVisitanteForum.nCdAnexoClicado \\u0026\\u0026 a.nSqAnexo == objParametroCadastroVisitanteForum.nSqAnexoClicado); })[0];\\r\\n                                i++;\\r\\n                            }\\r\\n                            var sLocal = \\\"PregaoEletronico\\\";\\r\\n                            if (objParametroCadastroVisitanteForum.nCdModuloClicado == MURAL.MODULO.Licitacao\\r\\n                                \\u0026\\u0026 objParametroCadastroVisitanteForum.nCdOrigemClicado != -2147483648) {\\r\\n                                sLocal = \\\"Licitacao/AnexoPropostaComercial/\\\";\\r\\n                            }\\r\\n                            dtoAnexo = {\\r\\n                                sNmLocalAnexo: sLocal,\\r\\n                                sNmArquivo: oAnexoClicado.sNmArquivo\\r\\n                            }\\r\\n                            break;\\r\\n                        case \\\"uc_MuralDetalheAnexoHabilitacao\\\":\\r\\n                            var oAnexoClicado;\\r\\n                            var i = 0;\\r\\n                            while (oAnexoClicado == undefined) {\\r\\n                                oAnexoClicado = $.grep(objParametroCadastroVisitanteForum.arrAnexos[i].items, function (a) { return (a.nCdAnexo == objParametroCadastroVisitanteForum.nCdAnexoClicado \\u0026\\u0026 a.nSqAnexo == objParametroCadastroVisitanteForum.nSqAnexoClicado); })[0];\\r\\n                                i++;\\r\\n                            }\\r\\n                            var sLocal = \\\"PregaoEletronico\\\";\\r\\n                            if (objParametroCadastroVisitanteForum.nCdModuloClicado == MURAL.MODULO.Licitacao\\r\\n                                \\u0026\\u0026 objParametroCadastroVisitanteForum.nCdOrigemClicado != -2147483648) {\\r\\n                                sLocal = \\\"Licitacao/AnexoHabilitacao/\\\";\\r\\n                            }\\r\\n                            dtoAnexo = {\\r\\n                                sNmLocalAnexo: sLocal,\\r\\n                                sNmArquivo: oAnexoClicado.sNmArquivo\\r\\n                            }\\r\\n                            break;\\r\\n                        case \\\"uc_MuralDetalheAnexoRecurso\\\":\\r\\n                            var oAnexoClicado = $.grep(objParametroCadastroVisitanteForum.arrAnexos, function (a) { return (a.nCdAnexo == objParametroCadastroVisitanteForum.nCdAnexoClicado \\u0026\\u0026 a.nSqAnexo == objParametroCadastroVisitanteForum.nSqAnexoClicado); })[0];\\r\\n\\r\\n                            var sLocal = \\\"PregaoEletronico/Recursos\\\";\\r\\n\\r\\n                            if (objParametroCadastroVisitanteForum.nCdModuloClicado == MURAL.MODULO.Licitacao\\r\\n                                \\u0026\\u0026 objParametroCadastroVisitanteForum.nCdOrigemClicado != -2147483648) {\\r\\n                                sLocal = \\\"Licitacao/AnexoRecurso/\\\";\\r\\n                            }\\r\\n                            dtoAnexo = {\\r\\n                                sNmLocalAnexo: sLocal,\\r\\n                                sNmArquivo: oAnexoClicado.sNmArquivo\\r\\n                            }\\r\\n                            break;\\r\\n                        case \\\"uc_MuralDetalheAnexoContraRazoes\\\":\\r\\n                            var oAnexoClicado = $.grep(objParametroCadastroVisitanteForum.arrAnexos, function (a) { return (a.nCdAnexo == objParametroCadastroVisitanteForum.nCdAnexoClicado \\u0026\\u0026 a.nSqAnexo == objParametroCadastroVisitanteForum.nSqAnexoClicado); })[0];\\r\\n\\r\\n                            var sLocal = \\\"PregaoEletronico/Recursos\\\";\\r\\n\\r\\n                            if (objParametroCadastroVisitanteForum.nCdModuloClicado == MURAL.MODULO.Licitacao\\r\\n                                \\u0026\\u0026 objParametroCadastroVisitanteForum.nCdOrigemClicado != -2147483648) {\\r\\n                                sLocal = \\\"Licitacao/AnexoRecursoContrarrazao/\\\";\\r\\n                            }\\r\\n                            dtoAnexo = {\\r\\n                                sNmLocalAnexo: sLocal,\\r\\n                                sNmArquivo: oAnexoClicado.sNmArquivo\\r\\n                            }\\r\\n                            break;\\r\\n                        case \\\"uc_MuralDetalheAnexoParecer\\\":\\r\\n                            var oAnexoClicado = $.grep(objParametroCadastroVisitanteForum.arrAnexos, function (a) { return (a.nCdAnexo == objParametroCadastroVisitanteForum.nCdAnexoClicado \\u0026\\u0026 a.nSqAnexo == objParametroCadastroVisitanteForum.nSqAnexoClicado); })[0];\\r\\n\\r\\n                            var sLocal = \\\"PregaoEletronico/Recursos\\\";\\r\\n\\r\\n                            if (objParametroCadastroVisitanteForum.nCdModuloClicado == MURAL.MODULO.Licitacao\\r\\n                                \\u0026\\u0026 objParametroCadastroVisitanteForum.nCdOrigemClicado != -2147483648) {\\r\\n                                sLocal = \\\"Licitacao/AnexoRecursoParecer/\\\";\\r\\n                            }\\r\\n                            dtoAnexo = {\\r\\n                                sNmLocalAnexo: sLocal,\\r\\n                                sNmArquivo: oAnexoClicado.sNmArquivo\\r\\n                            }\\r\\n                            break;\\r\\n                    }\\r\\n\\r\\n                    if (objParametroCadastroVisitanteForum.nIdFormularioValidacao != \\u0027uc_MuralDetalheForum\\u0027) {\\r\\n                        chamadaWebService(\\r\\n                            \\\"WebService/Servicos.asmx/AnexoExiste\\\",\\r\\n                            \\\"dtoAnexo:\\\" + JSON.stringify(dtoAnexo),\\r\\n                            function (_retorno) {\\r\\n                                if (_retorno.d != \\\"\\\") {\\r\\n                                    Alerta(_retorno.d, \\\"/\\\");\\r\\n                                    btCadastroVisitanteVoltar_ClickCadastroVisitanteForum();\\r\\n                                }\\r\\n                                else {\\r\\n                                    window.open(\\\"Download.aspx\\\" + oAnexoClicado.sDsParametroCriptografado, \\\"_self\\\");\\r\\n                                    btCadastroVisitanteVoltar_ClickCadastroVisitanteForum();\\r\\n                                }\\r\\n                            },\\r\\n                        );\\r\\n                    }\\r\\n                }\\r\\n            },\\r\\n            function () {\\r\\n                Alerta(\\\"Não foi possível recuperar os dados desse registro!\\\", \\\"/\\\");\\r\\n                btCadastroVisitanteVoltar_ClickCadastroVisitanteForum();\\r\\n            }\\r\\n        );\\r\\n\\r\\n    }\\r\\n    function SalvarEmpresaCadastroVisitanteForum() {\\r\\n        var dtoVisitante = adquirirCookie(\\\"CK_VISITANTE_TEMP\\\", \\\"/\\\");\\r\\n\\r\\n        if (dtoVisitante == \\\"\\\") {\\r\\n            dtoVisitante = {\\r\\n                nCdVisitante: Number($(\\\"#tbnCdVisitanteCadastroVisitanteForum\\\").val()) \\u003e 0 ? Number($(\\\"#tbnCdVisitanteCadastroVisitanteForum\\\").val()) : 0,\\r\\n                nCdEndereco: Number($(\\\"#tbnCdEnderecoCadastroVisitanteForum\\\").val()) \\u003e 0 ? Number($(\\\"#tbnCdEnderecoCadastroVisitanteForum\\\").val()) : 0,\\r\\n                nCdEmpresa: Number($(\\\"#tbnCdEmpresaCadastroVisitanteForum\\\").val()) \\u003e 0 ? Number($(\\\"#tbnCdEmpresaCadastroVisitanteForum\\\").val()) : 0,\\r\\n                sDsCpf: \\\"\\\",\\r\\n                sDsCnpj: \\\"\\\",\\r\\n                sDsRg: $(\\\"#tbRGCadastroVisitanteForum\\\").val(),\\r\\n                sNmVisitante: kendo.htmlEncode($(\\\"#tbNomeCadastroVisitanteForum\\\").val()),\\r\\n                sDsEmail: $(\\\"#tbEmailCadastroVisitanteForum\\\").val(),\\r\\n                sDsTelefone: $(\\\"#tbTelefoneCadastroVisitanteForum\\\").val(),\\r\\n                sDsEndereco: kendo.htmlEncode($(\\\"#tbEnderecoCadastroVisitanteForum\\\").val()),\\r\\n                sNrEndereco: kendo.htmlEncode($(\\\"#tbNumeroCadastroVisitanteForum\\\").val()),\\r\\n                sDsComplemento: kendo.htmlEncode($(\\\"#tbComplementoCadastroVisitanteForum\\\").val()),\\r\\n                sNmBairro: kendo.htmlEncode($(\\\"#tbBairroCadastroVisitanteForum\\\").val()),\\r\\n                sCdCep: $(\\\"#tbCEPCadastroVisitanteForum\\\").val(),\\r\\n                sCdPais: $(\\\"#ddlPaisCadastroVisitanteForum option:selected\\\").val(),\\r\\n                sCdEstado: $(\\\"#ddlEstadoCadastroVisitanteForum option:selected\\\").val(),\\r\\n                nCdCidade: $(\\\"#ddlCidadeCadastroVisitanteForum option:selected\\\").val(),\\r\\n                sDsTipoDocumento: \\\"\\\",\\r\\n                bFlInteresseCertame: $(\\\"input[name=\\u0027InteresseCertameCadastroVisitanteForum\\u0027]:checked\\\").val(),\\r\\n                sNmContato: kendo.htmlEncode($(\\\"#tbContatoCadastroVisitanteForum\\\").val()),\\r\\n                bFlConsentimentoLGPD: $(\\\"#cbConsentimentoLgpdCadastroVisitanteForum\\\").is(\\u0027:checked\\u0027) ? 1 : 0,\\r\\n                dtoAnexo: {\\r\\n                    nCdAnexo: objParametroCadastroVisitanteForum.nCdAnexoClicado,\\r\\n                    nSqAnexo: objParametroCadastroVisitanteForum.nSqAnexoClicado\\r\\n                },\\r\\n                dtoEdital: {\\r\\n                    nCdEdital: objParametroCadastroVisitanteForum.nCdEditalClicado,\\r\\n                    nCdOrigem: objParametroCadastroVisitanteForum.nCdOrigemClicado\\r\\n                },\\r\\n                dtoProcesso: {\\r\\n                    nCdProcesso: objParametroCadastroVisitanteForum.nCdOrigemClicado,\\r\\n                    nCdModulo: objParametroCadastroVisitanteForum.nCdModuloClicado,\\r\\n                    dtoIdioma: {\\r\\n                        nCdIdioma: adquirirIdIdioma(\\\"/\\\")\\r\\n                    }\\r\\n                }\\r\\n            };\\r\\n\\r\\n            if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CNPJ\\\") {\\r\\n                dtoVisitante.sDsTipoDocumento = \\\"CNPJ\\\";\\r\\n\\r\\n                if (adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n                    dtoVisitante.sDsCnpj = $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val().replace(/[^a-z0-9]/gi, \\\"\\\");\\r\\n                else\\r\\n                    dtoVisitante.sDsCnpj = $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val();\\r\\n            }\\r\\n            else if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CPF\\\") {\\r\\n                dtoVisitante.sDsTipoDocumento = \\\"CPF\\\";\\r\\n\\r\\n                if (adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n                    dtoVisitante.sDsCpf = $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val().replace(/[^0-9]/g, \\\"\\\");\\r\\n                else\\r\\n                    dtoVisitante.sDsCpf = $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val();\\r\\n            }\\r\\n        }\\r\\n        else {\\r\\n            dtoVisitante = JSON.parse(dtoVisitante);\\r\\n            dtoVisitante.dtoAnexo.nCdAnexo = objParametroCadastroVisitanteForum.nCdAnexoClicado;\\r\\n            dtoVisitante.dtoAnexo.nSqAnexo = objParametroCadastroVisitanteForum.nSqAnexoClicado;\\r\\n        }\\r\\n        let checkbox = $(\\u0027#cbPreCadastroCadastroVisitanteForum\\u0027);\\r\\n        if (checkbox.is(\\\":checked\\\")) {\\r\\n            chamadaWebService(\\r\\n                \\\"WebService/Servicos.asmx/SalvarEmpresa\\\",\\r\\n                \\\"dtoVisitante:\\\" + JSON.stringify(dtoVisitante),\\r\\n\\r\\n                function (_retorno) {\\r\\n                    if (_retorno.d == 1) {\\r\\n                        Alerta(\\\"Pré-cadastro realizado com sucesso.\\\", \\\"/\\\");\\r\\n                        btCadastroVisitanteVoltar_ClickCadastroVisitanteForum();\\r\\n                    }\\r\\n                    else {\\r\\n                        Alerta(\\\"CNPJ já cadastrado no sistema.\\\", \\\"/\\\");\\r\\n                        btCadastroVisitanteVoltar_ClickCadastroVisitanteForum();\\r\\n                    }\\r\\n                },\\r\\n            );\\r\\n        }\\r\\n    }\\r\\n\\r\\n\\r\\n    function btCadastroVisitanteVoltar_ClickCadastroVisitanteForum() {\\r\\n        reiniciaFormularioCadastroVisitanteForum(false);\\r\\n        objParametroCadastroVisitanteForum.nCdAnexoClicado = 0;\\r\\n        objParametroCadastroVisitanteForum.nCdMensagemClicado = 0;\\r\\n        objParametroCadastroVisitanteForum.frmValidacao = undefined;\\r\\n\\r\\n        $(\\\"#carregandoSalvarCadastroVisitanteForum\\\").fadeOut();\\r\\n\\r\\n        $(\\\"#painelCadastroCadastroVisitanteForum\\\").animate({ opacity: 0 }, 300, function () {\\r\\n            $(\\\"#painelCadastroCadastroVisitanteForum\\\").hide();\\r\\n            $(sNmGridCadastroVisitanteForum).show();\\r\\n            $(sNmGridCadastroVisitanteForum).animate({ opacity: 1 }, 300, function () { });\\r\\n        });\\r\\n    }\\r\\n\\r\\n    function btCadastroVisitanteConfirmar_ClickCadastroVisitanteForum() {\\r\\n        if (!$(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteForum\\\").hasClass(\\\"desativado\\\")) {\\r\\n            if ($(\\\"#\\\" + objParametroCadastroVisitanteForum.nIdFormularioValidacao).valid()) {\\r\\n\\r\\n                if (!validarConsentimentoLGPDCadastroVisitanteForum()) {\\r\\n                    return;\\r\\n                }\\r\\n\\r\\n                SalvarVisitanteCadastroVisitanteForum();\\r\\n                SalvarEmpresaCadastroVisitanteForum();\\r\\n            }\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function validarConsentimentoLGPDCadastroVisitanteForum() {\\r\\n        try {\\r\\n            var divLgpd = $(\\u0027#divConsentimentoLgpdCadastroVisitanteForum\\u0027);\\r\\n            var divErro = $(\\u0027#divErroLgpdCadastroVisitanteForum\\u0027);\\r\\n\\r\\n            if (divLgpd.length \\u003e 0 \\u0026\\u0026 divLgpd.is(\\u0027:visible\\u0027)) {\\r\\n                var checkbox = $(\\u0027#cbConsentimentoLgpdCadastroVisitanteForum\\u0027);\\r\\n\\r\\n                if (checkbox.length \\u003e 0 \\u0026\\u0026 !checkbox.is(\\u0027:checked\\u0027)) {\\r\\n                    divErro.show();\\r\\n                    checkbox.focus();\\r\\n                    return false;\\r\\n                } else {\\r\\n                    divErro.hide();\\r\\n                }\\r\\n            } else {\\r\\n                divErro.hide();\\r\\n            }\\r\\n            return true;\\r\\n        } catch (e) {\\r\\n            return true;\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function rbVisitanteTipoDocumento_ClickCadastroVisitanteForum() {\\r\\n        reiniciaFormularioCadastroVisitanteForum(true);\\r\\n\\r\\n        $(\\\"#tbDocumentoCadastroVisitanteForum\\\").unmask();\\r\\n\\r\\n        if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CNPJ\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteForum\\\").mask(\\\"**.***.***/****-**\\\");\\r\\n        else if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CPF\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteForum\\\").mask(\\\"999.999.999-99\\\");\\r\\n\\r\\n        // Configurar campos baseado no JSON apÃ³s um pequeno delay\\r\\n        setTimeout(function() {\\r\\n            try {\\r\\n                var tipoSelecionado = $(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val();\\r\\n\\r\\n                if (tipoSelecionado) {\\r\\n                    var valorTipo = tipoSelecionado === \\u0027CPF\\u0027 ? \\u00271\\u0027 : \\u00272\\u0027;\\r\\n                    configurarCamposPorTipoCadastroVisitanteForum(valorTipo);\\r\\n                    configurarVisibilidadeLGPDCadastroVisitanteForum();\\r\\n                }\\r\\n            } catch (e) {\\r\\n                console.error(\\u0027Erro ao configurar campos por tipo:\\u0027, e);\\r\\n            }\\r\\n        }, 100);\\r\\n    }\\r\\n\\r\\n    function tbDocumento_OnBlurCadastroVisitanteForum() {\\r\\n\\r\\n        if ($(\\\"#painelCadastroCadastroVisitanteForum input:radio\\\").parent().hasClass(\\\"checked\\\")) {\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteForum\\\").unmask();\\r\\n\\r\\n            if ($(\\\"#tbDocumentoCadastroVisitanteForum\\\").val() != \\\"\\\") {\\r\\n\\r\\n                var dtoVisitante = { sDsCpf: \\\"\\\", sDsCnpj: \\\"\\\", sDsTipoDocumento: \\\"\\\" };\\r\\n\\r\\n                if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CNPJ\\\") {\\r\\n                    dtoVisitante.sDsTipoDocumento = \\\"CNPJ\\\";\\r\\n\\r\\n                    if (adquirirIdIdioma(\\\"/\\\") == \\\"1\\\") {\\r\\n                        dtoVisitante.sDsCnpj = $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val().replace(/[^a-z0-9]/gi, \\\"\\\");\\r\\n                        $(\\\"#tbDocumentoCadastroVisitanteForum\\\").mask(\\\"**.***.***/****-**\\\");\\r\\n                    }\\r\\n                    else\\r\\n                        dtoVisitante.sDsCnpj = $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val();\\r\\n                }\\r\\n                else if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CPF\\\") {\\r\\n                    dtoVisitante.sDsTipoDocumento = \\\"CPF\\\";\\r\\n\\r\\n                    if (adquirirIdIdioma(\\\"/\\\") == \\\"1\\\") {\\r\\n                        dtoVisitante.sDsCpf = $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val().replace(/[^0-9]/g, \\\"\\\");\\r\\n                        $(\\\"#tbDocumentoCadastroVisitanteForum\\\").mask(\\\"999.999.999-99\\\");\\r\\n                    }\\r\\n                    else\\r\\n                        dtoVisitante.sDsCpf = $(\\\"#tbDocumentoCadastroVisitanteForum\\\").val();\\r\\n                }\\r\\n            }\\r\\n            else {\\r\\n                $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteForum\\\").removeClass(\\\"desativado\\\");\\r\\n                $(\\\"#carregandoSalvarCadastroVisitanteForum\\\").fadeOut();\\r\\n            }\\r\\n        }\\r\\n        else {\\r\\n            $(\\\"#btCadastroVisitanteConfirmarCadastroVisitanteForum\\\").removeClass(\\\"desativado\\\");\\r\\n            $(\\\"#carregandoSalvarCadastroVisitanteForum\\\").fadeOut();\\r\\n        }\\r\\n    }\\r\\n\\r\\n    function desabilitarCpfCadastroVisitanteForum() {\\r\\n\\r\\n        reiniciaFormularioCadastroVisitanteForum(true);\\r\\n\\r\\n        $(\\\"#tbDocumentoCadastroVisitanteForum\\\").unmask();\\r\\n\\r\\n        if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CNPJ\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteForum\\\").mask(\\\"**.***.***/****-**\\\");\\r\\n        else if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CPF\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteForum\\\").mask(\\\"999.999.999-99\\\");\\r\\n    }\\r\\n\\r\\n    function desabilitarBotoesCertameCadastroVisitanteForum() {\\r\\n\\r\\n        reiniciaFormularioCadastroVisitanteForum(true);\\r\\n\\r\\n        $(\\\"#tbDocumentoCadastroVisitanteForum\\\").unmask();\\r\\n\\r\\n        if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CNPJ\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteForum\\\").mask(\\\"**.***.***/****-**\\\");\\r\\n        else if ($(\\\"input[name=\\u0027documentoCadastroVisitanteForum\\u0027]:checked\\\").val() == \\\"CPF\\\" \\u0026\\u0026 adquirirIdIdioma(\\\"/\\\") == \\\"1\\\")\\r\\n            $(\\\"#tbDocumentoCadastroVisitanteForum\\\").mask(\\\"999.999.999-99\\\");\\r\\n    }\\r\\n\\r\\n    // FunÃ§Ã£o para configurar campos baseado no JSON\\r\\n    function configurarCamposJsonCadastroVisitanteForum() {\\r\\n        try {\\r\\n            if (!objJsonConfigCamposCadastroVisitanteForum) {\\r\\n                return;\\r\\n            }\\r\\n\\r\\n            var tipoSelecionado = $(\\u0027input[name=\\\"documentoCadastroVisitanteForum\\\"]:checked\\u0027).val();\\r\\n            if (!tipoSelecionado) {\\r\\n                $(\\u0027#rbCPFCadastroVisitanteForum\\u0027).prop(\\u0027checked\\u0027, true);\\r\\n                tipoSelecionado = \\u0027CPF\\u0027;\\r\\n            }\\r\\n\\r\\n            if (tipoSelecionado) {\\r\\n                var tipoConvertido = tipoSelecionado === \\u0027CPF\\u0027 ? \\u00271\\u0027 : \\u00272\\u0027;\\r\\n                configurarCamposPorTipoCadastroVisitanteForum(tipoConvertido);\\r\\n            }\\r\\n\\r\\n        } catch (e) {\\r\\n            console.error(\\u0027Erro ao configurar campos JSON:\\u0027, e);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    // FunÃ§Ã£o para configurar campos por tipo (CPF/CNPJ)\\r\\n    function configurarCamposPorTipoCadastroVisitanteForum(sTipoPessoa) {\\r\\n        try {\\r\\n            if (!objJsonConfigCamposCadastroVisitanteForum || typeof objJsonConfigCamposCadastroVisitanteForum !== \\u0027object\\u0027) {\\r\\n                return;\\r\\n            }\\r\\n\\r\\n            var config = null;\\r\\n            if (sTipoPessoa === \\u00271\\u0027) {\\r\\n                config = objJsonConfigCamposCadastroVisitanteForum.pessoaFisica;\\r\\n\\r\\n            } else if (sTipoPessoa === \\u00272\\u0027) {\\r\\n                config = objJsonConfigCamposCadastroVisitanteForum.pessoaJuridica;\\r\\n            }\\r\\n\\r\\n            if (!config) {\\r\\n                return;\\r\\n            }\\r\\n\\r\\n            var temContato = config.camposObrigatorios \\u0026\\u0026 config.camposObrigatorios.some(function(campo) {\\r\\n                return campo.toLowerCase() === \\u0027contato\\u0027 || campo.toLowerCase() === \\u0027nomecontato\\u0027;\\r\\n            });\\r\\n\\r\\n            // Mapeamento dos campos para containers no formulÃ¡rio\\r\\n            var mapeamentoCampos = {\\r\\n                \\u0027nome\\u0027: \\u0027#spanNomeCadastroVisitanteForum\\u0027,\\r\\n                \\u0027razaosocial\\u0027: \\u0027#spanNomeCadastroVisitanteForum\\u0027,\\r\\n                \\u0027rg\\u0027: \\u0027#spanRGCadastroVisitanteForum\\u0027,\\r\\n                \\u0027email\\u0027: { elemento: \\u0027#tbEmailCadastroVisitanteForum\\u0027, container: \\u0027.span3\\u0027 },\\r\\n                \\u0027telefone\\u0027: { elemento: \\u0027#tbTelefoneCadastroVisitanteForum\\u0027, container: \\u0027.span2\\u0027 },\\r\\n                \\u0027contato\\u0027: \\u0027#divContatoCadastroVisitanteForum\\u0027,\\r\\n                \\u0027endereco\\u0027: \\u0027#divEnderecoCadastroVisitanteForum\\u0027,\\r\\n                \\u0027numero\\u0027: \\u0027#divNumeroCadastroVisitanteForum\\u0027,\\r\\n                \\u0027complemento\\u0027: { elemento: \\u0027#tbComplementoCadastroVisitanteForum\\u0027, container: \\u0027.span5\\u0027 },\\r\\n                \\u0027bairro\\u0027: { elemento: \\u0027#tbBairroCadastroVisitanteForum\\u0027, container: \\u0027.span5\\u0027 },\\r\\n                \\u0027cep\\u0027: { elemento: \\u0027#tbCEPCadastroVisitanteForum\\u0027, container: \\u0027.span2\\u0027 },\\r\\n                \\u0027pais\\u0027: { elemento: \\u0027#ddlPaisCadastroVisitanteForum\\u0027, container: \\u0027.span4\\u0027 },\\r\\n                \\u0027estado\\u0027: { elemento: \\u0027#ddlEstadoCadastroVisitanteForum\\u0027, container: \\u0027.span4\\u0027 },\\r\\n                \\u0027cidade\\u0027: { elemento: \\u0027#ddlCidadeCadastroVisitanteForum\\u0027, container: \\u0027.span4\\u0027 }\\r\\n            };\\r\\n\\r\\n            // Lista de todos os campos controlÃ¡veis\\r\\n            var todosCampos = [\\r\\n                \\u0027#spanRGCadastroVisitanteForum\\u0027,\\r\\n                { elemento: \\u0027#tbEmailCadastroVisitanteForum\\u0027, container: \\u0027.span3\\u0027 },\\r\\n                { elemento: \\u0027#tbTelefoneCadastroVisitanteForum\\u0027, container: \\u0027.span2\\u0027 },\\r\\n                \\u0027#divContatoCadastroVisitanteForum\\u0027,\\r\\n                \\u0027#divEnderecoCadastroVisitanteForum\\u0027,\\r\\n                \\u0027#divNumeroCadastroVisitanteForum\\u0027,\\r\\n                { elemento: \\u0027#tbComplementoCadastroVisitanteForum\\u0027, container: \\u0027.span5\\u0027 },\\r\\n                { elemento: \\u0027#tbBairroCadastroVisitanteForum\\u0027, container: \\u0027.span5\\u0027 },\\r\\n                { elemento: \\u0027#tbCEPCadastroVisitanteForum\\u0027, container: \\u0027.span2\\u0027 },\\r\\n                { elemento: \\u0027#ddlPaisCadastroVisitanteForum\\u0027, container: \\u0027.span4\\u0027 },\\r\\n                { elemento: \\u0027#ddlEstadoCadastroVisitanteForum\\u0027, container: \\u0027.span4\\u0027 },\\r\\n                { elemento: \\u0027#ddlCidadeCadastroVisitanteForum\\u0027, container: \\u0027.span4\\u0027 }\\r\\n            ];\\r\\n\\r\\n            // Ocultar todos os campos primeiro\\r\\n            todosCampos.forEach(function(campo) {\\r\\n                if (typeof campo === \\u0027string\\u0027) {\\r\\n                    $(campo).hide();\\r\\n                } else {\\r\\n                    var elemento = $(campo.elemento);\\r\\n                    if (elemento.length \\u003e 0) {\\r\\n                        var containerParaOcultar = elemento.closest(campo.container);\\r\\n                        if (containerParaOcultar.length \\u003e 0) {\\r\\n                            containerParaOcultar.hide();\\r\\n                        }\\r\\n                    }\\r\\n                }\\r\\n            });\\r\\n\\r\\n            // Mostrar apenas os campos obrigatÃ³rios\\r\\n            if (config.camposObrigatorios \\u0026\\u0026 config.camposObrigatorios.length \\u003e 0) {\\r\\n                config.camposObrigatorios.forEach(function(campoConfig) {\\r\\n                    var campoLowerCase = campoConfig.toLowerCase();\\r\\n                    var mapeamento = mapeamentoCampos[campoLowerCase];\\r\\n\\r\\n                    if (campoLowerCase === \\u0027nome\\u0027 || campoLowerCase === \\u0027razaosocial\\u0027) {\\r\\n                        $(\\u0027#spanNomeCadastroVisitanteForum\\u0027).show();\\r\\n                        return;\\r\\n                    }\\r\\n\\r\\n                    if (typeof mapeamento === \\u0027string\\u0027) {\\r\\n                        $(mapeamento).show();\\r\\n                    } else if (typeof mapeamento === \\u0027object\\u0027) {\\r\\n                        var elemento = $(mapeamento.elemento);\\r\\n                        if (elemento.length \\u003e 0) {\\r\\n                            var containerParaMostrar = elemento.closest(mapeamento.container);\\r\\n                            if (containerParaMostrar.length \\u003e 0) {\\r\\n                                containerParaMostrar.show();\\r\\n                            }\\r\\n                        }\\r\\n                    }\\r\\n                });\\r\\n\\r\\n                // Sempre garantir que Nome esteja visÃ­vel\\r\\n                $(\\u0027#spanNomeCadastroVisitanteForum\\u0027).show();\\r\\n\\r\\n                // VerificaÃ§Ã£o final especÃ­fica para o campo Contato\\r\\n                var contatoConfigurado = config.camposObrigatorios \\u0026\\u0026 config.camposObrigatorios.some(function(campo) {\\r\\n                    var c = campo.toLowerCase();\\r\\n                    return c === \\u0027contato\\u0027 || c === \\u0027nomecontato\\u0027;\\r\\n                });\\r\\n\\r\\n                if (!contatoConfigurado) {\\r\\n                    $(\\u0027#divContatoCadastroVisitanteForum\\u0027).hide();\\r\\n                    console.log(\\u0027Campo Contato forÃ§adamente oculto pois nÃ£o estÃ¡ na configuraÃ§Ã£o JSON\\u0027);\\r\\n                } else {\\r\\n                    $(\\u0027#divContatoCadastroVisitanteForum\\u0027).show();\\r\\n                    console.log(\\u0027Campo Contato exibido conforme configuraÃ§Ã£o JSON\\u0027);\\r\\n                }\\r\\n\\r\\n            } else {\\r\\n                // Se nÃ£o hÃ¡ configuraÃ§Ã£o JSON, mostrar todos os campos (comportamento padrÃ£o)\\r\\n                todosCampos.forEach(function(campo) {\\r\\n                    if (typeof campo === \\u0027string\\u0027) {\\r\\n                        $(campo).show();\\r\\n                    } else {\\r\\n                        var elemento = $(campo.elemento);\\r\\n                        if (elemento.length \\u003e 0) {\\r\\n                            var containerParaMostrar = elemento.closest(campo.container);\\r\\n                            if (containerParaMostrar.length \\u003e 0) {\\r\\n                                containerParaMostrar.show();\\r\\n                            }\\r\\n                        }\\r\\n                    }\\r\\n                });\\r\\n                $(\\u0027#spanNomeCadastroVisitanteForum\\u0027).show();\\r\\n            }\\r\\n\\r\\n        } catch (e) {\\r\\n            console.error(\\u0027Erro na configuraÃ§Ã£o de campos por tipo:\\u0027, e);\\r\\n        }\\r\\n    }\\r\\n\\r\\n    // FunÃ§Ã£o para configurar visibilidade do LGPD\\r\\n    function configurarVisibilidadeLGPDCadastroVisitanteForum() {\\r\\n        try {\\r\\n            var tipoSelecionado = $(\\u0027input[name=\\\"documentoCadastroVisitanteForum\\\"]:checked\\u0027).val();\\r\\n            var mostrarLGPD = false;\\r\\n\\r\\n            if (!tipoSelecionado) {\\r\\n                $(\\u0027#divConsentimentoLgpdCadastroVisitanteForum\\u0027).hide();\\r\\n                $(\\u0027#cbConsentimentoLgpdCadastroVisitanteForum\\u0027).prop(\\u0027checked\\u0027, false);\\r\\n                return;\\r\\n            }\\r\\n\\r\\n            var exigirLGPDPorPadrao = $(\\u0027#painelCadastroCadastroVisitanteForum\\u0027).data(\\u0027exigirLgpd\\u0027);\\r\\n            if (exigirLGPDPorPadrao === true \\u0026\\u0026 \\\"CadastroVisitanteForum\\\" === \\\"CadastroVisitanteForum\\\") {\\r\\n                if (tipoSelecionado === \\u0027CPF\\u0027) {\\r\\n                    mostrarLGPD = true;\\r\\n                }\\r\\n            }\\r\\n\\r\\n            else if (objJsonConfigCamposCadastroVisitanteForum \\u0026\\u0026 tipoSelecionado) {\\r\\n                var config = null;\\r\\n                if (tipoSelecionado === \\u0027CPF\\u0027) {\\r\\n                    config = objJsonConfigCamposCadastroVisitanteForum.pessoaFisica;\\r\\n                } else if (tipoSelecionado === \\u0027CNPJ\\u0027) {\\r\\n                    config = objJsonConfigCamposCadastroVisitanteForum.pessoaJuridica;\\r\\n                }\\r\\n\\r\\n                if (config \\u0026\\u0026 config.exigirConsentimentoLGPD !== undefined) {\\r\\n                    mostrarLGPD = config.exigirConsentimentoLGPD;\\r\\n                }\\r\\n            } else if (typeof bFlExibirCheckboxLgpdCadastroVisitanteForum !== \\u0027undefined\\u0027) {\\r\\n                mostrarLGPD = bFlExibirCheckboxLgpdCadastroVisitanteForum;\\r\\n            }\\r\\n\\r\\n            var divLgpd = $(\\u0027#divConsentimentoLgpdCadastroVisitanteForum\\u0027);\\r\\n            if (divLgpd.length \\u003e 0) {\\r\\n                if (mostrarLGPD) {\\r\\n                    divLgpd.show();\\r\\n                } else {\\r\\n                    divLgpd.hide();\\r\\n                    $(\\u0027#cbConsentimentoLgpdCadastroVisitanteForum\\u0027).prop(\\u0027checked\\u0027, false);\\r\\n                }\\r\\n            }\\r\\n\\r\\n        } catch (e) {\\r\\n        }\\r\\n    }\\r\\n\\r\\n\\u003c/script\\u003e\\r\\n\\r\\n\\r\\n\\r\\n\\u003cdiv id=\\\"divDetalheForumMensagem\\\" style=\\\"display:none;\\\"\\u003e\\r\\n    \\u003cdiv id=\\\"carregandoDetalheForumMensagem\\\" class=\\\"carregandoDados\\\" style=\\\"display:none\\\"; \\u003e\\u003cimg src=\\\"Imagens/carregando.gif\\\" /\\u003e\\u003c/div\\u003e\\r\\n\\u003c/div\\u003e\\r\\n\\r\\n\\u003cscript type=\\\"text/javascript\\\"\\u003e\\r\\n    //Todos os objetos com  o nome dinâmico são a partir do userControl de Cadastro de visitante, pois este é usado por outras telas a partir de agora.\\r\\n    var objParametroCadastroVisitanteForum;\\r\\n    var objDadosTopicoClicado = { nCdMensagem: 0, sDsTitulo: \\\"\\\", sDsMensagem: \\\"\\\" };\\r\\n    MuralDetalheForum_Load(\\u0027{\\\"nCdProcesso\\\":588,\\\"nCdModulo\\\":59,\\\"bFlPermiteEsclarecer\\\":1,\\\"divForum\\\":\\\"divForum\\\",\\\"nCdMensagemClicado\\\":0,\\\"bFlForumPermitePostagem\\\":true}\\u0027);\\r\\n\\r\\n    function MuralDetalheForum_Load(_objParametros) {\\r\\n\\r\\n        objParametroCadastroVisitanteForum = JSON.parse(_objParametros);\\r\\n        objParametroCadastroVisitanteForum.nCdMensagemClicado = 0;\\r\\n        objParametroCadastroVisitanteForum.bFlAbrindoMensagem = false;\\r\\n        objParametroCadastroVisitanteForum.nIdFormularioValidacao = \\\"uc_MuralDetalheForum\\\";\\r\\n        removerCookie(\\\"CK_VISITANTE_TEMP\\\", \\\"/\\\");\\r\\n        \\r\\n        $(\\\"#divDetalheForumMensagem\\\").kendoWindow({\\r\\n            actions: [\\\"Close\\\"],\\r\\n            title: \\\"Mensagem para o esclarecimento\\\".toUpperCase(),\\r\\n            modal: true,\\r\\n            draggable: false,\\r\\n            resizable: false,\\r\\n            refresh: function () { this.center(); },\\r\\n            animation: { open: true, close: true },\\r\\n            close: function (e) {\\r\\n                objParametroCadastroVisitanteForum.bFlAbrindoMensagem = false;\\r\\n                $(\\\"#divDetalheForumMensagem\\\").data(\\\"kendoWindow\\\").restore();\\r\\n                $(\\\"#divDetalheForumMensagem\\\").children().not(\\\"div\\\").remove();\\r\\n                $(\\\"#gridForum\\\").data(\\\"kendoGrid\\\").dataSource.read();\\r\\n            },\\r\\n            visible: false\\r\\n        });\\r\\n\\r\\n        var sSchema = [{\\r\\n            nCdMensagem: { type: \\\"number\\\" },\\r\\n            sDsTitulo: { type: \\\"string\\\" },\\r\\n            sDsMensagem: { type: \\\"string\\\" },\\r\\n            tDtMensagem: { type: \\\"string\\\" },\\r\\n            nIdTipo: { type: \\\"number\\\" },\\r\\n            nCdEntidade: { type: \\\"number\\\" },\\r\\n            sCdUsuario: { type: \\\"string\\\" },\\r\\n            sNmUsuario: { type: \\\"string\\\" },\\r\\n            nCdMensagemPai: { type: \\\"number\\\" },\\r\\n            nCdSituacao: { type: \\\"number\\\" },\\r\\n            sDsJustificativaBloqueio: { type: \\\"string\\\" },\\r\\n            sDsMensagemOriginal: { type: \\\"string\\\" }\\r\\n        }];\\r\\n\\r\\n       var sColunas = [];\\r\\n\\r\\n        if ( 0 != Number(\\\"1\\\")) {\\r\\n            sColunas.push({\\r\\n                field: \\\"sNmUsuario\\\", title: \\\"Solicitante\\\", width: \\\"15%\\\"\\r\\n            });\\r\\n         }\\r\\n        sColunas.push(             \\r\\n                { field: \\\"sDsTitulo\\\", title: \\\"Tópico\\\", template: \\u0027#=formataTituloTopicoForum(nCdMensagem, sDsTitulo)#\\u0027 },\\r\\n                { field: \\\"nCdAnexo\\\", title: \\\"Anexos\\\", filterable: false, width: \\\"80px\\\", template: \\u0027#=formataAbrirListaForumAnexo(nCdAnexo, uid)#\\u0027 },\\r\\n                { field: \\\"tDtMensagem\\\", title: \\\"Data\\\", width: \\\"15%\\\", template: \\u0027#=formataDataHora(tDtMensagem, true)#\\u0027 }\\r\\n        );\\r\\n\\r\\n        if ( objParametroCadastroVisitanteForum.bFlForumPermitePostagem \\u003e 0)\\r\\n            sColunas.push({\\r\\n                field: \\\"nCdSituacao\\\",\\r\\n                title: \\\" \\\",\\r\\n                headerTemplate: \\\"\\u003cdiv onclick=\\u0027btPostarTopicoForum_Click(0)\\u0027 class=\\u0027ico-novo-topico-azul-25 areaClique\\u0027 title=\\u0027Novo tópico\\u0027 \\u003e\\u003c/div\\u003e\\\",\\r\\n                template: \\\"\\\",\\r\\n                width: \\\"4%\\\"\\r\\n            });\\r\\n        var dtoForum = {\\r\\n            dtoProcesso: {\\r\\n                nCdProcesso:  objParametroCadastroVisitanteForum.nCdProcesso,\\r\\n                nCdModulo: objParametroCadastroVisitanteForum.nCdModulo\\r\\n            },\\r\\n            dtoIdioma: {\\r\\n                nCdIdioma: adquirirIdIdioma(\\\"/\\\")\\r\\n            }\\r\\n        }\\r\\n\\r\\n        CarregaGrid(\\r\\n                    sSchema,\\r\\n                    \\\"WebService/Servicos.asmx/PesquisarProcessoDetalheForum\\\",\\r\\n                    \\\"dtoForum:\\\" + JSON.stringify(dtoForum),\\r\\n                    function (data) {\\r\\n                        reiniciaFormularioCadastroVisitanteForum(false);\\r\\n                    },\\r\\n                    \\\"gridForum\\\",\\r\\n                    sColunas,\\r\\n                    450,\\r\\n                    CarregarRespostas,\\r\\n                    undefined,\\r\\n                    undefined,\\r\\n                    function () {\\r\\n                        Alerta(\\\"Não foi possível recuperar os dados desse registro!\\\", \\\"/\\\");\\r\\n                        btAcao_Click(\\\"voltar\\\");\\r\\n                    }\\r\\n        );\\r\\n\\r\\n        $(\\\".campo-uniform-CadastroVisitanteForum\\\").uniform();\\r\\n    }\\r\\n\\r\\n    function formataTituloTopicoForum(_nCdMensagem, _sDsTitulo) {\\r\\n        return \\\"\\u003cdiv onclick=\\u0027btVisualizarTopicoForum_Click(\\\" + _nCdMensagem + \\\", this)\\u0027 class=\\u0027areaClique\\u0027 \\u003e\\\" + kendo.htmlEncode(_sDsTitulo) + \\\"\\u003c/div\\u003e\\\";\\r\\n    }\\r\\n\\r\\n    function btVisualizarTopicoForum_Click(_nCdMensagem, elemento) {\\r\\n        configurarClick