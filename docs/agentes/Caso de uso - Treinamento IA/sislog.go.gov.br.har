400 font-size-sm\">Fornecedores com Penalidades</span>\r\n                        </a>\r\n                        <a class=\"dropdown-item border-bottom border-light py-3\" href=\"javascript:\" onclick=\"telaHeader.abrirInterno('/Fornecedor/CertificadoCRC')\">\r\n                            <h6 class=\"fs-15 font-weight-medium mb-1\">Certificado de Registro Cadastral - CRC</h6>\r\n                            <span class=\"text-gray-400 font-size-sm\">Emissão/Validação de CRC</span>\r\n                        </a>\r\n                        <a class=\"dropdown-item border-bottom border-light py-3\" href=\"javascript:\" onclick=\"telaHeader.abrirInterno('/Fornecedor/ManualFornecedor')\">\r\n                            <h6 class=\"fs-15 font-weight-medium mb-1\">Sistema Sislog</h6>\r\n                            <span class=\"text-gray-400 font-size-sm\">Manual de Uso do Sistema SISLOG para Fornecedores</span>\r\n                        </a>\r\n                    </div>\r\n                </li>\r\n\r\n                <!-- Contratos -->\r\n                <li class=\"nav-item dropdown\">\r\n                    <a class=\"nav-link dropdown-toggle font-weight-semibold\" href=\"#\" id=\"landingsDropdown\" role=\"button\" data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\">\r\n                        Contratos\r\n                        <img class=\"chevron-down\" src=\"/Content/assets/images/chevron-down-solid.svg\" style=\"width: 10px; margin-top: 5px; position: absolute; margin-left: 2px\">\r\n                    </a>\r\n\r\n                    <div class=\"dropdown-menu overflow-hidden py-0\" aria-labelledby=\"landingsDropdown\">\r\n                        <a class=\"dropdown-item border-bottom border-light py-3\" href=\"javascript:\" onclick=\"telaHeader.abrirInterno('/Contrato/ContratoVigente')\">\r\n                            <h6 class=\"fs-15 font-weight-medium mb-1\">Contratos Vigentes</h6>\r\n                            <span class=\"text-gray-400 font-size-sm\">Acesso aos contratos</span>\r\n                        </a>\r\n                        <a class=\"dropdown-item border-bottom border-light py-3\" href=\"javascript:\" onclick=\"telaHeader.abrirInterno('/Contrato/HistoricoContrato')\">\r\n                            <h6 class=\"fs-15 font-weight-medium mb-1\">Contratos Vencidos</h6>\r\n                            <span class=\"text-gray-400 font-size-sm\">Histórico dos contratos</span>\r\n                        </a>\r\n                    </div>\r\n                </li>\r\n\r\n                <!-- Emendas GO -->\r\n                <li class=\"nav-item dropdown\">\r\n                    <a class=\"nav-link dropdown-toggle font-weight-semibold\" href=\"#\" id=\"landingsDropdown\" role=\"button\" data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\">\r\n                        EmendasGO\r\n                        <img class=\"chevron-down\" src=\"/Content/assets/images/chevron-down-solid.svg\" style=\"width: 10px; margin-top: 5px; position: absolute; margin-left: 2px\">\r\n                    </a>\r\n\r\n                    <div class=\"dropdown-menu overflow-hidden py-0\" aria-labelledby=\"landingsDropdown\">\r\n                        <a class=\"dropdown-item border-bottom border-light py-3\" href=\"javascript:\" onclick=\"telaHeader.abrirInterno('/PreCadastroFornecedor/BeneficiarioEmenda')\">\r\n                            <h6 class=\"fs-15 font-weight-medium mb-1\">Cadastro de Beneficiários</h6>\r\n                            <span class=\"text-gray-400 font-size-sm\">Cadastro de beneficiários de emendas parlamentares</span>\r\n                        </a>\r\n                        <a class=\"dropdown-item border-bottom border-light py-3\" href=\"javascript:\" onclick=\"telaHeader.abrirInterno('/EmendasParlamentares/OrientacaoGeral')\">\r\n                            <h6 class=\"fs-15 font-weight-medium mb-1\">Orientações EmendasGO</h6>\r\n                            <span class=\"text-gray-400 font-size-sm\">Orientações Gerais</span>\r\n                        </a>\r\n                        <a class=\"dropdown-item border-bottom border-light py-3\" href=\"/EmendasParlamentares/RelatorioGeral\">\r\n                            <h6 class=\"fs-15 font-weight-medium mb-1\">Relatórios</h6>\r\n                            <span class=\"text-gray-400 font-size-sm\">Emissão de relatório das emendas parlamentares</span>\r\n                        </a>\r\n                    </div>\r\n                </li>\r\n\r\n                <!-- Fale Conosco -->\r\n                <li class=\"nav-item dropdown\">\r\n                    <a class=\"nav-link dropdown-toggle font-weight-semibold\" href=\"#\" id=\"moreDropdown\" role=\"button\" data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\">\r\n                        Fale Conosco\r\n                        <img class=\"chevron-down\" src=\"/Content/assets/images/chevron-down-solid.svg\" style=\"width: 10px; margin-top: 5px; position: absolute; margin-left: 2px\">\r\n                    </a>\r\n                    <div class=\"dropdown-menu dropdown-megamenu-sm px-2 py-3\" aria-labelledby=\"moreDropdown\">\r\n                        <div class=\"form-row\">\r\n                            <div class=\"col-md text-center\" data-aos=\"fade-up\" data-aos-delay=\"50\">\r\n                                <div class=\"iconbox icon-lg rounded-circle iconbox-soft-primary mb-5\">\r\n                                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                                        <path d=\"M17.6049 14.673C16.9566 14.5351 16.4437 14.8349 15.9896 15.0967C15.5245 15.3665 14.6391 16.0811 14.1332 15.8972C11.5379 14.8339 9.09693 12.5705 8.04028 9.97625C7.85405 9.45961 8.56811 8.57321 8.83601 8.10554C9.09793 7.65185 9.39272 7.1352 9.25827 6.48565C9.13677 5.90105 7.56524 3.90942 7.00952 3.36479C6.64204 3.00504 6.26758 2.8