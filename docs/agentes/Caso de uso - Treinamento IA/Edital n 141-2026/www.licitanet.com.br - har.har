56682,\"datUpload\":\"2026-04-08 17:25:44\",\"name\":\"173398_editais_1775679944.zip\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/173398\\/documentos\\/173398_editais_1775679944.zip\"}],\"files\":[{\"identifier\":138026,\"datUpload\":\"2026-03-24 13:39:59\",\"name\":\"analises_empresas_1774370399.pdf\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/173398\\/documentos\\/analises_empresas_1774370399.pdf\"},{\"identifier\":31485,\"datUpload\":\"2026-03-16 13:12:18\",\"name\":\"impugnacao_porto_seguro_1773677537.pdf\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/173398\\/pedido_esclarecimento\\/impugnacao_porto_seguro_1773677537.pdf\"},{\"identifier\":31486,\"datUpload\":\"2026-03-16 13:12:18\",\"name\":\"acordao_decisao_tce_pa_1773677537.pdf\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/173398\\/pedido_esclarecimento\\/acordao_decisao_tce_pa_1773677537.pdf\"},{\"identifier\":31487,\"datUpload\":\"2026-03-16 13:12:18\",\"name\":\"acordao_decisao_tce_pr_1773677537.pdf\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/173398\\/pedido_esclarecimento\\/acordao_decisao_tce_pr_1773677537.pdf\"},{\"identifier\":31488,\"datUpload\":\"2026-03-16 13:12:18\",\"name\":\"decisao_diario_oficial_tce_pr_1773677537.pdf\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/173398\\/pedido_esclarecimento\\/decisao_diario_oficial_tce_pr_1773677537.pdf\"},{\"identifier\":31489,\"datUpload\":\"2026-03-16 13:12:18\",\"name\":\"informe_tecnico_anvisa_n_20_2015_1773677537.pdf\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/173398\\/pedido_esclarecimento\\/informe_tecnico_anvisa_n_20_2015_1773677537.pdf\"},{\"identifier\":31490,\"datUpload\":\"2026-03-16 13:12:18\",\"name\":\"rdc_16_de_2014_anvisa_1773677537.pdf\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/173398\\/pedido_esclarecimento\\/rdc_16_de_2014_anvisa_1773677537.pdf\"},{\"identifier\":31491,\"datUpload\":\"2026-03-16 13:12:18\",\"name\":\"resposta_manifestacao_anvisa_1773677537.pdf\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/173398\\/pedido_esclarecimento\\/resposta_manifestacao_anvisa_1773677537.pdf\"},{\"identifier\":31492,\"datUpload\":\"2026-03-16 13:12:18\",\"name\":\"solicitacao_anvisa_1773677537.pdf\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/173398\\/pedido_esclarecimento\\/solicitacao_anvisa_1773677537.pdf\"},{\"identifier\":32402,\"datUpload\":\"2026-04-02 20:23:56\",\"name\":\"esclarecimento_1775172236.pdf\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/173398\\/pedido_esclarecimento\\/esclarecimento_1775172236.pdf\"},{\"identifier\":32403,\"datUpload\":\"2026-04-02 20:23:56\",\"name\":\"cnh_leandro_e_joelma_1775172236.pdf\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/173398\\/pedido_esclarecimento\\/cnh_leandro_e_joelma_1775172236.pdf\"},{\"identifier\":32404,\"datUpload\":\"2026-04-02 20:23:56\",\"name\":\"cnpj_e_contrato_social_1775172236.pdf\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/173398\\/pedido_esclarecimento\\/cnpj_e_contrato_social_1775172236.pdf\"},{\"identifier\":54462,\"datUpload\":\"2026-03-18 16:11:51\",\"name\":\"impugnacao_pregao_eletronico_srp_n_013_2026_1773861111.pdf\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/173398\\/pedido_impugnacao\\/impugnacao_pregao_eletronico_srp_n_013_2026_1773861111.pdf\"}],\"requestsClarification\":[{\"orderDate\":\"06\\/03\\/2026 18:55:08\",\"replyDate\":null,\"order\":\"Participar de licita\\u00e7\\u00e3o\",\"reply\":\"\"},{\"orderDate\":\"09\\/03\\/2026 11:18:04\",\"replyDate\":null,\"order\":\"Os valores referentes ao lote 1 ou 7 s\\u00e3o referente ao somat\\u00f3rio mensal ou anual?\",\"reply\":\"\"},{\"orderDate\":\"16\\/03\\/2026 13:12:17\",\"replyDate\":null,\"order\":\"INCLUSAO DE AFE DE TODOS OS LICITANTES\",\"reply\":\"\"},{\"orderDate\":\"25\\/03\\/2026 15:34:24\",\"replyDate\":null,\"order\":\"Prezado(a) Pregoeiro(a),\\r\\n\\r\\nVenho, por meio deste, solicitar esclarecimentos acerca das quantidades informadas no edital, tendo em vista que estas n\\u00e3o condizem com aquelas disponibilizadas no portal.\\r\\n\\r\\nDiante da diverg\\u00eancia identificada, solicito a gentileza de informar qual das quantidades deve ser considerada para fins de elabora\\u00e7\\u00e3o da proposta, considerando a inconsist\\u00eancia entre o edital e o portal.\",\"reply\":\"\"},{\"orderDate\":\"27\\/03\\/2026 10:00:33\",\"replyDate\":null,\"order\":\"Solicitamos informa\\u00e7\\u00e3o a respeito da data real para abertura deste certame pois consta como ano de abertura 2027.\",\"reply\":\"\"},{\"orderDate\":\"02\\/04\\/2026 20:23:56\",\"replyDate\":null,\"order\":\"PEDIDO DE ESCLARECIMENTO\\r\\n1. Quantitativo de Usu\\u00e1rios\\r\\nConsiderando a aus\\u00eancia de defini\\u00e7\\u00e3o do quantitativo de usu\\u00e1rios, solicita-se:\\r\\n\\u2022\\tEstimativa m\\u00ednima e m\\u00e1xima de usu\\u00e1rios; \\r\\n\\u2022\\tEventual limita\\u00e7\\u00e3o de acessos simult\\u00e2neos. \\r\\nNos termos da jurisprud\\u00eancia consolidada do TCU:\\r\\nO Ac\\u00f3rd\\u00e3o 1.793\\/2011 \\u2013 Plen\\u00e1rio estabelece que a Administra\\u00e7\\u00e3o deve realizar adequado planejamento das contrata\\u00e7\\u00f5es, com estimativas consistentes de quantitativos, evitando altera\\u00e7\\u00f5es contratuais por falhas de dimensionamento.\\r\\nO Ac\\u00f3rd\\u00e3o 1.214\\/2013 \\u2013 Plen\\u00e1rio (TC 006.156\\/2011-8) refor\\u00e7a a necessidade de estrutura\\u00e7\\u00e3o contratual eficiente, com defini\\u00e7\\u00e3o clara de execu\\u00e7\\u00e3o, fiscaliza\\u00e7\\u00e3o e mitiga\\u00e7\\u00e3o de riscos, sob pena de preju\\u00edzos operacionais e inefici\\u00eancia.\\r\\nPor sua vez, o Ac\\u00f3rd\\u00e3o 2.622\\/2013 \\u2013 Plen\\u00e1rio evidencia que a forma\\u00e7\\u00e3o de pre\\u00e7os exige rigor t\\u00e9cnico e par\\u00e2metros consistentes, sob risco de sobrepre\\u00e7o, inexequibilidade e comprometimento da execu\\u00e7\\u00e3o contratual.\\r\\nDessa forma, a aus\\u00eancia de defini\\u00e7\\u00e3o dos quantitativos compromete a previsibilidade de custos, podendo resultar em propostas inexequ\\u00edveis ou distorcidas, em afronta aos princ\\u00edpios da efici\\u00eancia, do julgamento objetivo e da sele\\u00e7\\u00e3o da proposta mais vantajosa.\\r\\n2. Diverg\\u00eancia de cronograma\\r\\nH\\u00e1 diverg\\u00eancia entre as informa\\u00e7\\u00f5es constantes no PNCP (t\\u00e9rmino em 06\\/04\\/2026 \\u00e0s 07:30) e no Aviso (08\\/04\\/2026 \\u00e0s 09:00).\\r\\nSolicita-se confirma\\u00e7\\u00e3o do cronograma correto para envio de propostas e realiza\\u00e7\\u00e3o da sess\\u00e3o.\\r\\nSem mais, aguarda-se retorno.\",\"reply\":\"\"}],\"challengeRequests\":[{\"orderDate\":\"16\\/03\\/2026 13:23:21\",\"replyDate\":null,\"order\":\"Solicita-se esclarecimento quanto \\u00e0 possibilidade de oferta de lance com taxa de administra\\u00e7\\u00e3o de 0,00% (zero por cento). Tal percentual ser\\u00e1 aceito pela Administra\\u00e7\\u00e3o ou ser\\u00e1 interpretado como percentual negativo, considerando que o edital veda lances negativos? O questionamento visa evitar diverg\\u00eancias de interpreta\\u00e7\\u00e3o e prevenir eventual desclassifica\\u00e7\\u00e3o por entendimento distinto do instrumento convocat\\u00f3rio.\",\"reply\":\"\"},{\"orderDate\":\"18\\/03\\/2026 16:11:51\",\"replyDate\":null,\"order\":\"Vem, respeitosamente, apresentar IMPUGNA\\u00c7\\u00c3O ao edital em refer\\u00eancia, pelos fatos e fundamentos a seguir expostos:\\r\\nI \\u2013 DA EXCLUSIVIDADE INDEVIDA PARA ME\\/EPP\\r\\nII \\u2013 DA AUS\\u00caNCIA DE EXIG\\u00caNCIA DE LICENCIAMENTO SANIT\\u00c1RIO (GRAVE IRREGULARIDADE) E DE FUNCIONAMENTO\",\"reply\":\"\"}],\"biddingLaw\":2,\"totalItemsMeepp\":false,\"hasMeeppItems\":false,\"isInversion\":false,\"isGuarantee\":false},{\"identifier\":201358,\"status\":\"RECEBENDO PROPOSTA\",\"description\":\"Elabora\\u00e7\\u00e3o dos projetos b\\u00e1sico e executivo e constru\\u00e7\\u00e3o de um viaduto na rodovia MG-230 sobre a conex\\u00e3o com a Avenida Faria Pereira, no Munic\\u00edpio de Patroc\\u00ednio\\/MG.\",\"datStartSession\":\"18\\/12\\/2026 09:00:00\",\"datFinishSession\":null,\"datPublication\":\"14\\/09\\/2026 14:03:27\",\"datClarificationRequestLimit\":\"15\\/12\\/2026\",\"allowedClarificationRequest\":true,\"document\":\"18.468.033\\/0001-26\",\"buyer\":\"MUNIC\\u00cdPIO DE PATROC\\u00cdNIO\\/MG\",\"phone\":\"3438391800\",\"email\":\"licitacaoptc@patrocinio.mg.gov.br\",\"city\":\"Patroc\\u00ednio\",\"uf\":\"MG\",\"crier\":\"Uiara de Souza Monteiro Pinheiro\",\"documentCrier\":\"05869415683\",\"numBatches\":1,\"year\":2026,\"number\":\"8\",\"biddingProcess\":\"197\",\"isSuspended\":false,\"isCanceled\":false,\"typeBid\":1,\"typeBidText\":\"Menor Pre\\u00e7o por Item\",\"decree\":1,\"typeModel\":4,\"typeModelText\":\"Modo Fechado\",\"disputeMode\":15,\"disputeModeText\":\"CONCORR\\u00caNCIA T\\u00c9CNICA E PRE\\u00c7O\",\"isRevoked\":false,\"isPriceRecord\":false,\"isCovid\":false,\"typeRegionalBenefit\":1,\"regionalCities\":[],\"regionalBenefit\":\"N\\u00e3o se aplica\",\"regionalBenefitCeiling\":10,\"isExclusiveRegionalBenefit\":false,\"acquisition\":\"Obras e servi\\u00e7os especiais de engenharia\",\"isAutomaticDispute\":false,\"notices\":[{\"identifier\":408830,\"datUpload\":\"2026-09-14 13:47:37\",\"name\":\"201358_editais_1789404455.zip\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/201358\\/documentos\\/201358_editais_1789404455.zip\"}],\"files\":[{\"identifier\":41618,\"datUpload\":\"2026-09-29 11:34:45\",\"name\":\"impugnacao_ce_08_2026_patrocinio_1790692485.pdf\",\"link\":\"https:\\/\\/d2e4y9pc28eke4.cloudfront.net\\/pregao\\/201358\\/pedido_esclarecimento\\/impugnacao_ce_08_2026_patrocinio_1790692485.pdf\"},{\"identifier\":41619,\"datUpload\":\"2026-09-29 11:34:45\",\"name\":\"16_alteracao_hl_abe