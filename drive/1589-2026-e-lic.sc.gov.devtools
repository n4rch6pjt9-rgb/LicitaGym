            "mimeType": "text/css",
            "text": "@charset \"UTF-8\";\r\n/* CSS Document */\r\n\r\n\r\n/* ------------------------ GERAL ----------------------- */\r\n\r\nbody { font-size: 15px; }\r\n.conteudo {width: 95% !important;}\r\n\r\n.hide_480 {display: none !important;}\r\n.show_480 {display: block !important}\r\n\r\n\r\n/*--------------------------------------------------------------------------------------------*/\r\n/*--------------------------------------- CABECALHO ------------------------------------------*/\r\n\r\n#cabecalho {\r\n\theight: 168px;\r\n\tpadding-left: 10px;\r\n\tpadding-right: 10px;\r\n\tbackground-position: center 78px;\r\n}\r\n\r\n#cabecalho .conteudo {\tbackground-image: none !important; }\r\n\r\n#cabecalho .usuario {\r\n\tmargin-top: 20px;\r\n\tfloat: left;\r\n}\r\n\r\n#cabecalho .usuario a {\r\n\tfont-size: 0.8em;\r\n\tmargin-left: 0px;\r\n}\r\n\r\n#cabecalho .usuario a+a {\r\n\tmargin-left: 5px;\r\n}\r\n\r\n/*--------------------------------------------------------------------------------------------*/\r\n/*------------------------------------------ MENU --------------------------------------------*/\r\n\r\n#menu {\r\n\tpadding: 13px 10px;\r\n}\r\n\r\n#menu h3 {\r\n\tcolor: #aaa;\r\n\tfont-weight: normal;\r\n}\r\n\r\n#menu div.selector  {\r\n\twidth: 98%;\r\n}\r\n\r\n/*--------------------------------------------------------------------------------------------*/\r\n/*----------------------------------------- CORPO --------------------------------------------*/\r\n\r\n.coluna_esquerda,\r\n.coluna_direita {\r\n\twidth: 96%;\r\n\tpadding: 0 2%;\r\n}\r\n\r\n\r\n/*-----------------------------------------------------*/\r\n/*---------------------- PAINÉIS ----------------------*/\r\n\r\n.painel {\r\n\twidth: 94% !important;\r\n}\r\n\r\n.painel.pregao {\r\n\tmargin: 0px;\r\n\tmargin-bottom: 25px;\r\n}\r\n\r\n.painel.banners {\r\n\twidth: 93% !important;\r\n\tpadding: 1.5%;\r\n\tmargin: 0 2%;\r\n}\r\n\r\n.painel.banners a {\r\n\tmargin: 2.5%;\r\n    width: 44%;\r\n}\r\n\r\n.painel.banners a img {\r\n\twidth:100%;\r\n}\r\n\r\n\r\n/*-----------------------------------------------------*/\r\n/*------------------------ BOTÃO ----------------------*/\r\n\r\n.botao {\r\n\tpadding: 5px 10px 6px;\r\n}\r\n\r\n/*-----------------------------------------------------*/\r\n/*----------------------- LEGENDA ---------------------*/\r\n\r\n.coluna_esquerda .legenda {\r\n\tmargin-top: 4px;\r\n}\r\n\r\n.coluna_esquerda .legenda .botao {\r\n\tfloat: left;\r\n}"
          },
