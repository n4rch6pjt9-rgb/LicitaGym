Todas as modalidades</option>\r\n\t<option value=\"19\">Compra direta</option>\r\n\t<option value=\"23\">Convite</option>\r\n\t<option value=\"18\">Preg&#227;o eletr&#244;nico</option>\r\n\t<option value=\"59\">Processo de contrata&#231;&#227;o</option>\r\n\r\n</select>\r\n                \r\n                <div style=\"display:none;\" class=\"mural mural-pesquisa-agrupada portalTransparencia\" >\r\n                    <label id=\"lblVisoes\" for=\"ddlVisoes\" >Situação</label><br />\r\n                    <select id=\"ddlVisoes\" class=\"campoSelect enterFiltro\" aria-label=\"Situação\" data-testid=\"mural-select-visoes\"></select>\r\n                </div>\r\n                <div id=\"divTipoProcesso\" style=\"display:none;\" class=\"mural mural-estatistico oculta-campo-modulo\" >\r\n                    <label id=\"lblTipoProcesso\" for=\"ddlTipoProcesso\" >Tipo de processo</label><br />\r\n                    <select id=\"ddlTipoProcesso\" class=\"campoSelect enterFiltro oculta-campo-modulo\" ></select>\r\n                </div>\r\n\r\n                <br class=\"mural edital portalTransparencia\" /><br class=\"edital mural-estatistico\" />\r\n\r\n                <div id=\"btSalvarXLS\" class=\"areaBotao2 portalTransparencia\">\r\n                    <input type='button' id=\"btnSalvarXLS\" onclick='btExportar_Click(\"XLSX\")' style=\"margin-bottom:5px;\" class='campoBotao enterFiltro'  value=\"Salvar XLS\" />\r\n                </div>\r\n                <div id=\"btSalvarODS\" class=\"areaBotao2 portalTransparencia\">\r\n                    <input type='button' id=\"btnSalvarODS\" onclick='btExportar_Click(\"ODS\")' style=\"margin-bottom:5px;\" class='campoBotao enterFiltro' value=\"Salvar ODS\"/>\r\n                </div>\r\n                <div class=\"areaBotao2\" >\r\n                    <div class=\"ico-botao ico-buscar-branco-15\"></div>\r\n                    <input id=\"btProcurar\" type=\"button\" onclick=\"btProcurar_Click()\" value=\"Procurar\" class=\"campoBotao  enterFiltro\" />\r\n                </div>\r\n                <div class=\"areaBotao2\">\r\n                    <div class=\"ico-botao ico-limpar-branco-15\"></div>\r\n                    <input id=\"btLimpar\" type=\"button\" onclick=\"btLimpar_Click()\" value=\"Limpar\" class=\"campoBotao  enterFiltro\" />\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Painel de opções (esquerda) -->\r\n        <div id=\"areaOpcoes\" class=\"painelOpcoes\" style=\"display:none\">\r\n            <div class=\"iconePainel opcoes\" ><div class=\"ico-legenda-branco-25\"></div></div>\r\n            <div class=\"grupoFiltro direita\">\r\n                <h1>Legenda</h1>\r\n                <hr />\r\n                <ul id=\"ctl00_conteudoPrincipal_ulLegenda\" class=\"lista-legenda\"><li>&nbsp;</li><li class=\"listaLI\"><h4 class='titulo-legenda'>PROCESSO DE CONTRATAÇÃO</h4></li><li class=\"listaLI\"><img src='/core/images/icones/ic_P_agendado.gif' alt='' class='icone-legenda' />&nbsp;Agendado/Publicado</li><li class=\"listaLI\"><img src='/core/images/icones/ic_P_Aguardando_comissao.gif' alt='' class='icone-legenda' />&nbsp;Aguardando início pela comissão</li><li class=\"listaLI\"><img src='/core/images/icones/ic_compra_anulado.gif' alt='' class='icone-legenda' />&nbsp;Anulado</li><li class=\"listaLI\"><img src='/core/images/icones/ic_P_cancelado.gif' alt='' class='icone-legenda' />&nbsp;Cancelado</li><li class=\"listaLI\"><img src='/core/images/icones/ic_compra_deserto.gif' alt='' class='icone-legenda' />&nbsp;Deserto</li><li class=\"listaLI\"><img src='/core/images/icones/ic_em_andamento.gif' alt='' class='icone-legenda' />&nbsp;Em andamento</li><li class=\"listaLI\"><img src='/core/images/icones/ic_atividade_aprovacao.gif' alt='' class='icone-legenda' />&nbsp;Em aprovação</li><li class=\"listaLI\"><img src='/core/images/icones/ic_P_configuracao.gif' alt='' class='icone-legenda' />&nbsp;Em configuração</li><li class=\"listaLI\"><img s