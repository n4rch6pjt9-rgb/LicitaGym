 \"\\n</body>\\n</html > \";\r\n\r\n            new_window.document.write(complete_html_markup);\r\n            new_window.document.close();\r\n\r\n            //principal.removeLoadPainelDetalhe();\r\n        };\r\n\r\n        var data = parametros;\r\n        req.send(JSON.stringify(data));\r\n\r\n    }\r\n\r\n    var imprimirDocumentoExterno = function (key, sei) {\r\n\r\n        var url = '/PanelAquisicao/GerarPDFDocumentoView' + '?d=' + key + '&sei=' + sei;\r\n        window.open(url, '_blank');\r\n    };\r\n\r\n</script>\r\n\r\n    <div class=\"main-content\">\r\n\r\n        <style>\r\n    .navbar-nav .dropdown-toggle:after {\r\n        border: none !important;\r\n    }\r\n</style>\r\n\r\n<!-- Navbar -->\r\n<nav id=\"version30header\" class=\"navbar navbar-expand-lg navbar-light fixed-top py-2 py-lg-0\" style=\"background-color: #f5f5f5;\">\r\n    <div class=\"container\">\r\n\r\n        <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\r\n            <span class=\"navbar-toggler-icon\"></span>\r\n        </button>\r\n\r\n        <a class=\"navbar-brand font-weight-semibold\" href=\"/\">\r\n            <img src=\"/Content/assets/images/logo.svg\" alt=\"Sislog Logo\" class=\"logo\">\r\n        </a>\r\n\r\n        <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\r\n\r\n            <button class=\"navbar-toggler navbar-closer d-lg-none\" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"true\" aria-label=\"Toggle navigation\">\r\n                <i class=\"icon-x\"></i>\r\n            </button>\r\n\r\n            <ul class=\"navbar-nav mx-auto\">\r\n\r\n                <li class=\"d-lg-none\">\r\n                    <a class=\"nav-link font-weight-semibold\">Menu</a>\r\n                </li>\r\n\r\n                <li class=\"d-lg-none\">\r\n                    <a href=\"javascript:\" onclick=\"telaHeader.abrirInterno('/Login')\" class=\"nav-link font-weight-semibold portal-button btn btn-success btn-sm\" style=\"width:150px\">\r\n                        Acessar o portal\r\n                    </a>\r\n                </li>\r\n\r\n                <li>\r\n                    <a href=\"/\" class=\"nav-link font-weight-semibold active\">Página inicial</a>\r\n                </li>\r\n\r\n                <!-- Aquisições -->\r\n                <li class=\"nav-item dropdown\">\r\n                    <a class=\"nav-link dropdown-toggle font-weight-semibold\" href=\"javascript:\" id=\"landingsDropdown\" role=\"button\" data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\">\r\n                        Contratações\r\n                        <img class=\"chevron-down\" src=\"/Content/assets/images/chevron-down-solid.svg\" style=\"width: 10px; margin-top: 5px; position: absolute; margin-left: 2px\">\r\n                    </a>\r\n\r\n                    <div class=\"dropdown-menu overflow-hidden py-0\" aria-labelledby=\"landingsDropdown\">\r\n                        <a class=\"dropdown-item border-bottom border-light py-3\" href=\"javascript:\" onclick=\"telaHeader.abrirInterno('/Aquisicao/Licitacao')\">\r\n                            <h6 class=\"fs-15 font-weight-medium mb-1\">Licitações</h6>\r\n                            <span class=\"text-gray-400 font-size-sm\">Pregões, Concorrências, etc...</span>\r\n                        </a>\r\n                        <a class=\"dropdown-item border-bottom border-light py-3\" href=\"javascript:\" onclick=\"telaHeader.abrirInterno('/PanelAquisicao')\">\r\n                            <h6 class=\"fs-15 font-weight-medium mb-1\">Contratação Direta</h6>\r\n                            <span class=\"text-gray-400 font-size-sm\">Compras Diretas e Inexigibilidades</span>\r\n                        </a>\r\n                        <a class=\"dropdown-item border-bottom border-light py-3\" href=\"javascript:\" onclick=\"telaHeader.abrirInterno('/Aquisicao/ProcedimentoAuxiliar')\">\r\n                            <h6 class=\"fs-15 font-weight-medium mb-1\">Procedimentos Auxiliares</h6>\r\n                            <span class=\"text-gray-400 font-size-sm\">Em breve...</span>\r\n                        </a>\r\n                        <a class=\"dropdown-item border-bottom border-light py-3\" href=\"javascript:\" onclick=\"telaHeader.abrirInterno('/Aquisicao/RegistroPreco')\">\r\n                            <h6 class=\"fs-15 font-weight-medium mb-1\">Registro de Preços</h6>\r\n                            <span class=\"text-gray-400 font-size-sm\">Em breve...</span>\r\n                        </a>\r\n                    </div>\r\n                </li>\r\n\r\n                <!-- Fornecedores -->\r\n                <li class=\"nav-item dropdown\">\r\n                    <a class=\"nav-link dropdown-toggle font-weight-semibold\" href=\"#\" id=\"landingsDropdown\" role=\"button\" data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\">\r\n                        Fornecedores\r\n                        <img class=\"chevron-down\" src=\"/Content/assets/images/chevron-down-solid.svg\" style=\"width: 10px; margin-top: 5px; position: absolute; margin-left: 2px \">\r\n                    </a>\r\n\r\n                    <div class=\"dropdown-menu overflow-hidden py-0\" aria-labelledby=\"landingsDropdown\">\r\n                        <a class=\"dropdown-item border-bottom border-light py-3\" href=\"javascript:\" onclick=\"telaHeader.abrirInterno('/Fornecedor/OrientacaoGeral')\">\r\n                            <h6 class=\"fs-15 font-weight-medium mb-1\">Orientações Gerais</h6>\r\n                            <span class=\"text-gray-400 font-size-sm\">Orientações sobre Cadastro, Renovação, Documentação, etc...</span>\r\n                        </a>\r\n                        <a clas