            "mimeType": "text/css",
            "text": "@charset \"UTF-8\";\r\n/* CSS Document */\r\n\r\n\r\n/* ---------------------------------- GERAL ------------------------------------- */\r\n\r\nbody { font-size: 13.2px; }\r\n.conteudo {width: 750px !important;}\r\n\r\n.hide_800 { display: none; }\r\n.show_800 { display: block !important; }\r\n\r\n/*--------------------------------------------------------------------------------------------*/\r\n/*--------------------------------------- CABECALHO ------------------------------------------*/\r\n\r\n#cabecalho .conteudo {\tbackground-image: none !important; }\r\n\r\n#cabecalho .usuario {\r\n\tmargin-top: 10px\r\n}\r\n\r\n/*--------------------------------------------------------------------------------------------*/\r\n/*------------------------------------------ MENU --------------------------------------------*/\r\n\r\n#menu ul li {\r\n\tmargin: 3px 2px;;\r\n}\r\n\r\n#menu ul li a {\r\n\tfont-size: 1em;\r\n}\r\n\r\n/*--------------------------------------------------------------------------------------------*/\r\n/*----------------------------------------- CORPO --------------------------------------------*/\r\n\r\n#corpo {\r\n\tpadding: 36px 0px 25px 0px;\r\n}\r\n\t\r\n.coluna_esquerda {\r\n\twidth: 100%;\r\n\tfloat: left;\r\n}\r\n\r\n.coluna_direita {\r\n\twidth: 100%;\r\n\tfloat: left;\r\n}\r\n\r\n\r\n/*---------------------- PAINÉIS ----------------------*/\r\n\r\n.painel.pregao {\r\n\twidth: 46.5%;\r\n\tmargin: 0 2.5% 0 0;\r\n}\r\n\r\n.painel.banners {\r\n\tmargin-top: 30px;\r\n}\r\n\r\n.painel.banners a img {\r\n    width: 109px;\r\n}"
          },
