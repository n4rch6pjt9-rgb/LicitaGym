            "mimeType": "application/json",
            "text": "{\"d\":\"\\u003cform method=\\\"post\\\" action=\\\"../Servicos.asmx\\\" id=\\\"uc_MuralDetalheRelatorio\\\"\\u003e\\r\\n\\u003cdiv class=\\\"aspNetHidden\\\"\\u003e\\r\\n\\u003cinput type=\\\"hidden\\\" name=\\\"__VIEWSTATE\\\" id=\\\"__VIEWSTATE\\\" value=\\\"sGK8qX+BdAtFZsVmU5h8TarSCXzQMUtRWCbN047H9rpcspVibAQ07JXVB9y6GFmAMMs+Ng==\\\" /\\u003e\\r\\n\\u003c/div\\u003e\\r\\n\\r\\n\\r\\n\\u003cdiv id=\\\"gridRelatorio\\\"\\u003e\\u003c/div\\u003e\\r\\n\\r\\n\\u003cscript type=\\\"text/javascript\\\"\\u003e\\r\\n\\r\\n    var objParametroRelatorio;\\r\\n\\r\\n    MuralDetalheRelatorio_Load(\\u0027{\\\"nCdProcesso\\\":588,\\\"nCdModulo\\\":59,\\\"nIdTipoApuracao\\\":2,\\\"nCdSituacao\\\":3,\\\"nCdEmpresa\\\":14295,\\\"divRelatorio\\\":\\\"divRelatorio\\\"}\\u0027);\\r\\n\\r\\n    function MuralDetalheRelatorio_Load(_objParametros) {\\r\\n        objParametroRelatorio = JSON.parse(_objParametros);\\r\\n        MuralDetalheRelatorio_CarregarRelatorio();\\r\\n    }\\r\\n\\r\\n    function MuralDetalheRelatorio_CarregarRelatorio() {\\r\\n        var sSchema = [{\\r\\n            sNmItem: { type: \\\"string\\\" },\\r\\n            sDsPaginaRelatorio: { type: \\\"string\\\" },\\r\\n            sDsArquivoRelatorio: { type: \\\"string\\\" },\\r\\n            sDsParametroCriptografado: { type: \\\"string\\\" }\\r\\n        }];\\r\\n\\r\\n        var sColunas = [\\r\\n            { field: \\\"sNmItem\\\", title: \\\"Relatório\\\", width: \\\"25px\\\", template: \\u0027#=formataNmItem(sNmItem, sDsParametroCriptografado)#\\u0027 }\\r\\n        ];\\r\\n\\r\\n        var dtoProcesso = {\\r\\n            nCdProcesso: objParametroRelatorio.nCdProcesso,\\r\\n            nCdModulo: objParametroRelatorio.nCdModulo,\\r\\n            nIdTipoApuracao: objParametroRelatorio.nIdTipoApuracao,\\r\\n            nCdSituacao: objParametroRelatorio.nCdSituacao,\\r\\n            nCdEmpresa: objParametroRelatorio.nCdEmpresa,\\r\\n            dtoIdioma: {\\r\\n                nCdI