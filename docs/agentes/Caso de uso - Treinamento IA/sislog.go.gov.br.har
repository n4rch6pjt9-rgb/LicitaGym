Up.js\"></script>\r\n    <script src=\"/Content/assets/js/theme.js\"></script>\r\n    <script src=\"https://www.google.com/recaptcha/api.js?render=6Lf5b0YfAAAAAJ6e2mfGEnV6LClfzsYeqzHDhWyg\"></script>\r\n\r\n    <script>\r\n        $(document).ready(function () {\r\n            App.initFormulario();\r\n            //$('[data-toggle=\"tooltip\"]').tooltip();\r\n\r\n        });\r\n\r\n\r\n    </script>\r\n\r\n</body>\r\n\r\n</html>\r\n\r\n<script type=\"text/javascript\">\r\n    $(document).ready(function ()\r\n    {\r\n\r\n        ;\r\n    });\r\n\r\n    var _validFileExtensionsUpload = [\".pdf\"];\r\n\r\n    function validateSingleInputFile(oInput) {\r\n\r\n        if (oInput.type == \"file\") {\r\n            var sFileName = oInput.value;\r\n            if (sFileName.length > 0) {\r\n\r\n                var regex = new RegExp(\"^[a-zA-Z0-9 .]+$\");\r\n                var key = oInput.files[0].name;\r\n                if (!regex.test(key)) {\r\n                    mensagemNotificacaoGeral.exibaErro(\"O arquivo \" + sFileName + \" é inválido, pois contém caracteres especiais em seu nome tais como \\\"+:ç/', etc. Use apenas caracteres alfanuméricos ou alfabéticos.\");\r\n                    oInput.value = \"\";\r\n                    return false;\r\n                }\r\n\r\n                var blnValid = false;\r\n                for (var j = 0; j < _validFileExtensionsUpload.length; j++) {\r\n                    var sCurExtension = _validFileExtensionsUpload[j];\r\n                    if (sFileName.substr(sFileName.length - sCurExtension.length, sCurExtension.length).toLowerCase() == sCurExtension.toLowerCase()) {\r\n                        blnValid = true;\r\n                        break;\r\n                    }\r\n                }\r\n\r\n                if (!blnValid) {\r\n                    mensagemNotificacaoGeral.exibaErro(\"O arquivo \" + sFileName + \" é inválido, as extensões permitidas são: \" + _validFileExtensionsUpload.join(\", \"));\r\n                    oInput.value = \"\";\r\n                    return false;\r\n                }\r\n\r\n                const maximumSize = 10 * 1024 * 1024 // In MegaBytes\r\n                const files = Array.from(oInput.files)\r\n                const approvedFiles = new Array\r\n\r\n                if (!files.length) {\r\n                    mensagemNotificacaoGeral.exibaErro(\"Sem arquivos selecionados.\");\r\n                    oInput.value = \"\";\r\n                    return false;\r\n                }\r\n\r\n                for (const file of files) if (file.size <= maximumSize) approvedFiles.push(file)\r\n\r\n                if (!approvedFiles.length) {\r\n                    mensagemNotificacaoGeral.exibaErro(\"Tamanho máximo dos arquivos é de 10mb, upload não permitido.\");\r\n                    oInput.value = \"\";\r\n                    return false;\r\n                }\r\n            }\r\n        }\r\n        return true;\r\n    }\r\n\r\n    var telaIndex = function () {\r\n\r\n        var abrirComReCaptcha = function (url, params) {\r\n            exibaLoad();\r\n            \r\n            var novaUrl = url + '?interno=sim';\r\n\r\n            if (params && params.modalidades) {\r\n                query = params.modalidades\r\n                    .map(m => \"modalidades=\" + encodeURIComponent(m))\r\n                    .join(\"&\");\r\n\r\n                novaUrl += '&' + query;\r\n            }\r\n\r\n            principal.carregueConteudoComPost(novaUrl, contentIndex, {}, function () { removaLoad(); });\r\n        };\r\n\r\n        var searchContratacao = function (e, cod) {\r\n            e.preventDefault();\r\n            \r\n            let resultado = validacoesRelativas.validar($('#formBuscarContratacao'));\r\n            \r\n            if (resultado == false) {\r\n                mensagemNotificacaoGeral.exibaErro('Existem inconsistências');\r\n                return;\r\n            }\r\n\r\n            exibaLoad();\r\n\r\n            grecaptcha.ready(function () {\r\n                grecaptcha\r\n                    .execute('6Lf5b0YfAAAAAJ6e2mfGEnV6LClfzsYeqzHDhWyg', { action: 'submit' })\r\n                    .then(function (token) {\r\n                        var urlValidReCaptcha = \"/PanelAquisicao/IsValidReCaptcha\";\r\n\r\n                        if (!principal.verifyReCaptcha(urlValidReCaptcha, token)) {\r\n                            mensagemNotificacaoGeral.exibaErro(\"Possível robo\");\r\n                            return;\r\n                        }\r\n\r\n                        $.get('https://sislog.go.gov.br/PanelAquisicao/ValidarNovaJanela', { idLicitacao: cod }, function (data) {\r\n                            var json = JSON.parse(data);\r\n\r\n                            if (!json.Sucesso) {\r\n                                removaLoad();\r\n                                mensagemNotificacaoGeral.exibaErro(json.Mensagem);\r\n\r\n                                return;\r\n                            }\r\n\r\n                            window.location.href = 'https://sislog.go.gov.br/PanelAquisicao/DetalhesLicitacao?idLicitacao=' + cod;\r\n                        });\r\n                    })\r\n                    .catch(function(error) {\r\n                        removaLoad();\r\n                        mensagemNotificacaoGeral.exibaErro(\"Não foi possível validar a segurança. Tente recarregar a página.\");\r\n                    });\r\n            });\r\n        }\r\n\r\n        return {\r\n            abrirComReCaptcha: abrirComReCaptcha,\r\n            searchContratacao: searchContratacao\r\n        }\r\n    }();\r\n\r\n    var contentIndex = function () {\r\n        return $(\"#page-content\");\r\n    }\r\n\r\n    var exibaLoad = function () {\r\n        $(\"#page-content\").block();\r\n    };\r\n\r\n    var removaLoad = function () {\r\n        $(\"#page-content\").unblock();\r\n    };\r\n</script>"
